{
  "version": 1,
  "id": "grablab_payment",
  "package_version": "1.1.0",
  "provider_version": "grab-hmac-sha256-v1",
  "sources": [
    "https://github.com/urbanspress/grablab-cms"
  ],
  "origin": "https://payments.example.invalid",
  "verifier": "grab-hmac-sha256-v1",
  "types": {
    "payment_event": {
      "type": "record",
      "fields": [
        {
          "name": "type",
          "schema": {
            "type": "text",
            "max_length": 64
          }
        },
        {
          "name": "order_number",
          "schema": {
            "type": "text",
            "max_length": 64
          }
        },
        {
          "name": "amount",
          "schema": {
            "type": "text",
            "max_length": 32
          }
        },
        {
          "name": "currency",
          "schema": {
            "type": "text",
            "max_length": 8
          }
        },
        {
          "name": "payment_ref",
          "schema": {
            "type": "text",
            "max_length": 190
          }
        }
      ]
    }
  },
  "operations": {
    "lookup": {
      "method": "GET",
      "path": "/events/{id}",
      "path_fields": {
        "id": "id"
      },
      "input": {
        "type": "record",
        "fields": [
          {
            "name": "id",
            "schema": {
              "type": "text",
              "max_length": 128
            }
          }
        ]
      },
      "output": {
        "type": "ref",
        "ref": "payment_event"
      },
      "classification": "read-only",
      "timeout_ms": 10000,
      "max_body_bytes": 1048576
    }
  }
}
