# ==============================================================================
# Pretty Permalink & Search Public Routes
# ==============================================================================

make render_taxonomy_archive using stmts, tax_row, slug_norm, full_path, req
  set term_row to data.one using stmts.get_term, record {lookup: "tax_slug", id: 0, taxonomy_id: tax_row.id, slug: slug_norm}
  if term_row is nothing
    give back render_theme_page using stmts, "404", {"requested_path": full_path, "current_path": full_path}, 404, []
  end
  set theme to get_active_theme_context using stmts
  set registry to build_active_hook_registry using theme
  set q_map to {"taxonomy": tax_row.slug, "term_slug": slug_norm, "include_children": "true", "per_page": "10", "sort_by": "published_at", "sort_dir": "desc"}
  if req.query has "page"
    set q_map to collections.put using q_map, "page", (req.query at "page")
  end
  set qres to query_entries using stmts, theme, registry, q_map, yes
  set items to []
  set cnt to "0"
  if qres.ok
    set items to qres.data.items
    set cnt to text.from using qres.data.pagination.total_items
  end
  set summary to build_entries_summary using items
  set desc_txt to term_row.description
  if desc_txt is ""
    set desc_txt to tax_row.label_singular joined with ": " joined with term_row.name
  end
  set arch_prefix to tax_row.archive_slug joined with "/" joined with slug_norm
  give back render_theme_page using stmts, "archive", {"archive_label": term_row.name, "archive_slug": arch_prefix, "meta_description": desc_txt, "taxonomy_slug": tax_row.slug, "term_slug": slug_norm, "entry_count": cnt, "published_count": cnt, "entries_summary": summary, "current_path": full_path}, 200, items
end

route "GET" "/search" using req
  set q_text to ""
  if req.query has "q"
    set q_text to text.trim using (text.from using (req.query at "q"))
  end
  set theme to get_active_theme_context using stmts
  set registry to build_active_hook_registry using theme
  set qres to query_entries using stmts, theme, registry, {"per_page": "50", "sort_by": "published_at", "sort_dir": "desc"}, yes
  set matched to []
  if qres.ok
    set q_lower to text.lower using q_text
    for each item in qres.data.items
      if q_lower is "" or (text.contains using (text.lower using item.title), q_lower) or (text.contains using (text.lower using item.excerpt), q_lower)
        set matched to collections.append using matched, item
      end
    end
  end
  set summary to build_entries_summary using matched
  set cnt to text.from using (collections.length using matched)
  give back render_theme_page using stmts, "search", {"page_title": "Search", "query": q_text, "results_summary": summary, "published_count": cnt, "current_path": "/search"}, 200, matched
end

route "GET" "/" using req
  set settings to get_site_settings_map using stmts
  set home_id_raw to settings at "home_entry_id"
  if home_id_raw is not ""
    try
      set home_id to text.to_integer using home_id_raw
      set home_entry to data.one using stmts.get_entry_by_id, record {id: home_id}
      if home_entry is not nothing and home_entry.status is "published"
        give back render_single_entry using stmts, home_entry
      end
    catch err
    end
  end

  set theme to get_active_theme_context using stmts
  set registry to build_active_hook_registry using theme
  set q_map to {"per_page": "10", "sort_by": "published_at", "sort_dir": "desc"}
  if req.query has "page"
    set q_map to collections.put using q_map, "page", (req.query at "page")
  end
  set qres to query_entries using stmts, theme, registry, q_map, yes
  set items to []
  set cnt to "0"
  if qres.ok
    set items to qres.data.items
    set cnt to text.from using qres.data.pagination.total_items
  end
  set summary to build_entries_summary using items
  give back render_theme_page using stmts, "home", {"page_title": "Home", "meta_description": (settings at "site_tagline"), "published_count": cnt, "entries_summary": summary, "current_path": "/"}, 200, items
end

route "GET" "/category/{slug}" using req
  set slug_norm to normalize_slug using req.params.slug
  set full_path to "/category/" joined with slug_norm
  set tax_row to data.one using stmts.get_taxonomy, record {lookup: "archive", iv: 0, sv: "category"}
  if tax_row is nothing
    give back render_theme_page using stmts, "404", {"requested_path": full_path, "current_path": full_path}, 404, []
  end
  give back render_taxonomy_archive using stmts, tax_row, slug_norm, full_path, req
end

route "GET" "/tag/{slug}" using req
  set slug_norm to normalize_slug using req.params.slug
  set full_path to "/tag/" joined with slug_norm
  set tax_row to data.one using stmts.get_taxonomy, record {lookup: "archive", iv: 0, sv: "tag"}
  if tax_row is nothing
    give back render_theme_page using stmts, "404", {"requested_path": full_path, "current_path": full_path}, 404, []
  end
  give back render_taxonomy_archive using stmts, tax_row, slug_norm, full_path, req
end

route "GET" "/shop" using req
  if not stmts.commerce_ready
    give back render_theme_page using stmts, "404", {"requested_path": "/shop", "current_path": "/shop"}, 404, []
  end
  set cfg to get_commerce_config using stmts
  if not cfg.enabled
    give back render_theme_page using stmts, "404", {"requested_path": "/shop", "current_path": "/shop"}, 404, []
  end
  call run_commerce_sweep using stmts, no
  set prods to data.query using stmts.commerce.products, record {mode: "pub", iv: 0, sv: ""}
  set cards to []
  for each p in prods
    set price_s to format_cents_usd using p.price_cents
    set cards to collections.append using cards, ("<article class=\"cms-card cms-product-card\"><h3><a href=\"" joined with (escape_html using p.full_path) joined with "\">" joined with (escape_html using p.title) joined with "</a></h3><p class=\"cms-product-price\">$" joined with (escape_html using price_s) joined with " " joined with (escape_html using p.currency) joined with "</p><p>" joined with (escape_html using p.meta_description) joined with "</p></article>")
  end
  set catalog_html to "<p>No published products yet.</p>"
  if (collections.length using cards) is greater than 0
    set catalog_html to "<section class=\"cms-product-grid\">" joined with (text.join using cards, "") joined with "</section>"
  end
  set shop_js_url to safe_asset_url using "shop/shop.js"
  set shop_css_url to safe_asset_url using "shop/shop.css"
  set theme to get_active_theme_context using stmts
  if theme.mode is "coded" and (files.exists using ("themes/" joined with theme.slug joined with "/templates/shop.grab.html"))
    give back render_theme_page using stmts, "shop", {"page_title": "Shop", "archive_label": "Shop", "archive_slug": "shop", "meta_description": "Browse store products", "product_count": (text.from using (collections.length using prods)), "_slot_catalog_html": catalog_html, "shop_js_url": shop_js_url, "shop_css_url": shop_css_url, "current_path": "/shop"}, 200, []
  end
  give back render_theme_page using stmts, "archive", {"archive_label": "Shop", "archive_slug": "shop", "meta_description": "Browse store products", "entry_count": (text.from using (collections.length using prods)), "published_count": (text.from using (collections.length using prods)), "entries_summary": catalog_html, "current_path": "/shop"}, 200, []
end

route "GET" "/shop/cart" using req
  if not stmts.commerce_ready
    give back render_theme_page using stmts, "404", {"requested_path": "/shop/cart", "current_path": "/shop/cart"}, 404, []
  end
  set cfg to get_commerce_config using stmts
  if not cfg.enabled
    give back render_theme_page using stmts, "404", {"requested_path": "/shop/cart", "current_path": "/shop/cart"}, 404, []
  end
  call run_commerce_sweep using stmts, no
  set shop_js_url to safe_asset_url using "shop/shop.js"
  set shop_css_url to safe_asset_url using "shop/shop.css"
  set theme to get_active_theme_context using stmts
  if theme.mode is "coded" and (files.exists using ("themes/" joined with theme.slug joined with "/templates/cart.grab.html"))
    set resp to render_theme_page using stmts, "cart", {"page_title": "Cart & Checkout", "meta_description": "Review your shopping cart and complete checkout", "currency": cfg.currency, "guest_checkout": (text.from using cfg.guest_checkout), "shop_js_url": shop_js_url, "shop_css_url": shop_css_url, "current_path": "/shop/cart"}, 200, []
    give back server.response using record {status: resp.status, headers: {"Content-Type": "text/html; charset=utf-8", "Cache-Control": "no-store"}, body: resp.body}
  end
  give back render_theme_page using stmts, "single", {"title": "Cart & Checkout", "meta_title": "Cart & Checkout", "meta_description": "Review your cart", "content_type_label": "Store", "full_path": "/shop/cart", "published_at": "", "body_text": "Cart", "custom_fields_summary": "{}"}, 200, []
end

route "GET" "/shop/order/{number}" using req
  set no_cache_hdrs to {"Content-Type": "text/html; charset=utf-8", "Cache-Control": "no-store", "Referrer-Policy": "no-referrer"}
  if not stmts.commerce_ready
    give back server.response using record {status: 404, headers: no_cache_hdrs, body: "<h1>404 Not Found</h1>"}
  end
  set cfg to get_commerce_config using stmts
  if not cfg.enabled
    give back server.response using record {status: 404, headers: no_cache_hdrs, body: "<h1>404 Not Found</h1>"}
  end
  set raw_tok to get_query_param using req, "t"
  if raw_tok is ""
    give back server.response using record {status: 404, headers: no_cache_hdrs, body: "<h1>404 Order Not Found</h1>"}
  end
  set ord_num to text.trim using req.params.number
  set tok_hash to crypto.sha256_hex using raw_tok
  set ord to data.one using stmts.commerce.get_orders, record {mode: "number", iv: 0, sv: ord_num}
  if ord is nothing or ord.access_token_hash is not tok_hash
    give back server.response using record {status: 404, headers: no_cache_hdrs, body: "<h1>404 Order Not Found</h1>"}
  end

  set oitems to data.query using stmts.commerce.list_order_items, record {order_id: ord.id}
  set items_html_parts to []
  set dl_html_parts to []
  set now_rec to call dates.now_utc
  set is_fulfilled_paid to (ord.status is "paid" or ord.status is "fulfilling" or ord.status is "shipped" or ord.status is "delivered")

  for each oi in oitems
    set line_cents to oi.unit_price_cents times oi.qty
    set carrier_note to ""
    if oi.kind is "physical" and oi.carrier is not ""
      set carrier_note to " (" joined with (escape_html using oi.carrier) joined with ")"
    end
    set items_html_parts to collections.append using items_html_parts, ("<li><strong>" joined with (escape_html using oi.title) joined with "</strong> × " joined with (text.from using oi.qty) joined with " — $" joined with (escape_html using (format_cents_usd using line_cents)) joined with carrier_note joined with "</li>")
    if is_fulfilled_paid and oi.kind is "digital"
      set grants to data.query using stmts.commerce.get_download_grants, record {lookup: "order_item", sv: "", iv: oi.id}
      for each gr in grants
        if gr.remaining is greater than 0 and now_rec.iso is at most gr.expires_at
          set raw_dl to crypto.random_urlsafe using 32
          set dl_hash to crypto.sha256_hex using raw_dl
          call data.execute using stmts.commerce.upd_download_grant, record {token_hash: dl_hash, dec: 0, id: gr.id}
          set dl_href to "/api/commerce/download/" joined with (url_encode using raw_dl)
          set dl_html_parts to collections.append using dl_html_parts, ("<li><a href=\"" joined with (escape_html using dl_href) joined with "\">Download " joined with (escape_html using gr.original_name) joined with "</a> (remaining downloads: " joined with (text.from using gr.remaining) joined with ")</li>")
        end
      end
    end
  end

  set items_html to "<ul class=\"cms-order-items\">" joined with (text.join using items_html_parts, "") joined with "</ul>"
  set downloads_html to "<p>No digital downloads available for this order.</p>"
  if (collections.length using dl_html_parts) is greater than 0
    set downloads_html to "<section aria-label=\"Digital downloads\"><h2>Digital Downloads</h2><ul class=\"cms-order-downloads\">" joined with (text.join using dl_html_parts, "") joined with "</ul></section>"
  end
  set tokens_css_url to safe_asset_url using "grex/tokens.css"
  set shop_css_url to safe_asset_url using "shop/shop.css"
  set rendered to server.html using "views/shop/order.grab.html", record {tokens_css_url: tokens_css_url, shop_css_url: shop_css_url, order_number: ord.number, order_status: ord.status, currency: ord.currency, subtotal: (format_cents_usd using ord.subtotal_cents), discount_total: (format_cents_usd using ord.discount_cents), tax_total: (format_cents_usd using ord.tax_cents), shipping_total: (format_cents_usd using ord.shipping_cents), total: (format_cents_usd using ord.total_cents), created_at: ord.created_at}, 200
  set body_out to text.replace using rendered.body, "<!-- @slot:order_items_html -->", items_html
  set body_out to text.replace using body_out, "<!-- @slot:order_downloads_html -->", downloads_html
  give back server.response using record {status: 200, headers: no_cache_hdrs, body: body_out}
end

# ==============================================================================
# Author Mode Public Routes (/books*, /series*, /authors*)
# ==============================================================================

route "GET" "/books" using req
  if not stmts.author_ready or (not (get_author_config using stmts).enabled)
    give back render_theme_page using stmts, "404", {"requested_path": "/books", "current_path": "/books"}, 404, []
  end
  set epoch to get_cache_epoch using stmts, "cache_epoch:author"
  set cache_k to "author:books:catalog:" joined with (text.from using epoch)
  set cached to cache.get using stmts.cms_cache, cache_k
  set books_rows to []
  if cached.found
    set books_rows to cached.value
  otherwise
    set books_rows to data.query using stmts.author.books, record {mode: "pub", iv: 0, sv: ""}
    call cache.set using stmts.cms_cache, cache_k, books_rows, 300000
  end
  set cards to []
  for each b in books_rows
    set price_s to format_cents_usd using b.list_price_cents
    set cards to collections.append using cards, ("<article class=\"cms-book-card\"><h3><a href=\"" joined with (escape_html using b.full_path) joined with "\">" joined with (escape_html using b.title) joined with "</a></h3><p class=\"cms-meta\">By " joined with (escape_html using b.author_pen_name) joined with " &middot; " joined with (escape_html using b.edition_format) joined with "</p><p class=\"cms-book-price\">$" joined with (escape_html using price_s) joined with " " joined with (escape_html using b.currency) joined with "</p></article>")
  end
  set catalog_html to "<p>No published books yet.</p>"
  if (collections.length using cards) is greater than 0
    set catalog_html to "<section class=\"cms-book-grid\">" joined with (text.join using cards, "") joined with "</section>"
  end
  set reader_css_url to safe_asset_url using "author/reader.css"
  set theme to get_active_theme_context using stmts
  if theme.mode is "coded" and (files.exists using ("themes/" joined with theme.slug joined with "/templates/books.grab.html"))
    give back render_theme_page using stmts, "books", {"page_title": "Books", "archive_label": "Books Catalog", "archive_slug": "books", "meta_description": "Browse published books", "book_count": (text.from using (collections.length using books_rows)), "_slot_books_catalog_html": catalog_html, "reader_css_url": reader_css_url, "current_path": "/books"}, 200, []
  end
  give back render_theme_page using stmts, "archive", {"archive_label": "Books", "archive_slug": "books", "meta_description": "Browse published books", "entry_count": (text.from using (collections.length using books_rows)), "published_count": (text.from using (collections.length using books_rows)), "entries_summary": catalog_html, "current_path": "/books"}, 200, []
end

route "GET" "/books/chapter/{slug}" using req
  set slug_norm to normalize_slug using req.params.slug
  set full_path to "/books/chapter/" joined with slug_norm
  if not stmts.author_ready or (not (get_author_config using stmts).enabled)
    give back render_theme_page using stmts, "404", {"requested_path": full_path, "current_path": full_path}, 404, []
  end
  set chap to data.one using stmts.author.chapters, record {mode: "path", iv: 0, sv: full_path, sv2: ""}
  if chap is not nothing and chap.status is "published" and chap.is_sample is 1
    give back server.redirect using ("/books/" joined with chap.book_slug joined with "/sample/" joined with chap.slug), 301
  end
  set redir to data.one using stmts.find_redirect_by_old_path, record {old_path: full_path}
  if redir is not nothing and redir.target_path is not full_path and (not (is_reserved_path using redir.target_path))
    give back server.redirect using redir.target_path, 301
  end
  give back render_theme_page using stmts, "404", {"requested_path": full_path, "current_path": full_path}, 404, []
end

route "GET" "/books/{book_slug}/sample/{chapter_slug}" using req
  set b_slug to normalize_slug using req.params.book_slug
  set c_slug to normalize_slug using req.params.chapter_slug
  set req_path to "/books/" joined with b_slug joined with "/sample/" joined with c_slug
  if not stmts.author_ready or (not (get_author_config using stmts).enabled)
    give back render_theme_page using stmts, "404", {"requested_path": req_path, "current_path": req_path}, 404, []
  end
  set chap to data.one using stmts.author.chapters, record {mode: "book_slug", iv: 0, sv: b_slug, sv2: c_slug}
  if chap is nothing or chap.status is not "published" or chap.is_sample is not 1
    set redir_c to data.one using stmts.find_redirect_by_old_path, record {old_path: ("/books/chapter/" joined with c_slug)}
    if redir_c is not nothing and (not (is_reserved_path using redir_c.target_path))
      set moved_c to data.one using stmts.author.chapters, record {mode: "entry", iv: redir_c.entry_id, sv: "", sv2: ""}
      if moved_c is not nothing and moved_c.status is "published" and moved_c.is_sample is 1
        give back server.redirect using ("/books/" joined with moved_c.book_slug joined with "/sample/" joined with moved_c.slug), 301
      end
    end
    give back render_theme_page using stmts, "404", {"requested_path": req_path, "current_path": req_path}, 404, []
  end
  set book to data.one using stmts.author.books, record {mode: "id", iv: chap.book_id, sv: ""}
  if book is nothing or book.status is not "published"
    give back render_theme_page using stmts, "404", {"requested_path": req_path, "current_path": req_path}, 404, []
  end
  set tokens_css_url to safe_asset_url using "grex/tokens.css"
  set reader_css_url to safe_asset_url using "author/reader.css"
  set reader_js_url to safe_asset_url using "author/reader.js"
  set body_para to "<p>" joined with (escape_html using chap.body_html) joined with "</p>"
  set rendered to server.html using "views/author/reader.grab.html", record {meta_description: chap.title, chapter_title: chap.title, book_title: book.title, book_url: book.full_path, author_name: book.author_pen_name, chapter_number: (text.from using chap.chapter_number), reading_minutes: (text.from using chap.reading_minutes), word_count: (text.from using chap.word_count), cliffhanger_hook: chap.cliffhanger_hook, list_price: (format_cents_usd using book.list_price_cents), currency: book.currency, tokens_css_url: tokens_css_url, reader_css_url: reader_css_url, reader_js_url: reader_js_url}, 200
  set body_out to text.replace using rendered.body, "<!-- @slot:chapter_body_html -->", body_para
  give back server.response using record {status: 200, headers: {"Content-Type": "text/html; charset=utf-8"}, body: body_out}
end

route "GET" "/books/{slug}" using req
  set slug_norm to normalize_slug using req.params.slug
  set full_path to "/books/" joined with slug_norm
  if not stmts.author_ready or (not (get_author_config using stmts).enabled)
    give back render_theme_page using stmts, "404", {"requested_path": full_path, "current_path": full_path}, 404, []
  end
  set book to data.one using stmts.author.books, record {mode: "path", iv: 0, sv: full_path}
  if book is nothing or book.status is not "published" or book.active is not 1
    set redir to data.one using stmts.find_redirect_by_old_path, record {old_path: full_path}
    if redir is not nothing and redir.target_path is not full_path and (not (is_reserved_path using redir.target_path))
      give back server.redirect using redir.target_path, 301
    end
    give back render_theme_page using stmts, "404", {"requested_path": full_path, "current_path": full_path}, 404, []
  end

  set epoch to get_cache_epoch using stmts, "cache_epoch:author"
  set ld_cache_k to "author:book:" joined with (text.from using book.id) joined with ":ep:" joined with (text.from using epoch)
  set ld_cached to cache.get using stmts.cms_cache, ld_cache_k
  set ld_safe to ""
  if ld_cached.found
    set ld_safe to ld_cached.value
  otherwise
    set ld_safe to build_book_jsonld using stmts, book
    call cache.set using stmts.cms_cache, ld_cache_k, ld_safe, 300000
  end

  set series_html to ""
  if book.series_id is not nothing and book.series_title is not nothing
    set pos_txt to ""
    if book.series_position is not nothing
      set pos_txt to " (Book " joined with (text.from using book.series_position) joined with ")"
    end
    set series_html to "<p class=\"cms-meta\">Part of Series: <a href=\"" joined with (escape_html using book.series_full_path) joined with "\">" joined with (escape_html using book.series_title) joined with "</a>" joined with (escape_html using pos_txt) joined with "</p>"
  end

  set comm_html to ""
  set effective_price to format_cents_usd using book.list_price_cents
  if stmts.commerce_ready and book.product_id is not nothing
    set prod to data.one using stmts.commerce.products, record {mode: "id", iv: book.product_id, sv: ""}
    if prod is not nothing and prod.active is 1
      set effective_price to format_cents_usd using prod.price_cents
      set comm_html to "<section id=\"shop-product-mount\" data-product-id=\"" joined with (text.from using prod.id) joined with "\" data-product-title=\"" joined with (escape_html using book.title) joined with "\" data-product-price=\"" joined with (escape_html using effective_price) joined with "\" data-product-kind=\"" joined with (escape_html using prod.kind) joined with "\" aria-label=\"Add book to cart controls\"></section>"
    end
  end

  set samples to data.query using stmts.author.chapters, record {mode: "sample", iv: book.id, sv: "", sv2: ""}
  set samp_items to []
  for each sc in samples
    set s_href to "/books/" joined with book.slug joined with "/sample/" joined with sc.slug
    set samp_items to collections.append using samp_items, ("<li><a href=\"" joined with (escape_html using s_href) joined with "\">Chapter " joined with (text.from using sc.chapter_number) joined with ": " joined with (escape_html using sc.title) joined with "</a></li>")
  end
  set samples_html to "<p class=\"cms-muted\">No sample chapters published yet.</p>"
  if (collections.length using samp_items) is greater than 0
    set samples_html to "<ul class=\"cms-list\">" joined with (text.join using samp_items, "") joined with "</ul>"
  end

  set shop_js_url to safe_asset_url using "shop/shop.js"
  set shop_css_url to safe_asset_url using "shop/shop.css"
  set reader_css_url to safe_asset_url using "author/reader.css"
  set theme to get_active_theme_context using stmts
  set b_data to {"title": book.title, "meta_title": book.title, "meta_description": book.blurb, "subtitle": book.subtitle, "author_name": book.author_pen_name, "author_url": book.author_full_path, "edition_format": book.edition_format, "genre_slug": book.genre_slug, "in_language": book.in_language, "page_count": (text.from using book.page_count), "word_count": (text.from using book.word_count), "list_price": effective_price, "currency": book.currency, "isbn_13": book.isbn_13, "asin": book.asin, "blurb": book.blurb, "full_path": book.full_path, "current_path": book.full_path, "_head_json_ld": ld_safe, "_slot_book_series_html": series_html, "_slot_book_commerce_html": comm_html, "_slot_book_samples_html": samples_html, "shop_js_url": shop_js_url, "shop_css_url": shop_css_url, "reader_css_url": reader_css_url}
  if theme.mode is "coded" and (files.exists using ("themes/" joined with theme.slug joined with "/templates/book.grab.html"))
    give back render_theme_page using stmts, "book", b_data, 200, []
  end
  give back render_theme_page using stmts, "single", {"title": book.title, "meta_title": book.title, "meta_description": book.blurb, "content_type_label": "Book", "full_path": book.full_path, "published_at": book.updated_at, "body_text": book.blurb, "custom_fields_summary": "{}", "_head_json_ld": ld_safe}, 200, []
end

route "GET" "/series" using req
  if not stmts.author_ready or (not (get_author_config using stmts).enabled)
    give back render_theme_page using stmts, "404", {"requested_path": "/series", "current_path": "/series"}, 404, []
  end
  set s_rows to data.query using stmts.author.series, record {mode: "pub", iv: 0, sv: ""}
