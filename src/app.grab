use cache
use collections
use crypto
use data
use dates
use env
use events
use files
use http
use json
use math
use server
use text

# ==============================================================================
# Startup: Open Database, Open Cache, and Prepare All Parameterized SQL
# ==============================================================================

set db to data.open using "main"
set cms_cache to cache.open using "cms"

set stmt_get_setting to data.prepare using db, "SELECT key, value FROM site_settings WHERE (:key = '*' OR key = :key) ORDER BY key", record {params: record {key: "text"}, columns: record {key: "text", value: "text"}}
set stmt_upsert_setting_update to data.prepare using db, "UPDATE site_settings SET value = :value, updated_at = :updated_at WHERE key = :key", record {params: record {value: "text", updated_at: "text", key: "text"}, columns: record {}}
set stmt_upsert_setting_insert to data.prepare using db, "INSERT INTO site_settings (key, value, updated_at) VALUES (:key, :value, :updated_at)", record {params: record {key: "text", value: "text", updated_at: "text"}, columns: record {}}

set stmt_get_type to data.prepare using db, "SELECT id, slug, label_singular, label_plural, permalink_pattern, has_archive, archive_slug, is_system, created_at FROM content_types WHERE (:lookup = 'all') OR (:lookup = 'slug' AND slug = :sv) OR (:lookup = 'id' AND id = :iv) OR (:lookup = 'archive' AND has_archive = 1 AND archive_slug = :sv) ORDER BY id", record {params: record {lookup: "text", sv: "text", iv: "integer"}, columns: record {id: "integer", slug: "text", label_singular: "text", label_plural: "text", permalink_pattern: "text", has_archive: "integer", archive_slug: record {type: "text", nullable: yes}, is_system: "integer", created_at: "text"}}
set stmt_insert_type to data.prepare using db, "INSERT INTO content_types (slug, label_singular, label_plural, permalink_pattern, has_archive, archive_slug, is_system, created_at) VALUES (:slug, :label_singular, :label_plural, :permalink_pattern, :has_archive, :archive_slug, :is_system, :created_at)", record {params: record {slug: "text", label_singular: "text", label_plural: "text", permalink_pattern: "text", has_archive: "integer", archive_slug: record {type: "text", nullable: yes}, is_system: "integer", created_at: "text"}, columns: record {}}

set stmt_get_field_by_key to data.prepare using db, "SELECT id, content_type_id, field_key, label, field_type, is_required, default_value, sort_order FROM field_definitions WHERE content_type_id = :content_type_id AND (:field_key = '' OR field_key = :field_key) ORDER BY sort_order, id", record {params: record {content_type_id: "integer", field_key: "text"}, columns: record {id: "integer", content_type_id: "integer", field_key: "text", label: "text", field_type: "text", is_required: "integer", default_value: record {type: "text", nullable: yes}, sort_order: "integer"}}
set stmt_insert_field to data.prepare using db, "INSERT INTO field_definitions (content_type_id, field_key, label, field_type, is_required, default_value, sort_order) VALUES (:content_type_id, :field_key, :label, :field_type, :is_required, :default_value, :sort_order)", record {params: record {content_type_id: "integer", field_key: "text", label: "text", field_type: "text", is_required: "integer", default_value: record {type: "text", nullable: yes}, sort_order: "integer"}, columns: record {}}

set stmt_get_entry_by_id to data.prepare using db, "SELECT e.id, e.content_type_id, ct.slug AS content_type_slug, ct.label_singular AS content_type_label, e.slug, e.full_path, e.title, e.status, e.body_html, e.custom_fields_json, e.meta_title, e.meta_description, e.author_id, e.published_at, e.created_at, e.updated_at FROM entries e JOIN content_types ct ON ct.id = e.content_type_id WHERE (:id > 0 AND e.id = :id) OR (:id = 0) OR (:id < 0 AND e.author_id = (0 - :id)) ORDER BY e.id DESC", record {params: record {id: "integer"}, columns: record {id: "integer", content_type_id: "integer", content_type_slug: "text", content_type_label: "text", slug: "text", full_path: "text", title: "text", status: "text", body_html: "text", custom_fields_json: "text", meta_title: "text", meta_description: "text", author_id: record {type: "integer", nullable: yes}, published_at: record {type: "text", nullable: yes}, created_at: "text", updated_at: "text"}}
set stmt_get_entry_by_full_path to data.prepare using db, "SELECT e.id, e.content_type_id, ct.slug AS content_type_slug, ct.label_singular AS content_type_label, e.slug, e.full_path, e.title, e.status, e.body_html, e.custom_fields_json, e.meta_title, e.meta_description, e.author_id, e.published_at, e.created_at, e.updated_at FROM entries e JOIN content_types ct ON ct.id = e.content_type_id WHERE e.full_path = :full_path", record {params: record {full_path: "text"}, columns: record {id: "integer", content_type_id: "integer", content_type_slug: "text", content_type_label: "text", slug: "text", full_path: "text", title: "text", status: "text", body_html: "text", custom_fields_json: "text", meta_title: "text", meta_description: "text", author_id: record {type: "integer", nullable: yes}, published_at: record {type: "text", nullable: yes}, created_at: "text", updated_at: "text"}}
set stmt_insert_entry to data.prepare using db, "INSERT INTO entries (content_type_id, slug, full_path, title, status, body_html, custom_fields_json, meta_title, meta_description, author_id, published_at, created_at, updated_at) VALUES (:content_type_id, :slug, :full_path, :title, :status, :body_html, :custom_fields_json, :meta_title, :meta_description, :author_id, :published_at, :created_at, :updated_at)", record {params: record {content_type_id: "integer", slug: "text", full_path: "text", title: "text", status: "text", body_html: "text", custom_fields_json: "text", meta_title: "text", meta_description: "text", author_id: record {type: "integer", nullable: yes}, published_at: record {type: "text", nullable: yes}, created_at: "text", updated_at: "text"}, columns: record {}}
set stmt_update_entry to data.prepare using db, "UPDATE entries SET slug = :slug, full_path = :full_path, title = :title, status = :status, body_html = :body_html, custom_fields_json = :custom_fields_json, meta_title = :meta_title, meta_description = :meta_description, published_at = :published_at, updated_at = :updated_at WHERE id = :id", record {params: record {slug: "text", full_path: "text", title: "text", status: "text", body_html: "text", custom_fields_json: "text", meta_title: "text", meta_description: "text", published_at: record {type: "text", nullable: yes}, updated_at: "text", id: "integer"}, columns: record {}}
set stmt_delete_entry_by_id to data.prepare using db, "DELETE FROM entries WHERE id = :id", record {params: record {id: "integer"}, columns: record {}}

set stmt_count_entries_filtered to data.prepare using db, "SELECT count(*) AS total FROM entries e WHERE (:filter_type = 0 OR e.content_type_id = :content_type_id) AND (:filter_status = 0 OR e.status = :status)", record {params: record {filter_type: "integer", content_type_id: "integer", filter_status: "integer", status: "text"}, columns: record {total: "integer"}}
set stmt_query_entries_desc to data.prepare using db, "SELECT e.id, e.content_type_id, ct.slug AS content_type_slug, ct.label_singular AS content_type_label, e.slug, e.full_path, e.title, e.status, e.body_html, e.custom_fields_json, e.meta_title, e.meta_description, e.published_at, e.created_at, e.updated_at FROM entries e JOIN content_types ct ON ct.id = e.content_type_id WHERE (:filter_type = 0 OR e.content_type_id = :content_type_id) AND (:filter_status = 0 OR e.status = :status) ORDER BY CASE WHEN :sort_by = 'published_at' THEN COALESCE(e.published_at, e.created_at) WHEN :sort_by = 'created_at' THEN e.created_at WHEN :sort_by = 'updated_at' THEN e.updated_at WHEN :sort_by = 'title' THEN e.title ELSE '' END DESC, e.id DESC LIMIT :limit_rows OFFSET :offset_rows", record {params: record {filter_type: "integer", content_type_id: "integer", filter_status: "integer", status: "text", sort_by: "text", limit_rows: "integer", offset_rows: "integer"}, columns: record {id: "integer", content_type_id: "integer", content_type_slug: "text", content_type_label: "text", slug: "text", full_path: "text", title: "text", status: "text", body_html: "text", custom_fields_json: "text", meta_title: "text", meta_description: "text", published_at: record {type: "text", nullable: yes}, created_at: "text", updated_at: "text"}}
set stmt_query_entries_asc to data.prepare using db, "SELECT e.id, e.content_type_id, ct.slug AS content_type_slug, ct.label_singular AS content_type_label, e.slug, e.full_path, e.title, e.status, e.body_html, e.custom_fields_json, e.meta_title, e.meta_description, e.published_at, e.created_at, e.updated_at FROM entries e JOIN content_types ct ON ct.id = e.content_type_id WHERE (:filter_type = 0 OR e.content_type_id = :content_type_id) AND (:filter_status = 0 OR e.status = :status) ORDER BY CASE WHEN :sort_by = 'published_at' THEN COALESCE(e.published_at, e.created_at) WHEN :sort_by = 'created_at' THEN e.created_at WHEN :sort_by = 'updated_at' THEN e.updated_at WHEN :sort_by = 'title' THEN e.title ELSE '' END ASC, e.id ASC LIMIT :limit_rows OFFSET :offset_rows", record {params: record {filter_type: "integer", content_type_id: "integer", filter_status: "integer", status: "text", sort_by: "text", limit_rows: "integer", offset_rows: "integer"}, columns: record {id: "integer", content_type_id: "integer", content_type_slug: "text", content_type_label: "text", slug: "text", full_path: "text", title: "text", status: "text", body_html: "text", custom_fields_json: "text", meta_title: "text", meta_description: "text", published_at: record {type: "text", nullable: yes}, created_at: "text", updated_at: "text"}}

set stmt_find_redirect_by_old_path to data.prepare using db, "SELECT s.id, s.old_path, s.entry_id, e.full_path AS target_path, s.created_at FROM slug_history s JOIN entries e ON e.id = s.entry_id WHERE (:old_path = '__ALL__') OR (s.old_path = :old_path AND e.status = 'published') ORDER BY s.id DESC", record {params: record {old_path: "text"}, columns: record {id: "integer", old_path: "text", entry_id: "integer", target_path: "text", created_at: "text"}}
set stmt_delete_redirect to data.prepare using db, "DELETE FROM slug_history WHERE (:lookup = 'old_path' AND old_path = :sv) OR (:lookup = 'entry_id' AND entry_id = :iv)", record {params: record {lookup: "text", sv: "text", iv: "integer"}, columns: record {}}
set stmt_insert_redirect to data.prepare using db, "INSERT INTO slug_history (old_path, entry_id, created_at) VALUES (:old_path, :entry_id, :created_at)", record {params: record {old_path: "text", entry_id: "integer", created_at: "text"}, columns: record {}}

set stmt_get_theme to data.prepare using db, "SELECT slug, name, version, engine, is_active, manifest_json, installed_at FROM themes WHERE (:lookup = 'all') OR (:lookup = 'slug' AND slug = :sv) OR (:lookup = 'active' AND is_active = 1) ORDER BY slug", record {params: record {lookup: "text", sv: "text"}, columns: record {slug: "text", name: "text", version: "text", engine: "text", is_active: "integer", manifest_json: "text", installed_at: "text"}}
set stmt_insert_theme to data.prepare using db, "INSERT INTO themes (slug, name, version, engine, is_active, manifest_json, installed_at) VALUES (:slug, :name, :version, :engine, :is_active, :manifest_json, :installed_at)", record {params: record {slug: "text", name: "text", version: "text", engine: "text", is_active: "integer", manifest_json: "text", installed_at: "text"}, columns: record {}}
set stmt_update_theme_manifest to data.prepare using db, "UPDATE themes SET name = :name, version = :version, engine = :engine, manifest_json = :manifest_json WHERE slug = :slug", record {params: record {name: "text", version: "text", engine: "text", manifest_json: "text", slug: "text"}, columns: record {}}
set stmt_set_active_theme to data.prepare using db, "UPDATE themes SET is_active = CASE WHEN slug = :slug THEN 1 ELSE 0 END", record {params: record {slug: "text"}, columns: record {}}

set stmt_count_users to data.prepare using db, "SELECT count(*) AS total FROM users", record {params: record {}, columns: record {total: "integer"}}
set stmt_get_user to data.prepare using db, "SELECT id, email, display_name, role, password_hash, email_verified, is_active, last_login_at, created_at, updated_at FROM users WHERE (:lookup = 'all') OR (:lookup = 'id' AND id = :iv) OR (:lookup = 'email' AND email = :sv) ORDER BY id ASC", record {params: record {lookup: "text", iv: "integer", sv: "text"}, columns: record {id: "integer", email: "text", display_name: "text", role: "text", password_hash: record {type: "text", nullable: yes}, email_verified: "integer", is_active: "integer", last_login_at: record {type: "text", nullable: yes}, created_at: "text", updated_at: "text"}}
set stmt_insert_user to data.prepare using db, "INSERT INTO users (email, display_name, role, password_hash, email_verified, is_active, last_login_at, created_at, updated_at) VALUES (:email, :display_name, :role, :password_hash, :email_verified, :is_active, :last_login_at, :created_at, :updated_at)", record {params: record {email: "text", display_name: "text", role: "text", password_hash: record {type: "text", nullable: yes}, email_verified: "integer", is_active: "integer", last_login_at: record {type: "text", nullable: yes}, created_at: "text", updated_at: "text"}, columns: record {}}
set stmt_update_user to data.prepare using db, "UPDATE users SET display_name = COALESCE(:display_name, display_name), role = COALESCE(:role, role), is_active = COALESCE(:is_active, is_active), email_verified = COALESCE(:email_verified, email_verified), last_login_at = COALESCE(:last_login_at, last_login_at), updated_at = :updated_at WHERE id = :id", record {params: record {display_name: record {type: "text", nullable: yes}, role: record {type: "text", nullable: yes}, is_active: record {type: "integer", nullable: yes}, email_verified: record {type: "integer", nullable: yes}, last_login_at: record {type: "text", nullable: yes}, updated_at: "text", id: "integer"}, columns: record {}}

set stmt_get_session_with_user to data.prepare using db, "SELECT s.id AS session_id, s.user_id, s.token_hash, s.csrf_secret, s.ip_hash, s.user_agent, s.expires_at, s.created_at AS session_created_at, s.last_seen_at, u.email, u.display_name, u.role, u.email_verified, u.is_active FROM sessions s JOIN users u ON u.id = s.user_id WHERE s.token_hash = :token_hash", record {params: record {token_hash: "text"}, columns: record {session_id: "text", user_id: "integer", token_hash: "text", csrf_secret: "text", ip_hash: "text", user_agent: "text", expires_at: "text", session_created_at: "text", last_seen_at: "text", email: "text", display_name: "text", role: "text", email_verified: "integer", is_active: "integer"}}
set stmt_insert_session to data.prepare using db, "INSERT INTO sessions (id, user_id, token_hash, csrf_secret, ip_hash, user_agent, expires_at, created_at, last_seen_at) VALUES (:id, :user_id, :token_hash, :csrf_secret, :ip_hash, :user_agent, :expires_at, :created_at, :last_seen_at)", record {params: record {id: "text", user_id: "integer", token_hash: "text", csrf_secret: "text", ip_hash: "text", user_agent: "text", expires_at: "text", created_at: "text", last_seen_at: "text"}, columns: record {}}
set stmt_touch_session to data.prepare using db, "UPDATE sessions SET expires_at = :expires_at, last_seen_at = :last_seen_at WHERE id = :id", record {params: record {expires_at: "text", last_seen_at: "text", id: "text"}, columns: record {}}
set stmt_delete_sessions to data.prepare using db, "DELETE FROM sessions WHERE (:lookup = 'id' AND id = :sv) OR (:lookup = 'token' AND token_hash = :sv) OR (:lookup = 'user' AND user_id = :iv) OR (:lookup = 'expired' AND expires_at < :sv)", record {params: record {lookup: "text", sv: "text", iv: "integer"}, columns: record {}}

set stmt_get_oauth_account to data.prepare using db, "SELECT id, user_id, provider, provider_user_id, provider_email, created_at, updated_at FROM oauth_accounts WHERE provider = :provider AND provider_user_id = :provider_user_id", record {params: record {provider: "text", provider_user_id: "text"}, columns: record {id: "integer", user_id: "integer", provider: "text", provider_user_id: "text", provider_email: "text", created_at: "text", updated_at: "text"}}
set stmt_insert_oauth_account to data.prepare using db, "INSERT INTO oauth_accounts (user_id, provider, provider_user_id, provider_email, created_at, updated_at) VALUES (:user_id, :provider, :provider_user_id, :provider_email, :created_at, :updated_at)", record {params: record {user_id: "integer", provider: "text", provider_user_id: "text", provider_email: "text", created_at: "text", updated_at: "text"}, columns: record {}}
set stmt_update_oauth_account to data.prepare using db, "UPDATE oauth_accounts SET provider_email = :provider_email, updated_at = :updated_at WHERE id = :id", record {params: record {provider_email: "text", updated_at: "text", id: "integer"}, columns: record {}}

set stmt_count_media to data.prepare using db, "SELECT count(*) AS total FROM media WHERE (:mime_filter = '' OR mime_type LIKE :mime_like)", record {params: record {mime_filter: "text", mime_like: "text"}, columns: record {total: "integer"}}
set stmt_list_media to data.prepare using db, "SELECT id, filename, original_name, storage_path, mime_type, byte_size, width, height, alt_text, is_decorative, caption, sha256_hex, uploader_id, created_at, updated_at FROM media WHERE (:mime_filter = '' OR mime_type LIKE :mime_like) ORDER BY id DESC LIMIT :limit_rows OFFSET :offset_rows", record {params: record {mime_filter: "text", mime_like: "text", limit_rows: "integer", offset_rows: "integer"}, columns: record {id: "integer", filename: "text", original_name: "text", storage_path: "text", mime_type: "text", byte_size: "integer", width: record {type: "integer", nullable: yes}, height: record {type: "integer", nullable: yes}, alt_text: "text", is_decorative: "integer", caption: "text", sha256_hex: "text", uploader_id: record {type: "integer", nullable: yes}, created_at: "text", updated_at: "text"}}
set stmt_get_media to data.prepare using db, "SELECT id, filename, original_name, storage_path, mime_type, byte_size, width, height, alt_text, is_decorative, caption, sha256_hex, uploader_id, created_at, updated_at FROM media WHERE (:lookup = 'id' AND id = :iv) OR (:lookup = 'filename' AND filename = :sv)", record {params: record {lookup: "text", iv: "integer", sv: "text"}, columns: record {id: "integer", filename: "text", original_name: "text", storage_path: "text", mime_type: "text", byte_size: "integer", width: record {type: "integer", nullable: yes}, height: record {type: "integer", nullable: yes}, alt_text: "text", is_decorative: "integer", caption: "text", sha256_hex: "text", uploader_id: record {type: "integer", nullable: yes}, created_at: "text", updated_at: "text"}}
set stmt_insert_media to data.prepare using db, "INSERT INTO media (filename, original_name, storage_path, mime_type, byte_size, width, height, alt_text, is_decorative, caption, sha256_hex, uploader_id, created_at, updated_at) VALUES (:filename, :original_name, :storage_path, :mime_type, :byte_size, :width, :height, :alt_text, :is_decorative, :caption, :sha256_hex, :uploader_id, :created_at, :updated_at)", record {params: record {filename: "text", original_name: "text", storage_path: "text", mime_type: "text", byte_size: "integer", width: record {type: "integer", nullable: yes}, height: record {type: "integer", nullable: yes}, alt_text: "text", is_decorative: "integer", caption: "text", sha256_hex: "text", uploader_id: record {type: "integer", nullable: yes}, created_at: "text", updated_at: "text"}, columns: record {}}
set stmt_update_media to data.prepare using db, "UPDATE media SET alt_text = :alt_text, is_decorative = :is_decorative, caption = :caption, updated_at = :updated_at WHERE id = :id", record {params: record {alt_text: "text", is_decorative: "integer", caption: "text", updated_at: "text", id: "integer"}, columns: record {}}
set stmt_delete_media to data.prepare using db, "DELETE FROM media WHERE id = :id", record {params: record {id: "integer"}, columns: record {}}

set stmt_get_menu to data.prepare using db, "SELECT id, slug, name, location, created_at, updated_at FROM menus WHERE (:lookup = 'all') OR (:lookup = 'id' AND id = :iv) OR (:lookup = 'slug' AND slug = :sv) OR (:lookup = 'location' AND location = :sv) ORDER BY id ASC", record {params: record {lookup: "text", iv: "integer", sv: "text"}, columns: record {id: "integer", slug: "text", name: "text", location: record {type: "text", nullable: yes}, created_at: "text", updated_at: "text"}}
set stmt_insert_menu to data.prepare using db, "INSERT INTO menus (slug, name, location, created_at, updated_at) VALUES (:slug, :name, :location, :created_at, :updated_at)", record {params: record {slug: "text", name: "text", location: record {type: "text", nullable: yes}, created_at: "text", updated_at: "text"}, columns: record {}}
set stmt_clear_menu_location to data.prepare using db, "UPDATE menus SET location = NULL, updated_at = :updated_at WHERE location = :location", record {params: record {updated_at: "text", location: "text"}, columns: record {}}
set stmt_update_menu to data.prepare using db, "UPDATE menus SET name = :name, location = :location, updated_at = :updated_at WHERE id = :id", record {params: record {name: "text", location: record {type: "text", nullable: yes}, updated_at: "text", id: "integer"}, columns: record {}}
set stmt_delete_menu to data.prepare using db, "DELETE FROM menus WHERE id = :id", record {params: record {id: "integer"}, columns: record {}}

set stmt_list_menu_items_by_menu to data.prepare using db, "SELECT mi.id, mi.menu_id, mi.parent_id, mi.label, mi.link_type, mi.entry_id, mi.external_url, mi.target_blank, mi.css_class, mi.sort_order, mi.created_at, mi.updated_at, e.full_path AS entry_full_path, e.status AS entry_status, e.title AS entry_title FROM menu_items mi LEFT JOIN entries e ON e.id = mi.entry_id WHERE (:menu_id > 0 AND mi.menu_id = :menu_id) OR (:menu_id < 0 AND mi.id = (0 - :menu_id)) ORDER BY mi.sort_order ASC, mi.id ASC", record {params: record {menu_id: "integer"}, columns: record {id: "integer", menu_id: "integer", parent_id: record {type: "integer", nullable: yes}, label: "text", link_type: "text", entry_id: record {type: "integer", nullable: yes}, external_url: record {type: "text", nullable: yes}, target_blank: "integer", css_class: "text", sort_order: "integer", created_at: "text", updated_at: "text", entry_full_path: record {type: "text", nullable: yes}, entry_status: record {type: "text", nullable: yes}, entry_title: record {type: "text", nullable: yes}}}
set stmt_insert_menu_item to data.prepare using db, "INSERT INTO menu_items (menu_id, parent_id, label, link_type, entry_id, external_url, target_blank, css_class, sort_order, created_at, updated_at) VALUES (:menu_id, :parent_id, :label, :link_type, :entry_id, :external_url, :target_blank, :css_class, :sort_order, :created_at, :updated_at)", record {params: record {menu_id: "integer", parent_id: record {type: "integer", nullable: yes}, label: "text", link_type: "text", entry_id: record {type: "integer", nullable: yes}, external_url: record {type: "text", nullable: yes}, target_blank: "integer", css_class: "text", sort_order: "integer", created_at: "text", updated_at: "text"}, columns: record {}}
set stmt_delete_menu_items to data.prepare using db, "DELETE FROM menu_items WHERE (:lookup = 'menu' AND menu_id = :iv) OR (:lookup = 'id' AND id = :iv)", record {params: record {lookup: "text", iv: "integer"}, columns: record {}}

set stmt_get_taxonomy to data.prepare using db, "SELECT id, slug, label_singular, label_plural, is_hierarchical, archive_slug, content_type_slugs_json, is_system, created_at FROM taxonomies WHERE (:lookup = 'all') OR (:lookup = 'id' AND id = :iv) OR (:lookup = 'slug' AND slug = :sv) OR (:lookup = 'archive' AND archive_slug = :sv) ORDER BY id ASC", record {params: record {lookup: "text", iv: "integer", sv: "text"}, columns: record {id: "integer", slug: "text", label_singular: "text", label_plural: "text", is_hierarchical: "integer", archive_slug: "text", content_type_slugs_json: "text", is_system: "integer", created_at: "text"}}
set stmt_insert_taxonomy to data.prepare using db, "INSERT INTO taxonomies (slug, label_singular, label_plural, is_hierarchical, archive_slug, content_type_slugs_json, is_system, created_at) VALUES (:slug, :label_singular, :label_plural, :is_hierarchical, :archive_slug, :content_type_slugs_json, :is_system, :created_at)", record {params: record {slug: "text", label_singular: "text", label_plural: "text", is_hierarchical: "integer", archive_slug: "text", content_type_slugs_json: "text", is_system: "integer", created_at: "text"}, columns: record {}}
set stmt_delete_taxonomy to data.prepare using db, "DELETE FROM taxonomies WHERE id = :id", record {params: record {id: "integer"}, columns: record {}}

set stmt_get_term to data.prepare using db, "SELECT t.id, t.taxonomy_id, t.parent_id, t.slug, t.name, t.description, t.sort_order, t.created_at, t.updated_at, tx.slug AS taxonomy_slug, tx.archive_slug AS taxonomy_archive_slug, tx.is_hierarchical FROM terms t JOIN taxonomies tx ON tx.id = t.taxonomy_id WHERE (:lookup = 'id' AND t.id = :id) OR (:lookup = 'tax_slug' AND t.taxonomy_id = :taxonomy_id AND t.slug = :slug) OR (:lookup = 'tax' AND t.taxonomy_id = :taxonomy_id) ORDER BY t.sort_order ASC, t.name ASC, t.id ASC", record {params: record {lookup: "text", id: "integer", taxonomy_id: "integer", slug: "text"}, columns: record {id: "integer", taxonomy_id: "integer", parent_id: record {type: "integer", nullable: yes}, slug: "text", name: "text", description: "text", sort_order: "integer", created_at: "text", updated_at: "text", taxonomy_slug: "text", taxonomy_archive_slug: "text", is_hierarchical: "integer"}}
set stmt_insert_term to data.prepare using db, "INSERT INTO terms (taxonomy_id, parent_id, slug, name, description, sort_order, created_at, updated_at) VALUES (:taxonomy_id, :parent_id, :slug, :name, :description, :sort_order, :created_at, :updated_at)", record {params: record {taxonomy_id: "integer", parent_id: record {type: "integer", nullable: yes}, slug: "text", name: "text", description: "text", sort_order: "integer", created_at: "text", updated_at: "text"}, columns: record {}}
set stmt_delete_term to data.prepare using db, "DELETE FROM terms WHERE id = :id", record {params: record {id: "integer"}, columns: record {}}

set stmt_list_entry_terms to data.prepare using db, "SELECT et.entry_id, et.term_id, t.slug AS term_slug, t.name AS term_name, t.parent_id, tx.id AS taxonomy_id, tx.slug AS taxonomy_slug, tx.label_singular AS taxonomy_label, tx.archive_slug AS taxonomy_archive_slug FROM entry_terms et JOIN terms t ON t.id = et.term_id JOIN taxonomies tx ON tx.id = t.taxonomy_id WHERE et.entry_id = :entry_id ORDER BY tx.id ASC, t.sort_order ASC, t.id ASC", record {params: record {entry_id: "integer"}, columns: record {entry_id: "integer", term_id: "integer", term_slug: "text", term_name: "text", parent_id: record {type: "integer", nullable: yes}, taxonomy_id: "integer", taxonomy_slug: "text", taxonomy_label: "text", taxonomy_archive_slug: "text"}}
set stmt_delete_entry_terms_by_entry to data.prepare using db, "DELETE FROM entry_terms WHERE entry_id = :entry_id", record {params: record {entry_id: "integer"}, columns: record {}}
set stmt_insert_entry_term to data.prepare using db, "INSERT INTO entry_terms (entry_id, term_id, created_at) VALUES (:entry_id, :term_id, :created_at)", record {params: record {entry_id: "integer", term_id: "integer", created_at: "text"}, columns: record {}}

set stmt_count_entries_by_term to data.prepare using db, "SELECT count(DISTINCT e.id) AS total FROM entries e INNER JOIN entry_terms et ON et.entry_id = e.id WHERE et.term_id IN (:t0, :t1, :t2, :t3, :t4, :t5, :t6, :t7, :t8, :t9, :t10, :t11, :t12, :t13, :t14, :t15) AND (:filter_type = 0 OR e.content_type_id = :content_type_id) AND (:filter_status = 0 OR e.status = :status)", record {params: record {t0: "integer", t1: "integer", t2: "integer", t3: "integer", t4: "integer", t5: "integer", t6: "integer", t7: "integer", t8: "integer", t9: "integer", t10: "integer", t11: "integer", t12: "integer", t13: "integer", t14: "integer", t15: "integer", filter_type: "integer", content_type_id: "integer", filter_status: "integer", status: "text"}, columns: record {total: "integer"}}
set stmt_query_entries_by_term to data.prepare using db, "SELECT e.id, e.content_type_id, ct.slug AS content_type_slug, ct.label_singular AS content_type_label, e.slug, e.full_path, e.title, e.status, e.body_html, e.custom_fields_json, e.meta_title, e.meta_description, e.published_at, e.created_at, e.updated_at FROM entries e JOIN content_types ct ON ct.id = e.content_type_id WHERE EXISTS (SELECT 1 FROM entry_terms et WHERE et.entry_id = e.id AND et.term_id IN (:t0, :t1, :t2, :t3, :t4, :t5, :t6, :t7, :t8, :t9, :t10, :t11, :t12, :t13, :t14, :t15)) AND (:filter_type = 0 OR e.content_type_id = :content_type_id) AND (:filter_status = 0 OR e.status = :status) ORDER BY COALESCE(e.published_at, e.created_at) DESC, e.id DESC LIMIT :limit_rows OFFSET :offset_rows", record {params: record {t0: "integer", t1: "integer", t2: "integer", t3: "integer", t4: "integer", t5: "integer", t6: "integer", t7: "integer", t8: "integer", t9: "integer", t10: "integer", t11: "integer", t12: "integer", t13: "integer", t14: "integer", t15: "integer", filter_type: "integer", content_type_id: "integer", filter_status: "integer", status: "text", limit_rows: "integer", offset_rows: "integer"}, columns: record {id: "integer", content_type_id: "integer", content_type_slug: "text", content_type_label: "text", slug: "text", full_path: "text", title: "text", status: "text", body_html: "text", custom_fields_json: "text", meta_title: "text", meta_description: "text", published_at: record {type: "text", nullable: yes}, created_at: "text", updated_at: "text"}}

make try_prepare_commerce_stmts using target_db
  try
    set c_products to data.prepare using target_db, "SELECT p.id, p.entry_id, p.sku, p.kind, p.price_cents, p.compare_at_cents, p.currency, p.stock_qty, p.weight_g, p.tax_class, p.active, p.created_at, p.updated_at, e.slug, e.full_path, e.title, e.status, e.body_html, e.custom_fields_json, e.meta_title, e.meta_description, pf.carrier, pf.lulu_sku, pf.usps_service, pf.max_weight_g, pf.media_mail_eligible, pf.ships_from_country FROM products p JOIN entries e ON e.id = p.entry_id LEFT JOIN product_fulfillment pf ON pf.product_id = p.id WHERE (:mode = 'all') OR (:mode = 'pub' AND e.status = 'published' AND p.active = 1) OR (:mode = 'id' AND p.id = :iv) OR (:mode = 'entry' AND p.entry_id = :iv) OR (:mode = 'sku' AND p.sku = :sv) OR (:mode = 'path' AND e.full_path = :sv) ORDER BY p.id DESC", record {params: record {mode: "text", iv: "integer", sv: "text"}, columns: record {id: "integer", entry_id: "integer", sku: "text", kind: "text", price_cents: "integer", compare_at_cents: record {type: "integer", nullable: yes}, currency: "text", stock_qty: record {type: "integer", nullable: yes}, weight_g: "integer", tax_class: "text", active: "integer", created_at: "text", updated_at: "text", slug: "text", full_path: "text", title: "text", status: "text", body_html: "text", custom_fields_json: "text", meta_title: "text", meta_description: "text", carrier: record {type: "text", nullable: yes}, lulu_sku: record {type: "text", nullable: yes}, usps_service: record {type: "text", nullable: yes}, max_weight_g: record {type: "integer", nullable: yes}, media_mail_eligible: record {type: "integer", nullable: yes}, ships_from_country: record {type: "text", nullable: yes}}}
    set c_ins_product to data.prepare using target_db, "INSERT INTO products (entry_id, sku, kind, price_cents, compare_at_cents, currency, stock_qty, weight_g, tax_class, active, created_at, updated_at) VALUES (:entry_id, :sku, :kind, :price_cents, :compare_at_cents, :currency, :stock_qty, :weight_g, :tax_class, :active, :created_at, :updated_at)", record {params: record {entry_id: "integer", sku: "text", kind: "text", price_cents: "integer", compare_at_cents: record {type: "integer", nullable: yes}, currency: "text", stock_qty: record {type: "integer", nullable: yes}, weight_g: "integer", tax_class: "text", active: "integer", created_at: "text", updated_at: "text"}, columns: record {}}
    set c_upd_product to data.prepare using target_db, "UPDATE products SET sku = :sku, kind = :kind, price_cents = :price_cents, compare_at_cents = :compare_at_cents, stock_qty = :stock_qty, weight_g = :weight_g, tax_class = :tax_class, active = :active, updated_at = :updated_at WHERE id = :id", record {params: record {sku: "text", kind: "text", price_cents: "integer", compare_at_cents: record {type: "integer", nullable: yes}, stock_qty: record {type: "integer", nullable: yes}, weight_g: "integer", tax_class: "text", active: "integer", updated_at: "text", id: "integer"}, columns: record {}}
    set c_adj_stock to data.prepare using target_db, "UPDATE products SET stock_qty = stock_qty + :delta, updated_at = :updated_at WHERE id = :id AND stock_qty IS NOT NULL AND (:min_check = 0 OR stock_qty + :delta >= 0)", record {params: record {delta: "integer", updated_at: "text", id: "integer", min_check: "integer"}, columns: record {}}
    set c_del_fulfillment to data.prepare using target_db, "DELETE FROM product_fulfillment WHERE product_id = :product_id", record {params: record {product_id: "integer"}, columns: record {}}
    set c_ins_fulfillment to data.prepare using target_db, "INSERT INTO product_fulfillment (product_id, carrier, lulu_sku, usps_service, max_weight_g, media_mail_eligible, ships_from_country) VALUES (:product_id, :carrier, :lulu_sku, :usps_service, :max_weight_g, :media_mail_eligible, :ships_from_country)", record {params: record {product_id: "integer", carrier: "text", lulu_sku: "text", usps_service: "text", max_weight_g: "integer", media_mail_eligible: "integer", ships_from_country: "text"}, columns: record {}}
    set c_list_digital_files to data.prepare using target_db, "SELECT df.id, df.product_id, df.media_id, df.download_limit, df.expiry_hours, m.filename, m.original_name, m.mime_type, m.storage_path FROM product_digital_files df JOIN media m ON m.id = df.media_id WHERE df.product_id = :product_id ORDER BY df.id ASC", record {params: record {product_id: "integer"}, columns: record {id: "integer", product_id: "integer", media_id: "integer", download_limit: "integer", expiry_hours: "integer", filename: "text", original_name: "text", mime_type: "text", storage_path: "text"}}
    set c_del_digital_files to data.prepare using target_db, "DELETE FROM product_digital_files WHERE product_id = :product_id", record {params: record {product_id: "integer"}, columns: record {}}
    set c_ins_digital_file to data.prepare using target_db, "INSERT INTO product_digital_files (product_id, media_id, download_limit, expiry_hours, created_at) VALUES (:product_id, :media_id, :download_limit, :expiry_hours, :created_at)", record {params: record {product_id: "integer", media_id: "integer", download_limit: "integer", expiry_hours: "integer", created_at: "text"}, columns: record {}}
    set c_get_cart to data.prepare using target_db, "SELECT id, token_hash, csrf_secret, customer_id, user_id, status, currency, coupon_code, last_activity_at, created_at FROM carts WHERE (:lookup = 'token' AND token_hash = :sv) OR (:lookup = 'id' AND id = :sv) OR (:lookup = 'user' AND user_id = :iv AND status = 'open') OR (:lookup = 'open_any' AND status = 'open')", record {params: record {lookup: "text", sv: "text", iv: "integer"}, columns: record {id: "text", token_hash: "text", csrf_secret: "text", customer_id: record {type: "integer", nullable: yes}, user_id: record {type: "integer", nullable: yes}, status: "text", currency: "text", coupon_code: record {type: "text", nullable: yes}, last_activity_at: "text", created_at: "text"}}
    set c_ins_cart to data.prepare using target_db, "INSERT INTO carts (id, token_hash, csrf_secret, customer_id, user_id, status, currency, coupon_code, last_activity_at, created_at) VALUES (:id, :token_hash, :csrf_secret, :customer_id, :user_id, :status, :currency, :coupon_code, :last_activity_at, :created_at)", record {params: record {id: "text", token_hash: "text", csrf_secret: "text", customer_id: record {type: "integer", nullable: yes}, user_id: record {type: "integer", nullable: yes}, status: "text", currency: "text", coupon_code: record {type: "text", nullable: yes}, last_activity_at: "text", created_at: "text"}, columns: record {}}
    set c_upd_cart to data.prepare using target_db, "UPDATE carts SET token_hash = :token_hash, csrf_secret = :csrf_secret, customer_id = :customer_id, user_id = :user_id, status = :status, coupon_code = :coupon_code, last_activity_at = :last_activity_at WHERE id = :id AND (:req_open = 0 OR status = 'open')", record {params: record {token_hash: "text", csrf_secret: "text", customer_id: record {type: "integer", nullable: yes}, user_id: record {type: "integer", nullable: yes}, status: "text", coupon_code: record {type: "text", nullable: yes}, last_activity_at: "text", id: "text", req_open: "integer"}, columns: record {}}
    set c_list_cart_items to data.prepare using target_db, "SELECT ci.id, ci.cart_id, ci.product_id, ci.qty, ci.unit_price_cents, p.sku, p.kind, p.price_cents AS live_price_cents, p.stock_qty, p.weight_g, p.tax_class, p.active, e.title, e.slug, e.full_path, e.status AS entry_status, pf.carrier, pf.lulu_sku, pf.usps_service, pf.max_weight_g, pf.media_mail_eligible FROM cart_items ci JOIN products p ON p.id = ci.product_id JOIN entries e ON e.id = p.entry_id LEFT JOIN product_fulfillment pf ON pf.product_id = p.id WHERE ci.cart_id = :cart_id ORDER BY p.id ASC", record {params: record {cart_id: "text"}, columns: record {id: "integer", cart_id: "text", product_id: "integer", qty: "integer", unit_price_cents: "integer", sku: "text", kind: "text", live_price_cents: "integer", stock_qty: record {type: "integer", nullable: yes}, weight_g: "integer", tax_class: "text", active: "integer", title: "text", slug: "text", full_path: "text", entry_status: "text", carrier: record {type: "text", nullable: yes}, lulu_sku: record {type: "text", nullable: yes}, usps_service: record {type: "text", nullable: yes}, max_weight_g: record {type: "integer", nullable: yes}, media_mail_eligible: record {type: "integer", nullable: yes}}}
    set c_del_cart_item to data.prepare using target_db, "DELETE FROM cart_items WHERE cart_id = :cart_id AND (:pid = 0 OR product_id = :pid)", record {params: record {cart_id: "text", pid: "integer"}, columns: record {}}
    set c_ins_cart_item to data.prepare using target_db, "INSERT INTO cart_items (cart_id, product_id, qty, unit_price_cents, created_at, updated_at) VALUES (:cart_id, :product_id, :qty, :unit_price_cents, :created_at, :updated_at)", record {params: record {cart_id: "text", product_id: "integer", qty: "integer", unit_price_cents: "integer", created_at: "text", updated_at: "text"}, columns: record {}}
    set c_get_customers to data.prepare using target_db, "SELECT id, user_id, email, display_name, marketing_consent, created_at, updated_at FROM customers WHERE (:mode = 'all') OR (:mode = 'id' AND id = :iv) OR (:mode = 'email' AND email = :sv) ORDER BY id DESC", record {params: record {mode: "text", iv: "integer", sv: "text"}, columns: record {id: "integer", user_id: record {type: "integer", nullable: yes}, email: "text", display_name: "text", marketing_consent: "integer", created_at: "text", updated_at: "text"}}
    set c_ins_customer to data.prepare using target_db, "INSERT INTO customers (user_id, email, display_name, marketing_consent, created_at, updated_at) VALUES (:user_id, :email, :display_name, :marketing_consent, :created_at, :updated_at)", record {params: record {user_id: record {type: "integer", nullable: yes}, email: "text", display_name: "text", marketing_consent: "integer", created_at: "text", updated_at: "text"}, columns: record {}}
    set c_upd_customer to data.prepare using target_db, "UPDATE customers SET user_id = :user_id, email = :email, display_name = :display_name, marketing_consent = :marketing_consent, updated_at = :updated_at WHERE id = :id", record {params: record {user_id: record {type: "integer", nullable: yes}, email: "text", display_name: "text", marketing_consent: "integer", updated_at: "text", id: "integer"}, columns: record {}}
    set c_get_coupons to data.prepare using target_db, "SELECT id, code, type, value, min_subtotal_cents, max_redemptions, redeemed_count, starts_at, ends_at, active, created_by, created_at, updated_at FROM coupons WHERE (:mode = 'all') OR (:mode = 'id' AND id = :iv) OR (:mode = 'code' AND code = :sv) ORDER BY id DESC", record {params: record {mode: "text", iv: "integer", sv: "text"}, columns: record {id: "integer", code: "text", type: "text", value: "integer", min_subtotal_cents: "integer", max_redemptions: "integer", redeemed_count: "integer", starts_at: record {type: "text", nullable: yes}, ends_at: record {type: "text", nullable: yes}, active: "integer", created_by: "text", created_at: "text", updated_at: "text"}}
    set c_ins_coupon to data.prepare using target_db, "INSERT INTO coupons (code, type, value, min_subtotal_cents, max_redemptions, redeemed_count, starts_at, ends_at, active, created_by, created_at, updated_at) VALUES (:code, :type, :value, :min_subtotal_cents, :max_redemptions, :redeemed_count, :starts_at, :ends_at, :active, :created_by, :created_at, :updated_at)", record {params: record {code: "text", type: "text", value: "integer", min_subtotal_cents: "integer", max_redemptions: "integer", redeemed_count: "integer", starts_at: record {type: "text", nullable: yes}, ends_at: record {type: "text", nullable: yes}, active: "integer", created_by: "text", created_at: "text", updated_at: "text"}, columns: record {}}
    set c_upd_coupon to data.prepare using target_db, "UPDATE coupons SET active = :active, max_redemptions = :max_redemptions, starts_at = :starts_at, ends_at = :ends_at, updated_at = :updated_at WHERE id = :id", record {params: record {active: "integer", max_redemptions: "integer", starts_at: record {type: "text", nullable: yes}, ends_at: record {type: "text", nullable: yes}, updated_at: "text", id: "integer"}, columns: record {}}
    set c_claim_coupon to data.prepare using target_db, "UPDATE coupons SET redeemed_count = redeemed_count + 1, updated_at = :updated_at WHERE id = :id AND active = 1 AND redeemed_count < max_redemptions", record {params: record {updated_at: "text", id: "integer"}, columns: record {}}
    set c_del_coupon_redemption to data.prepare using target_db, "DELETE FROM coupon_redemptions WHERE order_id = :order_id AND coupon_id = :coupon_id", record {params: record {order_id: "integer", coupon_id: "integer"}, columns: record {}}
    set c_dec_coupon to data.prepare using target_db, "UPDATE coupons SET redeemed_count = CASE WHEN redeemed_count > 0 THEN redeemed_count - 1 ELSE 0 END, updated_at = :updated_at WHERE id = :id", record {params: record {updated_at: "text", id: "integer"}, columns: record {}}
    set c_ins_coupon_redemption to data.prepare using target_db, "INSERT INTO coupon_redemptions (coupon_id, order_id, created_at) VALUES (:coupon_id, :order_id, :created_at)", record {params: record {coupon_id: "integer", order_id: "integer", created_at: "text"}, columns: record {}}
    set c_get_orders to data.prepare using target_db, "SELECT o.id, o.number, o.cart_id, o.customer_id, o.user_id, o.status, o.subtotal_cents, o.discount_cents, o.tax_cents, o.shipping_cents, o.total_cents, o.currency, o.coupon_id, o.payment_ref, o.access_token_hash, o.shipping_address_json, o.needs_review, o.review_note, o.created_at, o.payment_due_by, o.paid_at, c.email AS customer_email, c.display_name AS customer_name FROM orders o JOIN customers c ON c.id = o.customer_id WHERE (:mode = 'all') OR (:mode = 'review' AND o.needs_review = 1) OR (:mode = 'status' AND o.status = :sv) OR (:mode = 'customer' AND o.customer_id = :iv) OR (:mode = 'id' AND o.id = :iv) OR (:mode = 'number' AND o.number = :sv) OR (:mode = 'token' AND o.access_token_hash = :sv) OR (:mode = 'active' AND o.status IN ('pending_payment', 'paid', 'fulfilling', 'shipped')) OR (:mode = 'due' AND o.status = 'pending_payment' AND o.payment_due_by <= :sv) ORDER BY o.id DESC", record {params: record {mode: "text", iv: "integer", sv: "text"}, columns: record {id: "integer", number: "text", cart_id: "text", customer_id: "integer", user_id: record {type: "integer", nullable: yes}, status: "text", subtotal_cents: "integer", discount_cents: "integer", tax_cents: "integer", shipping_cents: "integer", total_cents: "integer", currency: "text", coupon_id: record {type: "integer", nullable: yes}, payment_ref: "text", access_token_hash: "text", shipping_address_json: "text", needs_review: "integer", review_note: "text", created_at: "text", payment_due_by: "text", paid_at: record {type: "text", nullable: yes}, customer_email: "text", customer_name: "text"}}
    set c_ins_order to data.prepare using target_db, "INSERT INTO orders (number, cart_id, customer_id, user_id, status, subtotal_cents, discount_cents, tax_cents, shipping_cents, total_cents, currency, coupon_id, payment_ref, access_token_hash, shipping_address_json, needs_review, review_note, created_at, payment_due_by, paid_at) VALUES (:number, :cart_id, :customer_id, :user_id, :status, :subtotal_cents, :discount_cents, :tax_cents, :shipping_cents, :total_cents, :currency, :coupon_id, :payment_ref, :access_token_hash, :shipping_address_json, :needs_review, :review_note, :created_at, :payment_due_by, :paid_at)", record {params: record {number: "text", cart_id: "text", customer_id: "integer", user_id: record {type: "integer", nullable: yes}, status: "text", subtotal_cents: "integer", discount_cents: "integer", tax_cents: "integer", shipping_cents: "integer", total_cents: "integer", currency: "text", coupon_id: record {type: "integer", nullable: yes}, payment_ref: "text", access_token_hash: "text", shipping_address_json: "text", needs_review: "integer", review_note: "text", created_at: "text", payment_due_by: "text", paid_at: record {type: "text", nullable: yes}}, columns: record {}}
    set c_upd_order to data.prepare using target_db, "UPDATE orders SET number = :number, status = :status, needs_review = :needs_review, review_note = :review_note, shipping_address_json = :shipping_address_json, paid_at = :paid_at, payment_ref = :payment_ref WHERE id = :id AND (:req_status = '' OR status = :req_status)", record {params: record {number: "text", status: "text", needs_review: "integer", review_note: "text", shipping_address_json: "text", paid_at: record {type: "text", nullable: yes}, payment_ref: "text", id: "integer", req_status: "text"}, columns: record {}}
    set c_list_order_items to data.prepare using target_db, "SELECT id, order_id, product_id, sku, title, kind, qty, unit_price_cents, carrier, usps_service, lulu_sku FROM order_items WHERE order_id = :order_id ORDER BY id ASC", record {params: record {order_id: "integer"}, columns: record {id: "integer", order_id: "integer", product_id: "integer", sku: "text", title: "text", kind: "text", qty: "integer", unit_price_cents: "integer", carrier: "text", usps_service: "text", lulu_sku: "text"}}
    set c_ins_order_item to data.prepare using target_db, "INSERT INTO order_items (order_id, product_id, sku, title, kind, qty, unit_price_cents, carrier, usps_service, lulu_sku) VALUES (:order_id, :product_id, :sku, :title, :kind, :qty, :unit_price_cents, :carrier, :usps_service, :lulu_sku)", record {params: record {order_id: "integer", product_id: "integer", sku: "text", title: "text", kind: "text", qty: "integer", unit_price_cents: "integer", carrier: "text", usps_service: "text", lulu_sku: "text"}, columns: record {}}
    set c_list_order_audit to data.prepare using target_db, "SELECT id, order_id, actor, from_status, to_status, reason, created_at FROM order_audit WHERE order_id = :order_id ORDER BY id ASC", record {params: record {order_id: "integer"}, columns: record {id: "integer", order_id: "integer", actor: "text", from_status: "text", to_status: "text", reason: "text", created_at: "text"}}
    set c_ins_order_audit to data.prepare using target_db, "INSERT INTO order_audit (order_id, actor, from_status, to_status, reason, created_at) VALUES (:order_id, :actor, :from_status, :to_status, :reason, :created_at)", record {params: record {order_id: "integer", actor: "text", from_status: "text", to_status: "text", reason: "text", created_at: "text"}, columns: record {}}
    set c_get_download_grants to data.prepare using target_db, "SELECT dg.id, dg.order_item_id, dg.media_id, dg.token_hash, dg.expires_at, dg.remaining, dg.created_at, m.filename, m.original_name, m.storage_path, m.mime_type FROM download_grants dg JOIN media m ON m.id = dg.media_id WHERE (:lookup = 'token' AND dg.token_hash = :sv) OR (:lookup = 'order_item' AND dg.order_item_id = :iv)", record {params: record {lookup: "text", sv: "text", iv: "integer"}, columns: record {id: "integer", order_item_id: "integer", media_id: "integer", token_hash: "text", expires_at: "text", remaining: "integer", created_at: "text", filename: "text", original_name: "text", storage_path: "text", mime_type: "text"}}
    set c_upd_download_grant to data.prepare using target_db, "UPDATE download_grants SET token_hash = :token_hash, remaining = remaining - :dec WHERE id = :id AND (:dec = 0 OR remaining > 0)", record {params: record {token_hash: "text", dec: "integer", id: "integer"}, columns: record {}}
    set c_get_idem to data.prepare using target_db, "SELECT id, scope, key, request_hash, state, order_id, redirect_url, created_at FROM idempotency_keys WHERE scope = :scope AND key = :key", record {params: record {scope: "text", key: "text"}, columns: record {id: "integer", scope: "text", key: "text", request_hash: "text", state: "text", order_id: record {type: "integer", nullable: yes}, redirect_url: record {type: "text", nullable: yes}, created_at: "text"}}
    set c_ins_idem to data.prepare using target_db, "INSERT INTO idempotency_keys (scope, key, request_hash, state, order_id, redirect_url, created_at) VALUES (:scope, :key, :request_hash, :state, :order_id, :redirect_url, :created_at)", record {params: record {scope: "text", key: "text", request_hash: "text", state: "text", order_id: record {type: "integer", nullable: yes}, redirect_url: record {type: "text", nullable: yes}, created_at: "text"}, columns: record {}}
    set c_upd_idem to data.prepare using target_db, "UPDATE idempotency_keys SET request_hash = :request_hash, state = :state, order_id = :order_id, redirect_url = :redirect_url, created_at = :created_at WHERE scope = :scope AND key = :key AND (:req_state = '' OR state = :req_state)", record {params: record {request_hash: "text", state: "text", order_id: record {type: "integer", nullable: yes}, redirect_url: record {type: "text", nullable: yes}, created_at: "text", scope: "text", key: "text", req_state: "text"}, columns: record {}}
    set c_del_idem to data.prepare using target_db, "DELETE FROM idempotency_keys WHERE scope = :scope AND key = :key AND (:req_state = '' OR state = :req_state)", record {params: record {scope: "text", key: "text", req_state: "text"}, columns: record {}}
    set c_list_stale_carts to data.prepare using target_db, "SELECT c.id, c.currency, c.last_activity_at, cu.email, cu.marketing_consent FROM carts c JOIN customers cu ON cu.id = c.customer_id WHERE c.status = 'open' AND c.last_activity_at <= :cutoff_iso ORDER BY c.id ASC LIMIT 500", record {params: record {cutoff_iso: "text"}, columns: record {id: "text", currency: "text", last_activity_at: "text", email: "text", marketing_consent: "integer"}}
    set c_commerce_events to data.prepare using target_db, "SELECT id, name, subject_id, payload_json, created_at FROM commerce_events WHERE (:mode = 'list' AND id > :after_id AND (:sv = '' OR name = :sv)) OR (:mode = 'one' AND name = :sv AND subject_id = :subj) ORDER BY id ASC LIMIT :lim", record {params: record {mode: "text", after_id: "integer", sv: "text", subj: "text", lim: "integer"}, columns: record {id: "integer", name: "text", subject_id: "text", payload_json: "text", created_at: "text"}}
    set c_ins_commerce_event to data.prepare using target_db, "INSERT INTO commerce_events (name, subject_id, payload_json, created_at) VALUES (:name, :subject_id, :payload_json, :created_at)", record {params: record {name: "text", subject_id: "text", payload_json: "text", created_at: "text"}, columns: record {}}
    give back record {ready: yes, products: c_products, ins_product: c_ins_product, upd_product: c_upd_product, adj_stock: c_adj_stock, del_fulfillment: c_del_fulfillment, ins_fulfillment: c_ins_fulfillment, list_digital_files: c_list_digital_files, del_digital_files: c_del_digital_files, ins_digital_file: c_ins_digital_file, get_cart: c_get_cart, ins_cart: c_ins_cart, upd_cart: c_upd_cart, list_cart_items: c_list_cart_items, del_cart_item: c_del_cart_item, ins_cart_item: c_ins_cart_item, get_customers: c_get_customers, ins_customer: c_ins_customer, upd_customer: c_upd_customer, get_coupons: c_get_coupons, ins_coupon: c_ins_coupon, upd_coupon: c_upd_coupon, claim_coupon: c_claim_coupon, del_coupon_redemption: c_del_coupon_redemption, dec_coupon: c_dec_coupon, ins_coupon_redemption: c_ins_coupon_redemption, get_orders: c_get_orders, ins_order: c_ins_order, upd_order: c_upd_order, list_order_items: c_list_order_items, ins_order_item: c_ins_order_item, list_order_audit: c_list_order_audit, ins_order_audit: c_ins_order_audit, get_download_grants: c_get_download_grants, upd_download_grant: c_upd_download_grant, get_idem: c_get_idem, ins_idem: c_ins_idem, upd_idem: c_upd_idem, del_idem: c_del_idem, list_stale_carts: c_list_stale_carts, commerce_events: c_commerce_events, ins_commerce_event: c_ins_commerce_event}
  catch cerr
    give back record {ready: no}
  end
end

set commerce_stmts to try_prepare_commerce_stmts using db

make try_prepare_author_stmts using target_db
  try
    set a_authors to data.prepare using target_db, "SELECT a.id, a.entry_id, a.pen_name, a.bio_summary, a.website_url, a.social_links_json, a.active, a.created_at, a.updated_at, e.slug, e.full_path, e.title, e.status, e.body_html, e.meta_title, e.meta_description, e.author_id AS owner_user_id FROM authors a JOIN entries e ON e.id = a.entry_id WHERE (:mode = 'all') OR (:mode = 'pub' AND e.status = 'published' AND a.active = 1) OR (:mode = 'id' AND a.id = :iv) OR (:mode = 'entry' AND a.entry_id = :iv) OR (:mode = 'path' AND e.full_path = :sv) OR (:mode = 'owner' AND e.author_id = :iv) ORDER BY a.id DESC", record {params: record {mode: "text", iv: "integer", sv: "text"}, columns: record {id: "integer", entry_id: "integer", pen_name: "text", bio_summary: "text", website_url: "text", social_links_json: "text", active: "integer", created_at: "text", updated_at: "text", slug: "text", full_path: "text", title: "text", status: "text", body_html: "text", meta_title: "text", meta_description: "text", owner_user_id: record {type: "integer", nullable: yes}}}
    set a_ins_author to data.prepare using target_db, "INSERT INTO authors (entry_id, pen_name, bio_summary, website_url, social_links_json, active, created_at, updated_at) VALUES (:entry_id, :pen_name, :bio_summary, :website_url, :social_links_json, :active, :created_at, :updated_at)", record {params: record {entry_id: "integer", pen_name: "text", bio_summary: "text", website_url: "text", social_links_json: "text", active: "integer", created_at: "text", updated_at: "text"}, columns: record {}}
    set a_upd_author to data.prepare using target_db, "UPDATE authors SET pen_name = :pen_name, bio_summary = :bio_summary, website_url = :website_url, social_links_json = :social_links_json, active = :active, updated_at = :updated_at WHERE id = :id", record {params: record {pen_name: "text", bio_summary: "text", website_url: "text", social_links_json: "text", active: "integer", updated_at: "text", id: "integer"}, columns: record {}}

    set a_series to data.prepare using target_db, "SELECT s.id, s.entry_id, s.author_id, s.genre_slug, s.reading_order_mode, s.total_planned_books, s.active, s.created_at, s.updated_at, e.slug, e.full_path, e.title, e.status, e.body_html, e.meta_title, e.meta_description, e.author_id AS owner_user_id, a.pen_name AS author_pen_name, ae.full_path AS author_full_path FROM series s JOIN entries e ON e.id = s.entry_id JOIN authors a ON a.id = s.author_id JOIN entries ae ON ae.id = a.entry_id WHERE (:mode = 'all') OR (:mode = 'pub' AND e.status = 'published' AND s.active = 1) OR (:mode = 'id' AND s.id = :iv) OR (:mode = 'entry' AND s.entry_id = :iv) OR (:mode = 'author' AND s.author_id = :iv) OR (:mode = 'path' AND e.full_path = :sv) ORDER BY s.id DESC", record {params: record {mode: "text", iv: "integer", sv: "text"}, columns: record {id: "integer", entry_id: "integer", author_id: "integer", genre_slug: "text", reading_order_mode: "text", total_planned_books: "integer", active: "integer", created_at: "text", updated_at: "text", slug: "text", full_path: "text", title: "text", status: "text", body_html: "text", meta_title: "text", meta_description: "text", owner_user_id: record {type: "integer", nullable: yes}, author_pen_name: "text", author_full_path: "text"}}
    set a_ins_series to data.prepare using target_db, "INSERT INTO series (entry_id, author_id, genre_slug, reading_order_mode, total_planned_books, active, created_at, updated_at) VALUES (:entry_id, :author_id, :genre_slug, :reading_order_mode, :total_planned_books, :active, :created_at, :updated_at)", record {params: record {entry_id: "integer", author_id: "integer", genre_slug: "text", reading_order_mode: "text", total_planned_books: "integer", active: "integer", created_at: "text", updated_at: "text"}, columns: record {}}
    set a_upd_series to data.prepare using target_db, "UPDATE series SET author_id = :author_id, genre_slug = :genre_slug, reading_order_mode = :reading_order_mode, total_planned_books = :total_planned_books, active = :active, updated_at = :updated_at WHERE id = :id", record {params: record {author_id: "integer", genre_slug: "text", reading_order_mode: "text", total_planned_books: "integer", active: "integer", updated_at: "text", id: "integer"}, columns: record {}}

    set a_books to data.prepare using target_db, "SELECT b.id, b.entry_id, b.author_id, b.series_id, b.series_position, b.subtitle, b.isbn_13, b.asin, b.edition_format, b.page_count, b.word_count, b.in_language, b.genre_slug, b.blurb, b.list_price_cents, b.royalty_rate_bp, b.currency, b.product_id, b.cover_media_id, b.active, b.created_at, b.updated_at, e.slug, e.full_path, e.title, e.status, e.body_html, e.meta_title, e.meta_description, e.author_id AS owner_user_id, a.pen_name AS author_pen_name, ae.full_path AS author_full_path, se.title AS series_title, se.full_path AS series_full_path FROM books b JOIN entries e ON e.id = b.entry_id JOIN authors a ON a.id = b.author_id JOIN entries ae ON ae.id = a.entry_id LEFT JOIN series sr ON sr.id = b.series_id LEFT JOIN entries se ON se.id = sr.entry_id WHERE (:mode = 'all') OR (:mode = 'pub' AND e.status = 'published' AND b.active = 1) OR (:mode = 'id' AND b.id = :iv) OR (:mode = 'entry' AND b.entry_id = :iv) OR (:mode = 'series' AND b.series_id = :iv) OR (:mode = 'author' AND b.author_id = :iv) OR (:mode = 'path' AND e.full_path = :sv) ORDER BY COALESCE(b.series_position, 999999) ASC, b.id DESC", record {params: record {mode: "text", iv: "integer", sv: "text"}, columns: record {id: "integer", entry_id: "integer", author_id: "integer", series_id: record {type: "integer", nullable: yes}, series_position: record {type: "integer", nullable: yes}, subtitle: "text", isbn_13: "text", asin: "text", edition_format: "text", page_count: "integer", word_count: "integer", in_language: "text", genre_slug: "text", blurb: "text", list_price_cents: "integer", royalty_rate_bp: "integer", currency: "text", product_id: record {type: "integer", nullable: yes}, cover_media_id: record {type: "integer", nullable: yes}, active: "integer", created_at: "text", updated_at: "text", slug: "text", full_path: "text", title: "text", status: "text", body_html: "text", meta_title: "text", meta_description: "text", owner_user_id: record {type: "integer", nullable: yes}, author_pen_name: "text", author_full_path: "text", series_title: record {type: "text", nullable: yes}, series_full_path: record {type: "text", nullable: yes}}}
    set a_ins_book to data.prepare using target_db, "INSERT INTO books (entry_id, author_id, series_id, series_position, subtitle, isbn_13, asin, edition_format, page_count, word_count, in_language, genre_slug, blurb, list_price_cents, royalty_rate_bp, currency, product_id, cover_media_id, active, created_at, updated_at) VALUES (:entry_id, :author_id, :series_id, :series_position, :subtitle, :isbn_13, :asin, :edition_format, :page_count, :word_count, :in_language, :genre_slug, :blurb, :list_price_cents, :royalty_rate_bp, :currency, :product_id, :cover_media_id, :active, :created_at, :updated_at)", record {params: record {entry_id: "integer", author_id: "integer", series_id: record {type: "integer", nullable: yes}, series_position: record {type: "integer", nullable: yes}, subtitle: "text", isbn_13: "text", asin: "text", edition_format: "text", page_count: "integer", word_count: "integer", in_language: "text", genre_slug: "text", blurb: "text", list_price_cents: "integer", royalty_rate_bp: "integer", currency: "text", product_id: record {type: "integer", nullable: yes}, cover_media_id: record {type: "integer", nullable: yes}, active: "integer", created_at: "text", updated_at: "text"}, columns: record {}}
    set a_upd_book to data.prepare using target_db, "UPDATE books SET author_id = :author_id, series_id = :series_id, series_position = :series_position, subtitle = :subtitle, isbn_13 = :isbn_13, asin = :asin, edition_format = :edition_format, page_count = :page_count, word_count = :word_count, in_language = :in_language, genre_slug = :genre_slug, blurb = :blurb, list_price_cents = :list_price_cents, royalty_rate_bp = :royalty_rate_bp, product_id = :product_id, cover_media_id = :cover_media_id, active = :active, updated_at = :updated_at WHERE id = :id", record {params: record {author_id: "integer", series_id: record {type: "integer", nullable: yes}, series_position: record {type: "integer", nullable: yes}, subtitle: "text", isbn_13: "text", asin: "text", edition_format: "text", page_count: "integer", word_count: "integer", in_language: "text", genre_slug: "text", blurb: "text", list_price_cents: "integer", royalty_rate_bp: "integer", product_id: record {type: "integer", nullable: yes}, cover_media_id: record {type: "integer", nullable: yes}, active: "integer", updated_at: "text", id: "integer"}, columns: record {}}

    set a_chapters to data.prepare using target_db, "SELECT c.id, c.entry_id, c.book_id, c.chapter_number, c.sort_order, c.is_sample, c.word_count, c.reading_minutes, c.cliffhanger_hook, c.readability_grade_bp, c.readability_score, c.created_at, c.updated_at, e.slug, e.full_path, e.title, e.status, e.body_html, e.meta_title, e.meta_description, e.author_id AS owner_user_id, be.slug AS book_slug, be.title AS book_title, be.full_path AS book_full_path FROM chapters c JOIN entries e ON e.id = c.entry_id JOIN books b ON b.id = c.book_id JOIN entries be ON be.id = b.entry_id WHERE (:mode = 'all') OR (:mode = 'id' AND c.id = :iv) OR (:mode = 'entry' AND c.entry_id = :iv) OR (:mode = 'book' AND c.book_id = :iv) OR (:mode = 'sample' AND c.book_id = :iv AND c.is_sample = 1 AND e.status = 'published') OR (:mode = 'book_slug' AND be.slug = :sv AND e.slug = :sv2) OR (:mode = 'path' AND e.full_path = :sv) ORDER BY c.sort_order ASC, c.chapter_number ASC, c.id ASC", record {params: record {mode: "text", iv: "integer", sv: "text", sv2: "text"}, columns: record {id: "integer", entry_id: "integer", book_id: "integer", chapter_number: "integer", sort_order: "integer", is_sample: "integer", word_count: "integer", reading_minutes: "integer", cliffhanger_hook: "text", readability_grade_bp: record {type: "integer", nullable: yes}, readability_score: record {type: "integer", nullable: yes}, created_at: "text", updated_at: "text", slug: "text", full_path: "text", title: "text", status: "text", body_html: "text", meta_title: "text", meta_description: "text", owner_user_id: record {type: "integer", nullable: yes}, book_slug: "text", book_title: "text", book_full_path: "text"}}
    set a_ins_chapter to data.prepare using target_db, "INSERT INTO chapters (entry_id, book_id, chapter_number, sort_order, is_sample, word_count, reading_minutes, cliffhanger_hook, readability_grade_bp, readability_score, created_at, updated_at) VALUES (:entry_id, :book_id, :chapter_number, :sort_order, :is_sample, :word_count, :reading_minutes, :cliffhanger_hook, :readability_grade_bp, :readability_score, :created_at, :updated_at)", record {params: record {entry_id: "integer", book_id: "integer", chapter_number: "integer", sort_order: "integer", is_sample: "integer", word_count: "integer", reading_minutes: "integer", cliffhanger_hook: "text", readability_grade_bp: record {type: "integer", nullable: yes}, readability_score: record {type: "integer", nullable: yes}, created_at: "text", updated_at: "text"}, columns: record {}}
    set a_upd_chapter to data.prepare using target_db, "UPDATE chapters SET chapter_number = :chapter_number, sort_order = :sort_order, is_sample = :is_sample, word_count = :word_count, reading_minutes = :reading_minutes, cliffhanger_hook = :cliffhanger_hook, readability_grade_bp = :readability_grade_bp, readability_score = :readability_score, updated_at = :updated_at WHERE id = :id", record {params: record {chapter_number: "integer", sort_order: "integer", is_sample: "integer", word_count: "integer", reading_minutes: "integer", cliffhanger_hook: "text", readability_grade_bp: record {type: "integer", nullable: yes}, readability_score: record {type: "integer", nullable: yes}, updated_at: "text", id: "integer"}, columns: record {}}

    set a_get_radar to data.prepare using target_db, "SELECT id, radar_plan_id, genre_slug, target_type, entry_id, payload_sha256, imported_by, created_at FROM author_radar_imports WHERE (:mode = 'all') OR (:mode = 'plan' AND radar_plan_id = :sv) ORDER BY id DESC", record {params: record {mode: "text", sv: "text"}, columns: record {id: "integer", radar_plan_id: "text", genre_slug: "text", target_type: "text", entry_id: "integer", payload_sha256: "text", imported_by: "text", created_at: "text"}}
    set a_ins_radar to data.prepare using target_db, "INSERT INTO author_radar_imports (radar_plan_id, genre_slug, target_type, entry_id, payload_sha256, imported_by, created_at) VALUES (:radar_plan_id, :genre_slug, :target_type, :entry_id, :payload_sha256, :imported_by, :created_at)", record {params: record {radar_plan_id: "text", genre_slug: "text", target_type: "text", entry_id: "integer", payload_sha256: "text", imported_by: "text", created_at: "text"}, columns: record {}}

    give back record {ready: yes, err: "", authors: a_authors, ins_author: a_ins_author, upd_author: a_upd_author, series: a_series, ins_series: a_ins_series, upd_series: a_upd_series, books: a_books, ins_book: a_ins_book, upd_book: a_upd_book, chapters: a_chapters, ins_chapter: a_ins_chapter, upd_chapter: a_upd_chapter, get_radar: a_get_radar, ins_radar: a_ins_radar}
  catch aerr
    give back record {ready: no, err: aerr.message}
  end
end

set author_stmts to try_prepare_author_stmts using db

set stmts to record {db: db, cms_cache: cms_cache, commerce_ready: commerce_stmts.ready, commerce: commerce_stmts, author_ready: author_stmts.ready, author: author_stmts, get_setting: stmt_get_setting, upsert_setting_update: stmt_upsert_setting_update, upsert_setting_insert: stmt_upsert_setting_insert, get_type: stmt_get_type, insert_type: stmt_insert_type, get_field_by_key: stmt_get_field_by_key, insert_field: stmt_insert_field, get_entry_by_id: stmt_get_entry_by_id, get_entry_by_full_path: stmt_get_entry_by_full_path, insert_entry: stmt_insert_entry, update_entry: stmt_update_entry, delete_entry_by_id: stmt_delete_entry_by_id, count_entries_filtered: stmt_count_entries_filtered, query_entries_desc: stmt_query_entries_desc, query_entries_asc: stmt_query_entries_asc, find_redirect_by_old_path: stmt_find_redirect_by_old_path, delete_redirect: stmt_delete_redirect, insert_redirect: stmt_insert_redirect, get_theme: stmt_get_theme, insert_theme: stmt_insert_theme, update_theme_manifest: stmt_update_theme_manifest, set_active_theme: stmt_set_active_theme, count_users: stmt_count_users, get_user: stmt_get_user, insert_user: stmt_insert_user, update_user: stmt_update_user, get_session_with_user: stmt_get_session_with_user, insert_session: stmt_insert_session, touch_session: stmt_touch_session, delete_sessions: stmt_delete_sessions, get_oauth_account: stmt_get_oauth_account, insert_oauth_account: stmt_insert_oauth_account, update_oauth_account: stmt_update_oauth_account, count_media: stmt_count_media, list_media: stmt_list_media, get_media: stmt_get_media, insert_media: stmt_insert_media, update_media: stmt_update_media, delete_media: stmt_delete_media, get_menu: stmt_get_menu, insert_menu: stmt_insert_menu, clear_menu_location: stmt_clear_menu_location, update_menu: stmt_update_menu, delete_menu: stmt_delete_menu, list_menu_items_by_menu: stmt_list_menu_items_by_menu, insert_menu_item: stmt_insert_menu_item, delete_menu_items: stmt_delete_menu_items, get_taxonomy: stmt_get_taxonomy, insert_taxonomy: stmt_insert_taxonomy, delete_taxonomy: stmt_delete_taxonomy, get_term: stmt_get_term, insert_term: stmt_insert_term, delete_term: stmt_delete_term, list_entry_terms: stmt_list_entry_terms, delete_entry_terms_by_entry: stmt_delete_entry_terms_by_entry, insert_entry_term: stmt_insert_entry_term, count_entries_by_term: stmt_count_entries_by_term, query_entries_by_term: stmt_query_entries_by_term}

# ==============================================================================
# Shared Helpers: Normalization, Identifier & URL Safety, Escaping
# ==============================================================================

make is_allowed_chars using raw, allowed_str, min_len, max_len
  set n to text.length using raw
  if n is less than min_len or n is greater than max_len
    give back no
  end
  set chars to text.split using raw, ""
  for each ch in chars
    if not (text.contains using allowed_str, ch)
      give back no
    end
  end
  give back yes
end

make is_valid_slug using raw
  give back is_allowed_chars using raw, "abcdefghijklmnopqrstuvwxyz0123456789_-", 1, 64
end

make is_valid_field_key using raw
  give back is_allowed_chars using raw, "abcdefghijklmnopqrstuvwxyz0123456789_", 1, 64
end

make is_valid_theme_slug using raw
  give back is_allowed_chars using raw, "abcdefghijklmnopqrstuvwxyz0123456789-", 1, 64
end

make is_valid_entry_slug using raw
  give back is_allowed_chars using raw, "abcdefghijklmnopqrstuvwxyz0123456789_-", 1, 190
end

make normalize_slug using raw
  set cleaned to text.lower using (text.trim using raw)
  give back cleaned
end

make normalize_path using raw_path
  set cleaned to text.lower using (text.trim using raw_path)
  if cleaned is ""
    give back "/"
  end
  if not (text.starts_with using cleaned, "/")
    set cleaned to "/" joined with cleaned
  end
  while (text.length using cleaned) is greater than 1 and (text.ends_with using cleaned, "/")
    set chars to text.split using cleaned, ""
    set last_idx to (collections.length using chars) minus 1
    set sliced to collections.slice using chars, 0, last_idx
    set cleaned to text.join using sliced, ""
  end
  give back cleaned
end

make has_unsafe_path_chars using raw_path
  if (text.contains using raw_path, "..") or (text.contains using raw_path, "\\") or (text.contains using raw_path, "?") or (text.contains using raw_path, "#") or (text.contains using raw_path, "\r") or (text.contains using raw_path, "\n")
    give back yes
  end
  give back no
end

make is_reserved_path using raw_path
  set p to normalize_path using raw_path
  if p is "/admin" or (text.starts_with using p, "/admin/")
    give back yes
  end
  if p is "/api" or (text.starts_with using p, "/api/")
    give back yes
  end
  if p is "/static" or (text.starts_with using p, "/static/")
    give back yes
  end
  if p is "/media" or (text.starts_with using p, "/media/")
    give back yes
  end
  if p is "/login" or (text.starts_with using p, "/login/") or p is "/logout" or (text.starts_with using p, "/logout/")
    give back yes
  end
  if p is "/setup" or (text.starts_with using p, "/setup/") or p is "/search" or (text.starts_with using p, "/search/")
    give back yes
  end
  if p is "/shop/cart" or p is "/shop/checkout" or p is "/shop/order" or (text.starts_with using p, "/shop/order/")
    give back yes
  end
  if p is "/_health" or p is "/_ready" or p is "/robots.txt" or p is "/sitemap.xml" or p is "/favicon.ico"
    give back yes
  end
  give back no
end

make is_safe_url using raw_url
  set u to text.trim using raw_url
  if u is "" or (text.contains using u, "\r") or (text.contains using u, "\n") or (text.contains using u, "\\") or (text.contains using u, " ")
    give back no
  end
  set lower to text.lower using u
  if (text.starts_with using lower, "javascript:") or (text.starts_with using lower, "data:") or (text.starts_with using lower, "vbscript:")
    give back no
  end
  if (text.starts_with using lower, "//")
    give back no
  end
  if (text.starts_with using lower, "http://") or (text.starts_with using lower, "https://")
    set after_scheme to ""
    if text.starts_with using lower, "https://"
      set after_scheme to text.replace using lower, "https://", ""
    otherwise
      set after_scheme to text.replace using lower, "http://", ""
    end
    if after_scheme is "" or (text.starts_with using after_scheme, "/")
      give back no
    end
    give back yes
  end
  if text.starts_with using lower, "/"
    give back yes
  end
  give back no
end

make escape_html using raw
  set s to text.from using raw
  set s to text.replace using s, "&", "&amp;"
  set s to text.replace using s, "<", "&lt;"
  set s to text.replace using s, ">", "&gt;"
  set s to text.replace using s, "\"", "&#34;"
  set s to text.replace using s, "'", "&#39;"
  give back s
end

make safe_asset_url using raw_path
  try
    give back server.asset using raw_path
  catch err
    give back ""
  end
end

make has_map_key using m, key
  if m is nothing
    give back no
  end
  set ks to collections.keys using m
  for each k in ks
    if k is key
      give back yes
    end
  end
  give back no
end

make text_truncate using raw, max_chars
  set chars to text.split using raw, ""
  if (collections.length using chars) is at most max_chars
    give back raw
  end
  set sliced to collections.slice using chars, 0, max_chars
  give back (text.join using sliced, "") joined with "..."
end

make make_excerpt using raw_body
  set cleaned to text.trim using (text.from using raw_body)
  if cleaned is ""
    give back ""
  end
  if text.starts_with using cleaned, "{"
    give back "Structured Grex layout content."
  end
  give back text_truncate using cleaned, 160
end

# ==============================================================================
# Module 0.5: Authentication, Sessions, RBAC, Rate Limiting, Crypto & OAuth2/PKCE
# ==============================================================================

make get_req_header using req, header_lower
  if has_map_key using req.headers, header_lower
    give back text.trim using (text.from using (req.headers at header_lower))
  end
  give back ""
end

make extract_cookie using req, cookie_name
  set cookie_hdr to get_req_header using req, "cookie"
  if cookie_hdr is ""
    give back ""
  end
  set prefix to cookie_name joined with "="
  set parts to text.split using cookie_hdr, ";"
  for each part in parts
    set trimmed to text.trim using part
    if text.starts_with using trimmed, prefix
      set pieces to text.split using trimmed, "="
      if (collections.length using pieces) is at least 2
        set rest to collections.slice using pieces, 1, (collections.length using pieces)
        give back text.join using rest, "="
      end
    end
  end
  give back ""
end

make is_https_req using req
  if req.scheme is "https"
    give back yes
  end
  if (text.lower using (get_req_header using req, "x-forwarded-proto")) is "https"
    give back yes
  end
  give back no
end

make build_cookie using name, val, path_val, max_age_sec, is_https
  set base to name joined with "=" joined with val joined with "; Path=" joined with path_val joined with "; HttpOnly; SameSite=Lax; Max-Age=" joined with (text.from using max_age_sec)
  if is_https
    give back base joined with "; Secure"
  end
  give back base
end

make clear_session_cookie using is_https
  give back build_cookie using "grablab_session", "", "/", 0, is_https
end

make normalize_email using raw
  give back text.lower using (text.trim using (text.from using raw))
end

make is_valid_email using email
  set n to text.length using email
  if n is less than 5 or n is greater than 254
    give back no
  end
  if (text.contains using email, " ") or (text.contains using email, "\n") or (text.contains using email, "\r")
    give back no
  end
  set parts to text.split using email, "@"
  if (collections.length using parts) is not 2
    give back no
  end
  set local_part to parts at 0
  set domain_part to parts at 1
  if local_part is "" or domain_part is "" or (not (text.contains using domain_part, "."))
    give back no
  end
  give back yes
end

make is_valid_password using pw
  set n to text.length using pw
  if n is less than 10 or n is greater than 1024
    give back no
  end
  give back yes
end

make is_valid_role using r
  set allowed to ["admin", "editor", "author", "viewer"]
  for each item in allowed
    if item is r
      give back yes
    end
  end
  give back no
end

make role_has_capability using role, cap
  if role is "admin"
    give back yes
  end
  if role is "editor"
    set editor_caps to ["admin:access", "entries:read", "entries:read_all", "entries:create", "entries:update:own", "entries:update:any", "entries:publish", "entries:delete:own", "entries:delete:any", "media:read", "media:upload", "media:update_own", "media:update_any", "media:delete_own", "media:delete_any", "menus:manage", "taxonomies:manage", "commerce:manage", "author:manage"]
    for each item in editor_caps
      if item is cap
        give back yes
      end
    end
    give back no
  end
  if role is "author"
    set author_caps to ["admin:access", "entries:read", "entries:create", "entries:update:own", "entries:delete:own", "media:read", "media:upload", "media:update_own", "media:delete_own", "author:manage"]
    for each item in author_caps
      if item is cap
        give back yes
      end
    end
    give back no
  end
  give back no
end

make get_master_key
  try
    if env.has using "GRABLAB_MASTER_KEY"
      set raw to env.get using "GRABLAB_MASTER_KEY"
      if raw is not nothing
        set trimmed to text.trim using raw
        if trimmed is not ""
          give back trimmed
        end
      end
    end
    give back ""
  catch err
    give back ""
  end
end

make get_oauth_test_base_url
  try
    if env.has using "GRABLAB_OAUTH_TEST_BASE_URL"
      set raw to env.get using "GRABLAB_OAUTH_TEST_BASE_URL"
      if raw is not nothing
        set trimmed to text.trim using raw
        if text.starts_with using trimmed, "http://127.0.0.1:"
          give back trimmed
        end
      end
    end
    give back ""
  catch err
    give back ""
  end
end

make url_encode using raw
  set s to text.from using raw
  set s to text.replace using s, "%", "%25"
  set s to text.replace using s, " ", "%20"
  set s to text.replace using s, "!", "%21"
  set s to text.replace using s, "\"", "%22"
  set s to text.replace using s, "#", "%23"
  set s to text.replace using s, "$", "%24"
  set s to text.replace using s, "&", "%26"
  set s to text.replace using s, "'", "%27"
  set s to text.replace using s, "(", "%28"
  set s to text.replace using s, ")", "%29"
  set s to text.replace using s, "*", "%2A"
  set s to text.replace using s, "+", "%2B"
  set s to text.replace using s, ",", "%2C"
  set s to text.replace using s, "/", "%2F"
  set s to text.replace using s, ":", "%3A"
  set s to text.replace using s, ";", "%3B"
  set s to text.replace using s, "=", "%3D"
  set s to text.replace using s, "?", "%3F"
  set s to text.replace using s, "@", "%40"
  set s to text.replace using s, "[", "%5B"
  set s to text.replace using s, "]", "%5D"
  give back s
end

make default_oauth_providers_config
  give back {"google": {"enabled": no, "client_id": "", "client_secret_enc": "", "secret_hint": "", "allowed_domains": ""}, "github": {"enabled": no, "client_id": "", "client_secret_enc": "", "secret_hint": "", "allowed_domains": ""}, "discord": {"enabled": no, "client_id": "", "client_secret_enc": "", "secret_hint": "", "allowed_domains": ""}, "apple": {"enabled": no, "client_id": "", "client_secret_enc": "", "secret_hint": "", "allowed_domains": ""}}
end

make get_oauth_providers_config using stmts
  set row to data.one using stmts.get_setting, record {key: "oauth_providers_json"}
  if row is nothing or row.value is ""
    give back call default_oauth_providers_config
  end
  try
    set parsed to json.parse using row.value
    set base to call default_oauth_providers_config
    set keys to ["google", "github", "discord", "apple"]
    for each k in keys
      if has_map_key using parsed, k
        set p to parsed at k
        set merged to {"enabled": no, "client_id": "", "client_secret_enc": "", "secret_hint": "", "allowed_domains": ""}
        if has_map_key using p, "enabled"
          if p at "enabled"
            set merged to collections.put using merged, "enabled", yes
          end
        end
        if has_map_key using p, "client_id"
          set merged to collections.put using merged, "client_id", (text.from using (p at "client_id"))
        end
        if has_map_key using p, "client_secret_enc"
          set merged to collections.put using merged, "client_secret_enc", (text.from using (p at "client_secret_enc"))
        end
        if has_map_key using p, "secret_hint"
          set merged to collections.put using merged, "secret_hint", (text.from using (p at "secret_hint"))
        end
        if has_map_key using p, "allowed_domains"
          set merged to collections.put using merged, "allowed_domains", (text.from using (p at "allowed_domains"))
        end
        set base to collections.put using base, k, merged
      end
    end
    give back base
  catch err
    give back call default_oauth_providers_config
  end
end

make mask_oauth_providers using cfg
  set masked to {}
  set keys to ["google", "github", "discord", "apple"]
  for each k in keys
    set p to cfg at k
    set has_sec to (p at "client_secret_enc") is not ""
    set hint to p at "secret_hint"
    set item to {"enabled": (p at "enabled"), "client_id": (p at "client_id"), "has_secret": has_sec, "secret_hint": hint, "allowed_domains": (p at "allowed_domains")}
    set masked to collections.put using masked, k, item
  end
  give back masked
end

make render_social_login_buttons using cfg
  set labels to {"google": "Continue with Google", "github": "Continue with GitHub", "discord": "Continue with Discord", "apple": "Continue with Apple"}
  set keys to ["google", "github", "discord", "apple"]
  set btns to []
  for each k in keys
    set p to cfg at k
    if (p at "enabled") and ((p at "client_id") is not "") and ((p at "client_secret_enc") is not "")
      set label to labels at k
      set btns to collections.append using btns, ("<a class=\"cms-btn-secondary cms-social-btn\" href=\"/api/auth/oauth/" joined with k joined with "/start\">" joined with label joined with "</a>")
    end
  end
  if (collections.length using btns) is 0
    give back ""
  end
  give back "<section class=\"cms-social-login\" aria-label=\"Social sign in\"><p class=\"cms-muted\">Or continue with a configured provider:</p>" joined with (text.join using btns, "") joined with "</section>"
end

make build_secret_hint using raw_secret
  set chars to text.split using raw_secret, ""
  set n to collections.length using chars
  if n is at most 4
    give back "••••"
  end
  set tail to collections.slice using chars, (n minus 4), n
  give back "****" joined with (text.join using tail, "")
end

make is_session_expired using expires_at_iso, now_rec
  try
    set exp_rec to dates.parse_iso using expires_at_iso
    set diff to dates.diff_seconds using exp_rec, now_rec
    give back (diff is at most 0)
  catch err
    give back yes
  end
end

make resolve_session_token using stmts, raw_token
  if raw_token is ""
    give back nothing
  end
  set tok_hash to crypto.sha256_hex using raw_token
  set row to data.one using stmts.get_session_with_user, record {token_hash: tok_hash}
  if row is nothing
    give back nothing
  end
  if row.is_active is not 1
    call data.execute using stmts.delete_sessions, record {lookup: "id", sv: row.session_id, iv: 0}
    give back nothing
  end
  set now_rec to call dates.now_utc
  if is_session_expired using row.expires_at, now_rec
    call data.execute using stmts.delete_sessions, record {lookup: "id", sv: row.session_id, iv: 0}
    give back nothing
  end
  set exp_rec to dates.parse_iso using row.expires_at
  set rem_sec to dates.diff_seconds using exp_rec, now_rec
  if rem_sec is less than 259200
    set next_exp to dates.add_days using now_rec, 7
    call data.execute using stmts.touch_session, record {expires_at: next_exp.iso, last_seen_at: now_rec.iso, id: row.session_id}
  end
  give back row
end

make resolve_session using stmts, req
  set raw_token to extract_cookie using req, "grablab_session"
  give back resolve_session_token using stmts, raw_token
end

make extract_bearer_token using req
  set auth_hdr to text.trim using (get_req_header using req, "authorization")
  if (text.length using auth_hdr) is greater than 7
    set prefix to text.lower using (text.join using (collections.slice using (text.split using auth_hdr, ""), 0, 7), "")
    if prefix is "bearer "
      set tok to text.trim using (text.join using (collections.slice using (text.split using auth_hdr, ""), 7, (text.length using auth_hdr)), "")
      give back tok
    end
  end
  give back ""
end

make create_rotated_session using stmts, req, user_id, old_token_hash
  set sess_id to crypto.random_hex using 16
  set raw_token to crypto.random_urlsafe using 32
  set tok_hash to crypto.sha256_hex using raw_token
  set csrf_secret to crypto.random_urlsafe using 32
  set now_rec to call dates.now_utc
  set exp_rec to dates.add_days using now_rec, 7
  set ip_hash to crypto.sha256_hex using (text.from using req.client_ip)
  set ua to text_truncate using (get_req_header using req, "user-agent"), 180

  set tx to data.begin using stmts.db
  try
    if old_token_hash is not ""
      call data.execute using stmts.delete_sessions, record {lookup: "token", sv: old_token_hash, iv: 0}, tx
    end
    call data.execute using stmts.delete_sessions, record {lookup: "expired", sv: now_rec.iso, iv: 0}, tx
    call data.execute using stmts.insert_session, record {id: sess_id, user_id: user_id, token_hash: tok_hash, csrf_secret: csrf_secret, ip_hash: ip_hash, user_agent: ua, expires_at: exp_rec.iso, created_at: now_rec.iso, last_seen_at: now_rec.iso}, tx
    call data.execute using stmts.update_user, record {display_name: nothing, role: nothing, is_active: nothing, email_verified: nothing, last_login_at: now_rec.iso, updated_at: now_rec.iso, id: user_id}, tx
    call data.commit using tx
    give back record {ok: yes, session_id: sess_id, raw_token: raw_token, token_hash: tok_hash, csrf_secret: csrf_secret, expires_at: exp_rec.iso, error: ""}
  catch tx_err
    call data.rollback using tx
    give back record {ok: no, session_id: "", raw_token: "", token_hash: "", csrf_secret: "", expires_at: "", error: tx_err.message}
  end
end

make csrf_matches using req, sess
  set hdr to get_req_header using req, "x-csrf-token"
  if hdr is ""
    give back no
  end
  give back (crypto.sha256_hex using hdr) is (crypto.sha256_hex using sess.csrf_secret)
end

make require_api_auth using stmts, req, cap, require_csrf
  set sess to resolve_session using stmts, req
  if sess is nothing
    give back record {ok: no, session: nothing, response: (server.json using 401, record {error: "Authentication required"})}
  end
  if require_csrf and (not (csrf_matches using req, sess))
    give back record {ok: no, session: nothing, response: (server.json using 403, record {error: "Invalid or missing CSRF token"})}
  end
  if cap is not "" and (not (role_has_capability using sess.role, cap))
    give back record {ok: no, session: nothing, response: (server.json using 403, record {error: "Forbidden: insufficient role capability"})}
  end
  give back record {ok: yes, session: sess, response: nothing}
end

make check_auth_ip_limit using stmts, req
  set ip_key to "rl:ip:" joined with (crypto.sha256_hex using (text.from using req.client_ip))
  try
    set lim to cache.limit using stmts.cms_cache, ip_key, 120, 60000
    if not lim.allowed
      give back record {ok: no, response: (server.response using record {status: 429, headers: {"Content-Type": "application/json; charset=utf-8", "Retry-After": "60", "Cache-Control": "no-store"}, body: (json.stringify using (record {error: "Too many authentication requests. Try again shortly."}))})}
    end
    give back record {ok: yes, response: nothing}
  catch err
    give back record {ok: no, response: (server.json using 503, record {error: "Rate limiter unavailable"})}
  end
end

make login_pair_hash using req, email_norm
  give back crypto.sha256_hex using ((text.from using req.client_ip) joined with "|" joined with email_norm)
end

make check_login_rate_limit using stmts, req, email_norm
  set pair_hash to login_pair_hash using req, email_norm
  set epoch_key to "rl:epoch:" joined with pair_hash
  set epoch to "0"
  try
    set ep to cache.get using stmts.cms_cache, epoch_key
    if ep.found and ep.value is not nothing and ep.value is not ""
      set epoch to text.from using ep.value
    end
    set bucket to "rl:login:" joined with epoch joined with ":" joined with pair_hash
    set lim to cache.limit using stmts.cms_cache, bucket, 5, 900000
    if not lim.allowed
      give back record {ok: no, response: (server.response using record {status: 429, headers: {"Content-Type": "application/json; charset=utf-8", "Retry-After": "900", "Cache-Control": "no-store"}, body: (json.stringify using (record {error: "Too many failed sign-in attempts. Account temporarily locked for 15 minutes."}))})}
    end
    give back record {ok: yes, response: nothing}
  catch err
    give back record {ok: no, response: (server.json using 503, record {error: "Rate limiter unavailable"})}
  end
end

make clear_login_rate_limit using stmts, req, email_norm
  set pair_hash to login_pair_hash using req, email_norm
  set epoch_key to "rl:epoch:" joined with pair_hash
  try
    set cur to cache.get using stmts.cms_cache, epoch_key
    set n to 0
    if cur.found and cur.value is not nothing and cur.value is not ""
      set n to text.to_integer using (text.from using cur.value)
    end
    call cache.set using stmts.cms_cache, epoch_key, (text.from using (n plus 1)), 900000
  catch err
    give back no
  end
  give back yes
end

make is_supported_oauth_provider using p
  set allowed to ["google", "github", "discord", "apple"]
  for each item in allowed
    if item is p
      give back yes
    end
  end
  give back no
end

make resolve_provider_endpoints using provider, test_base
  if test_base is not ""
    give back record {authorize_url: (test_base joined with "/" joined with provider joined with "/authorize"), token_url: (test_base joined with "/" joined with provider joined with "/token"), userinfo_url: (test_base joined with "/" joined with provider joined with "/userinfo"), emails_url: (test_base joined with "/" joined with provider joined with "/emails"), scope: "openid email profile"}
  end
  if provider is "google"
    give back record {authorize_url: "https://accounts.google.com/o/oauth2/v2/auth", token_url: "https://oauth2.googleapis.com/token", userinfo_url: "https://openidconnect.googleapis.com/v1/userinfo", emails_url: "", scope: "openid email profile"}
  end
  if provider is "github"
    give back record {authorize_url: "https://github.com/login/oauth/authorize", token_url: "https://github.com/login/oauth/access_token", userinfo_url: "https://api.github.com/user", emails_url: "https://api.github.com/user/emails", scope: "read:user user:email"}
  end
  if provider is "discord"
    give back record {authorize_url: "https://discord.com/oauth2/authorize", token_url: "https://discord.com/api/oauth2/token", userinfo_url: "https://discord.com/api/users/@me", emails_url: "", scope: "identify email"}
  end
  give back record {authorize_url: "https://appleid.apple.com/auth/authorize", token_url: "https://appleid.apple.com/auth/token", userinfo_url: "", emails_url: "", scope: "name email"}
end

make email_domain_allowed using email, allowed_csv
  set cleaned to text.trim using allowed_csv
  if cleaned is ""
    give back yes
  end
  set parts to text.split using email, "@"
  if (collections.length using parts) is not 2
    give back no
  end
  set user_dom to text.lower using (parts at 1)
  set items to text.split using cleaned, ","
  for each item in items
    set candidate to text.lower using (text.trim using item)
    if candidate is not "" and candidate is user_dom
      give back yes
    end
  end
  give back no
end

make resolve_or_create_oauth_user using stmts, provider, provider_uid, email_norm, display_name, allow_signup
  set now_rec to call dates.now_utc
  set link to data.one using stmts.get_oauth_account, record {provider: provider, provider_user_id: provider_uid}
  if link is not nothing
    set user_row to data.one using stmts.get_user, record {lookup: "id", iv: link.user_id, sv: ""}
    if user_row is nothing or user_row.is_active is not 1
      give back record {ok: no, user: nothing, error: "Account disabled or missing"}
    end
    call data.execute using stmts.update_oauth_account, record {provider_email: email_norm, updated_at: now_rec.iso, id: link.id}
    give back record {ok: yes, user: user_row, error: ""}
  end

  set existing_user to data.one using stmts.get_user, record {lookup: "email", iv: 0, sv: email_norm}
  if existing_user is not nothing
    if existing_user.is_active is not 1
      give back record {ok: no, user: nothing, error: "Account disabled"}
    end
    call data.execute using stmts.insert_oauth_account, record {user_id: existing_user.id, provider: provider, provider_user_id: provider_uid, provider_email: email_norm, created_at: now_rec.iso, updated_at: now_rec.iso}
    give back record {ok: yes, user: existing_user, error: ""}
  end

  if not allow_signup
    give back record {ok: no, user: nothing, error: "No matching GrabLab user account and OAuth signup is disabled"}
  end

  set tx to data.begin using stmts.db
  try
    call data.execute using stmts.insert_user, record {email: email_norm, display_name: display_name, role: "viewer", password_hash: nothing, email_verified: 1, is_active: 1, last_login_at: now_rec.iso, created_at: now_rec.iso, updated_at: now_rec.iso}, tx
    set created_user to data.one using stmts.get_user, record {lookup: "email", iv: 0, sv: email_norm}, tx
    call data.execute using stmts.insert_oauth_account, record {user_id: created_user.id, provider: provider, provider_user_id: provider_uid, provider_email: email_norm, created_at: now_rec.iso, updated_at: now_rec.iso}, tx
    call data.commit using tx
    give back record {ok: yes, user: created_user, error: ""}
  catch tx_err
    call data.rollback using tx
    give back record {ok: no, user: nothing, error: tx_err.message}
  end
end

make admin_asset_urls
  give back record {tokens: (safe_asset_url using "grex/tokens.css"), grex: (safe_asset_url using "grex/grex.js"), admin_css: (safe_asset_url using "admin/admin.css"), admin_js: (safe_asset_url using "admin/admin.js")}
end

make render_admin_dashboard using stmts, sess, admin_page, page_title, page_subtitle
  set settings to get_site_settings_map using stmts
  set theme to get_active_theme_context using stmts
  set assets to call admin_asset_urls
  set rendered to server.html using "views/admin/dashboard.grab.html", record {csrf_token: sess.csrf_secret, admin_page: admin_page, user_role: sess.role, user_email: sess.email, user_name: sess.display_name, user_id: (text.from using sess.user_id), site_title: (settings at "site_title"), active_theme_slug: theme.slug, page_title: page_title, page_subtitle: page_subtitle, tokens_css_url: assets.tokens, admin_css_url: assets.admin_css, grex_js_url: assets.grex, admin_js_url: assets.admin_js}
  give back server.response using record {status: 200, headers: {"Content-Type": "text/html; charset=utf-8", "Cache-Control": "no-store"}, body: rendered.body}
end

# ==============================================================================
# Module 1: Content Type, Custom Field & Grex JS v1.0.0 Layout Validation
# ==============================================================================

make is_valid_field_type using ftype
  set allowed to ["text", "rich_text", "integer", "decimal", "boolean", "date", "url", "json"]
  for each item in allowed
    if item is ftype
      give back yes
    end
  end
  give back no
end

make is_allowed_grex_element using el_name
  set allowed to ["Fragment", "TemplatePart", "Section", "Container", "Grid", "Stack", "Card", "Heading", "Text", "RichText", "Link", "Button", "Image", "Icon", "Form", "Input", "Select", "Tabs", "Accordion", "Modal", "Nav", "ForEach"]
  for each item in allowed
    if item is el_name
      give back yes
    end
  end
  give back no
end

make is_allowed_grex_tag using tag_name
  set allowed to ["section", "main", "header", "footer", "article", "aside", "nav", "h1", "h2", "h3", "h4", "h5", "h6", "p", "span", "a", "button", "img", "ul", "ol", "li", "form", "input", "select", "label", "small", "strong", "em", "blockquote", "time", "code", "svg", "dialog", "details", "summary", "textarea", "tbody", "figure", "figcaption"]
  for each item in allowed
    if item is tag_name
      give back yes
    end
  end
  give back no
end

make is_binding_token using raw
  if (text.starts_with using raw, "{") and (text.ends_with using raw, "}") and (text.length using raw) is greater than 2
    set inner to text.replace using raw, "{", ""
    set inner to text.replace using inner, "}", ""
    if (not (text.contains using inner, "{")) and (not (text.contains using inner, "}")) and (is_valid_field_key using inner)
      give back yes
    end
  end
  give back no
end

make is_record_value using val
  if val is nothing
    give back no
  end
  try
    set ks to collections.keys using val
    give back yes
  catch err
    give back no
  end
end

make resolve_grex_element_name using node
  if not (is_record_value using node)
    give back ""
  end
  if node has "element" and (node at "element") is not nothing
    give back text.from using (node at "element")
  end
  if node has "type" and (node at "type") is not nothing
    give back text.from using (node at "type")
  end
  give back ""
end

make text_contains_unsafe_markup using raw
  set low to text.lower using raw
  if (text.contains using low, "<script") or (text.contains using low, "<iframe") or (text.contains using low, "<object") or (text.contains using low, "<div") or (text.contains using low, "javascript:") or (text.contains using low, "onerror=") or (text.contains using low, "onload=") or (text.contains using low, "onclick=") or (text.contains using low, "eval(")
    give back yes
  end
  give back no
end

make hex_digit_val using ch
  set digits to "0123456789abcdef"
  set chars to text.split using digits, ""
  set idx to 0
  for each c in chars
    if c is ch
      give back idx
    end
    set idx to idx plus 1
  end
  give back -1
end

make parse_css_color using raw_color
  set s to text.lower using (text.trim using (text.from using raw_color))
  if (text.starts_with using s, "rgba(") or (text.starts_with using s, "rgb(")
    if text.ends_with using s, ")"
      set inner to text.replace using s, "rgba(", ""
      set inner to text.replace using inner, "rgb(", ""
      set inner to text.replace using inner, ")", ""
      set parts to text.split using inner, ","
      if (collections.length using parts) is at least 3
        try
          set cr to math.clamp using (text.to_integer using (text.trim using (parts at 0))), 0, 255
          set cg to math.clamp using (text.to_integer using (text.trim using (parts at 1))), 0, 255
          set cb to math.clamp using (text.to_integer using (text.trim using (parts at 2))), 0, 255
          give back record {r: cr, g: cg, b: cb}
        catch cerr
          give back nothing
        end
      end
    end
    give back nothing
  end
  if not (text.starts_with using s, "#")
    give back nothing
  end
  set chars to text.split using s, ""
  set n to collections.length using chars
  if n is 4
    set r0 to hex_digit_val using (chars at 1)
    set g0 to hex_digit_val using (chars at 2)
    set b0 to hex_digit_val using (chars at 3)
    if r0 is less than 0 or g0 is less than 0 or b0 is less than 0
      give back nothing
    end
    give back record {r: (r0 times 17), g: (g0 times 17), b: (b0 times 17)}
  end
  if n is 7
    set r1 to hex_digit_val using (chars at 1)
    set r2 to hex_digit_val using (chars at 2)
    set g1 to hex_digit_val using (chars at 3)
    set g2 to hex_digit_val using (chars at 4)
    set b1 to hex_digit_val using (chars at 5)
    set b2 to hex_digit_val using (chars at 6)
    if r1 is less than 0 or r2 is less than 0 or g1 is less than 0 or g2 is less than 0 or b1 is less than 0 or b2 is less than 0
      give back nothing
    end
    give back record {r: ((r1 times 16) plus r2), g: ((g1 times 16) plus g2), b: ((b1 times 16) plus b2)}
  end
  give back nothing
end

make linearize_channel using c255
  set x to (c255 times 1.0) divided by 255.0
  if x is at most 0.04045
    give back x divided by 12.92
  end
  set inner to 0.59538671 minus (0.11764913 times x)
  set inner to 0.55729664 plus (x times inner)
  set inner to -0.03665408 plus (x times inner)
  set val to 0.0013962 plus (x times inner)
  if val is less than 0.0
    give back 0.0
  end
  if val is greater than 1.0
    give back 1.0
  end
  give back val
end

make compute_contrast_ratio using fg_color, bg_color
  set fg to parse_css_color using fg_color
  set bg to parse_css_color using bg_color
  if fg is nothing or bg is nothing
    give back nothing
  end
  set lf to (0.2126 times (linearize_channel using fg.r)) plus (0.7152 times (linearize_channel using fg.g)) plus (0.0722 times (linearize_channel using fg.b))
  set lb to (0.2126 times (linearize_channel using bg.r)) plus (0.7152 times (linearize_channel using bg.g)) plus (0.0722 times (linearize_channel using bg.b))
  set lighter to math.max using lf, lb
  set darker to math.min using lf, lb
  give back math.round using (((lighter plus 0.05) divided by (darker plus 0.05)) times 1.0), 2
end

make parse_px_number using raw_val
  set s to text.lower using (text.trim using (text.from using raw_val))
  if not (text.ends_with using s, "px")
    give back nothing
  end
  set num_s to text.trim using (text.replace using s, "px", "")
  if num_s is ""
    give back nothing
  end
  try
    if text.contains using num_s, "."
      give back (text.to_decimal using num_s) times 1.0
    otherwise
      give back (text.to_integer using num_s) times 1.0
    end
  catch err
    give back nothing
  end
end

make is_large_text_style using style_map
  set fs_raw to ""
  if has_map_key using style_map, "fontSize"
    set fs_raw to style_map at "fontSize"
  otherwise
    if has_map_key using style_map, "font-size"
      set fs_raw to style_map at "font-size"
    end
  end
  set px to parse_px_number using fs_raw
  if px is nothing
    give back no
  end
  if px is at least 24.0
    give back yes
  end
  set fw_raw to ""
  if has_map_key using style_map, "fontWeight"
    set fw_raw to text.lower using (text.trim using (text.from using (style_map at "fontWeight")))
  otherwise
    if has_map_key using style_map, "font-weight"
      set fw_raw to text.lower using (text.trim using (text.from using (style_map at "font-weight")))
    end
  end
  set is_bold to fw_raw is "bold"
  if (not is_bold) and fw_raw is not ""
    try
      if (text.to_integer using fw_raw) is at least 700
        set is_bold to yes
      end
    catch err
    end
  end
  give back (is_bold and (px is at least 18.66))
end

make extract_grex_style_maps using st_obj
  set maps to []
  if not (is_record_value using st_obj)
    give back maps
  end
  if (has_map_key using st_obj, "base") or (has_map_key using st_obj, "tablet") or (has_map_key using st_obj, "mobile")
    for each bp in ["base", "tablet", "mobile"]
      if has_map_key using st_obj, bp
        set sub_m to st_obj at bp
        if sub_m is not nothing
          set maps to collections.append using maps, sub_m
        end
      end
    end
  otherwise
    set maps to [st_obj]
  end
  give back maps
end

make extract_style_bg using style_map
  if not (is_record_value using style_map)
    give back ""
  end
  if has_map_key using style_map, "backgroundColor"
    give back text.from using (style_map at "backgroundColor")
  end
  if has_map_key using style_map, "background-color"
    give back text.from using (style_map at "background-color")
  end
  if has_map_key using style_map, "background"
    give back text.from using (style_map at "background")
  end
  give back ""
end

make collect_attr_map_violations using attr_map, scope_name, allow_bindings, check_markup
  set out to []
  if not (is_record_value using attr_map)
    give back [record {rule: "schema-invalid-attrs", message: "Grex " joined with scope_name joined with " must be a JSON object"}]
  end
  set ks to collections.keys using attr_map
  for each pk in ks
    set pkl to text.lower using pk
    if text.starts_with using pkl, "on"
      set out to collections.append using out, record {rule: "security-no-inline-events", message: "Inline event handler not allowed in " joined with scope_name joined with ": " joined with pk}
    end
    if pkl is "dangerouslysetinnerhtml" or pkl is "innerhtml" or pkl is "outerhtml"
      set out to collections.append using out, record {rule: "zero-innerHTML", message: "Unsafe raw HTML sink not allowed in " joined with scope_name joined with ": " joined with pk}
    end
    if pkl is "srcdoc"
      set out to collections.append using out, record {rule: "GREX-SEC-SRCDOC", message: "Unsafe srcdoc attribute not allowed in " joined with scope_name joined with ": " joined with pk}
    end
    if pkl is "href" or pkl is "src" or pkl is "action" or pkl is "formaction" or pkl is "poster" or pkl is "cite"
      set url_val to text.from using (attr_map at pk)
      if (not (is_safe_url using url_val)) and (not (allow_bindings and (is_binding_token using url_val)))
        set out to collections.append using out, record {rule: "url-protocol-check", message: "Unsafe URL in " joined with scope_name joined with ": " joined with pk}
      end
    end
    if check_markup and (pkl is "text" or pkl is "html" or pkl is "content")
      set txt_val to text.from using (attr_map at pk)
      if text_contains_unsafe_markup using txt_val
        set out to collections.append using out, record {rule: "csp-safe", message: "Unsafe script/div/event markup inside " joined with pk}
      end
    end
  end
  give back out
end

make collect_style_violations using st_obj, check_outline
  set out to []
  if not (is_record_value using st_obj)
    give back [record {rule: "schema-invalid-styles", message: "Grex styles must be a JSON object"}]
  end
  set style_maps to extract_grex_style_maps using st_obj
  for each sm in style_maps
    if not (is_record_value using sm)
      set out to collections.append using out, record {rule: "schema-invalid-styles", message: "Grex breakpoint style map must be a JSON object"}
    otherwise
      for each sk in (collections.keys using sm)
        set skl to text.lower using sk
        set sv to text.lower using (text.from using (sm at sk))
        if (text.contains using sv, "expression(") or (text.contains using sv, "javascript:") or (text.contains using sv, "vbscript:") or (text.contains using sv, "-moz-binding") or (text.contains using sv, "<script")
          set out to collections.append using out, record {rule: "GREX-SEC-CSS", message: "Unsafe CSS value in styles." joined with sk}
        end
        if check_outline and skl is "outline"
          set sv_t to text.trim using sv
          if sv_t is "none" or sv_t is "0"
            set out to collections.append using out, record {rule: "GREX-A11Y-005", message: "Removing focus outline violates WCAG keyboard accessibility"}
          end
        end
      end
    end
  end
  give back out
end

make validate_grex_node using node, depth
  if depth is greater than 24
    give back record {ok: no, error: "Grex layout nesting exceeds maximum depth (24)"}
  end
  try
    set el_name to resolve_grex_element_name using node
    if el_name is ""
      give back record {ok: no, error: "Grex layout node requires an element field"}
    end
    if not (is_allowed_grex_element using el_name)
      give back record {ok: no, error: "Unsupported or unsafe Grex element: " joined with el_name}
    end
    if node has "tag" and (node at "tag") is not nothing
      set tag_name to text.lower using (text.from using (node at "tag"))
      if tag_name is "div" or tag_name is "script" or tag_name is "iframe" or tag_name is "object" or tag_name is "embed" or tag_name is "style" or tag_name is "link" or tag_name is "meta" or tag_name is "base" or (not (is_allowed_grex_tag using tag_name))
        give back record {ok: no, error: "Disallowed HTML tag in Grex layout: " joined with tag_name}
      end
    end
    if node has "props" and (node at "props") is not nothing
      set pvs to collect_attr_map_violations using (node at "props"), "prop", yes, no
      if (collections.length using pvs) is greater than 0
        give back record {ok: no, error: (pvs at 0).message}
      end
    end
    if node has "attrs" and (node at "attrs") is not nothing
      set avs to collect_attr_map_violations using (node at "attrs"), "attrs", yes, no
      if (collections.length using avs) is greater than 0
        give back record {ok: no, error: (avs at 0).message}
      end
    end
    if node has "styles" and (node at "styles") is not nothing
      set svs to collect_style_violations using (node at "styles"), no
      if (collections.length using svs) is greater than 0
        give back record {ok: no, error: (svs at 0).message}
      end
    end
    if node has "children" and (node at "children") is not nothing
      set kids to node at "children"
      for each child in kids
        set child_res to validate_grex_node using child, (depth plus 1)
        if not child_res.ok
          give back child_res
        end
      end
    end
    give back record {ok: yes, error: ""}
  catch err
    give back record {ok: no, error: "Invalid Grex layout node structure"}
  end
end

make validate_single_field_value using ftype, raw_val
  set as_str to ""
  try
    set as_str to text.from using raw_val
  catch err
    give back record {ok: no, value: "", error: "Field value is not serializable"}
  end

  if ftype is "text"
    give back record {ok: yes, value: as_str, error: ""}
  end

  if ftype is "rich_text"
    set lower to text.lower using as_str
    if (text.contains using lower, "<script") or (text.contains using lower, "javascript:")
      give back record {ok: no, value: "", error: "Unsafe script content in rich_text field"}
    end
    give back record {ok: yes, value: as_str, error: ""}
  end

  if ftype is "integer"
    try
      set parsed_int to text.to_integer using as_str
      give back record {ok: yes, value: (text.from using parsed_int), error: ""}
    catch err
      give back record {ok: no, value: "", error: "Expected exact integer value"}
    end
  end

  if ftype is "decimal"
    try
      if text.contains using as_str, "."
        set parsed_dec to text.to_decimal using as_str
        give back record {ok: yes, value: as_str, error: ""}
      otherwise
        set parsed_int to text.to_integer using as_str
        give back record {ok: yes, value: as_str, error: ""}
      end
    catch err
      give back record {ok: no, value: "", error: "Expected exact base-10 decimal string"}
    end
  end

  if ftype is "boolean"
    set lower to text.lower using (text.trim using as_str)
    if lower is "yes" or lower is "true" or lower is "1"
      give back record {ok: yes, value: yes, error: ""}
    end
    if lower is "no" or lower is "false" or lower is "0"
      give back record {ok: yes, value: no, error: ""}
    end
    give back record {ok: no, value: "", error: "Expected boolean value"}
  end

  if ftype is "date"
    try
      set parsed_dt to dates.parse_iso using as_str
      give back record {ok: yes, value: parsed_dt.iso, error: ""}
    catch err
      give back record {ok: no, value: "", error: "Expected ISO-8601 date or UTC timestamp"}
    end
  end

  if ftype is "url"
    if not (is_safe_url using as_str)
      give back record {ok: no, value: "", error: "Unsafe or invalid URL"}
    end
    give back record {ok: yes, value: as_str, error: ""}
  end

  if ftype is "json"
    set parsed_json to nothing
    if as_str is (json.stringify using raw_val)
      set parsed_json to raw_val
    otherwise
      try
        set parsed_json to json.parse using as_str
      catch err
        set parsed_json to raw_val
      end
    end
    try
      set encoded to json.stringify using parsed_json
      if not ((text.starts_with using encoded, "{") or (text.starts_with using encoded, "["))
        give back record {ok: no, value: "", error: "JSON field must be a JSON object or array"}
      end
      if (text.starts_with using encoded, "{") and (is_record_value using parsed_json) and ((parsed_json has "element") or ((parsed_json has "type") and (is_allowed_grex_element using (text.from using (parsed_json at "type")))))
        set grex_res to validate_grex_node using parsed_json, 0
        if not grex_res.ok
          give back record {ok: no, value: "", error: grex_res.error}
        end
      end
      give back record {ok: yes, value: parsed_json, error: ""}
    catch err
      give back record {ok: no, value: "", error: "Invalid JSON field payload"}
    end
  end

  give back record {ok: no, value: "", error: "Unknown field type: " joined with ftype}
end

make validate_custom_fields using stmts, content_type_id, input_map
  set defs to data.query using stmts.get_field_by_key, record {content_type_id: content_type_id, field_key: ""}
  set validated to {}
  set def_keys to {}

  for each fdef in defs
    set fkey to fdef.field_key
    set def_keys to collections.put using def_keys, fkey, yes
    set has_val to has_map_key using input_map, fkey
    set raw_val to nothing
    if has_val
      set raw_val to input_map at fkey
    end

    if (not has_val) or (raw_val is nothing)
      if fdef.is_required is 1
        give back record {ok: no, json_text: "{}", error: "Missing required custom field: " joined with fkey}
      end
      if fdef.default_value is not nothing and fdef.default_value is not ""
        set def_res to validate_single_field_value using fdef.field_type, fdef.default_value
        if not def_res.ok
          give back record {ok: no, json_text: "{}", error: "Invalid default for " joined with fkey joined with ": " joined with def_res.error}
        end
        set validated to collections.put using validated, fkey, def_res.value
      end
    otherwise
      set val_res to validate_single_field_value using fdef.field_type, raw_val
      if not val_res.ok
        give back record {ok: no, json_text: "{}", error: "Field '" joined with fkey joined with "': " joined with val_res.error}
      end
      if fkey is "isbn_13"
        set isbn_chk to text.trim using (text.from using val_res.value)
        if isbn_chk is not "" and (not (is_valid_isbn13 using isbn_chk))
          give back record {ok: no, json_text: "{}", error: "Field 'isbn_13': invalid ISBN-13 digits or checksum"}
        end
      end
      set validated to collections.put using validated, fkey, val_res.value
    end
  end

  set in_keys to collections.keys using input_map
  for each ikey in in_keys
    if not (has_map_key using def_keys, ikey)
      give back record {ok: no, json_text: "{}", error: "Undefined custom field key: " joined with ikey}
    end
  end

  give back record {ok: yes, json_text: (json.stringify using validated), error: ""}
end

make normalize_and_validate_body using raw_val
  set body_text to ""
  set is_obj to no
  try
    set test_keys to collections.keys using raw_val
    set is_obj to yes
  catch err
    set is_obj to no
  end
  if is_obj
    set body_text to json.stringify using raw_val
  otherwise
    set body_text to text.from using raw_val
  end
  set trimmed to text.trim using body_text
  if text.starts_with using trimmed, "{"
    try
      set parsed_body to json.parse using trimmed
      if (is_record_value using parsed_body) and ((parsed_body has "element") or ((parsed_body has "type") and (is_allowed_grex_element using (text.from using (parsed_body at "type")))))
        set grex_chk to validate_grex_node using parsed_body, 0
        if not grex_chk.ok
          give back record {ok: no, body_html: "", error: grex_chk.error}
        end
      end
    catch err
    end
  end
  give back record {ok: yes, body_html: body_text, error: ""}
end

make compute_full_path using permalink_pattern, slug
  set raw to text.replace using permalink_pattern, ":slug", slug
  give back normalize_path using raw
end

# ==============================================================================
# Module 2: Safe Theme Import, Packaging & Exclusive Hot-Switch Engine
# ==============================================================================

make is_sensitive_segment using seg
  set s to text.lower using seg
  if s is ".git" or s is ".env" or s is ".ssh" or s is "id_rsa" or s is "id_ed25519" or s is ".ds_store"
    give back yes
  end
  if (text.starts_with using s, ".env.") or (text.ends_with using s, ".pem") or (text.ends_with using s, ".key")
    give back yes
  end
  give back no
end

make is_disallowed_executable_ext using rel
  set lower to text.lower using rel
  set bad_exts to [".exe", ".dll", ".so", ".dylib", ".sh", ".bat", ".cmd", ".ps1", ".py", ".php", ".rb", ".pl", ".go", ".wasm", ".msi", ".jar"]
  for each ext in bad_exts
    if text.ends_with using lower, ext
      give back yes
    end
  end
  give back no
end

make is_allowed_theme_file_ext using rel
  set lower to text.lower using rel
  set allowed_exts to [".json", ".grab.html", ".css", ".js", ".svg", ".png", ".jpg", ".jpeg", ".webp", ".woff2"]
  for each ext in allowed_exts
    if text.ends_with using lower, ext
      if ext is ".js" and (not (text.starts_with using lower, "assets/"))
        give back no
      end
      give back yes
    end
  end
  give back no
end

make is_text_theme_file using rel
  set lower to text.lower using rel
  if (text.ends_with using lower, ".json") or (text.ends_with using lower, ".grab.html") or (text.ends_with using lower, ".css") or (text.ends_with using lower, ".js") or (text.ends_with using lower, ".svg")
    give back yes
  end
  give back no
end

make is_safe_theme_relpath using rel
  if rel is "" or (text.starts_with using rel, "/") or (text.contains using rel, ":") or (text.contains using rel, "\\") or (text.contains using rel, "..")
    give back no
  end
  set segs to text.split using rel, "/"
  for each seg in segs
    if seg is "" or seg is "." or seg is ".." or (is_sensitive_segment using seg)
      give back no
    end
  end
  give back yes
end

make is_allowed_theme_capability using cap
  set allowed to ["templates", "parts", "hooks:theme", "grex:visual", "assets:static"]
  for each item in allowed
    if item is cap
      give back yes
    end
  end
  give back no
end

make is_allowed_theme_hook_name using hname
  set allowed to ["theme:head_meta", "theme:before_render", "query:modify_args", "content:before_save"]
  for each item in allowed
    if item is hname
      give back yes
    end
  end
  give back no
end

make is_allowed_theme_handler using handler_name
  set allowed to ["theme_meta_generator", "theme_meta_brand", "theme_query_defaults", "theme_before_render_badge", "theme_before_save_meta"]
  for each item in allowed
    if item is handler_name
      give back yes
    end
  end
  give back no
end

make validate_theme_capabilities using manifest
  set has_hooks_cap to no
  if not (manifest has "capabilities")
    give back record {ok: yes, has_hooks_cap: no, error: ""}
  end
  set caps to manifest at "capabilities"
  for each cap in caps
    set cstr to text.from using cap
    if not (is_allowed_theme_capability using cstr)
      give back record {ok: no, has_hooks_cap: no, error: "GRAB-E401: unauthorized theme capability: " joined with cstr}
    end
    if cstr is "hooks:theme"
      set has_hooks_cap to yes
    end
  end
  give back record {ok: yes, has_hooks_cap: has_hooks_cap, error: ""}
end

make validate_theme_hooks_block using manifest, has_hooks_cap
  if manifest has "plugins" or manifest has "hooks"
    give back record {ok: no, hooks: [], error: "GRAB-E401: unauthorized theme plugins or raw hooks block"}
  end
  if not (manifest has "themeHooks")
    give back record {ok: yes, hooks: [], error: ""}
  end
  if not has_hooks_cap
    give back record {ok: no, hooks: [], error: "GRAB-E401: themeHooks requires 'hooks:theme' capability"}
  end
  set raw_hooks to manifest at "themeHooks"
  set out to []
  for each item in raw_hooks
    if (not (item has "hook")) or (not (item has "handler"))
      give back record {ok: no, hooks: [], error: "GRAB-E401: themeHooks entry requires hook and handler"}
    end
    set hname to text.from using (item at "hook")
    set handler to text.from using (item at "handler")
    if not (is_allowed_theme_hook_name using hname)
      give back record {ok: no, hooks: [], error: "GRAB-E401: disallowed theme hook target: " joined with hname}
    end
    if not (is_allowed_theme_handler using handler)
      give back record {ok: no, hooks: [], error: "GRAB-E401: disallowed theme hook handler: " joined with handler}
    end
    set prio to 20
    if item has "priority"
      try
        set prio to text.to_integer using (text.from using (item at "priority"))
      catch err
        give back record {ok: no, hooks: [], error: "GRAB-E401: invalid hook priority"}
      end
    end
    set out to collections.append using out, record {hook: hname, priority: prio, handler: handler}
  end
  give back record {ok: yes, hooks: out, error: ""}
end

make resolve_theme_mode using manifest
  set mode_val to ""
  if manifest has "mode"
    set mode_val to text.from using (manifest at "mode")
  end
  set engine_val to ""
  if manifest has "engine"
    set engine_val to text.from using (manifest at "engine")
  end

  if mode_val is ""
    if engine_val is "coded"
      give back record {ok: yes, mode: "coded", engine: "coded", error: ""}
    end
    if engine_val is "grex-visual"
      give back record {ok: yes, mode: "visual", engine: "grex-visual", error: ""}
    end
    give back record {ok: no, mode: "", engine: "", error: "Theme engine must be coded or grex-visual"}
  end

  if mode_val is not "coded" and mode_val is not "visual"
    give back record {ok: no, mode: "", engine: "", error: "Theme mode must be coded or visual"}
  end

  if engine_val is ""
    if mode_val is "visual"
      give back record {ok: yes, mode: "visual", engine: "grex-visual", error: ""}
    end
    give back record {ok: yes, mode: "coded", engine: "coded", error: ""}
  end

  if mode_val is "coded" and engine_val is not "coded"
    give back record {ok: no, mode: "", engine: "", error: "Theme mode 'coded' conflicts with engine '" joined with engine_val joined with "'"}
  end
  if mode_val is "visual" and engine_val is not "grex-visual"
    give back record {ok: no, mode: "", engine: "", error: "Theme mode 'visual' conflicts with engine '" joined with engine_val joined with "'"}
  end

  give back record {ok: yes, mode: mode_val, engine: engine_val, error: ""}
end

make validate_grex_elements_doc using doc
  set required_slots to ["home", "single", "archive", "404"]
  if not (doc has "templates")
    give back record {ok: no, error: "grex.elements.json missing templates object"}
  end
  set tmpls to doc at "templates"
  for each slot in required_slots
    if not (has_map_key using tmpls, slot)
      give back record {ok: no, error: "grex.elements.json missing required template slot: " joined with slot}
    end
    set node_res to validate_grex_node using (tmpls at slot), 0
    if not node_res.ok
      give back record {ok: no, error: "Grex template '" joined with slot joined with "': " joined with node_res.error}
    end
  end
  set tkeys to collections.keys using tmpls
  for each tk in tkeys
    set node_res to validate_grex_node using (tmpls at tk), 0
    if not node_res.ok
      give back record {ok: no, error: "Grex template '" joined with tk joined with "': " joined with node_res.error}
    end
  end
  if doc has "parts"
    set parts_map to doc at "parts"
    set pkeys to collections.keys using parts_map
    for each pk in pkeys
      if not (is_valid_slug using pk)
        give back record {ok: no, error: "Invalid Grex template part key: " joined with pk}
      end
      set part_val to parts_map at pk
      if part_val is not nothing
        set p_res to validate_grex_node using part_val, 0
        if not p_res.ok
          give back record {ok: no, error: "Grex part '" joined with pk joined with "': " joined with p_res.error}
        end
      end
    end
  end
  give back record {ok: yes, error: ""}
end

make walk_theme_dir_check using base_dir, rel_dir, depth, state_rec
  if depth is greater than 8
    give back record {ok: no, file_count: state_rec.file_count, total_bytes: state_rec.total_bytes, error: "GRAB-E401: theme directory depth exceeds limit (8)"}
  end
  set full_dir to base_dir
  if rel_dir is not ""
    set full_dir to base_dir joined with "/" joined with rel_dir
  end
  set names to []
  try
    set names to files.list_dir using full_dir
  catch err
    give back record {ok: no, file_count: state_rec.file_count, total_bytes: state_rec.total_bytes, error: "GRAB-E401: unable to inspect theme directory: " joined with full_dir}
  end

  set cur_count to state_rec.file_count
  set cur_bytes to state_rec.total_bytes
  for each name in names
    if is_sensitive_segment using name
      give back record {ok: no, file_count: cur_count, total_bytes: cur_bytes, error: "GRAB-E401: sensitive entry disallowed in theme: " joined with name}
    end
    set child_rel to name
    if rel_dir is not ""
      set child_rel to rel_dir joined with "/" joined with name
    end
    if not (is_safe_theme_relpath using child_rel)
      give back record {ok: no, file_count: cur_count, total_bytes: cur_bytes, error: "GRAB-E401: unsafe theme path: " joined with child_rel}
    end
    set child_full to base_dir joined with "/" joined with child_rel
    set is_sub to no
    try
      set sub_names to files.list_dir using child_full
      set is_sub to yes
    catch err
      set is_sub to no
    end
    if is_sub
      set sub_res to walk_theme_dir_check using base_dir, child_rel, (depth plus 1), record {file_count: cur_count, total_bytes: cur_bytes}
      if not sub_res.ok
        give back sub_res
      end
      set cur_count to sub_res.file_count
      set cur_bytes to sub_res.total_bytes
    otherwise
      set cur_count to cur_count plus 1
      if cur_count is greater than 250
        give back record {ok: no, file_count: cur_count, total_bytes: cur_bytes, error: "GRAB-E401: theme exceeds maximum file count (250)"}
      end
      if is_disallowed_executable_ext using child_rel
        give back record {ok: no, file_count: cur_count, total_bytes: cur_bytes, error: "GRAB-E401: disallowed executable extension in theme: " joined with child_rel}
      end
      if not (is_allowed_theme_file_ext using child_rel)
        give back record {ok: no, file_count: cur_count, total_bytes: cur_bytes, error: "GRAB-E401: disallowed file extension in theme: " joined with child_rel}
      end
      if is_text_theme_file using child_rel
        try
          set txt to files.read_text using child_full
          set fbytes to text.length using txt
          if fbytes is greater than 5242880
            give back record {ok: no, file_count: cur_count, total_bytes: cur_bytes, error: "GRAB-E401: theme file exceeds 5 MB limit: " joined with child_rel}
          end
          set cur_bytes to cur_bytes plus fbytes
          if cur_bytes is greater than 26214400
            give back record {ok: no, file_count: cur_count, total_bytes: cur_bytes, error: "GRAB-E401: theme package exceeds 25 MB total limit"}
          end
        catch err
          give back record {ok: no, file_count: cur_count, total_bytes: cur_bytes, error: "GRAB-E401: invalid UTF-8 or unreadable theme file: " joined with child_rel}
        end
      end
    end
  end
  give back record {ok: yes, file_count: cur_count, total_bytes: cur_bytes, error: ""}
end

make validate_theme_manifest using slug
  if not (is_valid_theme_slug using slug)
    give back record {ok: no, manifest: {}, raw: "", mode: "", error: "Invalid theme slug"}
  end
  set base_dir to "themes/" joined with slug
  set manifest_path to base_dir joined with "/theme.json"
  set exists_flag to no
  try
    set exists_flag to files.exists using manifest_path
  catch err
    give back record {ok: no, manifest: {}, raw: "", mode: "", error: "Unable to access theme manifest"}
  end
  if not exists_flag
    give back record {ok: no, manifest: {}, raw: "", mode: "", error: "Theme manifest not found: " joined with manifest_path}
  end

  set dir_check to walk_theme_dir_check using base_dir, "", 0, record {file_count: 0, total_bytes: 0}
  if not dir_check.ok
    give back record {ok: no, manifest: {}, raw: "", mode: "", error: dir_check.error}
  end

  set raw_json to ""
  set manifest to {}
  try
    set raw_json to files.read_text using manifest_path
    set manifest to json.parse using raw_json
  catch err
    give back record {ok: no, manifest: {}, raw: "", mode: "", error: "Malformed theme.json"}
  end

  if (not (manifest has "schemaVersion")) or (not (manifest has "slug")) or (not (manifest has "name")) or (not (manifest has "version"))
    give back record {ok: no, manifest: {}, raw: "", mode: "", error: "theme.json missing required fields"}
  end
  if (not (manifest has "engine")) and (not (manifest has "mode"))
    give back record {ok: no, manifest: {}, raw: "", mode: "", error: "theme.json requires mode or engine"}
  end
  if (manifest at "schemaVersion") is not "1.0.0"
    give back record {ok: no, manifest: {}, raw: "", mode: "", error: "Unsupported theme schemaVersion"}
  end
  if (manifest at "slug") is not slug
    give back record {ok: no, manifest: {}, raw: "", mode: "", error: "theme.json slug does not match directory name"}
  end

  set cap_res to validate_theme_capabilities using manifest
  if not cap_res.ok
    give back record {ok: no, manifest: {}, raw: "", mode: "", error: cap_res.error}
  end
  set hooks_res to validate_theme_hooks_block using manifest, cap_res.has_hooks_cap
  if not hooks_res.ok
    give back record {ok: no, manifest: {}, raw: "", mode: "", error: hooks_res.error}
  end

  set mode_res to resolve_theme_mode using manifest
  if not mode_res.ok
    give back record {ok: no, manifest: {}, raw: "", mode: "", error: mode_res.error}
  end
  set mode to mode_res.mode

  if mode is "coded"
    if not (manifest has "templates")
      give back record {ok: no, manifest: {}, raw: "", mode: "", error: "Coded theme.json missing templates"}
    end
    set templates to manifest at "templates"
    set required_slots to ["home", "single", "archive", "404"]
    for each slot in required_slots
      if not (has_map_key using templates, slot)
        give back record {ok: no, manifest: {}, raw: "", mode: "", error: "theme.json missing required template slot: " joined with slot}
      end
    end
    set tmpl_keys to collections.keys using templates
    for each tkey in tmpl_keys
      set trel to text.from using (templates at tkey)
      if not (is_safe_theme_relpath using trel)
        give back record {ok: no, manifest: {}, raw: "", mode: "", error: "GRAB-E401: unsafe theme template path: " joined with trel}
      end
      if not (text.ends_with using trel, ".grab.html")
        give back record {ok: no, manifest: {}, raw: "", mode: "", error: "Theme templates must have .grab.html extension"}
      end
      set disk_path to base_dir joined with "/" joined with trel
      if not (files.exists using disk_path)
        give back record {ok: no, manifest: {}, raw: "", mode: "", error: "Missing theme template on disk: " joined with disk_path}
      end
    end
    if manifest has "parts"
      set parts to manifest at "parts"
      set pkeys to collections.keys using parts
      for each pkey in pkeys
        if not (is_valid_slug using pkey)
          give back record {ok: no, manifest: {}, raw: "", mode: "", error: "Invalid template part key: " joined with pkey}
        end
        set prel_raw to parts at pkey
        if prel_raw is not nothing
          set prel to text.from using prel_raw
          if not (is_safe_theme_relpath using prel)
            give back record {ok: no, manifest: {}, raw: "", mode: "", error: "GRAB-E401: unsafe theme part path: " joined with prel}
          end
          if not (text.ends_with using prel, ".grab.html")
            give back record {ok: no, manifest: {}, raw: "", mode: "", error: "Coded theme parts must have .grab.html extension"}
          end
          set p_disk to base_dir joined with "/" joined with prel
          if not (files.exists using p_disk)
            give back record {ok: no, manifest: {}, raw: "", mode: "", error: "Missing theme part on disk: " joined with p_disk}
          end
        end
      end
    end
  otherwise
    set grex_rel to "grex.elements.json"
    if manifest has "grexElements"
      set grex_rel to text.from using (manifest at "grexElements")
    end
    if (not (is_safe_theme_relpath using grex_rel)) or (not (text.ends_with using grex_rel, ".json"))
      give back record {ok: no, manifest: {}, raw: "", mode: "", error: "GRAB-E401: unsafe grexElements path"}
    end
    set grex_disk to base_dir joined with "/" joined with grex_rel
    if not (files.exists using grex_disk)
      give back record {ok: no, manifest: {}, raw: "", mode: "", error: "Visual theme missing grex.elements.json: " joined with grex_disk}
    end
    try
      set grex_raw to files.read_text using grex_disk
      set grex_doc to json.parse using grex_raw
      set grex_chk to validate_grex_elements_doc using grex_doc
      if not grex_chk.ok
        give back record {ok: no, manifest: {}, raw: "", mode: "", error: grex_chk.error}
      end
    catch err
      give back record {ok: no, manifest: {}, raw: "", mode: "", error: "Malformed grex.elements.json"}
    end
  end

  if manifest has "assets"
    set assets to manifest at "assets"
    for each asset_group in ["styles", "scripts"]
      if has_map_key using assets, asset_group
        set items to assets at asset_group
        for each arel in items
          set arel_str to text.from using arel
          if not (is_safe_theme_relpath using arel_str)
            give back record {ok: no, manifest: {}, raw: "", mode: "", error: "GRAB-E401: unsafe theme asset path: " joined with arel_str}
          end
          if asset_group is "styles" and (not (text.ends_with using (text.lower using arel_str), ".css"))
            give back record {ok: no, manifest: {}, raw: "", mode: "", error: "GRAB-E401: theme style asset must be .css"}
          end
          if asset_group is "scripts" and ((not (text.ends_with using (text.lower using arel_str), ".js")) or (not (text.starts_with using (text.lower using arel_str), "assets/")))
            give back record {ok: no, manifest: {}, raw: "", mode: "", error: "GRAB-E401: theme script asset must be under assets/*.js"}
          end
        end
      end
    end
  end

  give back record {ok: yes, manifest: manifest, raw: raw_json, mode: mode, engine: mode_res.engine, error: ""}
end

make validate_theme_package_bundle using payload
  if (not (payload has "slug")) or (not (payload has "manifest")) or (not (payload has "files"))
    give back record {ok: no, error: "Package bundle requires slug, manifest, and files"}
  end
  set slug to normalize_slug using (text.from using (payload at "slug"))
  if not (is_valid_theme_slug using slug)
    give back record {ok: no, error: "Invalid theme slug"}
  end
  set manifest to payload at "manifest"
  if (not (manifest has "schemaVersion")) or (not (manifest has "slug")) or (not (manifest has "name")) or (not (manifest has "version"))
    give back record {ok: no, error: "Manifest missing required fields"}
  end
  if (manifest at "slug") is not slug
    give back record {ok: no, error: "Manifest slug does not match package slug"}
  end
  set cap_res to validate_theme_capabilities using manifest
  if not cap_res.ok
    give back record {ok: no, error: cap_res.error}
  end
  set hooks_res to validate_theme_hooks_block using manifest, cap_res.has_hooks_cap
  if not hooks_res.ok
    give back record {ok: no, error: hooks_res.error}
  end
  set mode_res to resolve_theme_mode using manifest
  if not mode_res.ok
    give back record {ok: no, error: mode_res.error}
  end

  set file_entries to payload at "files"
  set count to collections.length using file_entries
  if count is greater than 250
    give back record {ok: no, error: "GRAB-E401: package exceeds maximum file count (250)"}
  end

  set total_bytes to 0
  set path_set to {}
  for each f in file_entries
    if not (f has "path")
      give back record {ok: no, error: "Package file entry missing path"}
    end
    set rel to text.from using (f at "path")
    if not (is_safe_theme_relpath using rel)
      give back record {ok: no, error: "GRAB-E401: unsafe package file path: " joined with rel}
    end
    if is_disallowed_executable_ext using rel
      give back record {ok: no, error: "GRAB-E401: disallowed executable extension: " joined with rel}
    end
    if not (is_allowed_theme_file_ext using rel)
      give back record {ok: no, error: "GRAB-E401: disallowed file extension: " joined with rel}
    end
    set fsize to 0
    if f has "size_bytes"
      set fsize to text.to_integer using (text.from using (f at "size_bytes"))
    otherwise
      if f has "content"
        set fsize to text.length using (text.from using (f at "content"))
      end
    end
    if fsize is greater than 5242880
      give back record {ok: no, error: "GRAB-E401: package file exceeds 5 MB limit: " joined with rel}
    end
    set total_bytes to total_bytes plus fsize
    if total_bytes is greater than 26214400
      give back record {ok: no, error: "GRAB-E401: package exceeds 25 MB total limit"}
    end
    set path_set to collections.put using path_set, rel, f
  end

  if mode_res.mode is "coded"
    if not (manifest has "templates")
      give back record {ok: no, error: "Coded theme manifest missing templates"}
    end
    set tmpls to manifest at "templates"
    for each req_slot in ["home", "single", "archive", "404"]
      if not (has_map_key using tmpls, req_slot)
        give back record {ok: no, error: "Missing required template slot: " joined with req_slot}
      end
      set trel to text.from using (tmpls at req_slot)
      if not (has_map_key using path_set, trel)
        give back record {ok: no, error: "Package missing declared template file: " joined with trel}
      end
    end
  otherwise
    set grex_rel to "grex.elements.json"
    if manifest has "grexElements"
      set grex_rel to text.from using (manifest at "grexElements")
    end
    if not (has_map_key using path_set, grex_rel)
      give back record {ok: no, error: "Visual theme package missing " joined with grex_rel}
    end
    set grex_entry to path_set at grex_rel
    if grex_entry has "content"
      try
        set gdoc to json.parse using (text.from using (grex_entry at "content"))
        set gchk to validate_grex_elements_doc using gdoc
        if not gchk.ok
          give back record {ok: no, error: gchk.error}
        end
      catch err
        give back record {ok: no, error: "Malformed grex.elements.json in package"}
      end
    end
  end

  give back record {ok: yes, slug: slug, mode: mode_res.mode, file_count: count, total_bytes: total_bytes, error: ""}
end

make upsert_setting using stmts, key, val, now_iso, tx
  set existing to data.one using stmts.get_setting, record {key: key}, tx
  if existing is nothing
    call data.execute using stmts.upsert_setting_insert, record {key: key, value: val, updated_at: now_iso}, tx
  otherwise
    call data.execute using stmts.upsert_setting_update, record {value: val, updated_at: now_iso, key: key}, tx
  end
end

make upsert_theme_row using stmts, slug, check_res, now_iso, tx
  set existing to data.one using stmts.get_theme, record {lookup: "slug", sv: slug}, tx
  if existing is nothing
    call data.execute using stmts.insert_theme, record {slug: slug, name: (check_res.manifest at "name"), version: (check_res.manifest at "version"), engine: check_res.engine, is_active: 0, manifest_json: check_res.raw, installed_at: now_iso}, tx
  otherwise
    call data.execute using stmts.update_theme_manifest, record {name: (check_res.manifest at "name"), version: (check_res.manifest at "version"), engine: check_res.engine, manifest_json: check_res.raw, slug: slug}, tx
  end
end

make get_active_theme_context using stmts
  set cached to cache.get using stmts.cms_cache, "active_theme"
  if cached.found
    give back cached.value
  end

  set row to data.one using stmts.get_theme, record {lookup: "active", sv: ""}
  set default_templates to {"home": "templates/home.grab.html", "single": "templates/single.grab.html", "archive": "templates/archive.grab.html", "404": "templates/404.grab.html", "search": "templates/search.grab.html"}
  set default_parts to {"header": "templates/parts/header.grab.html", "footer": "templates/parts/footer.grab.html", "card": "templates/parts/card.grab.html", "sidebar": "templates/parts/sidebar.grab.html"}
  set ctx to record {slug: "default-starter", name: "Default Starter", version: "1.0.0", engine: "coded", mode: "coded", templates: default_templates, parts: default_parts, themeHooks: [], assets: {}, grexElements: "grex.elements.json"}
  if row is not nothing
    set parsed to json.parse using row.manifest_json
    set mode_res to resolve_theme_mode using parsed
    set mode to "coded"
    if mode_res.ok
      set mode to mode_res.mode
    end
    set tmpls to {}
    if parsed has "templates"
      set tmpls to parsed at "templates"
    end
    set parts to {}
    if parsed has "parts"
      set parts to parsed at "parts"
    end
    set thooks to []
    if parsed has "themeHooks"
      set thooks to parsed at "themeHooks"
    end
    set assets to {}
    if parsed has "assets"
      set assets to parsed at "assets"
    end
    set grex_el_path to "grex.elements.json"
    if parsed has "grexElements"
      set grex_el_path to text.from using (parsed at "grexElements")
    end
    set ctx to record {slug: row.slug, name: row.name, version: row.version, engine: row.engine, mode: mode, templates: tmpls, parts: parts, themeHooks: thooks, assets: assets, grexElements: grex_el_path}
  end
  call cache.set using stmts.cms_cache, "active_theme", ctx, 300000
  give back ctx
end

make get_site_settings_map using stmts
  set cached to cache.get using stmts.cms_cache, "site_settings"
  if cached.found
    give back cached.value
  end
  set rows to data.query using stmts.get_setting, record {key: "*"}
  set out to {"site_title": "GrabLab CMS", "site_tagline": "Zero-plugin CMS", "active_theme_slug": "default-starter", "home_entry_id": ""}
  for each r in rows
    set out to collections.put using out, r.key, r.value
  end
  call cache.set using stmts.cms_cache, "site_settings", out, 300000
  give back out
end

# ==============================================================================
# Module 3: Cache Epochs & Deterministic Invalidation (use cache)
# ==============================================================================

make get_cache_epoch using stmts, epoch_key
  set cached to cache.get using stmts.cms_cache, epoch_key
  if cached.found
    give back cached.value
  end
  call cache.set using stmts.cms_cache, epoch_key, 1, 86400000
  give back 1
end

make bump_cache_epoch using stmts, epoch_key
  set cur to get_cache_epoch using stmts, epoch_key
  set nxt to cur plus 1
  call cache.set using stmts.cms_cache, epoch_key, nxt, 86400000
  give back nxt
end

make bump_query_cache_epochs using stmts, type_slug
  call bump_cache_epoch using stmts, "cache_epoch:query"
  if type_slug is not ""
    call bump_cache_epoch using stmts, ("cache_epoch:type:" joined with type_slug)
  end
end

make invalidate_menu_caches using stmts, location
  if location is not nothing and location is not ""
    call cache.delete using stmts.cms_cache, ("menu:loc:" joined with location)
  otherwise
    call cache.delete using stmts.cms_cache, "menu:loc:primary"
    call cache.delete using stmts.cms_cache, "menu:loc:footer"
    call cache.delete using stmts.cms_cache, "menu:loc:mobile"
  end
  call bump_cache_epoch using stmts, "cache_epoch:menu"
end

make invalidate_route_caches using stmts, path_a, path_b, type_slug
  if path_a is not ""
    call cache.delete using stmts.cms_cache, ("route:" joined with path_a)
  end
  if path_b is not ""
    call cache.delete using stmts.cms_cache, ("route:" joined with path_b)
  end
  call cache.delete using stmts.cms_cache, "route:/"
  if type_slug is not ""
    call cache.delete using stmts.cms_cache, ("archive:" joined with type_slug)
  end
  call cache.delete using stmts.cms_cache, "home_entries"
  call invalidate_menu_caches using stmts, ""
  call bump_query_cache_epochs using stmts, type_slug
end

# ==============================================================================
# Module 4: Native Hooks & Filters Registry (Core + Single Active Theme Only)
# ==============================================================================

make is_allowed_hook_handler_ref using source, handler_name
  if source is "core"
    set core_handlers to ["core_normalize_entry_before_save", "core_invalidate_after_publish", "core_default_head_meta", "core_prepare_render_context", "core_clamp_query_args", "core_emit_abandoned_checkout"]
    for each h in core_handlers
      if h is handler_name
        give back yes
      end
    end
    give back no
  end
  give back is_allowed_theme_handler using handler_name
end

make create_hook_registry using active_slug
  give back record {active_slug: active_slug, hooks: {}, filters: {}, next_seq: 0}
end

make validate_hook_source using registry, source
  if source is "core"
    give back yes
  end
  set expected to "theme:" joined with registry.active_slug
  if source is expected
    give back yes
  end
  give back no
end

make sort_registrations using items
  set sorted to []
  for each item in items
    set inserted to no
    set next_list to []
    for each existing in sorted
      if (not inserted) and ((item.priority is less than existing.priority) or (item.priority is existing.priority and item.seq is less than existing.seq))
        set next_list to collections.append using next_list, item
        set inserted to yes
      end
      set next_list to collections.append using next_list, existing
    end
    if not inserted
      set next_list to collections.append using next_list, item
    end
    set sorted to next_list
  end
  give back sorted
end

make registerHook using registry, hook_name, source, priority, handler_name
  if not (validate_hook_source using registry, source)
    give back record {ok: no, registry: registry, error: "GRAB-E401: hook source denied (zero-plugin active-theme isolation): " joined with source}
  end
  if not (is_allowed_hook_handler_ref using source, handler_name)
    give back record {ok: no, registry: registry, error: "GRAB-E401: unregistered or unsafe hook handler: " joined with handler_name}
  end
  set seq to registry.next_seq
  set entry to record {name: hook_name, kind: "hook", source: source, priority: priority, seq: seq, handler: handler_name}
  set existing to []
  if has_map_key using registry.hooks, hook_name
    set existing to registry.hooks at hook_name
  end
  set updated to sort_registrations using (collections.append using existing, entry)
  set next_hooks to collections.put using registry.hooks, hook_name, updated
  give back record {ok: yes, registry: (record {active_slug: registry.active_slug, hooks: next_hooks, filters: registry.filters, next_seq: (seq plus 1)}), error: ""}
end

make registerFilter using registry, filter_name, source, priority, handler_name
  if not (validate_hook_source using registry, source)
    give back record {ok: no, registry: registry, error: "GRAB-E401: filter source denied (zero-plugin active-theme isolation): " joined with source}
  end
  if not (is_allowed_hook_handler_ref using source, handler_name)
    give back record {ok: no, registry: registry, error: "GRAB-E401: unregistered or unsafe filter handler: " joined with handler_name}
  end
  set seq to registry.next_seq
  set entry to record {name: filter_name, kind: "filter", source: source, priority: priority, seq: seq, handler: handler_name}
  set existing to []
  if has_map_key using registry.filters, filter_name
    set existing to registry.filters at filter_name
  end
  set updated to sort_registrations using (collections.append using existing, entry)
  set next_filters to collections.put using registry.filters, filter_name, updated
  give back record {ok: yes, registry: (record {active_slug: registry.active_slug, hooks: registry.hooks, filters: next_filters, next_seq: (seq plus 1)}), error: ""}
end

make execute_hook_handler using stmts, handler_name, payload
  if handler_name is "core_invalidate_after_publish"
    set full_path to ""
    set old_path to ""
    set type_slug to ""
    if payload has "full_path"
      set full_path to text.from using (payload at "full_path")
    end
    if payload has "old_path"
      set old_path to text.from using (payload at "old_path")
    end
    if payload has "content_type_slug"
      set type_slug to text.from using (payload at "content_type_slug")
    end
    call invalidate_route_caches using stmts, old_path, full_path, type_slug
    give back record {ok: yes, executed: handler_name}
  end
  if handler_name is "core_prepare_render_context"
    give back record {ok: yes, executed: handler_name}
  end
  if handler_name is "theme_before_render_badge"
    give back record {ok: yes, executed: handler_name}
  end
  if handler_name is "core_emit_abandoned_checkout"
    give back record {ok: yes, executed: handler_name}
  end
  give back record {ok: yes, executed: handler_name}
end

make execute_filter_handler using handler_name, val, ctx
  if handler_name is "core_normalize_entry_before_save"
    set out to val
    set title_val to ""
    if has_map_key using out, "title"
      set title_val to text.trim using (text.from using (out at "title"))
      set out to collections.put using out, "title", title_val
    end
    if (not (has_map_key using out, "meta_title")) or ((out at "meta_title") is "")
      set out to collections.put using out, "meta_title", title_val
    end
    if (not (has_map_key using out, "meta_description")) or ((out at "meta_description") is "")
      if has_map_key using out, "body_html"
        set ex to make_excerpt using (out at "body_html")
        set out to collections.put using out, "meta_description", ex
      end
    end
    give back out
  end

  if handler_name is "theme_before_save_meta"
    set out to val
    if has_map_key using out, "meta_title"
      set mt to text.from using (out at "meta_title")
      if mt is not "" and (has_map_key using ctx, "theme_name")
        set suffix to " | " joined with (text.from using (ctx at "theme_name"))
        if not (text.ends_with using mt, suffix)
          set out to collections.put using out, "meta_title", (mt joined with suffix)
        end
      end
    end
    give back out
  end

  if handler_name is "core_default_head_meta"
    set tags to val
    set canon to "/"
    if has_map_key using ctx, "canonical_path"
      set canon to text.from using (ctx at "canonical_path")
    end
    if is_safe_url using canon
      set tags to collections.append using tags, ("<link rel=\"canonical\" href=\"" joined with (escape_html using canon) joined with "\">")
    end
    set og_title to "GrabLab CMS"
    if has_map_key using ctx, "page_title"
      set og_title to text.from using (ctx at "page_title")
    end
    set tags to collections.append using tags, ("<meta property=\"og:title\" content=\"" joined with (escape_html using og_title) joined with "\">")
    give back tags
  end

  if handler_name is "theme_meta_generator"
    set tags to val
    set tslug to "default-starter"
    if has_map_key using ctx, "theme_slug"
      set tslug to text.from using (ctx at "theme_slug")
    end
    set tags to collections.append using tags, ("<meta name=\"generator\" content=\"GrabLab CMS v1.4.0 (" joined with (escape_html using tslug) joined with ")\">")
    give back tags
  end

  if handler_name is "theme_meta_brand"
    set tags to val
    set tname to "GrabLab Theme"
    if has_map_key using ctx, "theme_name"
      set tname to text.from using (ctx at "theme_name")
    end
    set tags to collections.append using tags, ("<meta name=\"theme-name\" content=\"" joined with (escape_html using tname) joined with "\">")
    give back tags
  end

  if handler_name is "core_clamp_query_args"
    set args to val
    set p to args.page
    if p is less than 1
      set p to 1
    end
    set pp to args.per_page
    if pp is less than 1
      set pp to 1
    end
    if pp is greater than 100
      set pp to 100
    end
    set st to args.status
    if args.is_public
      set st to "published"
    end
    give back record {content_type: args.content_type, status: st, field_key: args.field_key, field_op: args.field_op, field_value: args.field_value, term_taxonomy: args.term_taxonomy, term_slug: args.term_slug, term_id: args.term_id, include_children: args.include_children, search: args.search, sort_by: args.sort_by, sort_dir: args.sort_dir, page: p, per_page: pp, is_public: args.is_public}
  end

  if handler_name is "theme_query_defaults"
    give back val
  end

  give back val
end

make runHook using stmts, registry, hook_name, payload
  set executed to []
  if not (has_map_key using registry.hooks, hook_name)
    give back executed
  end
  set handlers to registry.hooks at hook_name
  for each reg in handlers
    call execute_hook_handler using stmts, reg.handler, payload
    set executed to collections.append using executed, record {source: reg.source, priority: reg.priority, handler: reg.handler}
  end
  give back executed
end

make applyFilter using registry, filter_name, initial_val, ctx
  set current to initial_val
  if not (has_map_key using registry.filters, filter_name)
    give back current
  end
  set handlers to registry.filters at filter_name
  for each reg in handlers
    set current to execute_filter_handler using reg.handler, current, ctx
  end
  give back current
end

make build_active_hook_registry using theme
  set reg to create_hook_registry using theme.slug
  set r1 to registerFilter using reg, "content:before_save", "core", 10, "core_normalize_entry_before_save"
  set reg to r1.registry
  set r2 to registerHook using reg, "content:after_publish", "core", 10, "core_invalidate_after_publish"
  set reg to r2.registry
  set r3 to registerFilter using reg, "theme:head_meta", "core", 10, "core_default_head_meta"
  set reg to r3.registry
  set r4 to registerHook using reg, "theme:before_render", "core", 10, "core_prepare_render_context"
  set reg to r4.registry
  set r5 to registerFilter using reg, "query:modify_args", "core", 10, "core_clamp_query_args"
  set reg to r5.registry
  set r6 to registerHook using reg, "commerce:abandoned_checkout", "core", 10, "core_emit_abandoned_checkout"
  set reg to r6.registry

  set tsrc to "theme:" joined with theme.slug
  for each th in theme.themeHooks
    set hname to text.from using (th at "hook")
    set handler to text.from using (th at "handler")
    set prio to 20
    if th has "priority"
      set prio to text.to_integer using (text.from using (th at "priority"))
    end
    if hname is "theme:before_render" or hname is "content:after_publish"
      set res to registerHook using reg, hname, tsrc, prio, handler
      if res.ok
        set reg to res.registry
      end
    otherwise
      set res to registerFilter using reg, hname, tsrc, prio, handler
      if res.ok
        set reg to res.registry
      end
    end
  end
  give back reg
end

# ==============================================================================
# Module 5: Query Loop Engine (query_entries + use cache Invalidation)
# ==============================================================================

make is_allowed_sort_by using raw
  set allowed to ["published_at", "created_at", "updated_at", "title", "id"]
  for each item in allowed
    if item is raw
      give back yes
    end
  end
  give back no
end

make is_allowed_field_op using raw
  set allowed to ["eq", "neq", "contains"]
  for each item in allowed
    if item is raw
      give back yes
    end
  end
  give back no
end

make normalize_query_args using raw_map, is_public
  set ct to ""
  if has_map_key using raw_map, "content_type"
    set ct to normalize_slug using (text.from using (raw_map at "content_type"))
    if ct is not "" and (not (is_valid_slug using ct))
      give back record {ok: no, args: nothing, error: "Invalid content_type slug"}
    end
  end

  set status to "published"
  if (not is_public) and (has_map_key using raw_map, "status")
    set st_raw to text.lower using (text.trim using (text.from using (raw_map at "status")))
    if st_raw is not ""
      if st_raw is not "published" and st_raw is not "draft" and st_raw is not "archived" and st_raw is not "all"
        give back record {ok: no, args: nothing, error: "Invalid query status"}
      end
      set status to st_raw
    end
  end

  set field_key to ""
  if has_map_key using raw_map, "field_key"
    set field_key to normalize_slug using (text.from using (raw_map at "field_key"))
    if field_key is not "" and (not (is_valid_field_key using field_key))
      give back record {ok: no, args: nothing, error: "Invalid field_key"}
    end
  end

  set field_op to "eq"
  if has_map_key using raw_map, "field_op"
    set fop_raw to text.lower using (text.trim using (text.from using (raw_map at "field_op")))
    if fop_raw is not ""
      if not (is_allowed_field_op using fop_raw)
        give back record {ok: no, args: nothing, error: "Unsupported field_op (allowed: eq, neq, contains)"}
      end
      set field_op to fop_raw
    end
  end

  set field_value to ""
  if has_map_key using raw_map, "field_value"
    set field_value to text.from using (raw_map at "field_value")
  end

  set sort_by to "published_at"
  if has_map_key using raw_map, "sort_by"
    set sb_raw to text.lower using (text.trim using (text.from using (raw_map at "sort_by")))
    if sb_raw is not ""
      if not (is_allowed_sort_by using sb_raw)
        give back record {ok: no, args: nothing, error: "Unsupported sort_by column"}
      end
      set sort_by to sb_raw
    end
  end

  set sort_dir to "desc"
  if has_map_key using raw_map, "sort_dir"
    set sd_raw to text.lower using (text.trim using (text.from using (raw_map at "sort_dir")))
    if sd_raw is not ""
      if sd_raw is not "asc" and sd_raw is not "desc"
        give back record {ok: no, args: nothing, error: "sort_dir must be asc or desc"}
      end
      set sort_dir to sd_raw
    end
  end

  set page to 1
  if has_map_key using raw_map, "page"
    set p_raw to text.trim using (text.from using (raw_map at "page"))
    if p_raw is not ""
      try
        set page to text.to_integer using p_raw
      catch err
        give back record {ok: no, args: nothing, error: "page must be an integer"}
      end
      if page is less than 1
        give back record {ok: no, args: nothing, error: "page must be >= 1"}
      end
    end
  end

  set per_page to 10
  if has_map_key using raw_map, "per_page"
    set pp_raw to text.trim using (text.from using (raw_map at "per_page"))
    if pp_raw is not ""
      try
        set per_page to text.to_integer using pp_raw
      catch err
        give back record {ok: no, args: nothing, error: "per_page must be an integer"}
      end
      if per_page is less than 1 or per_page is greater than 100
        give back record {ok: no, args: nothing, error: "per_page must be between 1 and 100"}
      end
    end
  end

  set term_taxonomy to ""
  set term_slug to ""
  set term_id to 0
  set include_children to no

  if has_map_key using raw_map, "term_id"
    set tid_raw to text.trim using (text.from using (raw_map at "term_id"))
    if tid_raw is not "" and tid_raw is not "0"
      try
        set term_id to text.to_integer using tid_raw
      catch err
        give back record {ok: no, args: nothing, error: "term_id must be an integer"}
      end
    end
  end
  if has_map_key using raw_map, "taxonomy"
    set term_taxonomy to normalize_slug using (text.from using (raw_map at "taxonomy"))
  end
  if has_map_key using raw_map, "term_slug"
    set term_slug to normalize_slug using (text.from using (raw_map at "term_slug"))
  end
  if has_map_key using raw_map, "include_children"
    set ic_raw to text.lower using (text.trim using (text.from using (raw_map at "include_children")))
    if ic_raw is "yes" or ic_raw is "true" or ic_raw is "1"
      set include_children to yes
    end
  end
  if has_map_key using raw_map, "filter_by_term"
    set fbt to raw_map at "filter_by_term"
    if fbt is not nothing
      if fbt has "term_id"
        try
          set term_id to text.to_integer using (text.from using (fbt at "term_id"))
        catch err
          give back record {ok: no, args: nothing, error: "filter_by_term.term_id must be an integer"}
        end
      end
      if fbt has "taxonomy"
        set term_taxonomy to normalize_slug using (text.from using (fbt at "taxonomy"))
      end
      if fbt has "term_slug"
        set term_slug to normalize_slug using (text.from using (fbt at "term_slug"))
      end
      if fbt has "include_children"
        set fbt_ic to text.lower using (text.trim using (text.from using (fbt at "include_children")))
        if fbt_ic is "yes" or fbt_ic is "true" or fbt_ic is "1"
          set include_children to yes
        end
      end
    end
  end

  set search_q to ""
  if has_map_key using raw_map, "search"
    set search_q to text.trim using (text.from using (raw_map at "search"))
  end

  give back record {ok: yes, args: (record {content_type: ct, status: status, field_key: field_key, field_op: field_op, field_value: field_value, term_taxonomy: term_taxonomy, term_slug: term_slug, term_id: term_id, include_children: include_children, search: search_q, sort_by: sort_by, sort_dir: sort_dir, page: page, per_page: per_page, is_public: is_public}), error: ""}
end

make select_query_stmt using stmts, sort_by, sort_dir
  if sort_dir is "asc"
    give back stmts.query_entries_asc
  end
  give back stmts.query_entries_desc
end

make matches_custom_field_filter using cf_json_text, field_key, field_op, field_value
  if field_key is ""
    give back yes
  end
  try
    set cf_map to json.parse using cf_json_text
    if not (has_map_key using cf_map, field_key)
      if field_op is "neq"
        give back yes
      end
      give back no
    end
    set raw_val to text.from using (cf_map at field_key)
    if field_op is "eq"
      give back (raw_val is field_value)
    end
    if field_op is "neq"
      give back (raw_val is not field_value)
    end
    if field_op is "contains"
      give back (text.contains using (text.lower using raw_val), (text.lower using field_value))
    end
    give back no
  catch err
    give back no
  end
end

make format_query_item using row
  set cf_parsed to {}
  try
    set cf_parsed to json.parse using row.custom_fields_json
  catch err
    set cf_parsed to {}
  end
  set pub_at to ""
  if row.published_at is not nothing
    set pub_at to row.published_at
  end
  give back record {id: row.id, content_type_slug: row.content_type_slug, content_type_label: row.content_type_label, slug: row.slug, full_path: row.full_path, title: row.title, status: row.status, excerpt: (make_excerpt using row.body_html), custom_fields: cf_parsed, meta_title: row.meta_title, meta_description: row.meta_description, published_at: pub_at, created_at: row.created_at, updated_at: row.updated_at}
end

make compute_total_pages using total_items, per_page
  if total_items is at most 0
    give back 0
  end
  set pages to 0
  set rem to total_items
  while rem is greater than 0
    set rem to rem minus per_page
    set pages to pages plus 1
  end
  give back pages
end

make collect_term_filter_ids using stmts, term_taxonomy, term_slug, term_id, include_children
  if term_id is less than 1 and term_taxonomy is "" and term_slug is ""
    give back record {active: no, ids: []}
  end
  set root_term to nothing
  if term_id is greater than 0
    set root_term to data.one using stmts.get_term, record {lookup: "id", id: term_id, taxonomy_id: 0, slug: ""}
  otherwise
    if term_taxonomy is "" or term_slug is ""
      give back record {active: yes, ids: []}
    end
    set tax_row to data.one using stmts.get_taxonomy, record {lookup: "slug", iv: 0, sv: term_taxonomy}
    if tax_row is nothing
      give back record {active: yes, ids: []}
    end
    set root_term to data.one using stmts.get_term, record {lookup: "tax_slug", id: 0, taxonomy_id: tax_row.id, slug: term_slug}
  end
  if root_term is nothing
    give back record {active: yes, ids: []}
  end

  set out_ids to [root_term.id]
  if (not include_children) or (root_term.is_hierarchical is not 1)
    give back record {active: yes, ids: out_ids}
  end

  set all_terms to data.query using stmts.get_term, record {lookup: "tax", id: 0, taxonomy_id: root_term.taxonomy_id, slug: ""}
  set frontier to [root_term.id]
  set seen to collections.put using {}, (text.from using root_term.id), yes
  set depth to 0
  while depth is less than 8 and (collections.length using frontier) is greater than 0
    set next_frontier to []
    for each t in all_terms
      if t.parent_id is not nothing
        set pid_str to text.from using t.parent_id
        set tid_str to text.from using t.id
        set is_parent_in_frontier to no
        for each fid in frontier
          if (text.from using fid) is pid_str
            set is_parent_in_frontier to yes
          end
        end
        if is_parent_in_frontier and (not (has_map_key using seen, tid_str))
          set seen to collections.put using seen, tid_str, yes
          set out_ids to collections.append using out_ids, t.id
          set next_frontier to collections.append using next_frontier, t.id
        end
      end
    end
    set frontier to next_frontier
    set depth to depth plus 1
  end
  give back record {active: yes, ids: out_ids}
end

make matches_search_text using row, search_q
  if search_q is ""
    give back yes
  end
  set ql to text.lower using search_q
  if text.contains using (text.lower using row.title), ql
    give back yes
  end
  if text.contains using (text.lower using row.body_html), ql
    give back yes
  end
  if text.contains using (text.lower using row.slug), ql
    give back yes
  end
  give back no
end

make build_term_in_params using ids, filter_type, ct_id, filter_status, st_val, limit_rows, offset_rows
  set first_id to ids at 0
  set p_list to []
  set idx to 0
  set n_ids to collections.length using ids
  while idx is less than 16
    if idx is less than n_ids
      set p_list to collections.append using p_list, (ids at idx)
    otherwise
      set p_list to collections.append using p_list, first_id
    end
    set idx to idx plus 1
  end
  give back record {t0: (p_list at 0), t1: (p_list at 1), t2: (p_list at 2), t3: (p_list at 3), t4: (p_list at 4), t5: (p_list at 5), t6: (p_list at 6), t7: (p_list at 7), t8: (p_list at 8), t9: (p_list at 9), t10: (p_list at 10), t11: (p_list at 11), t12: (p_list at 12), t13: (p_list at 13), t14: (p_list at 14), t15: (p_list at 15), filter_type: filter_type, content_type_id: ct_id, filter_status: filter_status, status: st_val, limit_rows: limit_rows, offset_rows: offset_rows}
end

make query_entries using stmts, theme, registry, raw_map, is_public
  set norm_res to normalize_query_args using raw_map, is_public
  if not norm_res.ok
    give back record {ok: no, data: nothing, error: norm_res.error}
  end
  set args to applyFilter using registry, "query:modify_args", norm_res.args, {"theme_slug": theme.slug}

  set t_epoch to get_cache_epoch using stmts, "cache_epoch:theme"
  set g_epoch to get_cache_epoch using stmts, "cache_epoch:query"
  set ct_epoch to 1
  if args.content_type is not ""
    set ct_epoch to get_cache_epoch using stmts, ("cache_epoch:type:" joined with args.content_type)
  end
  set epoch_tag to (text.from using t_epoch) joined with ":" joined with (text.from using g_epoch) joined with ":" joined with (text.from using ct_epoch)
  set ic_flag to "0"
  if args.include_children
    set ic_flag to "1"
  end
  set cache_key to "query:" joined with epoch_tag joined with ":" joined with theme.slug joined with ":" joined with args.content_type joined with ":" joined with args.status joined with ":" joined with args.sort_by joined with ":" joined with args.sort_dir joined with ":" joined with (text.from using args.page) joined with ":" joined with (text.from using args.per_page) joined with ":" joined with args.field_key joined with ":" joined with args.field_op joined with ":" joined with args.field_value joined with ":t:" joined with args.term_taxonomy joined with ":" joined with args.term_slug joined with ":" joined with (text.from using args.term_id) joined with ":" joined with ic_flag joined with ":q:" joined with args.search

  set cached to cache.get using stmts.cms_cache, cache_key
  if cached.found
    set hit_data to cached.value
    give back record {ok: yes, data: (record {items: hit_data.items, pagination: hit_data.pagination, cache: (record {hit: yes, epoch: epoch_tag, key: cache_key})}), error: ""}
  end

  set filter_type to 0
  set ct_id to 0
  if args.content_type is not ""
    set ct_row to data.one using stmts.get_type, record {lookup: "slug", sv: args.content_type, iv: 0}
    if ct_row is nothing
      set empty_res to record {items: [], pagination: (record {page: args.page, per_page: args.per_page, total_items: 0, total_pages: 0, has_prev: no, has_next: no})}
      call cache.set using stmts.cms_cache, cache_key, empty_res, 120000
      give back record {ok: yes, data: (record {items: [], pagination: empty_res.pagination, cache: (record {hit: no, epoch: epoch_tag, key: cache_key})}), error: ""}
    end
    set filter_type to 1
    set ct_id to ct_row.id
  end

  set filter_status to 1
  set st_val to args.status
  if st_val is "all"
    set filter_status to 0
    set st_val to ""
  end

  set term_filter to collect_term_filter_ids using stmts, args.term_taxonomy, args.term_slug, args.term_id, args.include_children
  if term_filter.active and (collections.length using term_filter.ids) is 0
    set empty_res to record {items: [], pagination: (record {page: args.page, per_page: args.per_page, total_items: 0, total_pages: 0, has_prev: no, has_next: no})}
    call cache.set using stmts.cms_cache, cache_key, empty_res, 120000
    give back record {ok: yes, data: (record {items: [], pagination: empty_res.pagination, cache: (record {hit: no, epoch: epoch_tag, key: cache_key})}), error: ""}
  end

  set stmt to select_query_stmt using stmts, args.sort_by, args.sort_dir
  set items to []
  set total_items to 0

  if term_filter.active
    set tid_slice to collections.slice using term_filter.ids, 0, (math.min using 16, (collections.length using term_filter.ids))
    if args.field_key is "" and args.search is "" and (collections.length using term_filter.ids) is at most 16
      set tp_count to build_term_in_params using tid_slice, filter_type, ct_id, filter_status, st_val, 1, 0
      set cnt_row to data.one using stmts.count_entries_by_term, record {t0: tp_count.t0, t1: tp_count.t1, t2: tp_count.t2, t3: tp_count.t3, t4: tp_count.t4, t5: tp_count.t5, t6: tp_count.t6, t7: tp_count.t7, t8: tp_count.t8, t9: tp_count.t9, t10: tp_count.t10, t11: tp_count.t11, t12: tp_count.t12, t13: tp_count.t13, t14: tp_count.t14, t15: tp_count.t15, filter_type: filter_type, content_type_id: ct_id, filter_status: filter_status, status: st_val}
      if cnt_row is not nothing
        set total_items to cnt_row.total
      end
      set offset_val to (args.page minus 1) times args.per_page
      set rows to data.query using stmts.query_entries_by_term, (build_term_in_params using tid_slice, filter_type, ct_id, filter_status, st_val, args.per_page, offset_val)
      for each row in rows
        set items to collections.append using items, (format_query_item using row)
      end
    otherwise
      set all_trows to data.query using stmts.query_entries_by_term, (build_term_in_params using tid_slice, filter_type, ct_id, filter_status, st_val, 5000, 0)
      set matched to []
      for each row in all_trows
        if (matches_custom_field_filter using row.custom_fields_json, args.field_key, args.field_op, args.field_value) and (matches_search_text using row, args.search)
          set matched to collections.append using matched, (format_query_item using row)
        end
      end
      set total_items to collections.length using matched
      set start_idx to (args.page minus 1) times args.per_page
      if start_idx is less than total_items
        set end_idx to start_idx plus args.per_page
        if end_idx is greater than total_items
          set end_idx to total_items
        end
        set items to collections.slice using matched, start_idx, end_idx
      end
    end
  otherwise
    if args.field_key is "" and args.search is ""
      set cnt_row to data.one using stmts.count_entries_filtered, record {filter_type: filter_type, content_type_id: ct_id, filter_status: filter_status, status: st_val}
      if cnt_row is not nothing
        set total_items to cnt_row.total
      end
      set offset_val to (args.page minus 1) times args.per_page
      set rows to data.query using stmt, record {filter_type: filter_type, content_type_id: ct_id, filter_status: filter_status, status: st_val, sort_by: args.sort_by, limit_rows: args.per_page, offset_rows: offset_val}
      for each row in rows
        set items to collections.append using items, (format_query_item using row)
      end
    otherwise
      set all_rows to data.query using stmt, record {filter_type: filter_type, content_type_id: ct_id, filter_status: filter_status, status: st_val, sort_by: args.sort_by, limit_rows: 5000, offset_rows: 0}
      set matched to []
      for each row in all_rows
        if (matches_custom_field_filter using row.custom_fields_json, args.field_key, args.field_op, args.field_value) and (matches_search_text using row, args.search)
          set matched to collections.append using matched, (format_query_item using row)
        end
      end
      set total_items to collections.length using matched
      set start_idx to (args.page minus 1) times args.per_page
      if start_idx is less than total_items
        set end_idx to start_idx plus args.per_page
        if end_idx is greater than total_items
          set end_idx to total_items
        end
        set items to collections.slice using matched, start_idx, end_idx
      end
    end
  end

  set total_pages to compute_total_pages using total_items, args.per_page
  set has_prev to (args.page is greater than 1) and (total_pages is greater than 0)
  set has_next to (args.page is less than total_pages)
  set pagination to record {page: args.page, per_page: args.per_page, total_items: total_items, total_pages: total_pages, has_prev: has_prev, has_next: has_next}
  set to_cache to record {items: items, pagination: pagination}
  call cache.set using stmts.cms_cache, cache_key, to_cache, 120000
  give back record {ok: yes, data: (record {items: items, pagination: pagination, cache: (record {hit: no, epoch: epoch_tag, key: cache_key})}), error: ""}
end

# ==============================================================================
# Module 6: Reusable Template Parts & Grex Visual Theme Renderer
# ==============================================================================

make load_visual_grex_doc using stmts, theme
  set ckey to "grex_doc:" joined with theme.slug
  set cached to cache.get using stmts.cms_cache, ckey
  if cached.found
    give back cached.value
  end
  set path to "themes/" joined with theme.slug joined with "/" joined with theme.grexElements
  set doc to {}
  try
    set raw to files.read_text using path
    set doc to json.parse using raw
  catch err
    set doc to {}
  end
  call cache.set using stmts.cms_cache, ckey, doc, 300000
  give back doc
end

make resolve_grex_bind_text using raw_text, ctx
  set out to text.from using raw_text
  set keys to collections.keys using ctx
  for each k in keys
    set token to "{" joined with k joined with "}"
    if text.contains using out, token
      set val_str to text.from using (ctx at k)
      set out to text.replace using out, token, val_str
    end
  end
  give back out
end

make default_tag_for_grex_element using el_name, props
  if el_name is "Fragment" or el_name is "TemplatePart"
    give back ""
  end
  if el_name is "Section"
    give back "section"
  end
  if el_name is "Container" or el_name is "Stack" or el_name is "Grid"
    give back "section"
  end
  if el_name is "Card"
    give back "article"
  end
  if el_name is "Nav"
    give back "nav"
  end
  if el_name is "Heading"
    set lvl to "2"
    if has_map_key using props, "level"
      set lval to text.from using (props at "level")
      if lval is "1" or lval is "2" or lval is "3" or lval is "4" or lval is "5" or lval is "6"
        set lvl to lval
      end
    end
    give back "h" joined with lvl
  end
  if el_name is "Text" or el_name is "RichText"
    give back "p"
  end
  if el_name is "Link"
    give back "a"
  end
  if el_name is "Button"
    give back "button"
  end
  if el_name is "Image"
    give back "img"
  end
  if el_name is "ForEach"
    give back "section"
  end
  give back "section"
end

make render_grex_node using stmts, theme, registry, node, ctx, depth
  if depth is greater than 24
    give back ""
  end
  set el_name to resolve_grex_element_name using node
  set props to {}
  if node has "props"
    set props to node at "props"
  end

  if el_name is "Nav"
    if has_map_key using props, "location"
      set nav_loc to text.from using (props at "location")
      set cur_p to "/"
      if has_map_key using ctx, "current_path"
        set cur_p to text.from using (ctx at "current_path")
      end
      give back render_menu using stmts, nav_loc, cur_p
    end
  end

  if el_name is "TemplatePart"
    set pname to ""
    if has_map_key using props, "name"
      set pname to text.from using (props at "name")
    end
    if pname is ""
      give back ""
    end
    give back render_part using stmts, theme, registry, pname, ctx
  end

  if el_name is "ForEach"
    set qargs to {}
    if has_map_key using props, "query"
      set qargs to props at "query"
    end
    set qres to query_entries using stmts, theme, registry, qargs, yes
    if not qres.ok
      give back ""
    end
    set out_items to ""
    for each item in qres.data.items
      set item_ctx to collections.put using ctx, "title", item.title
      set item_ctx to collections.put using item_ctx, "full_path", item.full_path
      set item_ctx to collections.put using item_ctx, "content_type_label", item.content_type_label
      set item_ctx to collections.put using item_ctx, "published_at", item.published_at
      set item_ctx to collections.put using item_ctx, "excerpt", item.excerpt
      if node has "children"
        for each ch in (node at "children")
          set out_items to out_items joined with (render_grex_node using stmts, theme, registry, ch, item_ctx, (depth plus 1))
        end
      otherwise
        set out_items to out_items joined with (render_part using stmts, theme, registry, "card", item_ctx)
      end
    end
    set cls_attr to ""
    if has_map_key using props, "class"
      set cls_attr to " class=\"" joined with (escape_html using (text.from using (props at "class"))) joined with "\""
    end
    set q_json to escape_html using (json.stringify using qargs)
    give back "<section" joined with cls_attr joined with " data-grex-foreach=\"query\" data-grex-query=\"" joined with q_json joined with "\">" joined with out_items joined with "</section>"
  end

  set tag to default_tag_for_grex_element using el_name, props
  if node has "tag"
    set req_tag to text.lower using (text.from using (node at "tag"))
    if is_allowed_grex_tag using req_tag
      set tag to req_tag
    end
  end

  set inner to ""
  if has_map_key using props, "text"
    set bound_txt to resolve_grex_bind_text using (text.from using (props at "text")), ctx
    set inner to escape_html using bound_txt
  end
  if node has "children"
    for each ch in (node at "children")
      set inner to inner joined with (render_grex_node using stmts, theme, registry, ch, ctx, (depth plus 1))
    end
  end

  if tag is ""
    give back inner
  end

  set attrs to ""
  if has_map_key using props, "class"
    set attrs to attrs joined with " class=\"" joined with (escape_html using (text.from using (props at "class"))) joined with "\""
  end
  if has_map_key using props, "id"
    set attrs to attrs joined with " data-grex-id=\"" joined with (escape_html using (text.from using (props at "id"))) joined with "\""
  end
  if has_map_key using props, "href"
    set href_val to resolve_grex_bind_text using (text.from using (props at "href")), ctx
    if is_safe_url using href_val
      set attrs to attrs joined with " href=\"" joined with (escape_html using href_val) joined with "\""
    end
  end
  if has_map_key using props, "src"
    set src_val to resolve_grex_bind_text using (text.from using (props at "src")), ctx
    if is_safe_url using src_val
      set attrs to attrs joined with " src=\"" joined with (escape_html using src_val) joined with "\""
    end
  end
  if has_map_key using props, "alt"
    set alt_val to resolve_grex_bind_text using (text.from using (props at "alt")), ctx
    set attrs to attrs joined with " alt=\"" joined with (escape_html using alt_val) joined with "\""
  end
  if has_map_key using props, "aria-label"
    set aria_val to resolve_grex_bind_text using (text.from using (props at "aria-label")), ctx
    set attrs to attrs joined with " aria-label=\"" joined with (escape_html using aria_val) joined with "\""
  end

  if tag is "img"
    give back "<img" joined with attrs joined with ">"
  end
  give back "<" joined with tag joined with attrs joined with ">" joined with inner joined with "</" joined with tag joined with ">"
end

make render_part using stmts, theme, registry, part_name, ctx
  if theme.mode is "visual"
    set gdoc to load_visual_grex_doc using stmts, theme
    if gdoc has "parts"
      set gparts to gdoc at "parts"
      if has_map_key using gparts, part_name
        set pnode to gparts at part_name
        if pnode is not nothing
          give back render_grex_node using stmts, theme, registry, pnode, ctx, 0
        end
      end
    end
    give back ""
  end

  if not (has_map_key using theme.parts, part_name)
    give back ""
  end
  set part_rel_raw to theme.parts at part_name
  if part_rel_raw is nothing
    give back ""
  end
  set part_rel to text.from using part_rel_raw
  if part_rel is ""
    give back ""
  end
  set tmpl_path to "../themes/" joined with theme.slug joined with "/" joined with part_rel
  set rendered to server.html using tmpl_path, ctx, 200
  give back rendered.body
end

make render_query_cards using stmts, theme, registry, items, base_ctx
  set out to ""
  for each item in items
    set item_ctx to collections.put using base_ctx, "title", item.title
    set item_ctx to collections.put using item_ctx, "full_path", item.full_path
    set item_ctx to collections.put using item_ctx, "content_type_label", item.content_type_label
    set item_ctx to collections.put using item_ctx, "published_at", item.published_at
    set item_ctx to collections.put using item_ctx, "excerpt", item.excerpt
    set out to out joined with (render_part using stmts, theme, registry, "card", item_ctx)
  end
  give back out
end

make render_theme_page using stmts, slot_name, page_data, status, query_items
  set theme to get_active_theme_context using stmts
  set settings to get_site_settings_map using stmts
  set registry to build_active_hook_registry using theme

  set tokens_css_url to safe_asset_url using "/static/grex/tokens.css"
  set theme_css_url to safe_asset_url using ("/static/themes/" joined with theme.slug joined with "/theme.css")
  set grex_js_url to safe_asset_url using "/static/grex/grex.js"

  set merged to collections.put using page_data, "site_title", (settings at "site_title")
  set merged to collections.put using merged, "site_tagline", (settings at "site_tagline")
  set merged to collections.put using merged, "theme_name", theme.name
  set merged to collections.put using merged, "theme_slug", theme.slug
  set merged to collections.put using merged, "tokens_css_url", tokens_css_url
  set merged to collections.put using merged, "theme_css_url", theme_css_url
  if not (has_map_key using merged, "published_count")
    set merged to collections.put using merged, "published_count", "0"
  end

  call runHook using stmts, registry, "theme:before_render", {"slot": slot_name, "theme_slug": theme.slug}

  set meta_title to settings at "site_title"
  if has_map_key using merged, "page_title"
    set meta_title to text.from using (merged at "page_title")
  end
  if has_map_key using merged, "meta_title"
    set meta_title to text.from using (merged at "meta_title")
  end
  set canon_path to "/"
  if has_map_key using merged, "current_path"
    set canon_path to text.from using (merged at "current_path")
  otherwise
    if has_map_key using merged, "full_path"
      set canon_path to text.from using (merged at "full_path")
    end
    if has_map_key using merged, "archive_slug"
      set canon_path to "/" joined with (text.from using (merged at "archive_slug"))
    end
    set merged to collections.put using merged, "current_path", canon_path
  end
  set head_tags to applyFilter using registry, "theme:head_meta", [], {"theme_slug": theme.slug, "theme_name": theme.name, "page_title": meta_title, "canonical_path": canon_path}
  set head_meta_html to text.join using head_tags, "\n  "
  if (has_map_key using merged, "_head_json_ld") and ((merged at "_head_json_ld") is not "")
    set head_meta_html to head_meta_html joined with "\n  <script type=\"application/ld+json\">" joined with (merged at "_head_json_ld") joined with "</script>"
  end

  if theme.mode is "visual"
    set gdoc to load_visual_grex_doc using stmts, theme
    set tmpls to gdoc at "templates"
    set slot_node to tmpls at slot_name
    set body_inner to render_grex_node using stmts, theme, registry, slot_node, merged, 0
    set css_links to "<link rel=\"stylesheet\" href=\"" joined with (escape_html using tokens_css_url) joined with "\">"
    if theme_css_url is not ""
      set css_links to css_links joined with "\n  <link rel=\"stylesheet\" href=\"" joined with (escape_html using theme_css_url) joined with "\">"
    end
    set grex_script to ""
    if grex_js_url is not ""
      set grex_script to "\n  <script defer src=\"" joined with (escape_html using grex_js_url) joined with "\"></script>"
    end
    set doc_html to "<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>" joined with (escape_html using meta_title) joined with " — " joined with (escape_html using (settings at "site_title")) joined with "</title>\n  " joined with css_links joined with "\n  " joined with head_meta_html joined with grex_script joined with "\n</head>\n<body>\n" joined with body_inner joined with "\n</body>\n</html>\n"
    give back server.response using record {status: status, headers: {"Content-Type": "text/html; charset=utf-8"}, body: doc_html}
  end

  set tmpl_rel to "templates/" joined with slot_name joined with ".grab.html"
  if has_map_key using theme.templates, slot_name
    set tmpl_rel to text.from using (theme.templates at slot_name)
  end
  set tmpl_path to "../themes/" joined with theme.slug joined with "/" joined with tmpl_rel

  set base_resp to server.html using tmpl_path, merged, status
  set html_out to base_resp.body

  if text.contains using html_out, "<!-- @hook:theme_head_meta -->"
    set html_out to text.replace using html_out, "<!-- @hook:theme_head_meta -->", head_meta_html
  end
  if text.contains using html_out, "<!-- @part:header -->"
    set header_html to render_part using stmts, theme, registry, "header", merged
    set html_out to text.replace using html_out, "<!-- @part:header -->", header_html
  end
  if text.contains using html_out, "<!-- @part:footer -->"
    set footer_html to render_part using stmts, theme, registry, "footer", merged
    set html_out to text.replace using html_out, "<!-- @part:footer -->", footer_html
  end
  if text.contains using html_out, "<!-- @part:sidebar -->"
    set sidebar_html to render_part using stmts, theme, registry, "sidebar", merged
    set html_out to text.replace using html_out, "<!-- @part:sidebar -->", sidebar_html
  end
  if text.contains using html_out, "<!-- @part:query_cards -->"
    set cards_html to render_query_cards using stmts, theme, registry, query_items, merged
    set html_out to text.replace using html_out, "<!-- @part:query_cards -->", cards_html
  end
  if text.contains using html_out, "<!-- @menu:primary -->"
    set nav_primary to render_menu using stmts, "primary", canon_path
    set html_out to text.replace using html_out, "<!-- @menu:primary -->", nav_primary
  end
  if text.contains using html_out, "<!-- @menu:footer -->"
    set nav_footer to render_menu using stmts, "footer", canon_path
    set html_out to text.replace using html_out, "<!-- @menu:footer -->", nav_footer
  end
  if text.contains using html_out, "<!-- @menu:mobile -->"
    set nav_mobile to render_menu using stmts, "mobile", canon_path
    set html_out to text.replace using html_out, "<!-- @menu:mobile -->", nav_mobile
  end
  if (has_map_key using merged, "_slot_catalog_html") and (text.contains using html_out, "<!-- @slot:catalog_html -->")
    set html_out to text.replace using html_out, "<!-- @slot:catalog_html -->", (text.from using (merged at "_slot_catalog_html"))
  end
  if (has_map_key using merged, "_slot_books_catalog_html") and (text.contains using html_out, "<!-- @slot:books_catalog_html -->")
    set html_out to text.replace using html_out, "<!-- @slot:books_catalog_html -->", (text.from using (merged at "_slot_books_catalog_html"))
  end
  if (has_map_key using merged, "_slot_book_series_html") and (text.contains using html_out, "<!-- @slot:book_series_html -->")
    set html_out to text.replace using html_out, "<!-- @slot:book_series_html -->", (text.from using (merged at "_slot_book_series_html"))
  end
  if (has_map_key using merged, "_slot_book_commerce_html") and (text.contains using html_out, "<!-- @slot:book_commerce_html -->")
    set html_out to text.replace using html_out, "<!-- @slot:book_commerce_html -->", (text.from using (merged at "_slot_book_commerce_html"))
  end
  if (has_map_key using merged, "_slot_book_samples_html") and (text.contains using html_out, "<!-- @slot:book_samples_html -->")
    set html_out to text.replace using html_out, "<!-- @slot:book_samples_html -->", (text.from using (merged at "_slot_book_samples_html"))
  end
  if (has_map_key using merged, "_slot_series_books_html") and (text.contains using html_out, "<!-- @slot:series_books_html -->")
    set html_out to text.replace using html_out, "<!-- @slot:series_books_html -->", (text.from using (merged at "_slot_series_books_html"))
  end

  give back server.response using record {status: status, headers: {"Content-Type": "text/html; charset=utf-8"}, body: html_out}
end

# ==============================================================================
# Module 8: Media Library, Base64/Magic-Byte Sniffing & Raster Dimension Parser
# ==============================================================================

make get_upload_dir
  set dir_val to "uploads"
  try
    if env.has using "GRABLAB_UPLOAD_DIR"
      set raw to text.trim using (env.get using "GRABLAB_UPLOAD_DIR")
      if raw is not ""
        set dir_val to raw
      end
    end
  catch err
    set dir_val to "uploads"
  end
  if (text.contains using dir_val, "..") or (text.contains using (json.stringify using dir_val), "\\u000")
    give back ""
  end
  while (text.length using dir_val) is greater than 1 and (text.ends_with using dir_val, "/")
    set chars to text.split using dir_val, ""
    set dir_val to text.join using (collections.slice using chars, 0, ((collections.length using chars) minus 1)), ""
  end
  give back dir_val
end

make get_max_upload_bytes
  set max_b to 10485760
  try
    if env.has using "GRABLAB_MAX_UPLOAD_BYTES"
      set raw to text.trim using (env.get using "GRABLAB_MAX_UPLOAD_BYTES")
      if raw is not ""
        set parsed to text.to_integer using raw
        if parsed is greater than 0
          set max_b to parsed
        end
      end
    end
  catch err
    set max_b to 10485760
  end
  give back max_b
end

make build_b64_lookup
  set alpha to "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
  set chars to text.split using alpha, ""
  set tbl to {}
  set idx to 0
  for each ch in chars
    set tbl to collections.put using tbl, ch, idx
    set idx to idx plus 1
  end
  give back tbl
end

make ascii_char_code using c
  set table to " !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~"
  set chars to text.split using table, ""
  set code to 32
  for each item in chars
    if item is c
      give back code
    end
    set code to code plus 1
  end
  give back 0
end

make strip_data_uri_and_ws using raw_b64
  set s to text.trim using raw_b64
  if text.starts_with using (text.lower using s), "data:"
    set parts to text.split using s, ","
    if (collections.length using parts) is at least 2
      set s to parts at 1
    end
  end
  set s to text.replace using s, "\r", ""
  set s to text.replace using s, "\n", ""
  set s to text.replace using s, " ", ""
  set s to text.replace using s, "\t", ""
  give back s
end

make validate_and_decode_b64_prefix using clean_b64, max_decode_bytes
  set b64_tbl to call build_b64_lookup
  set n to text.length using clean_b64
  if n is less than 4 or ((n modulo 4) is not 0)
    give back record {ok: no, byte_size: 0, bytes: [], error: "Invalid base64 payload length"}
  end
  set chars to text.split using clean_b64, ""
  set pad to 0
  if (chars at (n minus 1)) is "="
    set pad to pad plus 1
  end
  if (chars at (n minus 2)) is "="
    set pad to pad plus 1
  end
  set byte_size to ((math.floor using (n divided by 4)) times 3) minus pad
  if byte_size is at most 0
    give back record {ok: no, byte_size: 0, bytes: [], error: "Empty media payload"}
  end

  set max_chars to ((math.floor using (max_decode_bytes divided by 3)) plus 1) times 4
  if max_chars is greater than n
    set max_chars to n
  end
  set out_bytes to []
  set i to 0
  while i is less than max_chars
    set c0 to chars at i
    set c1 to chars at (i plus 1)
    set c2 to chars at (i plus 2)
    set c3 to chars at (i plus 3)
    if (not (has_map_key using b64_tbl, c0)) or (not (has_map_key using b64_tbl, c1))
      give back record {ok: no, byte_size: 0, bytes: [], error: "Invalid base64 character in payload"}
    end
    set v0 to b64_tbl at c0
    set v1 to b64_tbl at c1
    set b0 to (v0 times 4) plus (math.floor using (v1 divided by 16))
    set out_bytes to collections.append using out_bytes, b0
    if c2 is not "="
      if not (has_map_key using b64_tbl, c2)
        give back record {ok: no, byte_size: 0, bytes: [], error: "Invalid base64 character in payload"}
      end
      set v2 to b64_tbl at c2
      set b1 to ((v1 modulo 16) times 16) plus (math.floor using (v2 divided by 4))
      set out_bytes to collections.append using out_bytes, b1
      if c3 is not "="
        if not (has_map_key using b64_tbl, c3)
          give back record {ok: no, byte_size: 0, bytes: [], error: "Invalid base64 character in payload"}
        end
        set v3 to b64_tbl at c3
        set b2 to ((v2 modulo 4) times 64) plus v3
        set out_bytes to collections.append using out_bytes, b2
      end
    end
    set i to i plus 4
  end
  give back record {ok: yes, byte_size: byte_size, bytes: out_bytes, error: ""}
end

make bytes_prefix_to_ascii_lower using b_list, max_len
  set ascii_tbl to " !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~"
  set ascii_chars to text.split using ascii_tbl, ""
  set lim to math.min using max_len, (collections.length using b_list)
  set out_chars to []
  set idx to 0
  while idx is less than lim
    set code to b_list at idx
    if code is at least 32 and code is at most 126
      set out_chars to collections.append using out_chars, (ascii_chars at (code minus 32))
    otherwise
      set out_chars to collections.append using out_chars, " "
    end
    set idx to idx plus 1
  end
  give back text.lower using (text.join using out_chars, "")
end

make read_u16_be using b_list, off
  give back ((b_list at off) times 256) plus (b_list at (off plus 1))
end

make read_u16_le using b_list, off
  give back (b_list at off) plus ((b_list at (off plus 1)) times 256)
end

make read_u32_be using b_list, off
  give back ((b_list at off) times 16777216) plus ((b_list at (off plus 1)) times 65536) plus ((b_list at (off plus 2)) times 256) plus (b_list at (off plus 3))
end

make sniff_media_magic using b_list
  set n to collections.length using b_list
  if n is less than 4
    give back record {ok: no, mime: "", ext: "", error: "Unsupported or unrecognized file signature"}
  end
  set ascii_head to bytes_prefix_to_ascii_lower using b_list, 512
  if (text.contains using ascii_head, "<svg") or (text.contains using ascii_head, "<?xml") or (text.contains using ascii_head, "<html") or (text.contains using ascii_head, "<!doctype") or (text.contains using ascii_head, "<script") or (text.contains using ascii_head, "<iframe")
    give back record {ok: no, mime: "", ext: "", error: "SVG, HTML, XML, and active script payloads are blocked"}
  end
  if (b_list at 0) is 77 and (b_list at 1) is 90
    give back record {ok: no, mime: "", ext: "", error: "Executable payloads are blocked"}
  end
  if (b_list at 0) is 127 and (b_list at 1) is 69 and (b_list at 2) is 76 and (b_list at 3) is 70
    give back record {ok: no, mime: "", ext: "", error: "ELF executable payloads are blocked"}
  end
  if (b_list at 0) is 35 and (b_list at 1) is 33
    give back record {ok: no, mime: "", ext: "", error: "Shell script payloads are blocked"}
  end
  if n is at least 8 and (b_list at 0) is 137 and (b_list at 1) is 80 and (b_list at 2) is 78 and (b_list at 3) is 71 and (b_list at 4) is 13 and (b_list at 5) is 10 and (b_list at 6) is 26 and (b_list at 7) is 10
    give back record {ok: yes, mime: "image/png", ext: "png", error: ""}
  end
  if n is at least 3 and (b_list at 0) is 255 and (b_list at 1) is 216 and (b_list at 2) is 255
    give back record {ok: yes, mime: "image/jpeg", ext: "jpg", error: ""}
  end
  if n is at least 6 and (b_list at 0) is 71 and (b_list at 1) is 73 and (b_list at 2) is 70 and (b_list at 3) is 56 and ((b_list at 4) is 55 or (b_list at 4) is 57) and (b_list at 5) is 97
    give back record {ok: yes, mime: "image/gif", ext: "gif", error: ""}
  end
  if n is at least 12 and (b_list at 0) is 82 and (b_list at 1) is 73 and (b_list at 2) is 70 and (b_list at 3) is 70 and (b_list at 8) is 87 and (b_list at 9) is 69 and (b_list at 10) is 66 and (b_list at 11) is 80
    give back record {ok: yes, mime: "image/webp", ext: "webp", error: ""}
  end
  if n is at least 5 and (b_list at 0) is 37 and (b_list at 1) is 80 and (b_list at 2) is 68 and (b_list at 3) is 70 and (b_list at 4) is 45
    give back record {ok: yes, mime: "application/pdf", ext: "pdf", error: ""}
  end
  give back record {ok: no, mime: "", ext: "", error: "Unsupported media type signature"}
end

make parse_raster_dimensions using mime, b_list
  set n to collections.length using b_list
  if mime is "application/pdf"
    give back record {ok: yes, width: nothing, height: nothing, error: ""}
  end
  if mime is "image/png"
    if n is less than 24 or (b_list at 12) is not 73 or (b_list at 13) is not 72 or (b_list at 14) is not 68 or (b_list at 15) is not 82
      give back record {ok: no, width: nothing, height: nothing, error: "Corrupt or truncated PNG header"}
    end
    set w to read_u32_be using b_list, 16
    set h to read_u32_be using b_list, 20
    if w is less than 1 or h is less than 1 or w is greater than 65535 or h is greater than 65535
      give back record {ok: no, width: nothing, height: nothing, error: "Invalid PNG dimensions"}
    end
    give back record {ok: yes, width: w, height: h, error: ""}
  end
  if mime is "image/gif"
    if n is less than 10
      give back record {ok: no, width: nothing, height: nothing, error: "Corrupt or truncated GIF header"}
    end
    set w to read_u16_le using b_list, 6
    set h to read_u16_le using b_list, 8
    if w is less than 1 or h is less than 1
      give back record {ok: no, width: nothing, height: nothing, error: "Invalid GIF dimensions"}
    end
    give back record {ok: yes, width: w, height: h, error: ""}
  end
  if mime is "image/webp"
    if n is less than 30
      give back record {ok: no, width: nothing, height: nothing, error: "Corrupt or truncated WebP header"}
    end
    if (b_list at 12) is 86 and (b_list at 13) is 80 and (b_list at 14) is 56 and (b_list at 15) is 32
      if (b_list at 23) is not 157 or (b_list at 24) is not 1 or (b_list at 25) is not 42
        give back record {ok: no, width: nothing, height: nothing, error: "Corrupt WebP VP8 frame"}
      end
      set w to (read_u16_le using b_list, 26) modulo 16384
      set h to (read_u16_le using b_list, 28) modulo 16384
      give back record {ok: yes, width: w, height: h, error: ""}
    end
    if (b_list at 12) is 86 and (b_list at 13) is 80 and (b_list at 14) is 56 and (b_list at 15) is 76
      if (b_list at 20) is not 47
        give back record {ok: no, width: nothing, height: nothing, error: "Corrupt WebP VP8L header"}
      end
      set v0 to b_list at 21
      set v1 to b_list at 22
      set v2 to b_list at 23
      set v3 to b_list at 24
      set w to ((v0 plus ((v1 modulo 64) times 256)) plus 1)
      set h to ((math.floor using (v1 divided by 64)) plus (v2 times 4) plus ((v3 modulo 16) times 1024) plus 1)
      give back record {ok: yes, width: w, height: h, error: ""}
    end
    if (b_list at 12) is 86 and (b_list at 13) is 80 and (b_list at 14) is 56 and (b_list at 15) is 88
      set w to (b_list at 24) plus ((b_list at 25) times 256) plus ((b_list at 26) times 65536) plus 1
      set h to (b_list at 27) plus ((b_list at 28) times 256) plus ((b_list at 29) times 65536) plus 1
      give back record {ok: yes, width: w, height: h, error: ""}
    end
    give back record {ok: no, width: nothing, height: nothing, error: "Unsupported or corrupt WebP chunk"}
  end
  if mime is "image/jpeg"
    set pos to 2
    while (pos plus 1) is less than n
      if (b_list at pos) is not 255
        give back record {ok: no, width: nothing, height: nothing, error: "Corrupt JPEG marker stream"}
      end
      while (pos plus 1) is less than n and (b_list at pos) is 255
        set pos to pos plus 1
      end
      set marker to b_list at pos
      set pos to pos plus 1
      if marker is 217 or marker is 218
        give back record {ok: no, width: nothing, height: nothing, error: "Truncated JPEG before SOF dimensions"}
      end
      set is_sof to (marker is 192 or marker is 193 or marker is 194 or marker is 195 or marker is 197 or marker is 198 or marker is 199 or marker is 201 or marker is 202 or marker is 203 or marker is 205 or marker is 206 or marker is 207)
      if is_sof
        if (pos plus 7) is greater than n
          give back record {ok: no, width: nothing, height: nothing, error: "Truncated JPEG SOF frame"}
        end
        set h to read_u16_be using b_list, (pos plus 3)
        set w to read_u16_be using b_list, (pos plus 5)
        if w is less than 1 or h is less than 1
          give back record {ok: no, width: nothing, height: nothing, error: "Invalid JPEG dimensions"}
        end
        give back record {ok: yes, width: w, height: h, error: ""}
      end
      if marker is not 0 and (not (marker is at least 208 and marker is at most 215)) and marker is not 1
        if (pos plus 2) is greater than n
          give back record {ok: no, width: nothing, height: nothing, error: "Truncated JPEG segment"}
        end
        set seg_len to read_u16_be using b_list, pos
        if seg_len is less than 2
          give back record {ok: no, width: nothing, height: nothing, error: "Invalid JPEG segment length"}
        end
        set pos to pos plus seg_len
      end
    end
    give back record {ok: no, width: nothing, height: nothing, error: "Truncated JPEG without dimensions"}
  end
  give back record {ok: no, width: nothing, height: nothing, error: "Unsupported media format"}
end

make sanitize_media_filename using raw_name
  set name to text.trim using raw_name
  if name is ""
    give back record {ok: no, name: "", ext: "", error: "Filename is required"}
  end
  if (text.contains using name, "..") or (text.contains using name, "/") or (text.contains using name, "\\") or (text.contains using (json.stringify using name), "\\u000") or (text.contains using (text.lower using name), "%00")
    give back record {ok: no, name: "", ext: "", error: "Invalid filename: path separators and traversal segments are forbidden"}
  end
  set trimmed to text_truncate using name, 255
  set ext to ""
  set parts to text.split using trimmed, "."
  if (collections.length using parts) is at least 2
    set ext to text.lower using (text.trim using (parts at ((collections.length using parts) minus 1)))
  end
  give back record {ok: yes, name: trimmed, ext: ext, error: ""}
end

make ext_matches_mime using ext, sniffed_mime
  if ext is ""
    give back yes
  end
  if sniffed_mime is "image/png"
    give back ext is "png"
  end
  if sniffed_mime is "image/jpeg"
    give back (ext is "jpg" or ext is "jpeg")
  end
  if sniffed_mime is "image/webp"
    give back ext is "webp"
  end
  if sniffed_mime is "image/gif"
    give back ext is "gif"
  end
  if sniffed_mime is "application/pdf"
    give back ext is "pdf"
  end
  give back no
end

make declared_mime_matches using declared, sniffed_mime
  set d to text.lower using (text.trim using declared)
  if d is "" or d is "application/octet-stream"
    give back yes
  end
  if d is sniffed_mime
    give back yes
  end
  if (d is "image/jpg") and (sniffed_mime is "image/jpeg")
    give back yes
  end
  give back no
end

make format_media_record using row
  set dec_flag to (row.is_decorative is 1)
  give back record {id: row.id, filename: row.filename, original_name: row.original_name, url: ("/media/" joined with (text.from using row.id) joined with "/" joined with row.filename), mime_type: row.mime_type, byte_size: row.byte_size, width: row.width, height: row.height, alt_text: row.alt_text, is_decorative: dec_flag, caption: row.caption, sha256_hex: row.sha256_hex, uploader_id: row.uploader_id, created_at: row.created_at, updated_at: row.updated_at}
end

# ==============================================================================
# Module 9: Navigation Menus, Validation & Semantic Grex Rendering
# ==============================================================================

make is_valid_menu_location using loc
  give back (loc is "" or loc is "primary" or loc is "footer" or loc is "mobile")
end

make is_valid_external_menu_url using raw_url
  set u to text.trim using raw_url
  if u is "" or (text.contains using u, "\r") or (text.contains using u, "\n") or (text.contains using (json.stringify using u), "\\u000") or (text.contains using u, " ") or (text.contains using u, "\\")
    give back no
  end
  if u is "/" or u is "/blog"
    give back yes
  end
  set low to text.lower using u
  if (text.starts_with using low, "https://") or (text.starts_with using low, "http://")
    give back (text.length using u) is greater than 8
  end
  give back no
end

make resolve_menu_item_url using item, include_unpublished
  if item.link_type is "external"
    if item.external_url is nothing
      give back ""
    end
    set eu to text.trim using item.external_url
    if is_valid_external_menu_url using eu
      give back eu
    end
    give back ""
  end
  if item.link_type is "entry"
    if item.entry_full_path is nothing
      give back ""
    end
    if (not include_unpublished) and (item.entry_status is not "published")
      give back ""
    end
    give back item.entry_full_path
  end
  give back ""
end

make build_menu_children using rows, parent_id_val, depth, include_unpublished
  if depth is greater than 4
    give back []
  end
  set out to []
  for each item in rows
    set match_parent to no
    if parent_id_val is nothing
      if item.parent_id is nothing
        set match_parent to yes
      end
    otherwise
      if item.parent_id is not nothing and item.parent_id is parent_id_val
        set match_parent to yes
      end
    end
    if match_parent
      set resolved_url to resolve_menu_item_url using item, include_unpublished
      if resolved_url is not "" or include_unpublished
        set kids to build_menu_children using rows, item.id, (depth plus 1), include_unpublished
        set out to collections.append using out, record {id: item.id, parent_id: item.parent_id, label: item.label, link_type: item.link_type, entry_id: item.entry_id, external_url: item.external_url, url: resolved_url, target_blank: (item.target_blank is 1), css_class: item.css_class, sort_order: item.sort_order, children: kids}
      end
    end
  end
  give back out
end

make get_menu_tree using stmts, location, include_unpublished
  if location is "" or (not (is_valid_menu_location using location))
    give back nothing
  end
  set ckey to "menu:loc:" joined with location
  if not include_unpublished
    set cached to cache.get using stmts.cms_cache, ckey
    if cached.found
      give back cached.value
    end
  end
  set menu_row to data.one using stmts.get_menu, record {lookup: "location", iv: 0, sv: location}
  if menu_row is nothing
    give back nothing
  end
  set rows to data.query using stmts.list_menu_items_by_menu, record {menu_id: menu_row.id}
  set items_tree to build_menu_children using rows, nothing, 1, include_unpublished
  set tree_obj to record {id: menu_row.id, slug: menu_row.slug, name: menu_row.name, location: menu_row.location, items: items_tree}
  if not include_unpublished
    call cache.set using stmts.cms_cache, ckey, tree_obj, 120000
  end
  give back tree_obj
end

make render_menu_ul using nodes, current_path, depth
  if (collections.length using nodes) is 0 or depth is greater than 4
    give back ""
  end
  set cur_norm to normalize_path using current_path
  set li_parts to []
  for each node in nodes
    set href_safe to "#"
    if node.url is not ""
      set href_safe to node.url
    end
    set a_attrs to "href=\"" joined with (escape_html using href_safe) joined with "\""
    if (normalize_path using href_safe) is cur_norm
      set a_attrs to a_attrs joined with " aria-current=\"page\""
    end
    if node.target_blank
      set a_attrs to a_attrs joined with " target=\"_blank\" rel=\"noopener noreferrer\""
    end
    if node.css_class is not ""
      set a_attrs to a_attrs joined with " class=\"" joined with (escape_html using node.css_class) joined with "\""
    end
    set sub_ul to render_menu_ul using node.children, cur_norm, (depth plus 1)
    set li_html to "<li><a " joined with a_attrs joined with ">" joined with (escape_html using node.label) joined with "</a>" joined with sub_ul joined with "</li>"
    set li_parts to collections.append using li_parts, li_html
  end
  give back "<ul>" joined with (text.join using li_parts, "") joined with "</ul>"
end

make render_menu using stmts, location, current_path
  set tree to get_menu_tree using stmts, location, no
  if tree is nothing
    give back ""
  end
  set ul_html to render_menu_ul using tree.items, current_path, 1
  give back "<nav class=\"cms-nav cms-nav-" joined with (escape_html using location) joined with "\" aria-label=\"" joined with (escape_html using tree.name) joined with "\">" joined with ul_html joined with "</nav>"
end

make validate_menu_hierarchy using items_list
  set by_key to {}
  set idx to 0
  for each item in items_list
    set k to "idx:" joined with (text.from using idx)
    if (has_map_key using item, "client_id") and (text.trim using (text.from using (item at "client_id"))) is not ""
      set k to "cid:" joined with (text.trim using (text.from using (item at "client_id")))
    otherwise
      if (has_map_key using item, "id") and (item at "id") is not nothing
        set k to "id:" joined with (text.from using (item at "id"))
      end
    end
    if has_map_key using by_key, k
      give back record {ok: no, error: "Duplicate menu item key"}
    end
    set by_key to collections.put using by_key, k, item
    set idx to idx plus 1
  end

  set keys_all to collections.keys using by_key
  for each k in keys_all
    set depth to 1
    set cur to by_key at k
    set visited to collections.put using {}, k, yes
    while (has_map_key using cur, "parent_key") and (cur at "parent_key") is not nothing and (cur at "parent_key") is not ""
      set pk to text.from using (cur at "parent_key")
      if pk is k or (has_map_key using visited, pk)
        give back record {ok: no, error: "Cycle detected in menu hierarchy"}
      end
      if not (has_map_key using by_key, pk)
        give back record {ok: no, error: "Parent menu item does not belong to this menu"}
      end
      set visited to collections.put using visited, pk, yes
      set depth to depth plus 1
      if depth is greater than 4
        give back record {ok: no, error: "Menu nesting depth exceeds maximum of 4 levels"}
      end
      set cur to by_key at pk
    end
  end
  give back record {ok: yes, error: ""}
end

# ==============================================================================
# Module 10: Taxonomies, Hierarchical Terms & Entry Term Assignment
# ==============================================================================

make parse_content_type_slugs_json using raw_json
  try
    set parsed to json.parse using raw_json
    set out to []
    for each s in parsed
      set sn to normalize_slug using (text.from using s)
      if sn is not "" and (is_valid_slug using sn)
        set out to collections.append using out, sn
      end
    end
    give back out
  catch err
    give back []
  end
end

make check_term_parent_valid using stmts, tax_row, self_id, parent_id
  if parent_id is nothing
    give back record {ok: yes, error: ""}
  end
  if tax_row.is_hierarchical is not 1
    give back record {ok: no, error: "Flat taxonomies do not support parent terms"}
  end
  if self_id is not nothing and parent_id is self_id
    give back record {ok: no, error: "Term cannot be its own parent"}
  end
  set all_terms to data.query using stmts.get_term, record {lookup: "tax", id: 0, taxonomy_id: tax_row.id, slug: ""}
  set by_id to {}
  for each t in all_terms
    set by_id to collections.put using by_id, (text.from using t.id), t
  end
  set pid_key to text.from using parent_id
  if not (has_map_key using by_id, pid_key)
    give back record {ok: no, error: "Parent term does not belong to this taxonomy"}
  end
  set cur_key to pid_key
  set steps to 0
  while cur_key is not "" and steps is less than 12
    if self_id is not nothing and cur_key is (text.from using self_id)
      give back record {ok: no, error: "Cycle detected in hierarchical terms"}
    end
    if not (has_map_key using by_id, cur_key)
      give back record {ok: yes, error: ""}
    end
    set node to by_id at cur_key
    if node.parent_id is nothing
      give back record {ok: yes, error: ""}
    end
    set cur_key to text.from using node.parent_id
    set steps to steps plus 1
  end
  give back record {ok: no, error: "Term hierarchy depth limit exceeded"}
end

make sync_entry_terms_tx using stmts, entry_id, term_ids_raw, now_iso, tx
  call data.execute using stmts.delete_entry_terms_by_entry, record {entry_id: entry_id}, tx
  set seen to {}
  for each tid_raw in term_ids_raw
    set tid to text.to_integer using (text.from using tid_raw)
    set tid_str to text.from using tid
    if not (has_map_key using seen, tid_str)
      set trow to data.one using stmts.get_term, record {lookup: "id", id: tid, taxonomy_id: 0, slug: ""}, tx
      if trow is nothing
        give back record {ok: no, error: "Unknown term_id: " joined with tid_str}
      end
      call data.execute using stmts.insert_entry_term, record {entry_id: entry_id, term_id: tid, created_at: now_iso}, tx
      set seen to collections.put using seen, tid_str, yes
    end
  end
  give back record {ok: yes, error: ""}
end

# ==============================================================================
# Module 11: Strict Grex Validation, WCAG AA auditAccessibility & grab mcp Tools
# ==============================================================================

make grex_node_has_accessible_name using node
  if not (is_record_value using node)
    give back no
  end
  if node has "text" and (node at "text") is not nothing
    if (text.trim using (text.from using (node at "text"))) is not ""
      give back yes
    end
  end
  if node has "props" and (is_record_value using (node at "props"))
    set props to node at "props"
    for each k in ["text", "label", "aria-label", "aria-labelledby"]
      if has_map_key using props, k
        set v to text.trim using (text.from using (props at k))
        if v is not ""
          give back yes
        end
      end
    end
  end
  if node has "attrs" and (is_record_value using (node at "attrs"))
    set amap to node at "attrs"
    for each k in ["aria-label", "aria-labelledby"]
      if has_map_key using amap, k
        set v to text.trim using (text.from using (amap at k))
        if v is not ""
          give back yes
        end
      end
    end
  end
  if node has "children" and (node at "children") is not nothing
    for each ch in (node at "children")
      if (is_record_value using ch) and (ch has "props") and (is_record_value using (ch at "props"))
        set cp to ch at "props"
        if has_map_key using cp, "text"
          if (text.trim using (text.from using (cp at "text"))) is not ""
            give back yes
          end
        end
      end
    end
  end
  give back no
end

make resolve_heading_level using node, tag_name
  if tag_name is "h1"
    give back 1
  end
  if tag_name is "h2"
    give back 2
  end
  if tag_name is "h3"
    give back 3
  end
  if tag_name is "h4"
    give back 4
  end
  if tag_name is "h5"
    give back 5
  end
  if tag_name is "h6"
    give back 6
  end
  if node has "props"
    set props to node at "props"
    if has_map_key using props, "level"
      try
        give back text.to_integer using (text.from using (props at "level"))
      catch err
        give back 0
      end
    end
  end
  give back 2
end

make audit_grex_tree_walk using stmts, node, depth, path_label, state
  set violations to state.violations
  set h1_count to state.h1_count
  set last_h to state.last_heading_level
  set inherited_bg to ""
  if has_map_key using state, "inherited_bg"
    set inherited_bg to state.inherited_bg
  end

  if depth is greater than 24
    set violations to collections.append using violations, record {rule: "schema-max-depth", path: path_label, message: "Grex layout nesting exceeds maximum depth (24)"}
    give back record {violations: violations, h1_count: h1_count, last_heading_level: last_h, inherited_bg: inherited_bg}
  end

  if not (is_record_value using node)
    set violations to collections.append using violations, record {rule: "schema-node-object", path: path_label, message: "Grex layout node must be a JSON object"}
    give back record {violations: violations, h1_count: h1_count, last_heading_level: last_h, inherited_bg: inherited_bg}
  end

  set el_name to resolve_grex_element_name using node
  if el_name is ""
    set violations to collections.append using violations, record {rule: "schema-element-required", path: path_label, message: "Grex layout node requires an element field"}
    give back record {violations: violations, h1_count: h1_count, last_heading_level: last_h, inherited_bg: inherited_bg}
  end

  if not (is_allowed_grex_element using el_name)
    set violations to collections.append using violations, record {rule: "schema-element-allowlist", path: path_label, message: "Unsupported or unsafe Grex element: " joined with el_name}
    give back record {violations: violations, h1_count: h1_count, last_heading_level: last_h, inherited_bg: inherited_bg}
  end

  set tag_name to ""
  if node has "tag" and (node at "tag") is not nothing
    set tag_name to text.lower using (text.from using (node at "tag"))
    if tag_name is "div"
      set violations to collections.append using violations, record {rule: "no-wrapper-div", path: path_label, message: "Wrapper <div> tags are strictly forbidden in Grex layouts"}
    otherwise
      if tag_name is "script" or tag_name is "iframe" or tag_name is "object" or tag_name is "embed" or tag_name is "style" or tag_name is "link" or tag_name is "meta" or tag_name is "base" or (not (is_allowed_grex_tag using tag_name))
        set violations to collections.append using violations, record {rule: "security-disallowed-tag", path: path_label, message: "Disallowed HTML tag in Grex layout: " joined with tag_name}
      end
    end
  end

  set props to {}
  if node has "props" and (node at "props") is not nothing
    set pvs to collect_attr_map_violations using (node at "props"), "prop", yes, yes
    for each pv in pvs
      set violations to collections.append using violations, record {rule: pv.rule, path: path_label, message: pv.message}
    end
    if is_record_value using (node at "props")
      set props to node at "props"
    end
  end

  set attrs_map to {}
  if node has "attrs" and (node at "attrs") is not nothing
    set avs to collect_attr_map_violations using (node at "attrs"), "attrs", yes, yes
    for each av in avs
      set violations to collections.append using violations, record {rule: av.rule, path: path_label, message: av.message}
    end
    if is_record_value using (node at "attrs")
      set attrs_map to node at "attrs"
    end
  end

  set node_bg to inherited_bg
  if node has "styles" and (node at "styles") is not nothing
    set st_obj to node at "styles"
    set svs to collect_style_violations using st_obj, yes
    for each sv in svs
      set violations to collections.append using violations, record {rule: sv.rule, path: path_label, message: sv.message}
    end
    set style_maps to extract_grex_style_maps using st_obj
    if (collections.length using style_maps) is greater than 0
      set cand_bg to extract_style_bg using (style_maps at 0)
      if cand_bg is not ""
        set node_bg to cand_bg
      end
      for each sm in style_maps
        if is_record_value using sm
          set sm_bg to extract_style_bg using sm
          if sm_bg is ""
            set sm_bg to node_bg
          end
          if (has_map_key using sm, "color") and sm_bg is not ""
            set fg_val to text.from using (sm at "color")
            set ratio to compute_contrast_ratio using fg_val, sm_bg
            if ratio is not nothing
              set min_ratio to 4.5
              if is_large_text_style using sm
                set min_ratio to 3.0
              end
              if ratio is less than min_ratio
                set violations to collections.append using violations, record {rule: "GREX-A11Y-001", path: path_label, message: ("Contrast ratio " joined with (text.from using ratio) joined with ":1 (" joined with fg_val joined with " on " joined with sm_bg joined with ") is below WCAG AA minimum " joined with (text.from using min_ratio) joined with ":1")}
              end
            end
          end
        end
      end
    end
  end

  if el_name is "Image" or tag_name is "img"
    set has_alt to no
    if (has_map_key using props, "is_decorative") and (is_truthy_val using (props at "is_decorative"))
      set has_alt to yes
    end
    if (has_map_key using props, "decorative") and (is_truthy_val using (props at "decorative"))
      set has_alt to yes
    end
    if (has_map_key using props, "aria-hidden") and (text.lower using (text.from using (props at "aria-hidden"))) is "true"
      set has_alt to yes
    end
    if (has_map_key using attrs_map, "aria-hidden") and (text.lower using (text.from using (attrs_map at "aria-hidden"))) is "true"
      set has_alt to yes
    end
    if has_map_key using props, "alt"
      if (text.trim using (text.from using (props at "alt"))) is not ""
        set has_alt to yes
      end
    end
    if (not has_alt) and (has_map_key using attrs_map, "alt")
      if (text.trim using (text.from using (attrs_map at "alt"))) is not ""
        set has_alt to yes
      end
    end
    if (not has_alt) and (has_map_key using props, "media_id")
      try
        set mid to text.to_integer using (text.from using (props at "media_id"))
        set mrow to data.one using stmts.get_media, record {lookup: "id", iv: mid, sv: ""}
        if mrow is nothing
          set violations to collections.append using violations, record {rule: "a11y-media-exists", path: path_label, message: "Referenced media_id not found"}
        otherwise
          if (text.trim using mrow.alt_text) is not "" or mrow.is_decorative is 1
            set has_alt to yes
          end
        end
      catch merr
      end
    end
    if not has_alt
      set violations to collections.append using violations, record {rule: "a11y-image-alt", path: path_label, message: "Image requires non-empty alt text or explicit is_decorative/decorative: true"}
    end
  end

  if el_name is "Heading" or tag_name is "h1" or tag_name is "h2" or tag_name is "h3" or tag_name is "h4" or tag_name is "h5" or tag_name is "h6"
    set lvl to resolve_heading_level using node, tag_name
    if lvl is less than 1 or lvl is greater than 6
      set violations to collections.append using violations, record {rule: "a11y-heading-level", path: path_label, message: "Heading level must be between 1 and 6"}
    otherwise
      if lvl is 1
        set h1_count to h1_count plus 1
        if h1_count is greater than 1
          set violations to collections.append using violations, record {rule: "a11y-single-h1", path: path_label, message: "Multiple <h1> headings detected; only one <h1> is allowed per layout"}
        end
      end
      if last_h is greater than 0 and lvl is greater than (last_h plus 1)
        set violations to collections.append using violations, record {rule: "a11y-heading-order", path: path_label, message: "Skipped heading level from h" joined with (text.from using last_h) joined with " to h" joined with (text.from using lvl)}
      end
      set last_h to lvl
    end
  end

  set is_hidden_input to (el_name is "Input" or tag_name is "input") and (has_map_key using props, "type") and ((text.lower using (text.from using (props at "type"))) is "hidden")
  if (not is_hidden_input) and (el_name is "Link" or el_name is "Button" or el_name is "Input" or el_name is "Select" or tag_name is "a" or tag_name is "button" or tag_name is "input" or tag_name is "select")
    if not (grex_node_has_accessible_name using node)
      set violations to collections.append using violations, record {rule: "a11y-interactive-label", path: path_label, message: "Interactive " joined with el_name joined with " requires accessible label (text, label, or aria-label)"}
    end
  end

  set cur_state to record {violations: violations, h1_count: h1_count, last_heading_level: last_h, inherited_bg: node_bg}
  if node has "children" and (node at "children") is not nothing
    set kids to node at "children"
    set idx to 0
    for each ch in kids
      set next_path to path_label joined with ".children[" joined with (text.from using idx) joined with "]"
      set cur_state to audit_grex_tree_walk using stmts, ch, (depth plus 1), next_path, cur_state
      set cur_state to record {violations: cur_state.violations, h1_count: cur_state.h1_count, last_heading_level: cur_state.last_heading_level, inherited_bg: node_bg}
      set idx to idx plus 1
    end
  end
  give back record {violations: cur_state.violations, h1_count: cur_state.h1_count, last_heading_level: cur_state.last_heading_level, inherited_bg: inherited_bg}
end

make render_validated_grex_html using stmts, node, depth
  if depth is greater than 24
    give back ""
  end
  set el_name to resolve_grex_element_name using node
  set props to {}
  if (node has "props") and (is_record_value using (node at "props"))
    set props to node at "props"
  end
  set attrs_map to {}
  if (node has "attrs") and (is_record_value using (node at "attrs"))
    set attrs_map to node at "attrs"
  end
  set tag to default_tag_for_grex_element using el_name, props
  if node has "tag" and (node at "tag") is not nothing
    set req_tag to text.lower using (text.from using (node at "tag"))
    if is_allowed_grex_tag using req_tag
      set tag to req_tag
    end
  end
  if el_name is "Heading" and (not (node has "tag")) and (has_map_key using props, "level")
    set lvl_str to text.from using (props at "level")
    if lvl_str is "1" or lvl_str is "2" or lvl_str is "3" or lvl_str is "4" or lvl_str is "5" or lvl_str is "6"
      set tag to "h" joined with lvl_str
    end
  end

  set inner to ""
  if has_map_key using props, "text"
    set inner to escape_html using (text.from using (props at "text"))
  otherwise
    if (is_record_value using node) and (node has "text") and (node at "text") is not nothing
      set inner to escape_html using (text.from using (node at "text"))
    end
  end
  if node has "children" and (node at "children") is not nothing
    for each ch in (node at "children")
      set inner to inner joined with (render_validated_grex_html using stmts, ch, (depth plus 1))
    end
  end
  if tag is ""
    give back inner
  end

  set attrs to ""
  if has_map_key using props, "class"
    set attrs to attrs joined with " class=\"" joined with (escape_html using (text.from using (props at "class"))) joined with "\""
  end
  if has_map_key using props, "href"
    set hv to text.from using (props at "href")
    if is_safe_url using hv
      set attrs to attrs joined with " href=\"" joined with (escape_html using hv) joined with "\""
    end
  end
  if el_name is "Image" or tag is "img"
    set src_val to ""
    set alt_val to ""
    set is_dec to no
    if has_map_key using props, "src"
      set src_val to text.from using (props at "src")
    end
    if has_map_key using props, "alt"
      set alt_val to text.from using (props at "alt")
    otherwise
      if has_map_key using attrs_map, "alt"
        set alt_val to text.from using (attrs_map at "alt")
      end
    end
    if ((has_map_key using props, "is_decorative") and (is_truthy_val using (props at "is_decorative"))) or ((has_map_key using props, "decorative") and (is_truthy_val using (props at "decorative")))
      set is_dec to yes
    end
    if has_map_key using props, "media_id"
      try
        set mrow to data.one using stmts.get_media, record {lookup: "id", iv: (text.to_integer using (text.from using (props at "media_id"))), sv: ""}
        if mrow is not nothing
          if src_val is ""
            set src_val to "/media/" joined with (text.from using mrow.id) joined with "/" joined with mrow.filename
          end
          if alt_val is "" and mrow.alt_text is not ""
            set alt_val to mrow.alt_text
          end
          if mrow.is_decorative is 1
            set is_dec to yes
          end
        end
      catch err
      end
    end
    if src_val is not "" and (is_safe_url using src_val)
      set attrs to attrs joined with " src=\"" joined with (escape_html using src_val) joined with "\""
    end
    if is_dec
      set attrs to attrs joined with " alt=\"\" aria-hidden=\"true\""
    otherwise
      set attrs to attrs joined with " alt=\"" joined with (escape_html using alt_val) joined with "\""
    end
    give back "<img" joined with attrs joined with ">"
  end
  if has_map_key using props, "aria-label"
    set attrs to attrs joined with " aria-label=\"" joined with (escape_html using (text.from using (props at "aria-label"))) joined with "\""
  otherwise
    if has_map_key using attrs_map, "aria-label"
      set attrs to attrs joined with " aria-label=\"" joined with (escape_html using (text.from using (attrs_map at "aria-label"))) joined with "\""
    end
  end
  give back "<" joined with tag joined with attrs joined with ">" joined with inner joined with "</" joined with tag joined with ">"
end

# ==============================================================================
# Module 11: Zero-Plugin E-Commerce Core (ADR-025c, Cart, Totals, Sweep, Checks)
# ==============================================================================

make commerce_error using status_code, err_code, msg, field_name
  set payload to {"error": err_code, "message": msg}
  if field_name is not ""
    set payload to collections.put using payload, "field", field_name
  end
  give back server.json using status_code, payload
end

make check_commerce_body_limit using req
  if (text.length using req.body) is greater than 65536
    give back record {ok: no, response: (commerce_error using 413, "body_too_large", "Request body exceeds 64 KiB limit", "")}
  end
  give back record {ok: yes, response: nothing}
end

make reject_client_price_fields using payload
  if not (is_record_value using payload)
    give back record {ok: yes, field: ""}
  end
  set forbidden to ["subtotal", "discount", "discount_total", "tax", "tax_total", "shipping", "shipping_total", "total", "unit_price", "unit_price_cents", "price", "price_cents", "amount"]
  for each fk in forbidden
    if has_map_key using payload, fk
      give back record {ok: no, field: fk}
    end
  end
  give back record {ok: yes, field: ""}
end

make is_ascii_digits using raw_s
  if raw_s is ""
    give back no
  end
  set chars to text.split using raw_s, ""
  for each ch in chars
    if not (text.contains using "0123456789", ch)
      give back no
    end
  end
  give back yes
end

make digits_to_int using raw_s
  set acc to 0
  set chars to text.split using raw_s, ""
  for each ch in chars
    set d to text.to_integer using ch
    set acc to (acc times 10) plus d
  end
  give back acc
end

make is_valid_isbn13 using raw_s
  set cleaned to text.replace using (text.replace using (text.trim using (text.from using raw_s)), "-", ""), " ", ""
  if (text.length using cleaned) is not 13
    give back no
  end
  if not (is_ascii_digits using cleaned)
    give back no
  end
  set chars to text.split using cleaned, ""
  set sum_v to 0
  set idx to 0
  for each ch in chars
    set d to text.to_integer using ch
    if (idx modulo 2) is 0
      set sum_v to sum_v plus d
    otherwise
      set sum_v to sum_v plus (d times 3)
    end
    set idx to idx plus 1
  end
  give back ((sum_v modulo 10) is 0)
end

make floor_div using num, den
  set rem to num modulo den
  give back math.floor using ((num minus rem) divided by den)
end

make round_half_up_div using num, den
  set rem to num modulo den
  set q to math.floor using ((num minus rem) divided by den)
  if (rem times 2) is at least den
    give back q plus 1
  end
  give back q
end

make format_cents_usd using cents
  if cents is less than 0
    set cents to 0
  end
  set whole to floor_div using cents, 100
  set rem to cents modulo 100
  set rem_s to text.from using rem
  if rem is less than 10
    set rem_s to "0" joined with rem_s
  end
  give back (text.from using whole) joined with "." joined with rem_s
end

make parse_money_cents using raw_val, allow_zero, max_cents
  set s to ""
  try
    set s to text.trim using raw_val
  catch err
    give back record {ok: no, cents: 0, formatted: "", code: "float_not_allowed", error: "Money amounts must be exact GrabDecimal strings (e.g. \"19.99\"), not raw JSON numbers or floats"}
  end
  if s is ""
    give back record {ok: no, cents: 0, formatted: "", code: "invalid_money", error: "Money amount cannot be empty"}
  end
  if (text.contains using s, "e") or (text.contains using s, "E")
    give back record {ok: no, cents: 0, formatted: "", code: "float_not_allowed", error: "Scientific notation is not allowed in money amounts"}
  end
  set parts to text.split using s, "."
  if (collections.length using parts) is not 2
    give back record {ok: no, cents: 0, formatted: "", code: "invalid_money", error: "Money amount must match ^(0|[1-9][0-9]*)\\.[0-9]{2}$"}
  end
  set whole_s to parts at 0
  set frac_s to parts at 1
  if (not (is_ascii_digits using whole_s)) or (not (is_ascii_digits using frac_s))
    give back record {ok: no, cents: 0, formatted: "", code: "invalid_money", error: "Money amount must contain only digits and a single decimal point"}
  end
  if (text.length using frac_s) is not 2
    give back record {ok: no, cents: 0, formatted: "", code: "invalid_money", error: "Money amount must have exactly 2 decimal digits"}
  end
  if (text.length using whole_s) is greater than 1 and (text.starts_with using whole_s, "0")
    give back record {ok: no, cents: 0, formatted: "", code: "invalid_money", error: "Leading zeros are not allowed in money whole part"}
  end
  if (text.length using whole_s) is greater than 10
    give back record {ok: no, cents: 0, formatted: "", code: "money_overflow", error: "Money amount exceeds 99999999.99 cap"}
  end
  set whole to digits_to_int using whole_s
  set frac to digits_to_int using frac_s
  set cents to (whole times 100) plus frac
  if (not allow_zero) and cents is 0
    give back record {ok: no, cents: 0, formatted: "", code: "invalid_money", error: "Money amount must be greater than 0.00"}
  end
  if cents is greater than max_cents
    give back record {ok: no, cents: 0, formatted: "", code: "money_overflow", error: "Money amount exceeds allowed cap"}
  end
  give back record {ok: yes, cents: cents, formatted: s, code: "", error: ""}
end

make parse_grab_integer using raw_val, min_v, max_v
  if raw_val is nothing
    give back record {ok: no, val: 0, code: "invalid_integer", error: "Integer value is required"}
  end
  set is_native_int to no
  try
    set chk to dates.from_unix using raw_val
    set is_native_int to yes
  catch err
    set is_native_int to no
  end
  if is_native_int
    set v to text.to_integer using (text.from using raw_val)
    if v is less than min_v or v is greater than max_v
      give back record {ok: no, val: 0, code: "out_of_range", error: "Integer value is out of range"}
    end
    give back record {ok: yes, val: v, code: "", error: ""}
  end
  set raw_s to ""
  try
    set raw_s to text.trim using raw_val
  catch err2
    give back record {ok: no, val: 0, code: "float_not_allowed", error: "Expected GrabInteger, got float or non-integer"}
  end
  if (text.contains using raw_s, ".") or (text.contains using raw_s, "e") or (text.contains using raw_s, "E")
    give back record {ok: no, val: 0, code: "float_not_allowed", error: "Floats and scientific notation are not allowed for GrabInteger"}
  end
  if not (is_ascii_digits using raw_s)
    give back record {ok: no, val: 0, code: "invalid_integer", error: "Invalid GrabInteger string"}
  end
  if (text.length using raw_s) is greater than 12
    give back record {ok: no, val: 0, code: "out_of_range", error: "Integer value too large"}
  end
  set v to digits_to_int using raw_s
  if v is less than min_v or v is greater than max_v
    give back record {ok: no, val: 0, code: "out_of_range", error: "Integer value is out of range"}
  end
  give back record {ok: yes, val: v, code: "", error: ""}
end

make get_commerce_config using stmts
  set settings to get_site_settings_map using stmts
  set enabled to no
  if (has_map_key using settings, "commerce_enabled") and ((settings at "commerce_enabled") is "1")
    set enabled to yes
  end
  set currency to "USD"
  if has_map_key using settings, "commerce_currency"
    set c to text.trim using (text.from using (settings at "commerce_currency"))
    if c is not ""
      set currency to c
    end
  end
  set guest_checkout to yes
  if (has_map_key using settings, "commerce_guest_checkout") and ((settings at "commerce_guest_checkout") is "0")
    set guest_checkout to no
  end
  set tax_std to 0
  set tax_red to 0
  set tax_dig to 0
  if has_map_key using settings, "commerce_tax_rates_json"
    try
      set tr to json.parse using (settings at "commerce_tax_rates_json")
      if tr has "standard_bp"
        set p1 to parse_grab_integer using (tr at "standard_bp"), 0, 5000
        if p1.ok
          set tax_std to p1.val
        end
      end
      if tr has "reduced_bp"
        set p2 to parse_grab_integer using (tr at "reduced_bp"), 0, 5000
        if p2.ok
          set tax_red to p2.val
        end
      end
      if tr has "digital_bp"
        set p3 to parse_grab_integer using (tr at "digital_bp"), 0, 5000
        if p3.ok
          set tax_dig to p3.val
        end
      end
    catch err
    end
  end
  set ship_usps_ground to 0
  set ship_usps_priority to 0
  set ship_usps_media to 0
  set ship_lulu to 0
  if has_map_key using settings, "commerce_shipping_rates_json"
    try
      set sr to json.parse using (settings at "commerce_shipping_rates_json")
      if sr has "usps_ground_advantage"
        set m1 to parse_money_cents using (sr at "usps_ground_advantage"), yes, 9999999999
        if m1.ok
          set ship_usps_ground to m1.cents
        end
      end
      if sr has "usps_priority"
        set m2 to parse_money_cents using (sr at "usps_priority"), yes, 9999999999
        if m2.ok
          set ship_usps_priority to m2.cents
        end
      end
      if sr has "usps_media_mail"
        set m3 to parse_money_cents using (sr at "usps_media_mail"), yes, 9999999999
        if m3.ok
          set ship_usps_media to m3.cents
        end
      end
      if sr has "lulu_direct"
        set m4 to parse_money_cents using (sr at "lulu_direct"), yes, 9999999999
        if m4.ok
          set ship_lulu to m4.cents
        end
      end
    catch err
    end
  end
  set ttl_min to 60
  if has_map_key using settings, "commerce_pending_ttl_minutes"
    set p_ttl to parse_grab_integer using (settings at "commerce_pending_ttl_minutes"), 1, 1440
    if p_ttl.ok
      set ttl_min to p_ttl.val
    end
  end
  set ab_min to 60
  if has_map_key using settings, "commerce_abandoned_after_minutes"
    set p_ab to parse_grab_integer using (settings at "commerce_abandoned_after_minutes"), 1, 10080
    if p_ab.ok
      set ab_min to p_ab.val
    end
  end
  set pay_tmpl to ""
  if has_map_key using settings, "commerce_payment_redirect_template"
    set pay_tmpl to text.trim using (text.from using (settings at "commerce_payment_redirect_template"))
  end
  set pay_allow to ""
  if has_map_key using settings, "commerce_payment_redirect_allowlist"
    set pay_allow to text.trim using (text.from using (settings at "commerce_payment_redirect_allowlist"))
  end
  set email_salt to ""
  if has_map_key using settings, "commerce_email_salt"
    set email_salt to text.trim using (text.from using (settings at "commerce_email_salt"))
  end
  give back record {enabled: enabled, currency: currency, guest_checkout: guest_checkout, tax_standard_bp: tax_std, tax_reduced_bp: tax_red, tax_digital_bp: tax_dig, ship_usps_ground: ship_usps_ground, ship_usps_priority: ship_usps_priority, ship_usps_media: ship_usps_media, ship_lulu: ship_lulu, ttl_minutes: ttl_min, abandoned_minutes: ab_min, payment_template: pay_tmpl, payment_allowlist: pay_allow, email_salt: email_salt}
end

make ensure_commerce_salt_and_type using stmts
  set now_rec to call dates.now_utc
  set settings to get_site_settings_map using stmts
  if (not (has_map_key using settings, "commerce_email_salt")) or ((text.trim using (text.from using (settings at "commerce_email_salt"))) is "")
    set new_salt to crypto.random_hex using 32
    call upsert_setting using stmts, "commerce_email_salt", new_salt, now_rec.iso, nothing
    call cache.delete using stmts.cms_cache, "site_settings"
  end
  set ct to data.one using stmts.get_type, record {lookup: "slug", sv: "product", iv: 0}
  if ct is nothing
    call data.execute using stmts.insert_type, record {slug: "product", label_singular: "Product", label_plural: "Products", permalink_pattern: "/shop/:slug", has_archive: 1, archive_slug: "shop", is_system: 1, created_at: now_rec.iso}
    set ct to data.one using stmts.get_type, record {lookup: "slug", sv: "product", iv: 0}
  end
  if ct is not nothing
    set f_isbn to data.one using stmts.get_field_by_key, record {content_type_id: ct.id, field_key: "isbn_13"}
    if f_isbn is nothing
      call data.execute using stmts.insert_field, record {content_type_id: ct.id, field_key: "isbn_13", label: "ISBN-13", field_type: "text", is_required: 0, default_value: "", sort_order: 10}
    end
    set f_sub to data.one using stmts.get_field_by_key, record {content_type_id: ct.id, field_key: "subtitle"}
    if f_sub is nothing
      call data.execute using stmts.insert_field, record {content_type_id: ct.id, field_key: "subtitle", label: "Subtitle", field_type: "text", is_required: 0, default_value: "", sort_order: 20}
    end
  end
end

make invalidate_commerce_caches using stmts, product_id
  if product_id is not nothing and product_id is greater than 0
    call cache.delete using stmts.cms_cache, ("commerce:product:" joined with (text.from using product_id))
  end
  call bump_cache_epoch using stmts, "cache_epoch:commerce"
  call bump_query_cache_epochs using stmts, "product"
  call cache.delete using stmts.cms_cache, "site_settings"
end

make validate_carrier_constraints using items
  set has_physical to no
  set usps_weight to 0
  set usps_max_weight to 31751
  set has_usps to no
  set all_media_mail_ok to yes
  set chosen_usps_service to "ground_advantage"
  set has_lulu to no

  for each it in items
    if it.kind is "physical"
      set has_physical to yes
      set carrier to ""
      if it.carrier is not nothing
        set carrier to text.lower using (text.trim using (text.from using it.carrier))
      end
      if carrier is not "usps" and carrier is not "lulu_direct"
        give back record {ok: no, code: "LULU-USPS-001", message: "Physical products support only USPS or lulu_direct fulfillment (UPS/FedEx/DHL disallowed)", has_physical: yes, has_usps: no, usps_service: "", has_lulu: no}
      end
      if carrier is "usps"
        set has_usps to yes
        set svc to "ground_advantage"
        if it.usps_service is not nothing and (text.trim using (text.from using it.usps_service)) is not ""
          set svc to text.lower using (text.trim using (text.from using it.usps_service))
        end
        if svc is not "ground_advantage" and svc is not "priority" and svc is not "media_mail"
          give back record {ok: no, code: "LULU-USPS-001", message: "Unsupported USPS service tier", has_physical: yes, has_usps: yes, usps_service: svc, has_lulu: no}
        end
        if svc is "priority"
          set chosen_usps_service to "priority"
        end
        if svc is "media_mail" and chosen_usps_service is "ground_advantage"
          set chosen_usps_service to "media_mail"
        end
        if it.media_mail_eligible is not 1
          set all_media_mail_ok to no
        end
        set max_w to 31751
        if it.max_weight_g is not nothing and it.max_weight_g is greater than 0 and it.max_weight_g is less than max_w
          set max_w to it.max_weight_g
        end
        if max_w is less than usps_max_weight
          set usps_max_weight to max_w
        end
        set usps_weight to usps_weight plus (it.weight_g times it.qty)
      end
      if carrier is "lulu_direct"
        set has_lulu to yes
        if it.lulu_sku is nothing or (text.trim using (text.from using it.lulu_sku)) is ""
          give back record {ok: no, code: "lulu_sku_required", message: "lulu_direct product requires a non-empty lulu_sku", has_physical: yes, has_usps: no, usps_service: "", has_lulu: yes}
        end
      end
    end
  end

  if has_usps
    if usps_weight is greater than usps_max_weight
      give back record {ok: no, code: "weight_exceeds_carrier_limit", message: "Total USPS parcel weight exceeds carrier maximum", has_physical: yes, has_usps: yes, usps_service: chosen_usps_service, has_lulu: has_lulu}
    end
    if chosen_usps_service is "media_mail" and (not all_media_mail_ok)
      give back record {ok: no, code: "media_mail_ineligible", message: "USPS Media Mail requires every USPS item to be media_mail_eligible", has_physical: yes, has_usps: yes, usps_service: chosen_usps_service, has_lulu: has_lulu}
    end
  end

  give back record {ok: yes, code: "", message: "", has_physical: has_physical, has_usps: has_usps, usps_service: chosen_usps_service, has_lulu: has_lulu}
end

make compute_cart_totals using items, coupon_row, cfg, carrier_res
  set lines to []
  set subtotal_cents to 0
  for each it in items
    set unit_c to it.live_price_cents
    if (has_map_key using it, "use_snapshot_price") and it.use_snapshot_price
      set unit_c to it.unit_price_cents
    end
    set line_sub to unit_c times it.qty
    set subtotal_cents to subtotal_cents plus line_sub
    set tclass to "standard"
    if it.tax_class is "reduced" or it.tax_class is "digital" or it.tax_class is "exempt"
      set tclass to it.tax_class
    end
    set lines to collections.append using lines, {"product_id": it.product_id, "line_sub": line_sub, "tax_class": tclass, "disc": 0, "rem": 0}
  end

  if subtotal_cents is greater than 9999999999
    give back record {ok: no, code: "money_overflow", error: "Subtotal exceeds 99999999.99 cap"}
  end

  set discount_cents to 0
  if coupon_row is not nothing and subtotal_cents is greater than 0
    if coupon_row.type is "fixed_cents"
      set discount_cents to coupon_row.value
    otherwise
      set discount_cents to round_half_up_div using (subtotal_cents times coupon_row.value), 10000
    end
    if discount_cents is greater than subtotal_cents
      set discount_cents to subtotal_cents
    end
  end

  set n_lines to collections.length using lines
  if subtotal_cents is greater than 0 and discount_cents is greater than 0 and n_lines is greater than 0
    set alloc_sum to 0
    set next_lines to []
    for each ln in lines
      set exact_num to discount_cents times (ln at "line_sub")
      set base_d to floor_div using exact_num, subtotal_cents
      set rem_d to exact_num modulo subtotal_cents
      set alloc_sum to alloc_sum plus base_d
      set nl to collections.put using ln, "disc", base_d
      set nl to collections.put using nl, "rem", rem_d
      set next_lines to collections.append using next_lines, nl
    end
    set lines to next_lines
    set leftover to discount_cents minus alloc_sum
    while leftover is greater than 0
      set best_idx to -1
      set best_rem to -1
      set idx to 0
      while idx is less than n_lines
        set cand to lines at idx
        set cr to cand at "rem"
        if cr is greater than best_rem
          set best_rem to cr
          set best_idx to idx
        end
        set idx to idx plus 1
      end
      if best_idx is less than 0
        set leftover to 0
      otherwise
        set rebuilt to []
        set j to 0
        while j is less than n_lines
          set cur_ln to lines at j
          if j is best_idx
            set cur_ln to collections.put using cur_ln, "disc", ((cur_ln at "disc") plus 1)
            set cur_ln to collections.put using cur_ln, "rem", -1
          end
          set rebuilt to collections.append using rebuilt, cur_ln
          set j to j plus 1
        end
        set lines to rebuilt
        set leftover to leftover minus 1
      end
    end
  end

  set std_net to 0
  set red_net to 0
  set dig_net to 0
  for each ln in lines
    set net_v to (ln at "line_sub") minus (ln at "disc")
    set tc to ln at "tax_class"
    if tc is "standard"
      set std_net to std_net plus net_v
    end
    if tc is "reduced"
      set red_net to red_net plus net_v
    end
    if tc is "digital"
      set dig_net to dig_net plus net_v
    end
  end

  set tax_std to round_half_up_div using (std_net times cfg.tax_standard_bp), 10000
  set tax_red to round_half_up_div using (red_net times cfg.tax_reduced_bp), 10000
  set tax_dig to round_half_up_div using (dig_net times cfg.tax_digital_bp), 10000
  set tax_cents to tax_std plus tax_red plus tax_dig

  set shipping_cents to 0
  if carrier_res.has_physical
    if carrier_res.has_usps
      if carrier_res.usps_service is "priority"
        set shipping_cents to shipping_cents plus cfg.ship_usps_priority
      otherwise
        if carrier_res.usps_service is "media_mail"
          set shipping_cents to shipping_cents plus cfg.ship_usps_media
        otherwise
          set shipping_cents to shipping_cents plus cfg.ship_usps_ground
        end
      end
    end
    if carrier_res.has_lulu
      set shipping_cents to shipping_cents plus cfg.ship_lulu
    end
  end

  set total_cents to (subtotal_cents minus discount_cents) plus tax_cents plus shipping_cents
  if total_cents is greater than 9999999999
    give back record {ok: no, code: "money_overflow", error: "Order total exceeds 99999999.99 cap"}
  end
  give back record {ok: yes, code: "", error: "", subtotal_cents: subtotal_cents, discount_cents: discount_cents, tax_cents: tax_cents, shipping_cents: shipping_cents, total_cents: total_cents}
end

make validate_allowlist_hosts using allowlist_csv
  set raw to text.trim using allowlist_csv
  if raw is ""
    give back record {ok: yes, hosts: []}
  end
  set parts to text.split using raw, ","
  set out_hosts to []
  for each p in parts
    set h to text.lower using (text.trim using p)
    if h is not ""
      if (text.contains using h, "*") or (text.contains using h, "/") or (text.contains using h, ":") or (text.contains using h, "@") or (text.contains using h, " ") or (text.contains using h, "?") or (text.contains using h, "#")
        give back record {ok: no, hosts: [], error: "GRAB-E402: allowlist entries must be bare exact hostnames with no scheme, port, wildcard, path, or userinfo"}
      end
      if not (is_allowed_chars using h, "abcdefghijklmnopqrstuvwxyz0123456789.-", 1, 253)
        give back record {ok: no, hosts: [], error: "GRAB-E402: allowlist host contains invalid characters"}
      end
      if (text.starts_with using h, ".") or (text.ends_with using h, ".") or (text.contains using h, "..")
        give back record {ok: no, hosts: [], error: "GRAB-E402: malformed hostname in payment allowlist"}
      end
      set out_hosts to collections.append using out_hosts, h
    end
  end
  give back record {ok: yes, hosts: out_hosts, error: ""}
end

make validate_https_url_against_allowlist using raw_url, allowlist_csv
  set u to text.trim using raw_url
  if u is "" or (text.contains using u, " ") or (text.contains using u, "\r") or (text.contains using u, "\n") or (text.contains using u, "\t") or (text.contains using u, "\\")
    give back record {ok: no, code: "GRAB-E402", error: "GRAB-E402: redirect URL contains whitespace or invalid control characters"}
  end
  set u_lower to text.lower using u
  if not (text.starts_with using u_lower, "https://")
    give back record {ok: no, code: "GRAB-E402", error: "GRAB-E402: redirect URL must use https:// scheme"}
  end
  if text.contains using u, "#"
    give back record {ok: no, code: "GRAB-E402", error: "GRAB-E402: redirect URL cannot contain URL fragments (#)"}
  end
  set chars to text.split using u, ""
  set rest_chars to collections.slice using chars, 8, (collections.length using chars)
  set rest to text.join using rest_chars, ""
  if rest is "" or (text.starts_with using rest, "/")
    give back record {ok: no, code: "GRAB-E402", error: "GRAB-E402: redirect URL missing host"}
  end
  set slash_parts to text.split using rest, "/"
  set q_parts to text.split using (slash_parts at 0), "?"
  set authority to q_parts at 0
  if authority is "" or (text.contains using authority, "@")
    give back record {ok: no, code: "GRAB-E402", error: "GRAB-E402: userinfo (@) in redirect URL is forbidden"}
  end
  set hp to text.split using authority, ":"
  set host_raw to hp at 0
  if (collections.length using hp) is greater than 2
    give back record {ok: no, code: "GRAB-E402", error: "GRAB-E402: malformed host:port in redirect URL"}
  end
  if (collections.length using hp) is 2
    if (hp at 1) is not "443"
      give back record {ok: no, code: "GRAB-E402", error: "GRAB-E402: non-443 ports are blocked by redirect allowlist"}
    end
  end
  set host_lower to text.lower using host_raw
  if host_lower is "" or (not (is_allowed_chars using host_lower, "abcdefghijklmnopqrstuvwxyz0123456789.-", 1, 253))
    give back record {ok: no, code: "GRAB-E402", error: "GRAB-E402: redirect host is invalid or non-ASCII"}
  end
  set allow_res to validate_allowlist_hosts using allowlist_csv
  if not allow_res.ok
    give back record {ok: no, code: "GRAB-E402", error: allow_res.error}
  end
  for each ah in allow_res.hosts
    if ah is host_lower
      give back record {ok: yes, code: "", error: "", url: u, host: host_lower}
    end
  end
  give back record {ok: no, code: "GRAB-E402", error: "GRAB-E402: redirect host is not in payment_redirect_allowlist"}
end

make build_payment_redirect_url using tmpl, order_num, amount_str, currency, return_url
  set out to text.replace using tmpl, "{order_number}", (url_encode using order_num)
  set out to text.replace using out, "{amount}", (url_encode using amount_str)
  set out to text.replace using out, "{currency}", (url_encode using currency)
  set out to text.replace using out, "{return_url}", (url_encode using return_url)
  if (text.contains using out, "{") or (text.contains using out, "}")
    give back record {ok: no, url: "", error: "GRAB-E402: unsupported placeholder in payment_redirect_template"}
  end
  give back record {ok: yes, url: out, error: ""}
end

make validate_coupon_for_cart using stmts, coupon_row, subtotal_cents, now_iso
  if coupon_row is nothing or coupon_row.active is not 1
    give back record {ok: no, reason: "unknown", message: "Coupon is invalid or unavailable"}
  end
  if coupon_row.starts_at is not nothing and coupon_row.starts_at is not ""
    if now_iso is less than coupon_row.starts_at
      give back record {ok: no, reason: "expired", message: "Coupon is not active yet"}
    end
  end
  if coupon_row.ends_at is not nothing and coupon_row.ends_at is not ""
    if now_iso is greater than coupon_row.ends_at
      give back record {ok: no, reason: "expired", message: "Coupon has expired"}
    end
  end
  if coupon_row.redeemed_count is at least coupon_row.max_redemptions
    give back record {ok: no, reason: "exhausted", message: "Coupon redemption limit reached"}
  end
  if subtotal_cents is less than coupon_row.min_subtotal_cents
    give back record {ok: no, reason: "min_subtotal", message: "Cart subtotal is below coupon minimum"}
  end
  give back record {ok: yes, reason: "", message: ""}
end

make is_valid_order_transition using from_st, to_st, is_admin
  if from_st is "pending_payment"
    if to_st is "paid" or to_st is "payment_failed" or to_st is "expired" or to_st is "cancelled"
      give back yes
    end
    give back no
  end
  if from_st is "paid"
    if to_st is "fulfilling"
      give back yes
    end
    if to_st is "cancelled" and is_admin
      give back yes
    end
    give back no
  end
  if from_st is "fulfilling"
    if to_st is "shipped"
      give back yes
    end
    if to_st is "cancelled" and is_admin
      give back yes
    end
    give back no
  end
  if from_st is "shipped"
    if to_st is "delivered"
      give back yes
    end
    give back no
  end
  give back no
end

make resolve_cart_record_from_cookie using stmts, req
  if not stmts.commerce_ready
    give back nothing
  end
  set raw_tok to extract_cookie using req, "gl_cart"
  if raw_tok is ""
    give back nothing
  end
  set tok_hash to crypto.sha256_hex using raw_tok
  give back data.one using stmts.commerce.get_cart, record {lookup: "token", sv: tok_hash, iv: 0}
end

make resolve_cart_from_cookie using stmts, req
  set c to resolve_cart_record_from_cookie using stmts, req
  if c is nothing or c.status is not "open"
    give back nothing
  end
  give back c
end

make cart_csrf_matches using req, cart_row
  set hdr to get_req_header using req, "x-csrf-token"
  if hdr is ""
    give back no
  end
  give back (crypto.sha256_hex using hdr) is (crypto.sha256_hex using cart_row.csrf_secret)
end

make rotate_cart_on_auth using stmts, req, attach_user_id
  if not stmts.commerce_ready
    give back no
  end
  set cart to resolve_cart_from_cookie using stmts, req
  if cart is nothing
    give back no
  end
  set now_rec to call dates.now_utc
  set next_tok to crypto.random_urlsafe using 32
  set next_hash to crypto.sha256_hex using next_tok
  set next_csrf to crypto.random_urlsafe using 32
  set next_uid to cart.user_id
  if attach_user_id is not nothing and attach_user_id is greater than 0
    set next_uid to attach_user_id
  otherwise
    if attach_user_id is 0
      set next_uid to nothing
    end
  end
  call data.execute using stmts.commerce.upd_cart, record {token_hash: next_hash, csrf_secret: next_csrf, customer_id: cart.customer_id, user_id: next_uid, status: cart.status, coupon_code: cart.coupon_code, last_activity_at: now_rec.iso, id: cart.id, req_open: 1}
  give back yes
end

make check_commerce_rate_limit using stmts, req, bucket_prefix, limit_n, window_ms
  set ip_hash to crypto.sha256_hex using (text.from using req.client_ip)
  set key to "rl:com:" joined with bucket_prefix joined with ":" joined with ip_hash
  try
    set lim to cache.limit using stmts.cms_cache, key, limit_n, window_ms
    if not lim.allowed
      give back record {ok: no, response: (commerce_error using 429, "rate_limited", "Too many commerce requests; please slow down", "")}
    end
    give back record {ok: yes, response: nothing}
  catch err
    give back record {ok: yes, response: nothing}
  end
end

make check_coupon_rate_limit using stmts, req, cart_id
  set c_key to "rl:cpn:cart:" joined with cart_id
  set ip_key to "rl:cpn:ip:" joined with (crypto.sha256_hex using (text.from using req.client_ip))
  try
    set lim1 to cache.limit using stmts.cms_cache, c_key, 10, 60000
    if not lim1.allowed
      give back record {ok: no, response: (commerce_error using 429, "rate_limited", "Too many coupon attempts on this cart", "")}
    end
    set lim2 to cache.limit using stmts.cms_cache, ip_key, 30, 600000
    if not lim2.allowed
      give back record {ok: no, response: (commerce_error using 429, "rate_limited", "Too many coupon attempts from this client", "")}
    end
  catch err
  end
  give back record {ok: yes, response: nothing}
end

make release_order_reservations_tx using stmts, order_row, next_status, actor, reason, now_iso, tx
  set upd to data.execute using stmts.commerce.upd_order, record {number: order_row.number, status: next_status, needs_review: order_row.needs_review, review_note: order_row.review_note, shipping_address_json: order_row.shipping_address_json, paid_at: order_row.paid_at, payment_ref: order_row.payment_ref, id: order_row.id, req_status: "pending_payment"}, tx
  if upd.rows_affected is not 1
    give back no
  end
  set oitems to data.query using stmts.commerce.list_order_items, record {order_id: order_row.id}, tx
  for each oi in oitems
    call data.execute using stmts.commerce.adj_stock, record {delta: oi.qty, updated_at: now_iso, id: oi.product_id, min_check: 0}, tx
  end
  if order_row.coupon_id is not nothing
    set del_r to data.execute using stmts.commerce.del_coupon_redemption, record {order_id: order_row.id, coupon_id: order_row.coupon_id}, tx
    if del_r.rows_affected is greater than 0
      call data.execute using stmts.commerce.dec_coupon, record {updated_at: now_iso, id: order_row.coupon_id}, tx
    end
  end
  call data.execute using stmts.commerce.ins_order_audit, record {order_id: order_row.id, actor: actor, from_status: "pending_payment", to_status: next_status, reason: reason, created_at: now_iso}, tx
  give back yes
end

make run_commerce_sweep using stmts, force_run
  if not stmts.commerce_ready
    give back record {ran: no, expired_orders: 0, abandoned_carts: 0, emitted_events: 0}
  end
  set cfg to get_commerce_config using stmts
  if not cfg.enabled
    give back record {ran: no, expired_orders: 0, abandoned_carts: 0, emitted_events: 0}
  end
  if not force_run
    try
      set lim to cache.limit using stmts.cms_cache, "commerce:sweep", 1, 300000
      if not lim.allowed
        give back record {ran: no, expired_orders: 0, abandoned_carts: 0, emitted_events: 0}
      end
    catch err
    end
  end
  call ensure_commerce_salt_and_type using stmts
  set cfg to get_commerce_config using stmts
  set now_rec to call dates.now_utc
  set now_iso to now_rec.iso
  set cutoff_unix to now_rec.unix minus (cfg.abandoned_minutes times 60)
  set cutoff_rec to dates.from_unix using cutoff_unix
  set cutoff_iso to cutoff_rec.iso

  set expired_count to 0
  set due_orders to data.query using stmts.commerce.get_orders, record {mode: "due", iv: 0, sv: now_iso}
  for each ord in due_orders
    set tx to data.begin using stmts.db
    try
      set ok_rel to release_order_reservations_tx using stmts, ord, "expired", "system", "payment_due_by_expired", now_iso, tx
      if ok_rel
        set expired_count to expired_count plus 1
      end
      call data.commit using tx
    catch tx_err
      call data.rollback using tx
    end
  end

  set abandoned_count to 0
  set events_count to 0
  set active_theme to get_active_theme_context using stmts
  set registry to build_active_hook_registry using active_theme
  set stale_carts to data.query using stmts.commerce.list_stale_carts, record {cutoff_iso: cutoff_iso}
  for each sc in stale_carts
    set citems to data.query using stmts.commerce.list_cart_items, record {cart_id: sc.id}
    if (collections.length using citems) is greater than 0
      set sub_cents to 0
      set ev_items to []
      for each ci in citems
        set sub_cents to sub_cents plus (ci.qty times ci.live_price_cents)
        set ev_items to collections.append using ev_items, {"sku": ci.sku, "title": ci.title, "qty": ci.qty, "unit_price": (format_cents_usd using ci.live_price_cents), "url": ci.full_path}
      end
      set full_cart to data.one using stmts.commerce.get_cart, record {lookup: "id", sv: sc.id, iv: 0}
      if full_cart is not nothing and full_cart.status is "open"
        set tx2 to data.begin using stmts.db
        try
          set u2 to data.execute using stmts.commerce.upd_cart, record {token_hash: full_cart.token_hash, csrf_secret: full_cart.csrf_secret, customer_id: full_cart.customer_id, user_id: full_cart.user_id, status: "abandoned", coupon_code: full_cart.coupon_code, last_activity_at: sc.last_activity_at, id: sc.id, req_open: 1}, tx2
          if u2.rows_affected is 1
            set abandoned_count to abandoned_count plus 1
            if sc.marketing_consent is 1
              set ex_ev to data.one using stmts.commerce.commerce_events, record {mode: "one", after_id: 0, sv: "commerce:abandoned_checkout", subj: sc.id, lim: 1}, tx2
              if ex_ev is nothing
                set e_hash to "sha256:" joined with (crypto.sha256_hex using (cfg.email_salt joined with sc.email))
                set ev_payload to {"name": "commerce:abandoned_checkout", "version": 1, "cart_id": sc.id, "email_hash": e_hash, "marketing_consent": 1, "currency": sc.currency, "subtotal": (format_cents_usd using sub_cents), "items": ev_items, "last_activity_at": sc.last_activity_at}
                call data.execute using stmts.commerce.ins_commerce_event, record {name: "commerce:abandoned_checkout", subject_id: sc.id, payload_json: (json.stringify using ev_payload), created_at: now_iso}, tx2
                set events_count to events_count plus 1
                call data.commit using tx2
                call runHook using stmts, registry, "commerce:abandoned_checkout", ev_payload
              otherwise
                call data.commit using tx2
              end
            otherwise
              call data.commit using tx2
            end
          otherwise
            call data.commit using tx2
          end
        catch tx2_err
          call data.rollback using tx2
        end
      end
    end
  end
  give back record {ran: yes, expired_orders: expired_count, abandoned_carts: abandoned_count, emitted_events: events_count}
end

make build_cart_response_payload using stmts, cart_row
  set cfg to get_commerce_config using stmts
  set now_rec to call dates.now_utc
  set items to data.query using stmts.commerce.list_cart_items, record {cart_id: cart_row.id}
  set carrier_res to validate_carrier_constraints using items
  set coupon_row to nothing
  set coupon_warning to ""
  if cart_row.coupon_code is not nothing and cart_row.coupon_code is not ""
    set c_cand to data.one using stmts.commerce.get_coupons, record {mode: "code", iv: 0, sv: cart_row.coupon_code}
    set sub_tmp to 0
    for each it in items
      set sub_tmp to sub_tmp plus (it.live_price_cents times it.qty)
    end
    set v_res to validate_coupon_for_cart using stmts, c_cand, sub_tmp, now_rec.iso
    if v_res.ok
      set coupon_row to c_cand
    otherwise
      set coupon_warning to v_res.reason
    end
  end
  set tot to compute_cart_totals using items, coupon_row, cfg, carrier_res
  set out_items to []
  for each it in items
    set line_cents to it.live_price_cents times it.qty
    set out_items to collections.append using out_items, {"product_id": it.product_id, "sku": it.sku, "title": it.title, "slug": it.slug, "url": it.full_path, "kind": it.kind, "qty": it.qty, "unit_price": (format_cents_usd using it.live_price_cents), "line_total": (format_cents_usd using line_cents), "tax_class": it.tax_class, "carrier": it.carrier, "usps_service": it.usps_service, "weight_g": it.weight_g}
  end
  set ccode to ""
  if coupon_row is not nothing
    set ccode to coupon_row.code
  end
  set sub_str to "0.00"
  set disc_str to "0.00"
  set tax_str to "0.00"
  set ship_str to "0.00"
  set tot_str to "0.00"
  if tot.ok
    set sub_str to format_cents_usd using tot.subtotal_cents
    set disc_str to format_cents_usd using tot.discount_cents
    set tax_str to format_cents_usd using tot.tax_cents
    set ship_str to format_cents_usd using tot.shipping_cents
    set tot_str to format_cents_usd using tot.total_cents
  end
  give back {"cart_id": cart_row.id, "currency": cart_row.currency, "coupon_code": ccode, "coupon_warning": coupon_warning, "has_physical": carrier_res.has_physical, "items": out_items, "subtotal": sub_str, "discount_total": disc_str, "tax_total": tax_str, "shipping_total": ship_str, "total": tot_str, "carrier_valid": carrier_res.ok, "carrier_error": carrier_res.message}
end

make mask_email using raw_email
  set e to text.trim using (text.from using raw_email)
  set parts to text.split using e, "@"
  if (collections.length using parts) is not 2
    give back "***"
  end
  set loc to parts at 0
  set dom to parts at 1
  set chars to text.split using loc, ""
  set prefix to "***"
  if (collections.length using chars) is at least 1
    set prefix to (chars at 0) joined with "***"
  end
  give back prefix joined with "@" joined with dom
end

make format_product_api_row using p
  set comp to nothing
  if p.compare_at_cents is not nothing
    set comp to format_cents_usd using p.compare_at_cents
  end
  set qty_out to nothing
  if p.stock_qty is not nothing
    set qty_out to p.stock_qty
  end
  give back {"id": p.id, "entry_id": p.entry_id, "sku": p.sku, "title": p.title, "slug": p.slug, "url": p.full_path, "status": p.status, "kind": p.kind, "price": (format_cents_usd using p.price_cents), "compare_at_price": comp, "currency": p.currency, "stock_qty": qty_out, "weight_g": p.weight_g, "tax_class": p.tax_class, "active": (p.active is 1), "carrier": p.carrier, "lulu_sku": p.lulu_sku, "usps_service": p.usps_service, "max_weight_g": p.max_weight_g, "media_mail_eligible": (p.media_mail_eligible is 1), "ships_from_country": p.ships_from_country, "meta_description": p.meta_description, "custom_fields_json": p.custom_fields_json}
end

# ==============================================================================
# Module 10: Author Mode (v1.4.0) Helpers, ADR-025c Validators & JSON-LD
# ==============================================================================

make author_error using status_code, err_code, msg, field_name, reason
  give back server.json using status_code, {"error": err_code, "message": msg, "field": field_name, "reason": reason}
end

make get_author_config using stmts
  set settings to get_site_settings_map using stmts
  set enabled to no
  if (has_map_key using settings, "author_mode_enabled") and ((settings at "author_mode_enabled") is "1")
    set enabled to yes
  end
  set origin to ""
  if has_map_key using settings, "groxy_ai_origin"
    set origin to text.trim using (text.from using (settings at "groxy_ai_origin"))
  end
  give back record {enabled: enabled, groxy_ai_origin: origin}
end

make ensure_author_types using stmts
  set now_rec to call dates.now_utc
  set now_iso to now_rec.iso
  set settings to get_site_settings_map using stmts
  if not (has_map_key using settings, "author_mode_enabled")
    call upsert_setting using stmts, "author_mode_enabled", "0", now_iso, nothing
  end
  if not (has_map_key using settings, "groxy_ai_origin")
    call upsert_setting using stmts, "groxy_ai_origin", "", now_iso, nothing
  end
  set author_types to [record {slug: "author", singular: "Author", plural: "Authors", pattern: "/authors/:slug", has_archive: 1, archive_slug: "authors"}, record {slug: "series", singular: "Series", plural: "Series", pattern: "/series/:slug", has_archive: 1, archive_slug: "series"}, record {slug: "book", singular: "Book", plural: "Books", pattern: "/books/:slug", has_archive: 1, archive_slug: "books"}, record {slug: "chapter", singular: "Chapter", plural: "Chapters", pattern: "/books/chapter/:slug", has_archive: 0, archive_slug: nothing}]
  for each ct in author_types
    set existing to data.one using stmts.get_type, record {lookup: "slug", sv: ct.slug, iv: 0}
    if existing is nothing
      call data.execute using stmts.insert_type, record {slug: ct.slug, label_singular: ct.singular, label_plural: ct.plural, permalink_pattern: ct.pattern, has_archive: ct.has_archive, archive_slug: ct.archive_slug, is_system: 1, created_at: now_iso}
    end
  end
  set book_row to data.one using stmts.get_type, record {lookup: "slug", sv: "book", iv: 0}
  if book_row is not nothing
    set book_fields to [record {key: "isbn_13", label: "ISBN-13", ftype: "text", sort: 1}, record {key: "asin", label: "ASIN", ftype: "text", sort: 2}, record {key: "subtitle", label: "Subtitle", ftype: "text", sort: 3}, record {key: "list_price", label: "List Price (USD)", ftype: "decimal", sort: 4}]
    for each bf in book_fields
      set ef to data.one using stmts.get_field_by_key, record {content_type_id: book_row.id, field_key: bf.key}
      if ef is nothing
        call data.execute using stmts.insert_field, record {content_type_id: book_row.id, field_key: bf.key, label: bf.label, field_type: bf.ftype, is_required: 0, default_value: "", sort_order: bf.sort}
      end
    end
  end
  call cache.delete using stmts.cms_cache, "site_settings"
end

make invalidate_author_caches using stmts, book_id, series_id, chapter_id, author_id
  if book_id is not nothing and book_id is greater than 0
    call cache.delete using stmts.cms_cache, ("author:book:" joined with (text.from using book_id))
  end
  if series_id is not nothing and series_id is greater than 0
    call cache.delete using stmts.cms_cache, ("author:series:" joined with (text.from using series_id))
  end
  if chapter_id is not nothing and chapter_id is greater than 0
    call cache.delete using stmts.cms_cache, ("author:chapter:" joined with (text.from using chapter_id))
  end
  if author_id is not nothing and author_id is greater than 0
    call cache.delete using stmts.cms_cache, ("author:author:" joined with (text.from using author_id))
  end
  call cache.delete using stmts.cms_cache, "author:books:catalog"
  call cache.delete using stmts.cms_cache, "site_settings"
  call bump_cache_epoch using stmts, "cache_epoch:author"
  call bump_query_cache_epochs using stmts, "book"
  call bump_query_cache_epochs using stmts, "series"
  call bump_query_cache_epochs using stmts, "chapter"
  call bump_query_cache_epochs using stmts, "author"
end

make require_author_admin_api using stmts, req, cap, require_csrf
  set bearer to extract_bearer_token using req
  if bearer is not ""
    give back record {ok: no, session: nothing, response: (author_error using 401, "mcp_bearer_forbidden", "MCP Bearer tokens are forbidden on /api/admin/author/* routes", "", "bearer_rejected")}
  end
  give back require_api_auth using stmts, req, cap, require_csrf
end

make check_author_rate_limit using stmts, req, sess, bucket_name
  set key_in to "rl:author:" joined with bucket_name joined with ":" joined with (text.from using sess.user_id) joined with ":" joined with (crypto.sha256_hex using (text.from using req.client_ip))
  try
    set lim to cache.limit using stmts.cms_cache, key_in, 30, 60000
    if not lim.allowed
      give back record {ok: no, response: (server.response using record {status: 429, headers: {"Content-Type": "application/json; charset=utf-8", "Retry-After": "60", "Cache-Control": "no-store"}, body: (json.stringify using {"error": "rate_limited", "message": "Too many author bridge requests; retry shortly"})})}
    end
    give back record {ok: yes, response: nothing}
  catch err
    give back record {ok: yes, response: nothing}
  end
end

make is_private_or_metadata_host using host_lower
  if host_lower is "" or host_lower is "localhost" or (text.ends_with using host_lower, ".localhost") or (text.ends_with using host_lower, ".local") or (text.ends_with using host_lower, ".internal")
    give back yes
  end
  if host_lower is "0.0.0.0" or host_lower is "metadata.google.internal" or host_lower is "[::1]" or host_lower is "::1" or host_lower is "localhost.localdomain"
    give back yes
  end
  if (text.starts_with using host_lower, "127.") or (text.starts_with using host_lower, "10.") or (text.starts_with using host_lower, "169.254.") or (text.starts_with using host_lower, "192.168.") or (text.starts_with using host_lower, "0.")
    give back yes
  end
  if text.starts_with using host_lower, "172."
    set octs to text.split using host_lower, "."
    if (collections.length using octs) is 4
      set second_s to octs at 1
      if is_ascii_digits using second_s
        set sec_num to text.to_integer using second_s
        if sec_num is at least 16 and sec_num is at most 31
          give back yes
        end
      end
    end
  end
  give back no
end

make validate_groxy_origin using raw_origin, allow_empty
  set u to text.trim using raw_origin
  if u is ""
    if allow_empty
      give back record {ok: yes, origin: "", error: ""}
    end
    give back record {ok: no, origin: "", error: "GRAB-E402: groxy_ai_origin is not configured"}
  end
  if (text.contains using u, " ") or (text.contains using u, "\r") or (text.contains using u, "\n") or (text.contains using u, "\t") or (text.contains using u, "\\") or (text.contains using u, "?") or (text.contains using u, "#") or (text.contains using u, "@")
    give back record {ok: no, origin: "", error: "GRAB-E402: groxy_ai_origin contains forbidden whitespace, userinfo, query, or fragment"}
  end
  set u_lower to text.lower using u
  set is_local_worker to text.starts_with using u_lower, "http://127.0.0.1:"
  set is_https to text.starts_with using u_lower, "https://"
  if (not is_local_worker) and (not is_https)
    give back record {ok: no, origin: "", error: "GRAB-E402: groxy_ai_origin must use https:// or http://127.0.0.1:<port>"}
  end
  set scheme_len to 8
  if is_local_worker
    set scheme_len to 7
  end
  set chars to text.split using u, ""
  set rest_chars to collections.slice using chars, scheme_len, (collections.length using chars)
  set authority to text.join using rest_chars, ""
  if authority is "" or (text.contains using authority, "/")
    give back record {ok: no, origin: "", error: "GRAB-E402: groxy_ai_origin must be an exact origin without trailing slash or path"}
  end
  set hp to text.split using authority, ":"
  if (collections.length using hp) is greater than 2
    give back record {ok: no, origin: "", error: "GRAB-E402: malformed host:port in groxy_ai_origin"}
  end
  set host_lower to text.lower using (hp at 0)
  if (collections.length using hp) is 2
    set port_s to hp at 1
    if not (is_ascii_digits using port_s) or (text.length using port_s) is greater than 5
      give back record {ok: no, origin: "", error: "GRAB-E402: invalid port in groxy_ai_origin"}
    end
    set pnum to text.to_integer using port_s
    if pnum is less than 1 or pnum is greater than 65535
      give back record {ok: no, origin: "", error: "GRAB-E402: port out of range in groxy_ai_origin"}
    end
  end
  if is_local_worker
    if host_lower is not "127.0.0.1" or (collections.length using hp) is not 2
      give back record {ok: no, origin: "", error: "GRAB-E402: loopback worker origin must be http://127.0.0.1:<port>"}
    end
    give back record {ok: yes, origin: ("http://127.0.0.1:" joined with (hp at 1)), error: ""}
  end
  if not (is_allowed_chars using host_lower, "abcdefghijklmnopqrstuvwxyz0123456789.-", 1, 253)
    give back record {ok: no, origin: "", error: "GRAB-E402: invalid hostname characters in groxy_ai_origin"}
  end
  if (text.starts_with using host_lower, ".") or (text.ends_with using host_lower, ".") or (text.contains using host_lower, "..") or (not (text.contains using host_lower, "."))
    give back record {ok: no, origin: "", error: "GRAB-E402: malformed public hostname in groxy_ai_origin"}
  end
  if is_private_or_metadata_host using host_lower
    give back record {ok: no, origin: "", error: "GRAB-E402: private, loopback, or cloud metadata hosts are blocked"}
  end
  set norm_origin to "https://" joined with host_lower
  if (collections.length using hp) is 2
    set norm_origin to norm_origin joined with ":" joined with (hp at 1)
  end
  give back record {ok: yes, origin: norm_origin, error: ""}
end

make is_author_reserved_slug using raw_slug, full_path
  set s to normalize_slug using raw_slug
  set reserved_segs to ["admin", "api", "static", "_health", "_ready", "shop", "login", "logout", "setup", "search", "media", "chapter", "sample"]
  for each r in reserved_segs
    if s is r
      give back yes
    end
  end
  if (text.starts_with using s, "admin") or (text.starts_with using s, "api") or (text.starts_with using s, "static") or (text.starts_with using s, "_health") or (text.starts_with using s, "_ready")
    if s is "admin" or s is "api" or s is "static" or s is "_health" or s is "_ready"
      give back yes
    end
  end
  if is_reserved_path using full_path
    give back yes
  end
  give back no
end

make parse_author_money_cents using raw_val, field_name
  if raw_val is nothing
    give back record {ok: no, cents: 0, formatted: "", reason: "missing_field", error: (field_name joined with " is required")}
  end
  set p to parse_money_cents using raw_val, yes, 999999999
  if not p.ok
    set rsn to p.code
    if rsn is not "float_not_allowed"
      set rsn to p.code
    end
    give back record {ok: no, cents: 0, formatted: "", reason: rsn, error: p.error}
  end
  give back record {ok: yes, cents: p.cents, formatted: p.formatted, reason: "", error: ""}
end

make parse_author_royalty_bp using raw_val, field_name
  if raw_val is nothing
    give back record {ok: no, bp: 0, formatted: "", reason: "missing_field", error: (field_name joined with " is required")}
  end
  set p to parse_money_cents using raw_val, yes, 10000
  if not p.ok
    give back record {ok: no, bp: 0, formatted: "", reason: p.code, error: p.error}
  end
  give back record {ok: yes, bp: p.cents, formatted: p.formatted, reason: "", error: ""}
end

make parse_author_int using raw_val, min_v, max_v
  set p to parse_grab_integer using raw_val, min_v, max_v
  if not p.ok
    give back record {ok: no, val: 0, reason: p.code, error: p.error}
  end
  give back record {ok: yes, val: p.val, reason: "", error: ""}
end

make validate_isbn13_strict using raw_val
  if raw_val is nothing
    give back record {ok: yes, canonical: "", error: ""}
  end
  set s to ""
  try
    set s to text.trim using raw_val
  catch err
    give back record {ok: no, canonical: "", error: "ISBN-13 must be a string"}
  end
  if s is ""
    give back record {ok: yes, canonical: "", error: ""}
  end
  if not (is_valid_isbn13 using s)
    give back record {ok: no, canonical: "", error: "ISBN-13 must be 13 digits with a valid GS1 check digit"}
  end
  set cleaned to text.replace using (text.replace using s, "-", ""), " ", ""
  give back record {ok: yes, canonical: cleaned, error: ""}
end

make validate_asin_strict using raw_val
  if raw_val is nothing
    give back record {ok: yes, canonical: "", error: ""}
  end
  set s to ""
  try
    set s to text.trim using raw_val
  catch err
    give back record {ok: no, canonical: "", error: "ASIN must be a string"}
  end
  if s is ""
    give back record {ok: yes, canonical: "", error: ""}
  end
  if not (is_allowed_chars using s, "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789", 10, 10)
    give back record {ok: no, canonical: "", error: "ASIN must match ^[A-Z0-9]{10}$"}
  end
  give back record {ok: yes, canonical: s, error: ""}
end

make serialize_safe_jsonld using obj
  set raw to json.stringify using obj
  set out to text.replace using raw, "&", "\\u0026"
  set out to text.replace using out, "<", "\\u003c"
  set out to text.replace using out, ">", "\\u003e"
  set out to text.replace using out, "</", "\\u003c/"
  give back out
end

make map_book_format_schema using edition_fmt
  if edition_fmt is "ebook"
    give back "https://schema.org/EBook"
  end
  if edition_fmt is "hardcover"
    give back "https://schema.org/Hardcover"
  end
  give back "https://schema.org/Paperback"
end

make build_book_jsonld using stmts, book_row
  set price_cents to book_row.list_price_cents
  set avail_schema to "https://schema.org/InStock"
  if stmts.commerce_ready and book_row.product_id is not nothing
    set prod to data.one using stmts.commerce.products, record {mode: "id", iv: book_row.product_id, sv: ""}
    if prod is not nothing
      set price_cents to prod.price_cents
      if prod.kind is not "digital" and prod.stock_qty is not nothing and prod.stock_qty is at most 0
        set avail_schema to "https://schema.org/OutOfStock"
      end
    end
  end
  set price_str to format_cents_usd using price_cents
  set ld to {"@context": "https://schema.org", "@type": "Book", "name": book_row.title, "author": {"@type": "Person", "name": book_row.author_pen_name}, "bookFormat": (map_book_format_schema using book_row.edition_format), "inLanguage": book_row.in_language, "description": book_row.blurb, "offers": {"@type": "Offer", "priceCurrency": book_row.currency, "price": price_str, "availability": avail_schema}}
  if book_row.isbn_13 is not ""
    set ld to collections.put using ld, "isbn", book_row.isbn_13
  end
  if book_row.page_count is greater than 0
    set ld to collections.put using ld, "numberOfPages", book_row.page_count
  end
  if book_row.genre_slug is not ""
    set ld to collections.put using ld, "genre", book_row.genre_slug
  end
  if book_row.series_id is not nothing and book_row.series_title is not nothing
    set part_of to {"@type": "BookSeries", "name": book_row.series_title}
    if book_row.series_position is not nothing
      set part_of to collections.put using part_of, "position", book_row.series_position
    end
    set ld to collections.put using ld, "isPartOf", part_of
  end
  give back serialize_safe_jsonld using ld
end

make build_series_jsonld using stmts, series_row, book_rows
  set parts to []
  for each b in book_rows
    if b.status is "published" and b.active is 1
      set p_cents to b.list_price_cents
      if stmts.commerce_ready and b.product_id is not nothing
        set prod to data.one using stmts.commerce.products, record {mode: "id", iv: b.product_id, sv: ""}
        if prod is not nothing
          set p_cents to prod.price_cents
        end
      end
      set b_obj to {"@type": "Book", "name": b.title, "url": b.full_path, "offers": {"@type": "Offer", "priceCurrency": b.currency, "price": (format_cents_usd using p_cents)}}
      if b.series_position is not nothing
        set b_obj to collections.put using b_obj, "position", b.series_position
      end
      set parts to collections.append using parts, b_obj
    end
  end
  set ld to {"@context": "https://schema.org", "@type": "BookSeries", "name": series_row.title, "author": {"@type": "Person", "name": series_row.author_pen_name}, "genre": series_row.genre_slug, "hasPart": parts}
  give back serialize_safe_jsonld using ld
end

make format_author_api_row using a
  give back {"id": a.id, "entry_id": a.entry_id, "pen_name": a.pen_name, "bio_summary": a.bio_summary, "website_url": a.website_url, "social_links_json": a.social_links_json, "active": (a.active is 1), "slug": a.slug, "full_path": a.full_path, "title": a.title, "status": a.status, "created_at": a.created_at, "updated_at": a.updated_at}
end

make format_series_api_row using s
  give back {"id": s.id, "entry_id": s.entry_id, "author_id": s.author_id, "author_pen_name": s.author_pen_name, "title": s.title, "slug": s.slug, "full_path": s.full_path, "status": s.status, "genre_slug": s.genre_slug, "reading_order_mode": s.reading_order_mode, "total_planned_books": s.total_planned_books, "active": (s.active is 1), "created_at": s.created_at, "updated_at": s.updated_at}
end

make format_book_api_row using b
  give back {"id": b.id, "entry_id": b.entry_id, "author_id": b.author_id, "author_pen_name": b.author_pen_name, "series_id": b.series_id, "series_position": b.series_position, "series_title": b.series_title, "title": b.title, "slug": b.slug, "full_path": b.full_path, "status": b.status, "subtitle": b.subtitle, "isbn_13": b.isbn_13, "asin": b.asin, "edition_format": b.edition_format, "page_count": b.page_count, "word_count": b.word_count, "in_language": b.in_language, "genre_slug": b.genre_slug, "blurb": b.blurb, "list_price": (format_cents_usd using b.list_price_cents), "royalty_rate": (format_cents_usd using b.royalty_rate_bp), "currency": b.currency, "product_id": b.product_id, "cover_media_id": b.cover_media_id, "active": (b.active is 1), "created_at": b.created_at, "updated_at": b.updated_at}
end

make format_chapter_api_row using c
  set r_grade to nothing
  if c.readability_grade_bp is not nothing
    set r_grade to format_cents_usd using c.readability_grade_bp
  end
  give back {"id": c.id, "entry_id": c.entry_id, "book_id": c.book_id, "book_slug": c.book_slug, "book_title": c.book_title, "title": c.title, "slug": c.slug, "full_path": c.full_path, "status": c.status, "chapter_number": c.chapter_number, "sort_order": c.sort_order, "is_sample": (c.is_sample is 1), "word_count": c.word_count, "reading_minutes": c.reading_minutes, "cliffhanger_hook": c.cliffhanger_hook, "readability_grade": r_grade, "readability_score": c.readability_score, "created_at": c.created_at, "updated_at": c.updated_at}
end

make groxy_fetch_csrf using origin_url
  try
    set resp to http.get using (origin_url joined with "/groxy"), record {timeout_ms: 4000}
    if resp.ok and resp.body is not nothing
      set marker to "name=\"groxy-csrf\" content=\""
      if text.contains using resp.body, marker
        set p1 to text.split using resp.body, marker
        if (collections.length using p1) is at least 2
          set p2 to text.split using (p1 at 1), "\""
          give back text.trim using (p2 at 0)
        end
      end
    end
  catch err
  end
  give back ""
end

make is_hex_str using raw_s, exact_len
  set s to text.lower using (text.trim using raw_s)
  if (text.length using s) is not exact_len
    give back no
  end
  give back is_allowed_chars using s, "0123456789abcdef", exact_len, exact_len
end

make is_valid_radar_token using tok
  if text.starts_with using tok, "rtok_res_"
    set rest to text.replace using tok, "rtok_res_", ""
    give back is_hex_str using rest, 64
  end
  if text.starts_with using tok, "atok_"
    set rest to text.replace using tok, "atok_", ""
    give back is_hex_str using rest, 64
  end
  give back no
end

make ensure_default_author_for_user using stmts, user_id, pen_name_hint, now_iso, tx
  set existing_list to data.query using stmts.author.authors, record {mode: "owner", iv: user_id, sv: ""}, tx
  if (collections.length using existing_list) is greater than 0
    give back existing_list at 0
  end
  set all_list to data.query using stmts.author.authors, record {mode: "all", iv: 0, sv: ""}, tx
  if (collections.length using all_list) is greater than 0
    give back all_list at 0
  end
  set ct_a to data.one using stmts.get_type, record {lookup: "slug", sv: "author", iv: 0}, tx
  set a_slug to "author-" joined with (text.from using user_id)
  set a_path to "/authors/" joined with a_slug
  set a_pen to text.trim using pen_name_hint
  if a_pen is ""
    set a_pen to "GrabLab Author"
  end
  set dup_e to data.one using stmts.get_entry_by_full_path, record {full_path: a_path}, tx
  if dup_e is nothing
    call data.execute using stmts.insert_entry, record {content_type_id: ct_a.id, slug: a_slug, full_path: a_path, title: a_pen, status: "draft", body_html: "", custom_fields_json: "{}", meta_title: a_pen, meta_description: "", author_id: user_id, published_at: nothing, created_at: now_iso, updated_at: now_iso}, tx
    set dup_e to data.one using stmts.get_entry_by_full_path, record {full_path: a_path}, tx
  end
  call data.execute using stmts.author.ins_author, record {entry_id: dup_e.id, pen_name: a_pen, bio_summary: "", website_url: "", social_links_json: "{}", active: 1, created_at: now_iso, updated_at: now_iso}, tx
  give back data.one using stmts.author.authors, record {mode: "entry", iv: dup_e.id, sv: ""}, tx
end

make resolve_mcp_principal using stmts, req
  set bearer to extract_bearer_token using req
  if bearer is not ""
    set sess to resolve_session_token using stmts, bearer
    if sess is nothing
      give back record {ok: no, status: 401, session: nothing, via_bearer: yes, error: "Invalid or expired MCP bearer token"}
    end
    give back record {ok: yes, status: 200, session: sess, via_bearer: yes, error: ""}
  end
  set csess to resolve_session using stmts, req
  if csess is nothing
    give back record {ok: no, status: 401, session: nothing, via_bearer: no, error: "MCP authentication required (Bearer token or valid session)"}
  end
  if not (csrf_matches using req, csess)
    give back record {ok: no, status: 403, session: nothing, via_bearer: no, error: "Missing or invalid X-CSRF-Token for cookie-authenticated MCP call"}
  end
  give back record {ok: yes, status: 200, session: csess, via_bearer: no, error: ""}
end

make mcp_tool_schemas using stmts
  set tools to [record {name: "list_content_types", description: "List registered GrabLab content types and field definitions", inputSchema: (record {type: "object", properties: {}})}, record {name: "query_entries", description: "Query CMS entries with optional content_type, status, field filters, filter_by_term, search, sorting, and pagination", inputSchema: (record {type: "object", properties: {"content_type": {"type": "string"}, "content_type_slug": {"type": "string"}, "status": {"type": "string"}, "field_key": {"type": "string"}, "field_op": {"type": "string"}, "field_value": {"type": "string"}, "filter_by_term": {"type": "object"}, "search": {"type": "string"}, "sort_by": {"type": "string"}, "sort_dir": {"type": "string"}, "page": {"type": "integer"}, "per_page": {"type": "integer"}, "limit": {"type": "integer"}, "offset": {"type": "integer"}}})}, record {name: "create_entry_draft", description: "Create a new draft entry (status is always forced to draft); validates optional grex_layout via grex.elements.json and WCAG AA guardrails", inputSchema: (record {type: "object", required: ["slug", "title"], properties: {"content_type": {"type": "string"}, "content_type_slug": {"type": "string"}, "slug": {"type": "string"}, "title": {"type": "string"}, "excerpt": {"type": "string"}, "body": {"type": "string"}, "body_html": {"type": "string"}, "custom_fields": {"type": "object"}, "grex_layout": {"type": "object"}, "layout": {"type": "object"}, "meta_title": {"type": "string"}, "meta_description": {"type": "string"}, "term_ids": {"type": "array"}}})}, record {name: "update_entry_layout", description: "Update an entry's Grex layout after grex.elements.json and WCAG AA auditAccessibility validation", inputSchema: (record {type: "object", required: ["entry_id"], properties: {"entry_id": {"type": "integer"}, "layout": {"type": "object"}, "grex_layout": {"type": "object"}}})}, record {name: "list_media", description: "List uploaded media assets", inputSchema: (record {type: "object", properties: {"mime_prefix": {"type": "string"}, "limit": {"type": "integer"}, "offset": {"type": "integer"}}})}, record {name: "list_menus", description: "List menus and resolved menu item hierarchies (optionally filtered by location)", inputSchema: (record {type: "object", properties: {"location": {"type": "string"}}})}]
  if stmts.commerce_ready
    set cfg to get_commerce_config using stmts
    if cfg.enabled
      set tools to collections.append using tools, (record {name: "list_commerce_events", description: "Read commerce events (including consented commerce:abandoned_checkout triggers) in ascending id order", inputSchema: (record {type: "object", properties: {"name": {"type": "string"}, "after_id": {"type": "integer"}, "limit": {"type": "integer"}}})})
      set tools to collections.append using tools, (record {name: "create_coupon_draft", description: "Create an inactive coupon draft (active is always forced to 0; max_redemptions <= 1000; percent_bp <= 5000)", inputSchema: (record {type: "object", required: ["code", "type", "value", "min_subtotal", "max_redemptions"], properties: {"code": {"type": "string"}, "type": {"type": "string"}, "value": {"type": "integer"}, "min_subtotal": {"type": "string"}, "max_redemptions": {"type": "integer"}, "starts_at": {"type": "string"}, "ends_at": {"type": "string"}}})})
    end
  end
  if stmts.author_ready
    set acfg to get_author_config using stmts
    if acfg.enabled
      set tools to collections.append using tools, (record {name: "list_author_catalog", description: "Read-only inspection of authors, series, books, and chapters metadata (exact ADR-025c strings)", inputSchema: (record {type: "object", properties: {"author_id": {"type": "integer"}, "series_id": {"type": "integer"}, "genre_slug": {"type": "string"}, "status": {"type": "string"}}})})
      set tools to collections.append using tools, (record {name: "create_book_draft", description: "Create a draft book (and optional draft chapters) strictly with status_enforced: draft; never modifies products", inputSchema: (record {type: "object", required: ["slug", "title"], properties: {"slug": {"type": "string"}, "title": {"type": "string"}, "subtitle": {"type": "string"}, "author_id": {"type": "integer"}, "series_id": {"type": "integer"}, "series_position": {"type": "integer"}, "isbn_13": {"type": "string"}, "asin": {"type": "string"}, "edition_format": {"type": "string"}, "page_count": {"type": "integer"}, "word_count": {"type": "integer"}, "in_language": {"type": "string"}, "genre_slug": {"type": "string"}, "blurb": {"type": "string"}, "list_price": {"type": "string"}, "royalty_rate": {"type": "string"}, "chapters": {"type": "array"}}})})
    end
  end
  give back tools
end

make execute_mcp_tool using stmts, sess, tool_name, args
  if args is nothing
    set args to {}
  end
  if not (is_record_value using args)
    give back record {ok: no, status: 400, payload: record {error: "MCP arguments must be a JSON object", code: -32602}}
  end

  if tool_name is "list_content_types"
    if not (role_has_capability using sess.role, "admin:access")
      give back record {ok: no, status: 403, payload: record {error: "Forbidden: insufficient capability for list_content_types"}}
    end
    set types to data.query using stmts.get_type, record {lookup: "all", sv: "", iv: 0}
    set out to []
    for each ct in types
      set fields to data.query using stmts.get_field_by_key, record {content_type_id: ct.id, field_key: ""}
      set out to collections.append using out, record {id: ct.id, slug: ct.slug, label_singular: ct.label_singular, label_plural: ct.label_plural, permalink_pattern: ct.permalink_pattern, has_archive: (ct.has_archive is 1), archive_slug: ct.archive_slug, fields: fields}
    end
    give back record {ok: yes, status: 200, payload: record {content_types: out}}
  end

  if tool_name is "query_entries"
    set req_status to "published"
    if args has "status" and (args at "status") is not nothing
      set req_status to text.lower using (text.trim using (text.from using (args at "status")))
    end
    if sess.role is "viewer" and req_status is not "published"
      give back record {ok: no, status: 403, payload: record {error: "Forbidden: viewer role cannot read non-published entries"}}
    end
    set limit_val to 20
    if args has "per_page" and (args at "per_page") is not nothing
      set limit_val to math.clamp using (text.to_integer using (text.from using (args at "per_page"))), 1, 100
    end
    if args has "limit" and (args at "limit") is not nothing
      set limit_val to math.clamp using (text.to_integer using (text.from using (args at "limit"))), 1, 100
    end
    set offset_val to 0
    set page_num to 1
    if args has "page" and (args at "page") is not nothing
      set page_num to math.max using 1, (text.to_integer using (text.from using (args at "page")))
      set offset_val to (page_num minus 1) times limit_val
    end
    if args has "offset" and (args at "offset") is not nothing
      set offset_val to math.max using 0, (text.to_integer using (text.from using (args at "offset")))
      set page_num to (math.floor using (offset_val divided by limit_val)) plus 1
    end
    set q_map to {"status": req_status, "per_page": (text.from using limit_val), "page": (text.from using page_num)}
    set ct_arg to ""
    if args has "content_type" and (args at "content_type") is not nothing
      set ct_arg to text.from using (args at "content_type")
    otherwise
      if args has "content_type_slug" and (args at "content_type_slug") is not nothing
        set ct_arg to text.from using (args at "content_type_slug")
      end
    end
    if ct_arg is not ""
      set q_map to collections.put using q_map, "content_type", ct_arg
    end
    for each qk in ["filter_by_term", "search", "field_key", "field_op", "field_value", "sort_by", "sort_dir"]
      if args has qk and (args at qk) is not nothing
        if qk is "filter_by_term"
          set q_map to collections.put using q_map, qk, (args at qk)
        otherwise
          set q_map to collections.put using q_map, qk, (text.from using (args at qk))
        end
      end
    end
    set theme to get_active_theme_context using stmts
    set registry to build_active_hook_registry using theme
    if sess.role is "author"
      set norm_a to normalize_query_args using q_map, no
      if not norm_a.ok
        give back record {ok: no, status: 400, payload: record {error: norm_a.error, code: -32602}}
      end
      set aargs to norm_a.args
      set raw_rows to data.query using stmts.get_entry_by_id, record {id: 0}
      set matched_rows to []
      for each r in raw_rows
        set can_see to (r.status is "published") or (r.author_id is not nothing and r.author_id is sess.user_id)
        if req_status is not "all" and r.status is not req_status
          set can_see to no
        end
        if can_see and aargs.content_type is not "" and r.content_type_slug is not aargs.content_type
          set can_see to no
        end
        if can_see and (not (matches_custom_field_filter using r.custom_fields_json, aargs.field_key, aargs.field_op, aargs.field_value))
          set can_see to no
        end
        if can_see and (not (matches_search_text using r, aargs.search))
          set can_see to no
        end
        if can_see
          set matched_rows to collections.append using matched_rows, (format_query_item using r)
        end
      end
      set total_items to collections.length using matched_rows
      set start_idx to (aargs.page minus 1) times aargs.per_page
      set paged_items to []
      if start_idx is less than total_items
        set end_idx to math.min using total_items, (start_idx plus aargs.per_page)
        set paged_items to collections.slice using matched_rows, start_idx, end_idx
      end
      set total_pages to compute_total_pages using total_items, aargs.per_page
      give back record {ok: yes, status: 200, payload: record {items: paged_items, pagination: record {page: aargs.page, per_page: aargs.per_page, total_items: total_items, total_pages: total_pages, has_prev: (aargs.page is greater than 1 and total_pages is greater than 0), has_next: (aargs.page is less than total_pages)}}}
    end
    set is_pub_q to (sess.role is "viewer")
    set qres to query_entries using stmts, theme, registry, q_map, is_pub_q
    if not qres.ok
      give back record {ok: no, status: 400, payload: record {error: qres.error, code: -32602}}
    end
    give back record {ok: yes, status: 200, payload: qres.data}
  end

  if tool_name is "create_entry_draft"
    if not (role_has_capability using sess.role, "entries:create")
      give back record {ok: no, status: 403, payload: record {error: "Forbidden: insufficient capability for create_entry_draft"}}
    end
    set ct_raw to ""
    if args has "content_type" and (args at "content_type") is not nothing
      set ct_raw to text.from using (args at "content_type")
    otherwise
      if args has "content_type_slug" and (args at "content_type_slug") is not nothing
        set ct_raw to text.from using (args at "content_type_slug")
      end
    end
    if ct_raw is "" or (not (args has "slug")) or (args at "slug") is nothing or (not (args has "title")) or (args at "title") is nothing
      give back record {ok: no, status: 400, payload: record {error: "Missing required fields: content_type (or content_type_slug), slug, title", code: -32602}}
    end
    set ct_slug to normalize_slug using ct_raw
    set ct to data.one using stmts.get_type, record {lookup: "slug", sv: ct_slug, iv: 0}
    if ct is nothing
      give back record {ok: no, status: 404, payload: record {error: "Content type not found"}}
    end
    set slug to normalize_slug using (text.from using (args at "slug"))
    if not (is_valid_entry_slug using slug)
      give back record {ok: no, status: 400, payload: record {error: "Invalid entry slug", code: -32602}}
    end
    set full_path to compute_full_path using ct.permalink_pattern, slug
    if is_reserved_path using full_path
      give back record {ok: no, status: 400, payload: record {error: "Computed permalink collides with reserved prefix", code: -32602}}
    end
    set conflict to data.one using stmts.get_entry_by_full_path, record {full_path: full_path}
    if conflict is not nothing
      give back record {ok: no, status: 409, payload: record {error: "Entry already exists at " joined with full_path}}
    end
    set body_html to ""
    set body_src to nothing
    if args has "body_html" and (args at "body_html") is not nothing
      set body_src to args at "body_html"
    otherwise
      if args has "body" and (args at "body") is not nothing
        set body_src to args at "body"
      end
    end
    if body_src is not nothing
      set bres to normalize_and_validate_body using body_src
      if not bres.ok
        give back record {ok: no, status: 400, payload: record {error: bres.error, code: -32602}}
      end
      set body_html to bres.body_html
    end
    set cf_in to {}
    if args has "custom_fields" and (args at "custom_fields") is not nothing
      if not (is_record_value using (args at "custom_fields"))
        give back record {ok: no, status: 400, payload: record {error: "custom_fields must be a JSON object", code: -32602}}
      end
      set cf_raw_in to args at "custom_fields"
      if ct.slug is "product"
        for each cfk in (collections.keys using cf_raw_in)
          if cfk is not "price" and cfk is not "price_cents" and cfk is not "stock" and cfk is not "stock_qty"
            set cf_in to collections.put using cf_in, cfk, (cf_raw_in at cfk)
          end
        end
      otherwise
        set cf_in to cf_raw_in
      end
    end
    set cf_res to validate_custom_fields using stmts, ct.id, cf_in
    if not cf_res.ok
      give back record {ok: no, status: 400, payload: record {error: cf_res.error, code: -32602}}
    end
    set next_cf_json to cf_res.json_text
    set draft_layout to nothing
    if args has "grex_layout" and (args at "grex_layout") is not nothing
      set draft_layout to args at "grex_layout"
    otherwise
      if args has "layout" and (args at "layout") is not nothing
        set draft_layout to args at "layout"
      end
    end
    if draft_layout is not nothing
      set layout_audit to audit_grex_tree_walk using stmts, draft_layout, 0, "layout", record {violations: [], h1_count: 0, last_heading_level: 0, inherited_bg: ""}
      if (collections.length using layout_audit.violations) is greater than 0
        set lerr_payload to record {error: "grex_validation_failed", code: -32602, mcp_error: (record {code: -32602, message: "Grex layout or WCAG AA validation failed", violations: layout_audit.violations}), violations: layout_audit.violations}
        give back record {ok: no, status: 422, payload: lerr_payload}
      end
      if body_html is ""
        set body_html to render_validated_grex_html using stmts, draft_layout, 0
      end
      set cf_merged to {}
      try
        set parsed_cf to json.parse using cf_res.json_text
        if is_record_value using parsed_cf
          for each cfk in (collections.keys using parsed_cf)
            set cf_merged to collections.put using cf_merged, cfk, (parsed_cf at cfk)
          end
        end
      catch cferr
        set cf_merged to {}
      end
      set cf_merged to collections.put using cf_merged, "_grex_layout", draft_layout
      set next_cf_json to json.stringify using cf_merged
    end
    set meta_t to ""
    if args has "meta_title" and (args at "meta_title") is not nothing
      set meta_t to text.from using (args at "meta_title")
    end
    set meta_d to ""
    if args has "meta_description" and (args at "meta_description") is not nothing
      set meta_d to text.from using (args at "meta_description")
    otherwise
      if args has "excerpt" and (args at "excerpt") is not nothing
        set meta_d to text.from using (args at "excerpt")
      end
    end
    set term_ids to []
    if args has "term_ids" and (args at "term_ids") is not nothing
      set term_ids to args at "term_ids"
    end
    set now_rec to call dates.now_utc
    set tx to data.begin using stmts.db
    try
      call data.execute using stmts.insert_entry, record {content_type_id: ct.id, slug: slug, full_path: full_path, title: (text.from using (args at "title")), status: "draft", body_html: body_html, custom_fields_json: next_cf_json, meta_title: meta_t, meta_description: meta_d, author_id: sess.user_id, published_at: nothing, created_at: now_rec.iso, updated_at: now_rec.iso}, tx
      set created to data.one using stmts.get_entry_by_full_path, record {full_path: full_path}, tx
      if (collections.length using term_ids) is greater than 0
        set tr to sync_entry_terms_tx using stmts, created.id, term_ids, now_rec.iso, tx
        if not tr.ok
          call data.rollback using tx
          give back record {ok: no, status: 400, payload: record {error: tr.error, code: -32602}}
        end
      end
      call data.commit using tx
      call invalidate_route_caches using stmts, full_path, "", ct.slug
      if draft_layout is not nothing
        give back record {ok: yes, status: 201, payload: record {entry: created, status_enforced: "draft", grex_layout_json: draft_layout}}
      end
      give back record {ok: yes, status: 201, payload: record {entry: created, status_enforced: "draft"}}
    catch tx_err
      call data.rollback using tx
      give back record {ok: no, status: 500, payload: record {error: tx_err.message}}
    end
  end

  if tool_name is "update_entry_layout"
    if not (role_has_capability using sess.role, "entries:update:own")
      give back record {ok: no, status: 403, payload: record {error: "Forbidden: insufficient capability for update_entry_layout"}}
    end
    set has_layout to ((args has "layout" and (args at "layout") is not nothing) or (args has "grex_layout" and (args at "grex_layout") is not nothing))
    if (not (args has "entry_id")) or (args at "entry_id") is nothing or (not has_layout)
      give back record {ok: no, status: 400, payload: record {error: "Missing required fields: entry_id, layout (or grex_layout)", code: -32602}}
    end
    set entry_id to text.to_integer using (text.from using (args at "entry_id"))
    set existing to data.one using stmts.get_entry_by_id, record {id: entry_id}
    if existing is nothing
      give back record {ok: no, status: 404, payload: record {error: "Entry not found"}}
    end
    if not (role_has_capability using sess.role, "entries:update:any")
      if existing.author_id is nothing or existing.author_id is not sess.user_id
        give back record {ok: no, status: 403, payload: record {error: "Forbidden: can only update layout of your own entries"}}
      end
    end
    set layout_node to nothing
    if args has "layout" and (args at "layout") is not nothing
      set layout_node to args at "layout"
    otherwise
      set layout_node to args at "grex_layout"
    end
    set audit_res to audit_grex_tree_walk using stmts, layout_node, 0, "layout", record {violations: [], h1_count: 0, last_heading_level: 0, inherited_bg: ""}
    if (collections.length using audit_res.violations) is greater than 0
      set gerr_payload to record {error: "grex_validation_failed", code: -32602, mcp_error: (record {code: -32602, message: "Grex layout or WCAG AA validation failed", violations: audit_res.violations}), violations: audit_res.violations}
      give back record {ok: no, status: 422, payload: gerr_payload}
    end
    set rendered_html to render_validated_grex_html using stmts, layout_node, 0
    set cf_map to {}
    try
      set parsed_cf to json.parse using existing.custom_fields_json
      if parsed_cf is not nothing
        for each cfk in (collections.keys using parsed_cf)
          set cf_map to collections.put using cf_map, cfk, (parsed_cf at cfk)
        end
      end
    catch err
      set cf_map to {}
    end
    set cf_map to collections.put using cf_map, "_grex_layout", layout_node
    set next_cf_json to json.stringify using cf_map
    set now_rec to call dates.now_utc
    call data.execute using stmts.update_entry, record {slug: existing.slug, full_path: existing.full_path, title: existing.title, status: existing.status, body_html: rendered_html, custom_fields_json: next_cf_json, meta_title: existing.meta_title, meta_description: existing.meta_description, published_at: existing.published_at, updated_at: now_rec.iso, id: entry_id}
    set updated to data.one using stmts.get_entry_by_id, record {id: entry_id}
    call invalidate_route_caches using stmts, existing.full_path, "", existing.content_type_slug
    give back record {ok: yes, status: 200, payload: record {entry: updated, body_html: rendered_html, grex_layout_json: layout_node, violations: []}}
  end

  if tool_name is "list_media"
    if not (role_has_capability using sess.role, "media:read")
      give back record {ok: no, status: 403, payload: record {error: "Forbidden: insufficient capability for list_media"}}
    end
    set mime_prefix to ""
    set mime_like to "%"
    if args has "mime_prefix" and (args at "mime_prefix") is not nothing
      set mime_prefix to text.lower using (text.trim using (text.from using (args at "mime_prefix")))
      if mime_prefix is not ""
        set mime_like to mime_prefix joined with "%"
      end
    end
    set lim to 50
    if args has "limit" and (args at "limit") is not nothing
      set lim to math.clamp using (text.to_integer using (text.from using (args at "limit"))), 1, 100
    end
    set off to 0
    if args has "offset" and (args at "offset") is not nothing
      set off to math.max using 0, (text.to_integer using (text.from using (args at "offset")))
    end
    set rows to data.query using stmts.list_media, record {mime_filter: mime_prefix, mime_like: mime_like, limit_rows: lim, offset_rows: off}
    set items to []
    for each r in rows
      set items to collections.append using items, (format_media_record using r)
    end
    give back record {ok: yes, status: 200, payload: record {media: items}}
  end

  if tool_name is "list_menus"
    if not (role_has_capability using sess.role, "admin:access")
      give back record {ok: no, status: 403, payload: record {error: "Forbidden: insufficient capability for list_menus"}}
    end
    set loc_filter to ""
    if args has "location" and (args at "location") is not nothing
      set loc_filter to text.lower using (text.trim using (text.from using (args at "location")))
    end
    set menus_rows to data.query using stmts.get_menu, record {lookup: "all", iv: 0, sv: ""}
    set out to []
    for each m in menus_rows
      set m_loc to ""
      if m.location is not nothing
        set m_loc to text.lower using (text.trim using m.location)
      end
      if loc_filter is "" or m_loc is loc_filter
        set m_items to data.query using stmts.list_menu_items_by_menu, record {menu_id: m.id}
        set tree to build_menu_children using m_items, nothing, 1, yes
        set out to collections.append using out, record {id: m.id, slug: m.slug, name: m.name, location: m.location, items: tree}
      end
    end
    give back record {ok: yes, status: 200, payload: record {menus: out}}
  end

  if tool_name is "list_commerce_events"
    if not (role_has_capability using sess.role, "commerce:manage")
      give back record {ok: no, status: 403, payload: record {error: "Forbidden: insufficient capability for list_commerce_events"}}
    end
    if not stmts.commerce_ready
      give back record {ok: no, status: 404, payload: record {error: "Commerce schema not migrated"}}
    end
    set cfg to get_commerce_config using stmts
    if not cfg.enabled
      give back record {ok: no, status: 404, payload: record {error: "Commerce is currently disabled"}}
    end
    call run_commerce_sweep using stmts, no
    set ev_name to ""
    if args has "name" and (args at "name") is not nothing
      set ev_name to text.trim using (text.from using (args at "name"))
    end
    set after_id to 0
    if args has "after_id" and (args at "after_id") is not nothing
      set p_after to parse_grab_integer using (args at "after_id"), 0, 2147483647
      if not p_after.ok
        give back record {ok: no, status: 422, payload: record {error: p_after.code, message: p_after.error, code: -32602}}
      end
      set after_id to p_after.val
    end
    set lim to 25
    if args has "limit" and (args at "limit") is not nothing
      set p_lim to parse_grab_integer using (args at "limit"), 1, 100
      if not p_lim.ok
        give back record {ok: no, status: 422, payload: record {error: p_lim.code, message: p_lim.error, code: -32602}}
      end
      set lim to p_lim.val
    end
    set rows to data.query using stmts.commerce.commerce_events, record {mode: "list", after_id: after_id, sv: ev_name, subj: "", lim: lim}
    set events_out to []
    set next_after to after_id
    for each r in rows
      set parsed_p to {}
      try
        set parsed_p to json.parse using r.payload_json
      catch err
      end
      set events_out to collections.append using events_out, {"id": r.id, "name": r.name, "subject_id": r.subject_id, "payload": parsed_p, "created_at": r.created_at}
      set next_after to r.id
    end
    give back record {ok: yes, status: 200, payload: {"events": events_out, "next_after_id": next_after}}
  end

  if tool_name is "create_coupon_draft"
    if not (role_has_capability using sess.role, "commerce:manage")
      give back record {ok: no, status: 403, payload: record {error: "Forbidden: insufficient capability for create_coupon_draft"}}
    end
    if not stmts.commerce_ready
      give back record {ok: no, status: 404, payload: record {error: "Commerce schema not migrated"}}
    end
    set cfg to get_commerce_config using stmts
    if not cfg.enabled
      give back record {ok: no, status: 404, payload: record {error: "Commerce is currently disabled"}}
    end
    if (not (args has "code")) or (not (args has "type")) or (not (args has "value")) or (not (args has "min_subtotal")) or (not (args has "max_redemptions"))
      give back record {ok: no, status: 400, payload: record {error: "Missing required coupon draft parameters", code: -32602}}
    end
    set code_u to text.upper using (text.trim using (text.from using (args at "code")))
    if not (is_allowed_chars using code_u, "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_-", 3, 40)
      give back record {ok: no, status: 422, payload: record {error: "invalid_coupon_code", message: "Coupon code must be 3-40 uppercase alphanumeric characters (_ or -)", code: -32602}}
    end
    set ctype to text.lower using (text.trim using (text.from using (args at "type")))
    if ctype is not "percent_bp" and ctype is not "fixed_cents"
      give back record {ok: no, status: 422, payload: record {error: "invalid_coupon_type", message: "Coupon type must be percent_bp or fixed_cents", code: -32602}}
    end
    set max_val_cap to 9999999999
    if ctype is "percent_bp"
      set max_val_cap to 5000
    end
    set p_val to parse_grab_integer using (args at "value"), 1, max_val_cap
    if not p_val.ok
      give back record {ok: no, status: 422, payload: record {error: p_val.code, message: p_val.error, code: -32602}}
    end
    set p_min to parse_money_cents using (args at "min_subtotal"), yes, 9999999999
    if not p_min.ok
      give back record {ok: no, status: 422, payload: record {error: p_min.code, message: p_min.error, code: -32602}}
    end
    set p_max to parse_grab_integer using (args at "max_redemptions"), 1, 1000
    if not p_max.ok
      give back record {ok: no, status: 422, payload: record {error: p_max.code, message: p_max.error, code: -32602}}
    end
    set dup_cpn to data.one using stmts.commerce.get_coupons, record {mode: "code", iv: 0, sv: code_u}
    if dup_cpn is not nothing
      give back record {ok: no, status: 409, payload: record {error: "Coupon code already exists"}}
    end
    set starts_at to nothing
    if args has "starts_at" and (args at "starts_at") is not nothing and (text.trim using (text.from using (args at "starts_at"))) is not ""
      set starts_at to text.trim using (text.from using (args at "starts_at"))
    end
    set ends_at to nothing
    if args has "ends_at" and (args at "ends_at") is not nothing and (text.trim using (text.from using (args at "ends_at"))) is not ""
      set ends_at to text.trim using (text.from using (args at "ends_at"))
    end
    set now_rec to call dates.now_utc
    set created_by to "mcp:" joined with (text.from using sess.user_id)
    call data.execute using stmts.commerce.ins_coupon, record {code: code_u, type: ctype, value: p_val.val, min_subtotal_cents: p_min.cents, max_redemptions: p_max.val, redeemed_count: 0, starts_at: starts_at, ends_at: ends_at, active: 0, created_by: created_by, created_at: now_rec.iso, updated_at: now_rec.iso}
    set created to data.one using stmts.commerce.get_coupons, record {mode: "code", iv: 0, sv: code_u}
    give back record {ok: yes, status: 201, payload: {"coupon": created, "active_enforced": 0, "created_by": created_by}}
  end

  if tool_name is "list_author_catalog"
    if not (role_has_capability using sess.role, "author:manage")
      give back record {ok: no, status: 403, payload: record {error: "Forbidden: insufficient capability for list_author_catalog"}}
    end
    if not stmts.author_ready
      give back record {ok: no, status: 404, payload: record {error: "Author Mode schema not migrated"}}
    end
    set acfg to get_author_config using stmts
    if not acfg.enabled
      give back record {ok: no, status: 404, payload: record {error: "Author Mode is currently disabled"}}
    end
    set f_author to 0
    if args has "author_id" and (args at "author_id") is not nothing
      set pa to parse_author_int using (args at "author_id"), 1, 2147483647
      if not pa.ok
        give back record {ok: no, status: 422, payload: record {error: "author_validation_failed", field: "author_id", reason: pa.reason, message: pa.error, code: -32602}}
      end
      set f_author to pa.val
    end
    set f_series to 0
    if args has "series_id" and (args at "series_id") is not nothing
      set ps to parse_author_int using (args at "series_id"), 1, 2147483647
      if not ps.ok
        give back record {ok: no, status: 422, payload: record {error: "author_validation_failed", field: "series_id", reason: ps.reason, message: ps.error, code: -32602}}
      end
      set f_series to ps.val
    end
    set f_genre to ""
    if args has "genre_slug" and (args at "genre_slug") is not nothing
      set f_genre to text.lower using (text.trim using (text.from using (args at "genre_slug")))
    end
    set f_status to "all"
    if args has "status" and (args at "status") is not nothing
      set f_status to text.lower using (text.trim using (text.from using (args at "status")))
    end
    set can_see_all to role_has_capability using sess.role, "entries:read_all"
    set a_rows to data.query using stmts.author.authors, record {mode: "all", iv: 0, sv: ""}
    set s_rows to data.query using stmts.author.series, record {mode: "all", iv: 0, sv: ""}
    set b_rows to data.query using stmts.author.books, record {mode: "all", iv: 0, sv: ""}
    set c_rows to data.query using stmts.author.chapters, record {mode: "all", iv: 0, sv: "", sv2: ""}
    set authors_out to []
    for each ar in a_rows
      if (can_see_all or ar.status is "published" or (ar.owner_user_id is not nothing and ar.owner_user_id is sess.user_id)) and (f_author is 0 or ar.id is f_author) and (f_status is "all" or ar.status is f_status)
        set authors_out to collections.append using authors_out, (format_author_api_row using ar)
      end
    end
    set series_out to []
    for each sr in s_rows
      if (can_see_all or sr.status is "published" or (sr.owner_user_id is not nothing and sr.owner_user_id is sess.user_id)) and (f_author is 0 or sr.author_id is f_author) and (f_series is 0 or sr.id is f_series) and (f_genre is "" or sr.genre_slug is f_genre) and (f_status is "all" or sr.status is f_status)
        set series_out to collections.append using series_out, (format_series_api_row using sr)
      end
    end
    set books_out to []
    set visible_book_ids to {}
    for each br in b_rows
      if (can_see_all or br.status is "published" or (br.owner_user_id is not nothing and br.owner_user_id is sess.user_id)) and (f_author is 0 or br.author_id is f_author) and (f_series is 0 or (br.series_id is not nothing and br.series_id is f_series)) and (f_genre is "" or br.genre_slug is f_genre) and (f_status is "all" or br.status is f_status)
        set books_out to collections.append using books_out, (format_book_api_row using br)
        set visible_book_ids to collections.put using visible_book_ids, (text.from using br.id), yes
      end
    end
    set chaps_out to []
    for each cr in c_rows
      if (has_map_key using visible_book_ids, (text.from using cr.book_id)) and (can_see_all or cr.status is "published" or (cr.owner_user_id is not nothing and cr.owner_user_id is sess.user_id)) and (f_status is "all" or cr.status is f_status)
        set chaps_out to collections.append using chaps_out, (format_chapter_api_row using cr)
      end
    end
    give back record {ok: yes, status: 200, payload: {"authors": authors_out, "series": series_out, "books": books_out, "chapters": chaps_out}}
  end

  if tool_name is "create_book_draft"
    if not (role_has_capability using sess.role, "author:manage")
      give back record {ok: no, status: 403, payload: record {error: "Forbidden: insufficient capability for create_book_draft"}}
    end
    if not stmts.author_ready
      give back record {ok: no, status: 404, payload: record {error: "Author Mode schema not migrated"}}
    end
    set acfg to get_author_config using stmts
    if not acfg.enabled
      give back record {ok: no, status: 404, payload: record {error: "Author Mode is currently disabled"}}
    end
    if (not (args has "slug")) or (args at "slug") is nothing or (not (args has "title")) or (args at "title") is nothing
      give back record {ok: no, status: 400, payload: record {error: "Missing required fields: slug, title", code: -32602}}
    end
    set slug to normalize_slug using (text.from using (args at "slug"))
    if not (is_valid_entry_slug using slug)
      give back record {ok: no, status: 422, payload: record {error: "author_validation_failed", field: "slug", reason: "invalid_slug", message: "Invalid book slug", code: -32602}}
    end
    call ensure_author_types using stmts
    set ct_b to data.one using stmts.get_type, record {lookup: "slug", sv: "book", iv: 0}
    set full_path to compute_full_path using ct_b.permalink_pattern, slug
    if is_author_reserved_slug using slug, full_path
      give back record {ok: no, status: 409, payload: record {error: "reserved_slug_collision", message: "Book slug collides with reserved system prefix"}}
    end
    set conflict to data.one using stmts.get_entry_by_full_path, record {full_path: full_path}
    if conflict is not nothing
      give back record {ok: no, status: 409, payload: record {error: ("Book already exists at " joined with full_path)}}
    end
    set b_title to text.trim using (text.from using (args at "title"))
    if b_title is ""
      give back record {ok: no, status: 422, payload: record {error: "author_validation_failed", field: "title", reason: "empty_title", message: "Book title cannot be empty", code: -32602}}
    end
    set price_raw to "14.99"
    if args has "list_price" and (args at "list_price") is not nothing
      set price_raw to args at "list_price"
    end
    set p_price to parse_author_money_cents using price_raw, "list_price"
    if not p_price.ok
      give back record {ok: no, status: 422, payload: record {error: "author_validation_failed", field: "list_price", reason: p_price.reason, message: p_price.error, code: -32602}}
    end
    set roy_raw to "70.00"
    if args has "royalty_rate" and (args at "royalty_rate") is not nothing
      set roy_raw to args at "royalty_rate"
    end
    set p_roy to parse_author_royalty_bp using roy_raw, "royalty_rate"
    if not p_roy.ok
      give back record {ok: no, status: 422, payload: record {error: "author_validation_failed", field: "royalty_rate", reason: p_roy.reason, message: p_roy.error, code: -32602}}
    end
    set isbn_in to nothing
    if args has "isbn_13"
      set isbn_in to args at "isbn_13"
    end
    set isbn_res to validate_isbn13_strict using isbn_in
    if not isbn_res.ok
      give back record {ok: no, status: 422, payload: record {error: "author_validation_failed", field: "isbn_13", reason: "invalid_isbn_13", message: isbn_res.error, code: -32602}}
    end
    set asin_in to nothing
    if args has "asin"
      set asin_in to args at "asin"
    end
    set asin_res to validate_asin_strict using asin_in
    if not asin_res.ok
      give back record {ok: no, status: 422, payload: record {error: "author_validation_failed", field: "asin", reason: "invalid_asin", message: asin_res.error, code: -32602}}
    end
    set ed_fmt to "paperback"
    if args has "edition_format" and (args at "edition_format") is not nothing
      set ed_fmt to text.lower using (text.trim using (text.from using (args at "edition_format")))
    end
    if ed_fmt is not "ebook" and ed_fmt is not "paperback" and ed_fmt is not "hardcover" and ed_fmt is not "bundle"
      give back record {ok: no, status: 422, payload: record {error: "author_validation_failed", field: "edition_format", reason: "invalid_edition_format", message: "edition_format must be ebook, paperback, hardcover, or bundle", code: -32602}}
    end
    set pg_cnt to 0
    if args has "page_count" and (args at "page_count") is not nothing
      set ppg to parse_author_int using (args at "page_count"), 0, 50000
      if not ppg.ok
        give back record {ok: no, status: 422, payload: record {error: "author_validation_failed", field: "page_count", reason: ppg.reason, message: ppg.error, code: -32602}}
      end
      set pg_cnt to ppg.val
    end
    set wd_cnt to 0
    if args has "word_count" and (args at "word_count") is not nothing
      set pwd to parse_author_int using (args at "word_count"), 0, 5000000
      if not pwd.ok
        give back record {ok: no, status: 422, payload: record {error: "author_validation_failed", field: "word_count", reason: pwd.reason, message: pwd.error, code: -32602}}
      end
      set wd_cnt to pwd.val
    end
    set ser_id to nothing
    if args has "series_id" and (args at "series_id") is not nothing
      set psi to parse_author_int using (args at "series_id"), 1, 2147483647
      if not psi.ok
        give back record {ok: no, status: 422, payload: record {error: "author_validation_failed", field: "series_id", reason: psi.reason, message: psi.error, code: -32602}}
      end
      set s_chk to data.one using stmts.author.series, record {mode: "id", iv: psi.val, sv: ""}
      if s_chk is nothing
        give back record {ok: no, status: 404, payload: record {error: "Series not found"}}
      end
      set ser_id to psi.val
    end
    set ser_pos to nothing
    if args has "series_position" and (args at "series_position") is not nothing
      set psp to parse_author_int using (args at "series_position"), 1, 9999
      if not psp.ok
        give back record {ok: no, status: 422, payload: record {error: "author_validation_failed", field: "series_position", reason: psp.reason, message: psp.error, code: -32602}}
      end
      set ser_pos to psp.val
    end
    set sub_s to ""
    if args has "subtitle" and (args at "subtitle") is not nothing
      set sub_s to text.trim using (text.from using (args at "subtitle"))
    end
    set lang_s to "en"
    if args has "in_language" and (args at "in_language") is not nothing and (text.trim using (text.from using (args at "in_language"))) is not ""
      set lang_s to text.trim using (text.from using (args at "in_language"))
    end
    set genre_s to ""
    if args has "genre_slug" and (args at "genre_slug") is not nothing
      set genre_s to text.lower using (text.trim using (text.from using (args at "genre_slug")))
    end
    set blurb_s to ""
    if args has "blurb" and (args at "blurb") is not nothing
      set bres to normalize_and_validate_body using (args at "blurb")
      if not bres.ok
        give back record {ok: no, status: 422, payload: record {error: "author_validation_failed", field: "blurb", reason: "unsafe_html", message: bres.error, code: -32602}}
      end
      set blurb_s to bres.body_html
    end

    set now_rec to call dates.now_utc
    set now_iso to now_rec.iso
    set tx to data.begin using stmts.db
    try
      set target_author_id to 0
      if args has "author_id" and (args at "author_id") is not nothing
        set pai to parse_author_int using (args at "author_id"), 1, 2147483647
        if not pai.ok
          call data.rollback using tx
          give back record {ok: no, status: 422, payload: record {error: "author_validation_failed", field: "author_id", reason: pai.reason, message: pai.error, code: -32602}}
        end
        set a_row to data.one using stmts.author.authors, record {mode: "id", iv: pai.val, sv: ""}, tx
        if a_row is nothing
          call data.rollback using tx
          give back record {ok: no, status: 404, payload: record {error: "Author not found"}}
        end
        set target_author_id to a_row.id
      otherwise
        set def_a to ensure_default_author_for_user using stmts, sess.user_id, sess.display_name, now_iso, tx
        set target_author_id to def_a.id
      end
      set cf_book to json.stringify using {"isbn_13": isbn_res.canonical, "asin": asin_res.canonical, "subtitle": sub_s, "list_price": p_price.formatted}
      call data.execute using stmts.insert_entry, record {content_type_id: ct_b.id, slug: slug, full_path: full_path, title: b_title, status: "draft", body_html: blurb_s, custom_fields_json: cf_book, meta_title: b_title, meta_description: blurb_s, author_id: sess.user_id, published_at: nothing, created_at: now_iso, updated_at: now_iso}, tx
      set ent_b to data.one using stmts.get_entry_by_full_path, record {full_path: full_path}, tx
      call data.execute using stmts.author.ins_book, record {entry_id: ent_b.id, author_id: target_author_id, series_id: ser_id, series_position: ser_pos, subtitle: sub_s, isbn_13: isbn_res.canonical, asin: asin_res.canonical, edition_format: ed_fmt, page_count: pg_cnt, word_count: wd_cnt, in_language: lang_s, genre_slug: genre_s, blurb: blurb_s, list_price_cents: p_price.cents, royalty_rate_bp: p_roy.bp, currency: "USD", product_id: nothing, cover_media_id: nothing, active: 1, created_at: now_iso, updated_at: now_iso}, tx
      set created_b to data.one using stmts.author.books, record {mode: "entry", iv: ent_b.id, sv: ""}, tx
      set created_chaps to []
      if args has "chapters" and (args at "chapters") is not nothing
        set ct_c to data.one using stmts.get_type, record {lookup: "slug", sv: "chapter", iv: 0}, tx
        set ch_idx to 1
        for each ch in (args at "chapters")
          set c_title to "Chapter " joined with (text.from using ch_idx)
          if ch has "title" and (ch at "title") is not nothing
            set c_title to text.trim using (text.from using (ch at "title"))
          end
          set c_slug to slug joined with "-ch-" joined with (text.from using ch_idx)
          if ch has "slug" and (ch at "slug") is not nothing
            set c_slug to normalize_slug using (text.from using (ch at "slug"))
          end
          set c_path to compute_full_path using ct_c.permalink_pattern, c_slug
          set c_num to ch_idx
          if ch has "chapter_number" and (ch at "chapter_number") is not nothing
            set pcn to parse_author_int using (ch at "chapter_number"), 1, 9999
            if not pcn.ok
              call data.rollback using tx
              give back record {ok: no, status: 422, payload: record {error: "author_validation_failed", field: "chapter_number", reason: pcn.reason, message: pcn.error, code: -32602}}
            end
            set c_num to pcn.val
          end
          set c_body to ""
          if ch has "body_html" and (ch at "body_html") is not nothing
            set cb_res to normalize_and_validate_body using (ch at "body_html")
            if cb_res.ok
              set c_body to cb_res.body_html
            end
          end
          set c_sample to 0
          if ch has "is_sample" and ((ch at "is_sample") is yes or (ch at "is_sample") is 1)
            set c_sample to 1
          end
          set c_hook to ""
          if ch has "cliffhanger_hook" and (ch at "cliffhanger_hook") is not nothing
            set c_hook to text.trim using (text.from using (ch at "cliffhanger_hook"))
          end
          call data.execute using stmts.insert_entry, record {content_type_id: ct_c.id, slug: c_slug, full_path: c_path, title: c_title, status: "draft", body_html: c_body, custom_fields_json: "{}", meta_title: c_title, meta_description: c_hook, author_id: sess.user_id, published_at: nothing, created_at: now_iso, updated_at: now_iso}, tx
          set ent_c to data.one using stmts.get_entry_by_full_path, record {full_path: c_path}, tx
          call data.execute using stmts.author.ins_chapter, record {entry_id: ent_c.id, book_id: created_b.id, chapter_number: c_num, sort_order: ch_idx, is_sample: c_sample, word_count: 0, reading_minutes: 0, cliffhanger_hook: c_hook, readability_grade_bp: nothing, readability_score: nothing, created_at: now_iso, updated_at: now_iso}, tx
          set cr_new to data.one using stmts.author.chapters, record {mode: "entry", iv: ent_c.id, sv: "", sv2: ""}, tx
          set created_chaps to collections.append using created_chaps, (format_chapter_api_row using cr_new)
          set ch_idx to ch_idx plus 1
        end
      end
      call data.commit using tx
      call invalidate_author_caches using stmts, created_b.id, ser_id, 0, target_author_id
      call invalidate_route_caches using stmts, full_path, "", "book"
      give back record {ok: yes, status: 201, payload: {"book": (format_book_api_row using created_b), "chapters": created_chaps, "status_enforced": "draft"}}
    catch tx_err
      call data.rollback using tx
      give back record {ok: no, status: 500, payload: record {error: tx_err.message}}
    end
  end

  give back record {ok: no, status: 404, payload: record {error: "Unknown MCP tool: " joined with tool_name}}
end

# ==============================================================================
# Module 7: Pretty Permalink Resolution & 301 Redirect Helper
# ==============================================================================

make build_entries_summary using items
  set parts to []
  for each e in items
    set line to e.title joined with " (" joined with e.full_path joined with ")"
    set parts to collections.append using parts, line
  end
  if (collections.length using parts) is 0
    give back "No published entries yet."
  end
  give back text.join using parts, " | "
end

make render_single_entry using stmts, entry
  set meta_title to entry.meta_title
  if meta_title is ""
    set meta_title to entry.title
  end
  set published_at to ""
  if entry.published_at is not nothing
    set published_at to entry.published_at
  end
  if stmts.commerce_ready and entry.content_type_slug is "product"
    set cfg to get_commerce_config using stmts
    if cfg.enabled
      set prod to data.one using stmts.commerce.products, record {mode: "entry", iv: entry.id, sv: ""}
      if prod is not nothing and prod.active is 1
        set price_str to format_cents_usd using prod.price_cents
        set comp_str to ""
        if prod.compare_at_cents is not nothing and prod.compare_at_cents is greater than prod.price_cents
          set comp_str to format_cents_usd using prod.compare_at_cents
        end
        set avail_schema to "https://schema.org/InStock"
        set avail_label to "In Stock"
        if prod.kind is "digital"
          set avail_label to "Digital Download (Instant after payment)"
        otherwise
          if prod.stock_qty is not nothing and prod.stock_qty is at most 0
            set avail_schema to "https://schema.org/OutOfStock"
            set avail_label to "Out of Stock"
          end
        end
        set isbn_val to ""
        try
          set cf_parsed to json.parse using entry.custom_fields_json
          if (is_record_value using cf_parsed) and (cf_parsed has "isbn_13") and ((cf_parsed at "isbn_13") is not nothing)
            set isbn_val to text.from using (cf_parsed at "isbn_13")
          end
        catch err
        end
        set ld_offer to {"@type": "Offer", "priceCurrency": prod.currency, "price": price_str, "availability": avail_schema}
        set ld_obj to {"@context": "https://schema.org", "@type": "Product", "name": entry.title, "sku": prod.sku, "description": entry.meta_description, "offers": ld_offer}
        if isbn_val is not ""
          set ld_obj to collections.put using ld_obj, "isbn", isbn_val
        end
        set ld_raw to json.stringify using ld_obj
        set ld_safe to text.replace using (text.replace using ld_raw, "<", "\\u003c"), ">", "\\u003e"
        set shop_js_url to safe_asset_url using "shop/shop.js"
        set shop_css_url to safe_asset_url using "shop/shop.css"
        set p_data to {"title": entry.title, "meta_title": meta_title, "meta_description": entry.meta_description, "content_type_label": entry.content_type_label, "full_path": entry.full_path, "published_at": published_at, "body_text": entry.body_html, "custom_fields_summary": entry.custom_fields_json, "product_id": (text.from using prod.id), "product_sku": prod.sku, "product_price": price_str, "product_compare_at": comp_str, "product_currency": prod.currency, "product_kind": prod.kind, "product_availability": avail_label, "product_carrier": (text.from using prod.carrier), "product_isbn_13": isbn_val, "_head_json_ld": ld_safe, "shop_js_url": shop_js_url, "shop_css_url": shop_css_url}
        set theme to get_active_theme_context using stmts
        if theme.mode is "coded" and (files.exists using ("themes/" joined with theme.slug joined with "/templates/product.grab.html"))
          give back render_theme_page using stmts, "product", p_data, 200, []
        end
        give back render_theme_page using stmts, "single", p_data, 200, []
      end
    end
  end
  set page_data to {"title": entry.title, "meta_title": meta_title, "meta_description": entry.meta_description, "content_type_label": entry.content_type_label, "full_path": entry.full_path, "published_at": published_at, "body_text": entry.body_html, "custom_fields_summary": entry.custom_fields_json}
  give back render_theme_page using stmts, "single", page_data, 200, []
end

make resolve_public_path using stmts, req_path
  set norm_path to normalize_path using req_path
  if (has_unsafe_path_chars using req_path) or (is_reserved_path using norm_path)
    give back render_theme_page using stmts, "404", {"requested_path": norm_path}, 404, []
  end

  set entry to data.one using stmts.get_entry_by_full_path, record {full_path: norm_path}
  if entry is not nothing and entry.status is "published"
    give back render_single_entry using stmts, entry
  end

  set redir to data.one using stmts.find_redirect_by_old_path, record {old_path: norm_path}
  if redir is not nothing and redir.target_path is not norm_path and (not (is_reserved_path using redir.target_path))
    give back server.redirect using redir.target_path, 301
  end

  give back render_theme_page using stmts, "404", {"requested_path": norm_path}, 404, []
end

# ==============================================================================
# Reserved System Routes (/setup, /login, /admin, /api, /_health, /_ready)
# ==============================================================================

make get_query_param using req, pname
  if not (has_map_key using req.query, pname)
    give back ""
  end
  give back text.trim using (text.from using (req.query at pname))
end

make is_truthy_val using val
  if val is nothing
    give back no
  end
  if val is yes or val is 1
    give back yes
  end
  set s to text.lower using (text.trim using (text.from using val))
  give back (s is "yes" or s is "true" or s is "1")
end

make require_admin_html using stmts, req, cap
  set cnt_row to data.one using stmts.count_users, record {}
  if cnt_row is nothing or cnt_row.total is 0
    give back record {ok: no, session: nothing, response: (server.redirect using "/setup", 302)}
  end
  set sess to resolve_session using stmts, req
  if sess is nothing
    give back record {ok: no, session: nothing, response: (server.redirect using "/login", 302)}
  end
  if cap is not "" and (not (role_has_capability using sess.role, cap))
    give back record {ok: no, session: nothing, response: (server.text using 403, "Forbidden: insufficient role capability")}
  end
  give back record {ok: yes, session: sess, response: nothing}
end

make activate_theme_by_slug using stmts, raw_slug
  set slug to normalize_slug using raw_slug
  set check_res to validate_theme_manifest using slug
  if not check_res.ok
    give back record {ok: no, status: 400, error: check_res.error, active_theme: nothing, mode: ""}
  end

  set now_rec to call dates.now_utc
  set tx to data.begin using stmts.db
  try
    call upsert_theme_row using stmts, slug, check_res, now_rec.iso, tx
    call data.execute using stmts.set_active_theme, record {slug: slug}, tx
    call upsert_setting using stmts, "active_theme_slug", slug, now_rec.iso, tx
    set active_row to data.one using stmts.get_theme, record {lookup: "slug", sv: slug}, tx
    call data.commit using tx

    call cache.delete using stmts.cms_cache, "active_theme"
    call cache.delete using stmts.cms_cache, "site_settings"
    call cache.delete using stmts.cms_cache, ("grex_doc:" joined with slug)
    call bump_cache_epoch using stmts, "cache_epoch:theme"
    call bump_cache_epoch using stmts, "cache_epoch:query"
    give back record {ok: yes, status: 200, error: "", active_theme: active_row, mode: check_res.mode}
  catch tx_err
    call data.rollback using tx
    give back record {ok: no, status: 500, error: tx_err.message, active_theme: nothing, mode: ""}
  end
end

route "GET" "/setup"
  set cnt_row to data.one using stmts.count_users, record {}
  if cnt_row is not nothing and cnt_row.total is greater than 0
    give back server.redirect using "/login", 302
  end
  set settings to get_site_settings_map using stmts
  set assets to call admin_asset_urls
  set rendered to server.html using "views/admin/setup.grab.html", record {site_title: (settings at "site_title"), tokens_css_url: assets.tokens, admin_css_url: assets.admin_css, grex_js_url: assets.grex, admin_js_url: assets.admin_js}
  give back server.response using record {status: 200, headers: {"Content-Type": "text/html; charset=utf-8", "Cache-Control": "no-store"}, body: rendered.body}
end

route "GET" "/login" using req
  set cnt_row to data.one using stmts.count_users, record {}
  if cnt_row is nothing or cnt_row.total is 0
    give back server.redirect using "/setup", 302
  end
  set sess to resolve_session using stmts, req
  if sess is not nothing and (role_has_capability using sess.role, "admin:access")
    give back server.redirect using "/admin", 302
  end
  set settings to get_site_settings_map using stmts
  set assets to call admin_asset_urls
  set oauth_cfg to get_oauth_providers_config using stmts
  set social_html to render_social_login_buttons using oauth_cfg
  set rendered to server.html using "views/admin/login.grab.html", record {site_title: (settings at "site_title"), tokens_css_url: assets.tokens, admin_css_url: assets.admin_css, grex_js_url: assets.grex, admin_js_url: assets.admin_js}
  set final_html to text.replace using rendered.body, "<!-- @slot:social_login -->", social_html
  give back server.response using record {status: 200, headers: {"Content-Type": "text/html; charset=utf-8", "Cache-Control": "no-store"}, body: final_html}
end

