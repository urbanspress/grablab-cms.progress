  end
  set sum_html to "<p>No published series yet.</p>"
  if (collections.length using cards) is greater than 0
    set sum_html to "<section class=\"cms-book-grid\">" joined with (text.join using cards, "") joined with "</section>"
  end
  give back render_theme_page using stmts, "archive", {"archive_label": "Book Series", "archive_slug": "series", "meta_description": "Published book series", "entry_count": (text.from using (collections.length using s_rows)), "published_count": (text.from using (collections.length using s_rows)), "entries_summary": sum_html, "current_path": "/series"}, 200, []
end

route "GET" "/series/{slug}" using req
  set slug_norm to normalize_slug using req.params.slug
  set full_path to "/series/" joined with slug_norm
  if not stmts.author_ready or (not (get_author_config using stmts).enabled)
    give back render_theme_page using stmts, "404", {"requested_path": full_path, "current_path": full_path}, 404, []
  end
  set ser to data.one using stmts.author.series, record {mode: "path", iv: 0, sv: full_path}
  if ser is nothing or ser.status is not "published" or ser.active is not 1
    set redir to data.one using stmts.find_redirect_by_old_path, record {old_path: full_path}
    if redir is not nothing and redir.target_path is not full_path and (not (is_reserved_path using redir.target_path))
      give back server.redirect using redir.target_path, 301
    end
    give back render_theme_page using stmts, "404", {"requested_path": full_path, "current_path": full_path}, 404, []
  end

  set s_books to data.query using stmts.author.books, record {mode: "series", iv: ser.id, sv: ""}
  set ld_safe to build_series_jsonld using stmts, ser, s_books
  set li_parts to []
  for each b in s_books
    if b.status is "published" and b.active is 1
      set p_s to format_cents_usd using b.list_price_cents
      set li_parts to collections.append using li_parts, ("<li><a href=\"" joined with (escape_html using b.full_path) joined with "\">" joined with (escape_html using b.title) joined with "</a> — $" joined with (escape_html using p_s) joined with " " joined with (escape_html using b.currency) joined with "</li>")
    end
  end
  set books_html to "<p class=\"cms-muted\">No published books in this series yet.</p>"
  if (collections.length using li_parts) is greater than 0
    set books_html to "<ol class=\"cms-series-list\">" joined with (text.join using li_parts, "") joined with "</ol>"
  end
  set reader_css_url to safe_asset_url using "author/reader.css"
  set theme to get_active_theme_context using stmts
  if theme.mode is "coded" and (files.exists using ("themes/" joined with theme.slug joined with "/templates/series.grab.html"))
    give back render_theme_page using stmts, "series", {"title": ser.title, "meta_title": ser.title, "meta_description": ser.meta_description, "genre_slug": ser.genre_slug, "author_name": ser.author_pen_name, "author_url": ser.author_full_path, "reading_order_mode": ser.reading_order_mode, "total_planned_books": (text.from using ser.total_planned_books), "body_text": ser.body_html, "full_path": ser.full_path, "current_path": ser.full_path, "_head_json_ld": ld_safe, "_slot_series_books_html": books_html, "reader_css_url": reader_css_url}, 200, []
  end
  give back render_theme_page using stmts, "single", {"title": ser.title, "meta_title": ser.title, "meta_description": ser.meta_description, "content_type_label": "Series", "full_path": ser.full_path, "published_at": ser.updated_at, "body_text": ser.body_html, "custom_fields_summary": "{}", "_head_json_ld": ld_safe}, 200, []
end

