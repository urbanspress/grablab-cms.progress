set stmt_count_entries_by_term to data.prepare using db, "SELECT count(DISTINCT e.id) AS total FROM entries e INNER JOIN entry_terms et ON et.entry_id = e.id WHERE et.term_id IN (:t0, :t1, :t2, :t3, :t4, :t5, :t6, :t7, :t8, :t9, :t10, :t11, :t12, :t13, :t14, :t15) AND (:filter_type = 0 OR e.content_type_id = :content_type_id) AND (:filter_status = 0 OR e.status = :status)", record {params: record {t0: "integer", t1: "integer", t2: "integer", t3: "integer", t4: "integer", t5: "integer", t6: "integer", t7: "integer", t8: "integer", t9: "integer", t10: "integer", t11: "integer", t12: "integer", t13: "integer", t14: "integer", t15: "integer", filter_type: "integer", content_type_id: "integer", filter_status: "integer", status: "text"}, columns: record {total: "integer"}}
set stmt_query_entries_by_term to data.prepare using db, "SELECT DISTINCT e.id, e.content_type_id, ct.slug AS content_type_slug, ct.label_singular AS content_type_label, e.slug, e.full_path, e.title, e.status, e.body_html, e.custom_fields_json, e.meta_title, e.meta_description, e.published_at, e.created_at, e.updated_at FROM entries e JOIN content_types ct ON ct.id = e.content_type_id INNER JOIN entry_terms et ON et.entry_id = e.id WHERE et.term_id IN (:t0, :t1, :t2, :t3, :t4, :t5, :t6, :t7, :t8, :t9, :t10, :t11, :t12, :t13, :t14, :t15) AND (:filter_type = 0 OR e.content_type_id = :content_type_id) AND (:filter_status = 0 OR e.status = :status) ORDER BY COALESCE(e.published_at, e.created_at) DESC, e.id DESC LIMIT :limit_rows OFFSET :offset_rows", record {params: record {t0: "integer", t1: "integer", t2: "integer", t3: "integer", t4: "integer", t5: "integer", t6: "integer", t7: "integer", t8: "integer", t9: "integer", t10: "integer", t11: "integer", t12: "integer", t13: "integer", t14: "integer", t15: "integer", filter_type: "integer", content_type_id: "integer", filter_status: "integer", status: "text", limit_rows: "integer", offset_rows: "integer"}, columns: record {id: "integer", content_type_id: "integer", content_type_slug: "text", content_type_label: "text", slug: "text", full_path: "text", title: "text", status: "text", body_html: "text", custom_fields_json: "text", meta_title: "text", meta_description: "text", published_at: record {type: "text", nullable: yes}, created_at: "text", updated_at: "text"}}

set stmts to record {db: db, cms_cache: cms_cache, get_setting: stmt_get_setting, list_settings: stmt_list_settings, upsert_setting_update: stmt_upsert_setting_update, upsert_setting_insert: stmt_upsert_setting_insert, list_types: stmt_list_types, get_type_by_slug: stmt_get_type_by_slug, get_type_by_id: stmt_get_type_by_id, get_type_by_archive: stmt_get_type_by_archive, insert_type: stmt_insert_type, list_fields_by_type: stmt_list_fields_by_type, get_field_by_key: stmt_get_field_by_key, insert_field: stmt_insert_field, list_entries: stmt_list_entries, list_entries_by_author: stmt_list_entries_by_author, list_published_entries: stmt_list_published_entries, list_published_by_type: stmt_list_published_by_type, get_entry_by_id: stmt_get_entry_by_id, get_entry_by_full_path: stmt_get_entry_by_full_path, get_published_entry_by_path: stmt_get_published_entry_by_path, insert_entry: stmt_insert_entry, update_entry: stmt_update_entry, delete_entry_by_id: stmt_delete_entry_by_id, count_entries_filtered: stmt_count_entries_filtered, query_published_at_desc: stmt_query_published_at_desc, query_published_at_asc: stmt_query_published_at_asc, query_created_at_desc: stmt_query_created_at_desc, query_created_at_asc: stmt_query_created_at_asc, query_updated_at_desc: stmt_query_updated_at_desc, query_updated_at_asc: stmt_query_updated_at_asc, query_title_desc: stmt_query_title_desc, query_title_asc: stmt_query_title_asc, query_id_desc: stmt_query_id_desc, query_id_asc: stmt_query_id_asc, find_redirect_by_old_path: stmt_find_redirect_by_old_path, list_redirects: stmt_list_redirects, delete_redirect_by_old_path: stmt_delete_redirect_by_old_path, delete_redirects_by_entry_id: stmt_delete_redirects_by_entry_id, insert_redirect: stmt_insert_redirect, list_themes: stmt_list_themes, get_theme_by_slug: stmt_get_theme_by_slug, get_active_theme: stmt_get_active_theme, insert_theme: stmt_insert_theme, update_theme_manifest: stmt_update_theme_manifest, deactivate_all_themes: stmt_deactivate_all_themes, activate_theme_slug: stmt_activate_theme_slug, count_users: stmt_count_users, list_users: stmt_list_users, get_user_by_id: stmt_get_user_by_id, get_user_by_email: stmt_get_user_by_email, insert_user: stmt_insert_user, update_user: stmt_update_user, update_user_login: stmt_update_user_login, update_user_password: stmt_update_user_password, get_session_with_user: stmt_get_session_with_user, insert_session: stmt_insert_session, touch_session: stmt_touch_session, delete_session_by_id: stmt_delete_session_by_id, delete_session_by_token: stmt_delete_session_by_token, delete_sessions_by_user: stmt_delete_sessions_by_user, delete_expired_sessions: stmt_delete_expired_sessions, get_oauth_account: stmt_get_oauth_account, insert_oauth_account: stmt_insert_oauth_account, update_oauth_account: stmt_update_oauth_account, count_media: stmt_count_media, list_media: stmt_list_media, get_media_by_id: stmt_get_media_by_id, get_media_by_filename: stmt_get_media_by_filename, insert_media: stmt_insert_media, update_media: stmt_update_media, delete_media: stmt_delete_media, list_menus: stmt_list_menus, get_menu_by_id: stmt_get_menu_by_id, get_menu_by_slug: stmt_get_menu_by_slug, get_menu_by_location: stmt_get_menu_by_location, insert_menu: stmt_insert_menu, clear_menu_location: stmt_clear_menu_location, update_menu: stmt_update_menu, delete_menu: stmt_delete_menu, list_menu_items_by_menu: stmt_list_menu_items_by_menu, get_menu_item_by_id: stmt_get_menu_item_by_id, insert_menu_item: stmt_insert_menu_item, update_menu_item: stmt_update_menu_item, delete_menu_items_by_menu: stmt_delete_menu_items_by_menu, delete_menu_item_by_id: stmt_delete_menu_item_by_id, list_taxonomies: stmt_list_taxonomies, get_taxonomy_by_id: stmt_get_taxonomy_by_id, get_taxonomy_by_slug: stmt_get_taxonomy_by_slug, get_taxonomy_by_archive: stmt_get_taxonomy_by_archive, insert_taxonomy: stmt_insert_taxonomy, update_taxonomy: stmt_update_taxonomy, delete_taxonomy: stmt_delete_taxonomy, list_terms_by_tax: stmt_list_terms_by_tax, get_term_by_id: stmt_get_term_by_id, get_term_by_tax_slug: stmt_get_term_by_tax_slug, insert_term: stmt_insert_term, update_term: stmt_update_term, delete_term: stmt_delete_term, list_entry_terms: stmt_list_entry_terms, delete_entry_terms_by_entry: stmt_delete_entry_terms_by_entry, insert_entry_term: stmt_insert_entry_term, count_entries_by_term: stmt_count_entries_by_term, query_entries_by_term: stmt_query_entries_by_term}

# ==============================================================================
# Shared Helpers: Normalization, Identifier & URL Safety, Escaping
# ==============================================================================

make is_allowed_chars using raw, allowed_str, min_len, max_len
  set n to text.length using raw
  if n is less than min_len or n is greater than max_len
    give back no
  end
  set chars to text.split using raw, ""
  for each ch in chars
    if not (text.contains using allowed_str, ch)
      give back no
    end
  end
  give back yes
end

make is_valid_slug using raw
  give back is_allowed_chars using raw, "abcdefghijklmnopqrstuvwxyz0123456789_-", 1, 64
end

make is_valid_field_key using raw
  give back is_allowed_chars using raw, "abcdefghijklmnopqrstuvwxyz0123456789_", 1, 64
end

make is_valid_theme_slug using raw
  give back is_allowed_chars using raw, "abcdefghijklmnopqrstuvwxyz0123456789-", 1, 64
end

make is_valid_entry_slug using raw
  give back is_allowed_chars using raw, "abcdefghijklmnopqrstuvwxyz0123456789_-", 1, 190
end

make normalize_slug using raw
  set cleaned to text.lower using (text.trim using raw)
  give back cleaned
end

make normalize_path using raw_path
  set cleaned to text.lower using (text.trim using raw_path)
  if cleaned is ""
    give back "/"
  end
  if not (text.starts_with using cleaned, "/")
    set cleaned to "/" joined with cleaned
  end
  while (text.length using cleaned) is greater than 1 and (text.ends_with using cleaned, "/")
    set chars to text.split using cleaned, ""
    set last_idx to (collections.length using chars) minus 1
    set sliced to collections.slice using chars, 0, last_idx
    set cleaned to text.join using sliced, ""
  end
  give back cleaned
end

make has_unsafe_path_chars using raw_path
  if (text.contains using raw_path, "..") or (text.contains using raw_path, "\\") or (text.contains using raw_path, "?") or (text.contains using raw_path, "#") or (text.contains using raw_path, "\r") or (text.contains using raw_path, "\n")
    give back yes
  end
  give back no
end

make is_reserved_path using raw_path
  set p to normalize_path using raw_path
  if p is "/admin" or (text.starts_with using p, "/admin/")
    give back yes
  end
  if p is "/api" or (text.starts_with using p, "/api/")
    give back yes
  end
  if p is "/static" or (text.starts_with using p, "/static/")
    give back yes
  end
  if p is "/media" or (text.starts_with using p, "/media/")
    give back yes
  end
  if p is "/login" or (text.starts_with using p, "/login/") or p is "/logout" or (text.starts_with using p, "/logout/")
    give back yes
  end
  if p is "/setup" or (text.starts_with using p, "/setup/") or p is "/search" or (text.starts_with using p, "/search/")
    give back yes
  end
  if p is "/_health" or p is "/_ready" or p is "/robots.txt" or p is "/sitemap.xml" or p is "/favicon.ico"
    give back yes
  end
  give back no
end

make is_safe_url using raw_url
  set u to text.trim using raw_url
  if u is "" or (text.contains using u, "\r") or (text.contains using u, "\n") or (text.contains using u, "\\") or (text.contains using u, " ")
    give back no
  end
  set lower to text.lower using u
  if (text.starts_with using lower, "javascript:") or (text.starts_with using lower, "data:") or (text.starts_with using lower, "vbscript:")
    give back no
  end
  if (text.starts_with using lower, "//")
    give back no
  end
  if (text.starts_with using lower, "http://") or (text.starts_with using lower, "https://")
    set after_scheme to ""
    if text.starts_with using lower, "https://"
      set after_scheme to text.replace using lower, "https://", ""
    otherwise
      set after_scheme to text.replace using lower, "http://", ""
    end
    if after_scheme is "" or (text.starts_with using after_scheme, "/")
      give back no
    end
    give back yes
  end
  if text.starts_with using lower, "/"
    give back yes
  end
  give back no
end

make escape_html using raw
  set s to text.from using raw
  set s to text.replace using s, "&", "&amp;"
  set s to text.replace using s, "<", "&lt;"
  set s to text.replace using s, ">", "&gt;"
  set s to text.replace using s, "\"", "&#34;"
  set s to text.replace using s, "'", "&#39;"
  give back s
end

make safe_asset_url using raw_path
  try
    give back server.asset using raw_path
  catch err
    give back ""
  end
end

make has_map_key using m, key
  if m is nothing
    give back no
  end
  set ks to collections.keys using m
  for each k in ks
    if k is key
      give back yes
    end
  end
  give back no
end

make text_truncate using raw, max_chars
  set chars to text.split using raw, ""
  if (collections.length using chars) is at most max_chars
    give back raw
  end
  set sliced to collections.slice using chars, 0, max_chars
  give back (text.join using sliced, "") joined with "..."
end

make make_excerpt using raw_body
  set cleaned to text.trim using (text.from using raw_body)
  if cleaned is ""
    give back ""
  end
  if text.starts_with using cleaned, "{"
    give back "Structured Grex layout content."
  end
  give back text_truncate using cleaned, 160
end

# ==============================================================================
# Module 0.5: Authentication, Sessions, RBAC, Rate Limiting, Crypto & OAuth2/PKCE
# ==============================================================================

make get_req_header using req, header_lower
  if has_map_key using req.headers, header_lower
    give back text.trim using (text.from using (req.headers at header_lower))
  end
  give back ""
end

make extract_cookie using req, cookie_name
  set cookie_hdr to get_req_header using req, "cookie"
  if cookie_hdr is ""
    give back ""
  end
  set prefix to cookie_name joined with "="
  set parts to text.split using cookie_hdr, ";"
  for each part in parts
    set trimmed to text.trim using part
    if text.starts_with using trimmed, prefix
      set pieces to text.split using trimmed, "="
      if (collections.length using pieces) is at least 2
        set rest to collections.slice using pieces, 1, (collections.length using pieces)
        give back text.join using rest, "="
      end
    end
  end
  give back ""
end

make is_https_req using req
  if req.scheme is "https"
    give back yes
  end
  if (text.lower using (get_req_header using req, "x-forwarded-proto")) is "https"
    give back yes
  end
  give back no
end

make build_cookie using name, val, path_val, max_age_sec, is_https
  set base to name joined with "=" joined with val joined with "; Path=" joined with path_val joined with "; HttpOnly; SameSite=Lax; Max-Age=" joined with (text.from using max_age_sec)
  if is_https
    give back base joined with "; Secure"
  end
  give back base
end

make clear_session_cookie using is_https
  give back build_cookie using "grablab_session", "", "/", 0, is_https
end

make normalize_email using raw
  give back text.lower using (text.trim using (text.from using raw))
end

make is_valid_email using email
  set n to text.length using email
  if n is less than 5 or n is greater than 254
    give back no
  end
  if (text.contains using email, " ") or (text.contains using email, "\n") or (text.contains using email, "\r")
    give back no
  end
  set parts to text.split using email, "@"
  if (collections.length using parts) is not 2
    give back no
  end
  set local_part to parts at 0
  set domain_part to parts at 1
  if local_part is "" or domain_part is "" or (not (text.contains using domain_part, "."))
    give back no
  end
  give back yes
end

make is_valid_password using pw
  set n to text.length using pw
  if n is less than 10 or n is greater than 1024
    give back no
  end
  give back yes
end

make is_valid_role using r
  set allowed to ["admin", "editor", "author", "viewer"]
  for each item in allowed
    if item is r
      give back yes
    end
  end
  give back no
end

make role_has_capability using role, cap
  if role is "admin"
    give back yes
  end
  if role is "editor"
    set editor_caps to ["admin:access", "entries:read", "entries:read_all", "entries:create", "entries:update:own", "entries:update:any", "entries:publish", "entries:delete:own", "entries:delete:any", "media:read", "media:upload", "media:update_own", "media:update_any", "media:delete_own", "media:delete_any", "menus:manage", "taxonomies:manage"]
    for each item in editor_caps
      if item is cap
        give back yes
      end
    end
    give back no
  end
  if role is "author"
    set author_caps to ["admin:access", "entries:read", "entries:create", "entries:update:own", "entries:delete:own", "media:read", "media:upload", "media:update_own", "media:delete_own"]
    for each item in author_caps
      if item is cap
        give back yes
      end
    end
    give back no
  end
  give back no
end

make get_master_key
  try
    if env.has using "GRABLAB_MASTER_KEY"
      set raw to env.get using "GRABLAB_MASTER_KEY"
      if raw is not nothing
        set trimmed to text.trim using raw
        if trimmed is not ""
          give back trimmed
        end
      end
    end
    give back ""
  catch err
    give back ""
  end
end

make get_oauth_test_base_url
  try
    if env.has using "GRABLAB_OAUTH_TEST_BASE_URL"
      set raw to env.get using "GRABLAB_OAUTH_TEST_BASE_URL"
      if raw is not nothing
        set trimmed to text.trim using raw
        if text.starts_with using trimmed, "http://127.0.0.1:"
          give back trimmed
        end
      end
    end
    give back ""
  catch err
    give back ""
  end
end

make url_encode using raw
  set s to text.from using raw
  set s to text.replace using s, "%", "%25"
  set s to text.replace using s, " ", "%20"
  set s to text.replace using s, "!", "%21"
  set s to text.replace using s, "\"", "%22"
  set s to text.replace using s, "#", "%23"
  set s to text.replace using s, "$", "%24"
  set s to text.replace using s, "&", "%26"
  set s to text.replace using s, "'", "%27"
  set s to text.replace using s, "(", "%28"
  set s to text.replace using s, ")", "%29"
  set s to text.replace using s, "*", "%2A"
  set s to text.replace using s, "+", "%2B"
  set s to text.replace using s, ",", "%2C"
  set s to text.replace using s, "/", "%2F"
  set s to text.replace using s, ":", "%3A"
  set s to text.replace using s, ";", "%3B"
  set s to text.replace using s, "=", "%3D"
  set s to text.replace using s, "?", "%3F"
  set s to text.replace using s, "@", "%40"
  set s to text.replace using s, "[", "%5B"
  set s to text.replace using s, "]", "%5D"
  give back s
end

make default_oauth_providers_config
  give back {"google": {"enabled": no, "client_id": "", "client_secret_enc": "", "secret_hint": "", "allowed_domains": ""}, "github": {"enabled": no, "client_id": "", "client_secret_enc": "", "secret_hint": "", "allowed_domains": ""}, "discord": {"enabled": no, "client_id": "", "client_secret_enc": "", "secret_hint": "", "allowed_domains": ""}, "apple": {"enabled": no, "client_id": "", "client_secret_enc": "", "secret_hint": "", "allowed_domains": ""}}
end

make get_oauth_providers_config using stmts
  set row to data.one using stmts.get_setting, record {key: "oauth_providers_json"}
  if row is nothing or row.value is ""
    give back call default_oauth_providers_config
  end
  try
    set parsed to json.parse using row.value
    set base to call default_oauth_providers_config
    set keys to ["google", "github", "discord", "apple"]
    for each k in keys
      if has_map_key using parsed, k
        set p to parsed at k
        set merged to {"enabled": no, "client_id": "", "client_secret_enc": "", "secret_hint": "", "allowed_domains": ""}
        if has_map_key using p, "enabled"
          if p at "enabled"
            set merged to collections.put using merged, "enabled", yes
          end
        end
        if has_map_key using p, "client_id"
          set merged to collections.put using merged, "client_id", (text.from using (p at "client_id"))
        end
        if has_map_key using p, "client_secret_enc"
          set merged to collections.put using merged, "client_secret_enc", (text.from using (p at "client_secret_enc"))
        end
        if has_map_key using p, "secret_hint"
          set merged to collections.put using merged, "secret_hint", (text.from using (p at "secret_hint"))
        end
        if has_map_key using p, "allowed_domains"
          set merged to collections.put using merged, "allowed_domains", (text.from using (p at "allowed_domains"))
        end
        set base to collections.put using base, k, merged
      end
    end
    give back base
  catch err
    give back call default_oauth_providers_config
  end
end

make mask_oauth_providers using cfg
  set masked to {}
  set keys to ["google", "github", "discord", "apple"]
  for each k in keys
    set p to cfg at k
    set has_sec to (p at "client_secret_enc") is not ""
    set hint to p at "secret_hint"
    set item to {"enabled": (p at "enabled"), "client_id": (p at "client_id"), "has_secret": has_sec, "secret_hint": hint, "allowed_domains": (p at "allowed_domains")}
    set masked to collections.put using masked, k, item
  end
  give back masked
end

make render_social_login_buttons using cfg
  set labels to {"google": "Continue with Google", "github": "Continue with GitHub", "discord": "Continue with Discord", "apple": "Continue with Apple"}
  set keys to ["google", "github", "discord", "apple"]
  set btns to []
  for each k in keys
    set p to cfg at k
    if (p at "enabled") and ((p at "client_id") is not "") and ((p at "client_secret_enc") is not "")
      set label to labels at k
      set btns to collections.append using btns, ("<a class=\"cms-btn-secondary cms-social-btn\" href=\"/api/auth/oauth/" joined with k joined with "/start\">" joined with label joined with "</a>")
    end
  end
  if (collections.length using btns) is 0
    give back ""
  end
  give back "<section class=\"cms-social-login\" aria-label=\"Social sign in\"><p class=\"cms-muted\">Or continue with a configured provider:</p>" joined with (text.join using btns, "") joined with "</section>"
end

make build_secret_hint using raw_secret
  set chars to text.split using raw_secret, ""
  set n to collections.length using chars
  if n is at most 4
    give back "••••"
  end
  set tail to collections.slice using chars, (n minus 4), n
  give back "****" joined with (text.join using tail, "")
end

make is_session_expired using expires_at_iso, now_rec
  try
    set exp_rec to dates.parse_iso using expires_at_iso
    set diff to dates.diff_seconds using exp_rec, now_rec
    give back (diff is at most 0)
  catch err
    give back yes
  end
end

make resolve_session_token using stmts, raw_token
  if raw_token is ""
    give back nothing
  end
  set tok_hash to crypto.sha256_hex using raw_token
  set row to data.one using stmts.get_session_with_user, record {token_hash: tok_hash}
  if row is nothing
    give back nothing
  end
  if row.is_active is not 1
    call data.execute using stmts.delete_session_by_id, record {id: row.session_id}
    give back nothing
  end
  set now_rec to call dates.now_utc
  if is_session_expired using row.expires_at, now_rec
    call data.execute using stmts.delete_session_by_id, record {id: row.session_id}
    give back nothing
  end
  set exp_rec to dates.parse_iso using row.expires_at
  set rem_sec to dates.diff_seconds using exp_rec, now_rec
  if rem_sec is less than 259200
    set next_exp to dates.add_days using now_rec, 7
    call data.execute using stmts.touch_session, record {expires_at: next_exp.iso, last_seen_at: now_rec.iso, id: row.session_id}
  end
  give back row
end

make resolve_session using stmts, req
  set raw_token to extract_cookie using req, "grablab_session"
  give back resolve_session_token using stmts, raw_token
end

make extract_bearer_token using req
  set auth_hdr to text.trim using (get_req_header using req, "authorization")
  if (text.length using auth_hdr) is greater than 7
    set prefix to text.lower using (text.join using (collections.slice using (text.split using auth_hdr, ""), 0, 7), "")
    if prefix is "bearer "
      set tok to text.trim using (text.join using (collections.slice using (text.split using auth_hdr, ""), 7, (text.length using auth_hdr)), "")
      give back tok
    end
  end
  give back ""
end

make create_rotated_session using stmts, req, user_id, old_token_hash
  set sess_id to crypto.random_hex using 16
  set raw_token to crypto.random_urlsafe using 32
  set tok_hash to crypto.sha256_hex using raw_token
  set csrf_secret to crypto.random_urlsafe using 32
  set now_rec to call dates.now_utc
  set exp_rec to dates.add_days using now_rec, 7
  set ip_hash to crypto.sha256_hex using (text.from using req.client_ip)
  set ua to text_truncate using (get_req_header using req, "user-agent"), 180

  set tx to data.begin using stmts.db
  try
    if old_token_hash is not ""
      call data.execute using stmts.delete_session_by_token, record {token_hash: old_token_hash}, tx
    end
    call data.execute using stmts.delete_expired_sessions, record {now_iso: now_rec.iso}, tx
    call data.execute using stmts.insert_session, record {id: sess_id, user_id: user_id, token_hash: tok_hash, csrf_secret: csrf_secret, ip_hash: ip_hash, user_agent: ua, expires_at: exp_rec.iso, created_at: now_rec.iso, last_seen_at: now_rec.iso}, tx
    call data.execute using stmts.update_user_login, record {last_login_at: now_rec.iso, updated_at: now_rec.iso, id: user_id}, tx
    call data.commit using tx
    give back record {ok: yes, session_id: sess_id, raw_token: raw_token, token_hash: tok_hash, csrf_secret: csrf_secret, expires_at: exp_rec.iso, error: ""}
  catch tx_err
    call data.rollback using tx
    give back record {ok: no, session_id: "", raw_token: "", token_hash: "", csrf_secret: "", expires_at: "", error: tx_err.message}
  end
end

make csrf_matches using req, sess
  set hdr to get_req_header using req, "x-csrf-token"
  if hdr is ""
    give back no
  end
  give back (crypto.sha256_hex using hdr) is (crypto.sha256_hex using sess.csrf_secret)
end

make require_api_auth using stmts, req, cap, require_csrf
  set sess to resolve_session using stmts, req
  if sess is nothing
    give back record {ok: no, session: nothing, response: (server.json using 401, record {error: "Authentication required"})}
  end
  if require_csrf and (not (csrf_matches using req, sess))
    give back record {ok: no, session: nothing, response: (server.json using 403, record {error: "Invalid or missing CSRF token"})}
  end
  if cap is not "" and (not (role_has_capability using sess.role, cap))
    give back record {ok: no, session: nothing, response: (server.json using 403, record {error: "Forbidden: insufficient role capability"})}
  end
  give back record {ok: yes, session: sess, response: nothing}
end

make check_auth_ip_limit using stmts, req
  set ip_key to "rl:ip:" joined with (crypto.sha256_hex using (text.from using req.client_ip))
  try
    set lim to cache.limit using stmts.cms_cache, ip_key, 120, 60000
    if not lim.allowed
      give back record {ok: no, response: (server.response using record {status: 429, headers: {"Content-Type": "application/json; charset=utf-8", "Retry-After": "60", "Cache-Control": "no-store"}, body: (json.stringify using (record {error: "Too many authentication requests. Try again shortly."}))})}
    end
    give back record {ok: yes, response: nothing}
  catch err
    give back record {ok: no, response: (server.json using 503, record {error: "Rate limiter unavailable"})}
  end
end

make login_pair_hash using req, email_norm
  give back crypto.sha256_hex using ((text.from using req.client_ip) joined with "|" joined with email_norm)
end

make check_login_rate_limit using stmts, req, email_norm
  set pair_hash to login_pair_hash using req, email_norm
  set epoch_key to "rl:epoch:" joined with pair_hash
  set epoch to "0"
  try
    set ep to cache.get using stmts.cms_cache, epoch_key
    if ep.found and ep.value is not nothing and ep.value is not ""
      set epoch to text.from using ep.value
    end
    set bucket to "rl:login:" joined with epoch joined with ":" joined with pair_hash
    set lim to cache.limit using stmts.cms_cache, bucket, 5, 900000
    if not lim.allowed
      give back record {ok: no, response: (server.response using record {status: 429, headers: {"Content-Type": "application/json; charset=utf-8", "Retry-After": "900", "Cache-Control": "no-store"}, body: (json.stringify using (record {error: "Too many failed sign-in attempts. Account temporarily locked for 15 minutes."}))})}
    end
    give back record {ok: yes, response: nothing}
  catch err
    give back record {ok: no, response: (server.json using 503, record {error: "Rate limiter unavailable"})}
  end
end

make clear_login_rate_limit using stmts, req, email_norm
  set pair_hash to login_pair_hash using req, email_norm
  set epoch_key to "rl:epoch:" joined with pair_hash
  try
    set cur to cache.get using stmts.cms_cache, epoch_key
    set n to 0
    if cur.found and cur.value is not nothing and cur.value is not ""
      set n to text.to_integer using (text.from using cur.value)
    end
    call cache.set using stmts.cms_cache, epoch_key, (text.from using (n plus 1)), 900000
  catch err
    give back no
  end
  give back yes
end

make is_supported_oauth_provider using p
  set allowed to ["google", "github", "discord", "apple"]
  for each item in allowed
    if item is p
      give back yes
    end
  end
  give back no
end

make resolve_provider_endpoints using provider, test_base
  if test_base is not ""
    give back record {authorize_url: (test_base joined with "/" joined with provider joined with "/authorize"), token_url: (test_base joined with "/" joined with provider joined with "/token"), userinfo_url: (test_base joined with "/" joined with provider joined with "/userinfo"), emails_url: (test_base joined with "/" joined with provider joined with "/emails"), scope: "openid email profile"}
  end
  if provider is "google"
    give back record {authorize_url: "https://accounts.google.com/o/oauth2/v2/auth", token_url: "https://oauth2.googleapis.com/token", userinfo_url: "https://openidconnect.googleapis.com/v1/userinfo", emails_url: "", scope: "openid email profile"}
  end
  if provider is "github"
    give back record {authorize_url: "https://github.com/login/oauth/authorize", token_url: "https://github.com/login/oauth/access_token", userinfo_url: "https://api.github.com/user", emails_url: "https://api.github.com/user/emails", scope: "read:user user:email"}
  end
  if provider is "discord"
    give back record {authorize_url: "https://discord.com/oauth2/authorize", token_url: "https://discord.com/api/oauth2/token", userinfo_url: "https://discord.com/api/users/@me", emails_url: "", scope: "identify email"}
  end
  give back record {authorize_url: "https://appleid.apple.com/auth/authorize", token_url: "https://appleid.apple.com/auth/token", userinfo_url: "", emails_url: "", scope: "name email"}
end

make email_domain_allowed using email, allowed_csv
  set cleaned to text.trim using allowed_csv
  if cleaned is ""
    give back yes
  end
  set parts to text.split using email, "@"
  if (collections.length using parts) is not 2
    give back no
  end
  set user_dom to text.lower using (parts at 1)
  set items to text.split using cleaned, ","
  for each item in items
    set candidate to text.lower using (text.trim using item)
    if candidate is not "" and candidate is user_dom
      give back yes
    end
  end
  give back no
end

make resolve_or_create_oauth_user using stmts, provider, provider_uid, email_norm, display_name, allow_signup
  set now_rec to call dates.now_utc
  set link to data.one using stmts.get_oauth_account, record {provider: provider, provider_user_id: provider_uid}
  if link is not nothing
    set user_row to data.one using stmts.get_user_by_id, record {id: link.user_id}
    if user_row is nothing or user_row.is_active is not 1
      give back record {ok: no, user: nothing, error: "Account disabled or missing"}
    end
    call data.execute using stmts.update_oauth_account, record {provider_email: email_norm, updated_at: now_rec.iso, id: link.id}
    give back record {ok: yes, user: user_row, error: ""}
  end

  set existing_user to data.one using stmts.get_user_by_email, record {email: email_norm}
  if existing_user is not nothing
    if existing_user.is_active is not 1
      give back record {ok: no, user: nothing, error: "Account disabled"}
    end
    call data.execute using stmts.insert_oauth_account, record {user_id: existing_user.id, provider: provider, provider_user_id: provider_uid, provider_email: email_norm, created_at: now_rec.iso, updated_at: now_rec.iso}
    give back record {ok: yes, user: existing_user, error: ""}
  end

  if not allow_signup
    give back record {ok: no, user: nothing, error: "No matching GrabLab user account and OAuth signup is disabled"}
  end

  set tx to data.begin using stmts.db
  try
    call data.execute using stmts.insert_user, record {email: email_norm, display_name: display_name, role: "viewer", password_hash: nothing, email_verified: 1, is_active: 1, last_login_at: now_rec.iso, created_at: now_rec.iso, updated_at: now_rec.iso}, tx
    set created_user to data.one using stmts.get_user_by_email, record {email: email_norm}, tx
    call data.execute using stmts.insert_oauth_account, record {user_id: created_user.id, provider: provider, provider_user_id: provider_uid, provider_email: email_norm, created_at: now_rec.iso, updated_at: now_rec.iso}, tx
    call data.commit using tx
    give back record {ok: yes, user: created_user, error: ""}
  catch tx_err
    call data.rollback using tx
    give back record {ok: no, user: nothing, error: tx_err.message}
  end
end

make admin_asset_urls
  give back record {tokens: (safe_asset_url using "grex/tokens.css"), grex: (safe_asset_url using "grex/grex.js"), admin_css: (safe_asset_url using "admin/admin.css"), admin_js: (safe_asset_url using "admin/admin.js")}
end

make render_admin_dashboard using stmts, sess, admin_page, page_title, page_subtitle
  set settings to get_site_settings_map using stmts
  set theme to get_active_theme_context using stmts
  set assets to call admin_asset_urls
  set rendered to server.html using "views/admin/dashboard.grab.html", record {csrf_token: sess.csrf_secret, admin_page: admin_page, user_role: sess.role, user_email: sess.email, user_name: sess.display_name, user_id: (text.from using sess.user_id), site_title: (settings at "site_title"), active_theme_slug: theme.slug, page_title: page_title, page_subtitle: page_subtitle, tokens_css_url: assets.tokens, admin_css_url: assets.admin_css, grex_js_url: assets.grex, admin_js_url: assets.admin_js}
  give back server.response using record {status: 200, headers: {"Content-Type": "text/html; charset=utf-8", "Cache-Control": "no-store"}, body: rendered.body}
end

# ==============================================================================
# Module 1: Content Type, Custom Field & Grex JS v1.0.0 Layout Validation
# ==============================================================================

make is_valid_field_type using ftype
  set allowed to ["text", "rich_text", "integer", "decimal", "boolean", "date", "url", "json"]
  for each item in allowed
    if item is ftype
      give back yes
    end
  end
  give back no
end

make is_allowed_grex_element using el_name
  set allowed to ["Fragment", "TemplatePart", "Section", "Container", "Grid", "Stack", "Card", "Heading", "Text", "RichText", "Link", "Button", "Image", "Icon", "Form", "Input", "Select", "Tabs", "Accordion", "Modal", "Nav", "ForEach"]
  for each item in allowed
    if item is el_name
      give back yes
    end
  end
  give back no
end

make is_allowed_grex_tag using tag_name
  set allowed to ["section", "main", "header", "footer", "article", "aside", "nav", "h1", "h2", "h3", "h4", "h5", "h6", "p", "span", "a", "button", "img", "ul", "ol", "li", "form", "input", "select", "label"]
  for each item in allowed
    if item is tag_name
      give back yes
    end
  end
  give back no
end

make is_binding_token using raw
  if (text.starts_with using raw, "{") and (text.ends_with using raw, "}") and (text.length using raw) is greater than 2
    set inner to text.replace using raw, "{", ""
    set inner to text.replace using inner, "}", ""
    if (not (text.contains using inner, "{")) and (not (text.contains using inner, "}")) and (is_valid_field_key using inner)
      give back yes
    end
  end
  give back no
end

make validate_grex_node using node, depth
  if depth is greater than 24
    give back record {ok: no, error: "Grex layout nesting exceeds maximum depth (24)"}
  end
  try
    if not (node has "element")
      give back record {ok: no, error: "Grex layout node requires an element field"}
    end
    set el_name to text.from using (node at "element")
    if not (is_allowed_grex_element using el_name)
      give back record {ok: no, error: "Unsupported or unsafe Grex element: " joined with el_name}
    end
    if node has "tag"
      set tag_name to text.lower using (text.from using (node at "tag"))
      if tag_name is "div" or tag_name is "script" or tag_name is "iframe" or tag_name is "object" or tag_name is "style" or (not (is_allowed_grex_tag using tag_name))
        give back record {ok: no, error: "Disallowed HTML tag in Grex layout: " joined with tag_name}
      end
    end
    if node has "props"
      set props to node at "props"
      set prop_keys to collections.keys using props
      for each pk in prop_keys
        set pkl to text.lower using pk
        if text.starts_with using pkl, "on"
          give back record {ok: no, error: "Inline event handler prop not allowed: " joined with pk}
        end
        if pkl is "dangerouslysetinnerhtml" or pkl is "innerhtml" or pkl is "outerhtml"
          give back record {ok: no, error: "Unsafe raw HTML prop not allowed: " joined with pk}
        end
        if pkl is "href" or pkl is "src" or pkl is "action" or pkl is "formaction"
          set url_val to text.from using (props at pk)
          if (not (is_safe_url using url_val)) and (not (is_binding_token using url_val))
            give back record {ok: no, error: "Unsafe URL in Grex prop: " joined with pk}
          end
        end
      end
    end
    if node has "children"
      set kids to node at "children"
      for each child in kids
        set child_res to validate_grex_node using child, (depth plus 1)
        if not child_res.ok
          give back child_res
        end
      end
    end
    give back record {ok: yes, error: ""}
  catch err
    give back record {ok: no, error: "Invalid Grex layout node structure"}
  end
end

make validate_single_field_value using ftype, raw_val
  set as_str to ""
  try
    set as_str to text.from using raw_val
  catch err
    give back record {ok: no, value: "", error: "Field value is not serializable"}
  end

  if ftype is "text"
    give back record {ok: yes, value: as_str, error: ""}
  end

  if ftype is "rich_text"
    set lower to text.lower using as_str
    if (text.contains using lower, "<script") or (text.contains using lower, "javascript:")
      give back record {ok: no, value: "", error: "Unsafe script content in rich_text field"}
    end
    give back record {ok: yes, value: as_str, error: ""}
  end

  if ftype is "integer"
    try
      set parsed_int to text.to_integer using as_str
      give back record {ok: yes, value: (text.from using parsed_int), error: ""}
    catch err
      give back record {ok: no, value: "", error: "Expected exact integer value"}
    end
  end

  if ftype is "decimal"
    try
      if text.contains using as_str, "."
        set parsed_dec to text.to_decimal using as_str
        give back record {ok: yes, value: as_str, error: ""}
      otherwise
        set parsed_int to text.to_integer using as_str
        give back record {ok: yes, value: as_str, error: ""}
      end
    catch err
      give back record {ok: no, value: "", error: "Expected exact base-10 decimal string"}
    end
  end

  if ftype is "boolean"
    set lower to text.lower using (text.trim using as_str)
    if lower is "yes" or lower is "true" or lower is "1"
      give back record {ok: yes, value: yes, error: ""}
    end
    if lower is "no" or lower is "false" or lower is "0"
      give back record {ok: yes, value: no, error: ""}
    end
    give back record {ok: no, value: "", error: "Expected boolean value"}
  end

  if ftype is "date"
    try
      set parsed_dt to dates.parse_iso using as_str
      give back record {ok: yes, value: parsed_dt.iso, error: ""}
    catch err
      give back record {ok: no, value: "", error: "Expected ISO-8601 date or UTC timestamp"}
    end
  end

  if ftype is "url"
    if not (is_safe_url using as_str)
      give back record {ok: no, value: "", error: "Unsafe or invalid URL"}
    end
    give back record {ok: yes, value: as_str, error: ""}
  end

  if ftype is "json"
    set parsed_json to nothing
    if as_str is (json.stringify using raw_val)
      set parsed_json to raw_val
    otherwise
      try
        set parsed_json to json.parse using as_str
      catch err
        set parsed_json to raw_val
      end
    end
    try
      set encoded to json.stringify using parsed_json
      if not ((text.starts_with using encoded, "{") or (text.starts_with using encoded, "["))
        give back record {ok: no, value: "", error: "JSON field must be a JSON object or array"}
      end
      if (text.starts_with using encoded, "{") and (parsed_json has "element")
        set grex_res to validate_grex_node using parsed_json, 0
        if not grex_res.ok
          give back record {ok: no, value: "", error: grex_res.error}
        end
      end
      give back record {ok: yes, value: parsed_json, error: ""}
    catch err
      give back record {ok: no, value: "", error: "Invalid JSON field payload"}
    end
  end

  give back record {ok: no, value: "", error: "Unknown field type: " joined with ftype}
end

make validate_custom_fields using stmts, content_type_id, input_map
  set defs to data.query using stmts.list_fields_by_type, record {content_type_id: content_type_id}
  set validated to {}
  set def_keys to {}

  for each fdef in defs
    set fkey to fdef.field_key
    set def_keys to collections.put using def_keys, fkey, yes
    set has_val to has_map_key using input_map, fkey
    set raw_val to nothing
    if has_val
      set raw_val to input_map at fkey
    end

    if (not has_val) or (raw_val is nothing)
      if fdef.is_required is 1
        give back record {ok: no, json_text: "{}", error: "Missing required custom field: " joined with fkey}
      end
      if fdef.default_value is not nothing and fdef.default_value is not ""
        set def_res to validate_single_field_value using fdef.field_type, fdef.default_value
        if not def_res.ok
          give back record {ok: no, json_text: "{}", error: "Invalid default for " joined with fkey joined with ": " joined with def_res.error}
        end
        set validated to collections.put using validated, fkey, def_res.value
      end
    otherwise
      set val_res to validate_single_field_value using fdef.field_type, raw_val
      if not val_res.ok
        give back record {ok: no, json_text: "{}", error: "Field '" joined with fkey joined with "': " joined with val_res.error}
      end
      set validated to collections.put using validated, fkey, val_res.value
    end
  end

  set in_keys to collections.keys using input_map
  for each ikey in in_keys
    if not (has_map_key using def_keys, ikey)
      give back record {ok: no, json_text: "{}", error: "Undefined custom field key: " joined with ikey}
    end
  end

  give back record {ok: yes, json_text: (json.stringify using validated), error: ""}
end

make normalize_and_validate_body using raw_val
  set body_text to ""
  set is_obj to no
  try
    set test_keys to collections.keys using raw_val
    set is_obj to yes
  catch err
    set is_obj to no
  end
  if is_obj
    set body_text to json.stringify using raw_val
  otherwise
    set body_text to text.from using raw_val
  end
  set trimmed to text.trim using body_text
  if text.starts_with using trimmed, "{"
    try
      set parsed_body to json.parse using trimmed
      if parsed_body has "element"
        set grex_chk to validate_grex_node using parsed_body, 0
        if not grex_chk.ok
          give back record {ok: no, body_html: "", error: grex_chk.error}
        end
      end
    catch err
    end
  end
  give back record {ok: yes, body_html: body_text, error: ""}
end

make compute_full_path using permalink_pattern, slug
  set raw to text.replace using permalink_pattern, ":slug", slug
  give back normalize_path using raw
end

# ==============================================================================
# Module 2: Safe Theme Import, Packaging & Exclusive Hot-Switch Engine
# ==============================================================================

make is_sensitive_segment using seg
  set s to text.lower using seg
  if s is ".git" or s is ".env" or s is ".ssh" or s is "id_rsa" or s is "id_ed25519" or s is ".ds_store"
    give back yes
  end
  if (text.starts_with using s, ".env.") or (text.ends_with using s, ".pem") or (text.ends_with using s, ".key")
    give back yes
  end
  give back no
end

make is_disallowed_executable_ext using rel
  set lower to text.lower using rel
  set bad_exts to [".exe", ".dll", ".so", ".dylib", ".sh", ".bat", ".cmd", ".ps1", ".py", ".php", ".rb", ".pl", ".go", ".wasm", ".msi", ".jar"]
  for each ext in bad_exts
    if text.ends_with using lower, ext
      give back yes
    end
  end
  give back no
end

make is_allowed_theme_file_ext using rel
  set lower to text.lower using rel
  set allowed_exts to [".json", ".grab.html", ".css", ".js", ".svg", ".png", ".jpg", ".jpeg", ".webp", ".woff2"]
  for each ext in allowed_exts
    if text.ends_with using lower, ext
      if ext is ".js" and (not (text.starts_with using lower, "assets/"))
        give back no
      end
      give back yes
    end
  end
  give back no
end

make is_text_theme_file using rel
  set lower to text.lower using rel
  if (text.ends_with using lower, ".json") or (text.ends_with using lower, ".grab.html") or (text.ends_with using lower, ".css") or (text.ends_with using lower, ".js") or (text.ends_with using lower, ".svg")
    give back yes
  end
  give back no
end

make is_safe_theme_relpath using rel
  if rel is "" or (text.starts_with using rel, "/") or (text.contains using rel, ":") or (text.contains using rel, "\\") or (text.contains using rel, "..")
    give back no
  end
  set segs to text.split using rel, "/"
  for each seg in segs
    if seg is "" or seg is "." or seg is ".." or (is_sensitive_segment using seg)
      give back no
    end
  end
  give back yes
end

make is_allowed_theme_capability using cap
  set allowed to ["templates", "parts", "hooks:theme", "grex:visual", "assets:static"]
  for each item in allowed
    if item is cap
      give back yes
    end
  end
  give back no
end

make is_allowed_theme_hook_name using hname
  set allowed to ["theme:head_meta", "theme:before_render", "query:modify_args", "content:before_save"]
  for each item in allowed
    if item is hname
      give back yes
    end
  end
  give back no
end

make is_allowed_theme_handler using handler_name
  set allowed to ["theme_meta_generator", "theme_meta_brand", "theme_query_defaults", "theme_before_render_badge", "theme_before_save_meta"]
  for each item in allowed
    if item is handler_name
      give back yes
    end
  end
  give back no
end

make validate_theme_capabilities using manifest
  set has_hooks_cap to no
  if not (manifest has "capabilities")
    give back record {ok: yes, has_hooks_cap: no, error: ""}
  end
  set caps to manifest at "capabilities"
  for each cap in caps
    set cstr to text.from using cap
    if not (is_allowed_theme_capability using cstr)
      give back record {ok: no, has_hooks_cap: no, error: "GRAB-E401: unauthorized theme capability: " joined with cstr}
    end
    if cstr is "hooks:theme"
      set has_hooks_cap to yes
    end
  end
  give back record {ok: yes, has_hooks_cap: has_hooks_cap, error: ""}
end

make validate_theme_hooks_block using manifest, has_hooks_cap
  if manifest has "plugins" or manifest has "hooks"
    give back record {ok: no, hooks: [], error: "GRAB-E401: unauthorized theme plugins or raw hooks block"}
  end
  if not (manifest has "themeHooks")
    give back record {ok: yes, hooks: [], error: ""}
  end
  if not has_hooks_cap
    give back record {ok: no, hooks: [], error: "GRAB-E401: themeHooks requires 'hooks:theme' capability"}
  end
  set raw_hooks to manifest at "themeHooks"
  set out to []
  for each item in raw_hooks
    if (not (item has "hook")) or (not (item has "handler"))
      give back record {ok: no, hooks: [], error: "GRAB-E401: themeHooks entry requires hook and handler"}
    end
    set hname to text.from using (item at "hook")
    set handler to text.from using (item at "handler")
    if not (is_allowed_theme_hook_name using hname)
      give back record {ok: no, hooks: [], error: "GRAB-E401: disallowed theme hook target: " joined with hname}
    end
    if not (is_allowed_theme_handler using handler)
      give back record {ok: no, hooks: [], error: "GRAB-E401: disallowed theme hook handler: " joined with handler}
    end
    set prio to 20
    if item has "priority"
      try
        set prio to text.to_integer using (text.from using (item at "priority"))
      catch err
        give back record {ok: no, hooks: [], error: "GRAB-E401: invalid hook priority"}
      end
    end
    set out to collections.append using out, record {hook: hname, priority: prio, handler: handler}
  end
  give back record {ok: yes, hooks: out, error: ""}
end

make resolve_theme_mode using manifest
  set mode_val to ""
  if manifest has "mode"
    set mode_val to text.from using (manifest at "mode")
  end
  set engine_val to ""
  if manifest has "engine"
    set engine_val to text.from using (manifest at "engine")
  end

  if mode_val is ""
    if engine_val is "coded"
      give back record {ok: yes, mode: "coded", engine: "coded", error: ""}
    end
    if engine_val is "grex-visual"
      give back record {ok: yes, mode: "visual", engine: "grex-visual", error: ""}
    end
    give back record {ok: no, mode: "", engine: "", error: "Theme engine must be coded or grex-visual"}
  end

  if mode_val is not "coded" and mode_val is not "visual"
    give back record {ok: no, mode: "", engine: "", error: "Theme mode must be coded or visual"}
  end

  if engine_val is ""
    if mode_val is "visual"
      give back record {ok: yes, mode: "visual", engine: "grex-visual", error: ""}
    end
    give back record {ok: yes, mode: "coded", engine: "coded", error: ""}
  end

  if mode_val is "coded" and engine_val is not "coded"
    give back record {ok: no, mode: "", engine: "", error: "Theme mode 'coded' conflicts with engine '" joined with engine_val joined with "'"}
  end
  if mode_val is "visual" and engine_val is not "grex-visual"
    give back record {ok: no, mode: "", engine: "", error: "Theme mode 'visual' conflicts with engine '" joined with engine_val joined with "'"}
  end

  give back record {ok: yes, mode: mode_val, engine: engine_val, error: ""}
end

make validate_grex_elements_doc using doc
  set required_slots to ["home", "single", "archive", "404"]
  if not (doc has "templates")
    give back record {ok: no, error: "grex.elements.json missing templates object"}
  end
  set tmpls to doc at "templates"
  for each slot in required_slots
    if not (has_map_key using tmpls, slot)
      give back record {ok: no, error: "grex.elements.json missing required template slot: " joined with slot}
    end
    set node_res to validate_grex_node using (tmpls at slot), 0
    if not node_res.ok
      give back record {ok: no, error: "Grex template '" joined with slot joined with "': " joined with node_res.error}
    end
  end
  set tkeys to collections.keys using tmpls
  for each tk in tkeys
    set node_res to validate_grex_node using (tmpls at tk), 0
    if not node_res.ok
      give back record {ok: no, error: "Grex template '" joined with tk joined with "': " joined with node_res.error}
    end
  end
  if doc has "parts"
    set parts_map to doc at "parts"
    set pkeys to collections.keys using parts_map
    for each pk in pkeys
      if not (is_valid_slug using pk)
        give back record {ok: no, error: "Invalid Grex template part key: " joined with pk}
      end
      set part_val to parts_map at pk
      if part_val is not nothing
        set p_res to validate_grex_node using part_val, 0
        if not p_res.ok
          give back record {ok: no, error: "Grex part '" joined with pk joined with "': " joined with p_res.error}
        end
      end
    end
  end
  give back record {ok: yes, error: ""}
end

make walk_theme_dir_check using base_dir, rel_dir, depth, state_rec
  if depth is greater than 8
    give back record {ok: no, file_count: state_rec.file_count, total_bytes: state_rec.total_bytes, error: "GRAB-E401: theme directory depth exceeds limit (8)"}
  end
  set full_dir to base_dir
  if rel_dir is not ""
    set full_dir to base_dir joined with "/" joined with rel_dir
  end
  set names to []
  try
    set names to files.list_dir using full_dir
  catch err
    give back record {ok: no, file_count: state_rec.file_count, total_bytes: state_rec.total_bytes, error: "GRAB-E401: unable to inspect theme directory: " joined with full_dir}
  end

  set cur_count to state_rec.file_count
  set cur_bytes to state_rec.total_bytes
  for each name in names
    if is_sensitive_segment using name
      give back record {ok: no, file_count: cur_count, total_bytes: cur_bytes, error: "GRAB-E401: sensitive entry disallowed in theme: " joined with name}
    end
    set child_rel to name
    if rel_dir is not ""
      set child_rel to rel_dir joined with "/" joined with name
    end
    if not (is_safe_theme_relpath using child_rel)
      give back record {ok: no, file_count: cur_count, total_bytes: cur_bytes, error: "GRAB-E401: unsafe theme path: " joined with child_rel}
    end
    set child_full to base_dir joined with "/" joined with child_rel
    set is_sub to no
    try
      set sub_names to files.list_dir using child_full
      set is_sub to yes
    catch err
      set is_sub to no
    end
    if is_sub
      set sub_res to walk_theme_dir_check using base_dir, child_rel, (depth plus 1), record {file_count: cur_count, total_bytes: cur_bytes}
      if not sub_res.ok
        give back sub_res
      end
      set cur_count to sub_res.file_count
      set cur_bytes to sub_res.total_bytes
    otherwise
      set cur_count to cur_count plus 1
      if cur_count is greater than 250
        give back record {ok: no, file_count: cur_count, total_bytes: cur_bytes, error: "GRAB-E401: theme exceeds maximum file count (250)"}
      end
      if is_disallowed_executable_ext using child_rel
        give back record {ok: no, file_count: cur_count, total_bytes: cur_bytes, error: "GRAB-E401: disallowed executable extension in theme: " joined with child_rel}
      end
      if not (is_allowed_theme_file_ext using child_rel)
        give back record {ok: no, file_count: cur_count, total_bytes: cur_bytes, error: "GRAB-E401: disallowed file extension in theme: " joined with child_rel}
      end
      if is_text_theme_file using child_rel
        try
          set txt to files.read_text using child_full
          set fbytes to text.length using txt
          if fbytes is greater than 5242880
            give back record {ok: no, file_count: cur_count, total_bytes: cur_bytes, error: "GRAB-E401: theme file exceeds 5 MB limit: " joined with child_rel}
          end
          set cur_bytes to cur_bytes plus fbytes
          if cur_bytes is greater than 26214400
            give back record {ok: no, file_count: cur_count, total_bytes: cur_bytes, error: "GRAB-E401: theme package exceeds 25 MB total limit"}
          end
        catch err
          give back record {ok: no, file_count: cur_count, total_bytes: cur_bytes, error: "GRAB-E401: invalid UTF-8 or unreadable theme file: " joined with child_rel}
        end
      end
    end
  end
  give back record {ok: yes, file_count: cur_count, total_bytes: cur_bytes, error: ""}
end

make validate_theme_manifest using slug
  if not (is_valid_theme_slug using slug)
    give back record {ok: no, manifest: {}, raw: "", mode: "", error: "Invalid theme slug"}
  end
  set base_dir to "themes/" joined with slug
  set manifest_path to base_dir joined with "/theme.json"
  set exists_flag to no
  try
    set exists_flag to files.exists using manifest_path
  catch err
    give back record {ok: no, manifest: {}, raw: "", mode: "", error: "Unable to access theme manifest"}
  end
  if not exists_flag
    give back record {ok: no, manifest: {}, raw: "", mode: "", error: "Theme manifest not found: " joined with manifest_path}
  end

  set dir_check to walk_theme_dir_check using base_dir, "", 0, record {file_count: 0, total_bytes: 0}
  if not dir_check.ok
    give back record {ok: no, manifest: {}, raw: "", mode: "", error: dir_check.error}
  end

  set raw_json to ""
  set manifest to {}
  try
    set raw_json to files.read_text using manifest_path
    set manifest to json.parse using raw_json
  catch err
    give back record {ok: no, manifest: {}, raw: "", mode: "", error: "Malformed theme.json"}
  end

  if (not (manifest has "schemaVersion")) or (not (manifest has "slug")) or (not (manifest has "name")) or (not (manifest has "version"))
    give back record {ok: no, manifest: {}, raw: "", mode: "", error: "theme.json missing required fields"}
  end
  if (not (manifest has "engine")) and (not (manifest has "mode"))
    give back record {ok: no, manifest: {}, raw: "", mode: "", error: "theme.json requires mode or engine"}
  end
  if (manifest at "schemaVersion") is not "1.0.0"
    give back record {ok: no, manifest: {}, raw: "", mode: "", error: "Unsupported theme schemaVersion"}
  end
  if (manifest at "slug") is not slug
    give back record {ok: no, manifest: {}, raw: "", mode: "", error: "theme.json slug does not match directory name"}
  end

  set cap_res to validate_theme_capabilities using manifest
  if not cap_res.ok
    give back record {ok: no, manifest: {}, raw: "", mode: "", error: cap_res.error}
  end
  set hooks_res to validate_theme_hooks_block using manifest, cap_res.has_hooks_cap
  if not hooks_res.ok
    give back record {ok: no, manifest: {}, raw: "", mode: "", error: hooks_res.error}
  end

  set mode_res to resolve_theme_mode using manifest
  if not mode_res.ok
    give back record {ok: no, manifest: {}, raw: "", mode: "", error: mode_res.error}
  end
  set mode to mode_res.mode

  if mode is "coded"
    if not (manifest has "templates")
      give back record {ok: no, manifest: {}, raw: "", mode: "", error: "Coded theme.json missing templates"}
    end
    set templates to manifest at "templates"
    set required_slots to ["home", "single", "archive", "404"]
    for each slot in required_slots
      if not (has_map_key using templates, slot)
        give back record {ok: no, manifest: {}, raw: "", mode: "", error: "theme.json missing required template slot: " joined with slot}
      end
    end
    set tmpl_keys to collections.keys using templates
    for each tkey in tmpl_keys
      set trel to text.from using (templates at tkey)
      if not (is_safe_theme_relpath using trel)
        give back record {ok: no, manifest: {}, raw: "", mode: "", error: "GRAB-E401: unsafe theme template path: " joined with trel}
      end
      if not (text.ends_with using trel, ".grab.html")
        give back record {ok: no, manifest: {}, raw: "", mode: "", error: "Theme templates must have .grab.html extension"}
      end
      set disk_path to base_dir joined with "/" joined with trel
      if not (files.exists using disk_path)
        give back record {ok: no, manifest: {}, raw: "", mode: "", error: "Missing theme template on disk: " joined with disk_path}
      end
    end
    if manifest has "parts"
      set parts to manifest at "parts"
      set pkeys to collections.keys using parts
      for each pkey in pkeys
        if not (is_valid_slug using pkey)
          give back record {ok: no, manifest: {}, raw: "", mode: "", error: "Invalid template part key: " joined with pkey}
        end
        set prel_raw to parts at pkey
        if prel_raw is not nothing
          set prel to text.from using prel_raw
          if not (is_safe_theme_relpath using prel)
            give back record {ok: no, manifest: {}, raw: "", mode: "", error: "GRAB-E401: unsafe theme part path: " joined with prel}
          end
          if not (text.ends_with using prel, ".grab.html")
            give back record {ok: no, manifest: {}, raw: "", mode: "", error: "Coded theme parts must have .grab.html extension"}
          end
          set p_disk to base_dir joined with "/" joined with prel
          if not (files.exists using p_disk)
            give back record {ok: no, manifest: {}, raw: "", mode: "", error: "Missing theme part on disk: " joined with p_disk}
          end
        end
      end
    end
  otherwise
    set grex_rel to "grex.elements.json"
    if manifest has "grexElements"
      set grex_rel to text.from using (manifest at "grexElements")
    end
    if (not (is_safe_theme_relpath using grex_rel)) or (not (text.ends_with using grex_rel, ".json"))
      give back record {ok: no, manifest: {}, raw: "", mode: "", error: "GRAB-E401: unsafe grexElements path"}
    end
    set grex_disk to base_dir joined with "/" joined with grex_rel
    if not (files.exists using grex_disk)
      give back record {ok: no, manifest: {}, raw: "", mode: "", error: "Visual theme missing grex.elements.json: " joined with grex_disk}
    end
    try
      set grex_raw to files.read_text using grex_disk
      set grex_doc to json.parse using grex_raw
      set grex_chk to validate_grex_elements_doc using grex_doc
      if not grex_chk.ok
        give back record {ok: no, manifest: {}, raw: "", mode: "", error: grex_chk.error}
      end
    catch err
      give back record {ok: no, manifest: {}, raw: "", mode: "", error: "Malformed grex.elements.json"}
    end
  end

  if manifest has "assets"
    set assets to manifest at "assets"
    for each asset_group in ["styles", "scripts"]
      if has_map_key using assets, asset_group
        set items to assets at asset_group
        for each arel in items
          set arel_str to text.from using arel
          if not (is_safe_theme_relpath using arel_str)
            give back record {ok: no, manifest: {}, raw: "", mode: "", error: "GRAB-E401: unsafe theme asset path: " joined with arel_str}
          end
          if asset_group is "styles" and (not (text.ends_with using (text.lower using arel_str), ".css"))
            give back record {ok: no, manifest: {}, raw: "", mode: "", error: "GRAB-E401: theme style asset must be .css"}
          end
          if asset_group is "scripts" and ((not (text.ends_with using (text.lower using arel_str), ".js")) or (not (text.starts_with using (text.lower using arel_str), "assets/")))
            give back record {ok: no, manifest: {}, raw: "", mode: "", error: "GRAB-E401: theme script asset must be under assets/*.js"}
          end
        end
      end
    end
  end

  give back record {ok: yes, manifest: manifest, raw: raw_json, mode: mode, engine: mode_res.engine, error: ""}
end

make validate_theme_package_bundle using payload
  if (not (payload has "slug")) or (not (payload has "manifest")) or (not (payload has "files"))
    give back record {ok: no, error: "Package bundle requires slug, manifest, and files"}
  end
  set slug to normalize_slug using (text.from using (payload at "slug"))
  if not (is_valid_theme_slug using slug)
    give back record {ok: no, error: "Invalid theme slug"}
  end
  set manifest to payload at "manifest"
  if (not (manifest has "schemaVersion")) or (not (manifest has "slug")) or (not (manifest has "name")) or (not (manifest has "version"))
    give back record {ok: no, error: "Manifest missing required fields"}
  end
  if (manifest at "slug") is not slug
    give back record {ok: no, error: "Manifest slug does not match package slug"}
  end
  set cap_res to validate_theme_capabilities using manifest
  if not cap_res.ok
    give back record {ok: no, error: cap_res.error}
  end
  set hooks_res to validate_theme_hooks_block using manifest, cap_res.has_hooks_cap
  if not hooks_res.ok
    give back record {ok: no, error: hooks_res.error}
  end
  set mode_res to resolve_theme_mode using manifest
  if not mode_res.ok
    give back record {ok: no, error: mode_res.error}
  end

  set file_entries to payload at "files"
  set count to collections.length using file_entries
  if count is greater than 250
    give back record {ok: no, error: "GRAB-E401: package exceeds maximum file count (250)"}
  end

  set total_bytes to 0
  set path_set to {}
  for each f in file_entries
    if not (f has "path")
      give back record {ok: no, error: "Package file entry missing path"}
    end
    set rel to text.from using (f at "path")
    if not (is_safe_theme_relpath using rel)
      give back record {ok: no, error: "GRAB-E401: unsafe package file path: " joined with rel}
    end
    if is_disallowed_executable_ext using rel
      give back record {ok: no, error: "GRAB-E401: disallowed executable extension: " joined with rel}
    end
    if not (is_allowed_theme_file_ext using rel)
      give back record {ok: no, error: "GRAB-E401: disallowed file extension: " joined with rel}
    end
    set fsize to 0
    if f has "size_bytes"
      set fsize to text.to_integer using (text.from using (f at "size_bytes"))
    otherwise
      if f has "content"
        set fsize to text.length using (text.from using (f at "content"))
      end
    end
    if fsize is greater than 5242880
      give back record {ok: no, error: "GRAB-E401: package file exceeds 5 MB limit: " joined with rel}
    end
    set total_bytes to total_bytes plus fsize
    if total_bytes is greater than 26214400
      give back record {ok: no, error: "GRAB-E401: package exceeds 25 MB total limit"}
    end
    set path_set to collections.put using path_set, rel, f
  end

  if mode_res.mode is "coded"
    if not (manifest has "templates")
      give back record {ok: no, error: "Coded theme manifest missing templates"}
    end
    set tmpls to manifest at "templates"
    for each req_slot in ["home", "single", "archive", "404"]
      if not (has_map_key using tmpls, req_slot)
        give back record {ok: no, error: "Missing required template slot: " joined with req_slot}
      end
      set trel to text.from using (tmpls at req_slot)
      if not (has_map_key using path_set, trel)
        give back record {ok: no, error: "Package missing declared template file: " joined with trel}
      end
    end
  otherwise
    set grex_rel to "grex.elements.json"
    if manifest has "grexElements"
      set grex_rel to text.from using (manifest at "grexElements")
    end
    if not (has_map_key using path_set, grex_rel)
      give back record {ok: no, error: "Visual theme package missing " joined with grex_rel}
    end
    set grex_entry to path_set at grex_rel
    if grex_entry has "content"
      try
        set gdoc to json.parse using (text.from using (grex_entry at "content"))
        set gchk to validate_grex_elements_doc using gdoc
        if not gchk.ok
          give back record {ok: no, error: gchk.error}
        end
      catch err
        give back record {ok: no, error: "Malformed grex.elements.json in package"}
      end
    end
  end

  give back record {ok: yes, slug: slug, mode: mode_res.mode, file_count: count, total_bytes: total_bytes, error: ""}
end

make upsert_setting using stmts, key, val, now_iso, tx
  set existing to data.one using stmts.get_setting, record {key: key}, tx
  if existing is nothing
    call data.execute using stmts.upsert_setting_insert, record {key: key, value: val, updated_at: now_iso}, tx
  otherwise
    call data.execute using stmts.upsert_setting_update, record {value: val, updated_at: now_iso, key: key}, tx
  end
end

make upsert_theme_row using stmts, slug, check_res, now_iso, tx
  set existing to data.one using stmts.get_theme_by_slug, record {slug: slug}, tx
  if existing is nothing
    call data.execute using stmts.insert_theme, record {slug: slug, name: (check_res.manifest at "name"), version: (check_res.manifest at "version"), engine: check_res.engine, is_active: 0, manifest_json: check_res.raw, installed_at: now_iso}, tx
  otherwise
    call data.execute using stmts.update_theme_manifest, record {name: (check_res.manifest at "name"), version: (check_res.manifest at "version"), engine: check_res.engine, manifest_json: check_res.raw, slug: slug}, tx
  end
end

make get_active_theme_context using stmts
  set cached to cache.get using stmts.cms_cache, "active_theme"
  if cached.found
    give back cached.value
  end

  set row to data.one using stmts.get_active_theme, record {}
  set default_templates to {"home": "templates/home.grab.html", "single": "templates/single.grab.html", "archive": "templates/archive.grab.html", "404": "templates/404.grab.html", "search": "templates/search.grab.html"}
  set default_parts to {"header": "templates/parts/header.grab.html", "footer": "templates/parts/footer.grab.html", "card": "templates/parts/card.grab.html", "sidebar": "templates/parts/sidebar.grab.html"}
  set ctx to record {slug: "default-starter", name: "Default Starter", version: "1.0.0", engine: "coded", mode: "coded", templates: default_templates, parts: default_parts, themeHooks: [], assets: {}, grexElements: "grex.elements.json"}
  if row is not nothing
    set parsed to json.parse using row.manifest_json
    set mode_res to resolve_theme_mode using parsed
    set mode to "coded"
    if mode_res.ok
      set mode to mode_res.mode
    end
    set tmpls to {}
    if parsed has "templates"
      set tmpls to parsed at "templates"
    end
    set parts to {}
    if parsed has "parts"
      set parts to parsed at "parts"
    end
    set thooks to []
    if parsed has "themeHooks"
      set thooks to parsed at "themeHooks"
    end
    set assets to {}
    if parsed has "assets"
      set assets to parsed at "assets"
    end
    set grex_el_path to "grex.elements.json"
    if parsed has "grexElements"
      set grex_el_path to text.from using (parsed at "grexElements")
    end
    set ctx to record {slug: row.slug, name: row.name, version: row.version, engine: row.engine, mode: mode, templates: tmpls, parts: parts, themeHooks: thooks, assets: assets, grexElements: grex_el_path}
  end
  call cache.set using stmts.cms_cache, "active_theme", ctx, 300000
  give back ctx
end

make get_site_settings_map using stmts
  set cached to cache.get using stmts.cms_cache, "site_settings"
  if cached.found
    give back cached.value
  end
  set rows to data.query using stmts.list_settings, record {}
  set out to {"site_title": "GrabLab CMS", "site_tagline": "Zero-plugin CMS", "active_theme_slug": "default-starter", "home_entry_id": ""}
  for each r in rows
    set out to collections.put using out, r.key, r.value
  end
  call cache.set using stmts.cms_cache, "site_settings", out, 300000
  give back out
end

# ==============================================================================
# Module 3: Cache Epochs & Deterministic Invalidation (use cache)
# ==============================================================================

make get_cache_epoch using stmts, epoch_key
  set cached to cache.get using stmts.cms_cache, epoch_key
  if cached.found
    give back cached.value
  end
  call cache.set using stmts.cms_cache, epoch_key, 1, 86400000
  give back 1
end

make bump_cache_epoch using stmts, epoch_key
  set cur to get_cache_epoch using stmts, epoch_key
  set nxt to cur plus 1
  call cache.set using stmts.cms_cache, epoch_key, nxt, 86400000
  give back nxt
end

make bump_query_cache_epochs using stmts, type_slug
  call bump_cache_epoch using stmts, "cache_epoch:query"
  if type_slug is not ""
    call bump_cache_epoch using stmts, ("cache_epoch:type:" joined with type_slug)
  end
end

make invalidate_menu_caches using stmts, location
  if location is not nothing and location is not ""
    call cache.delete using stmts.cms_cache, ("menu:loc:" joined with location)
  otherwise
    call cache.delete using stmts.cms_cache, "menu:loc:primary"
    call cache.delete using stmts.cms_cache, "menu:loc:footer"
    call cache.delete using stmts.cms_cache, "menu:loc:mobile"
  end
  call bump_cache_epoch using stmts, "cache_epoch:menu"
end

make invalidate_route_caches using stmts, path_a, path_b, type_slug
  if path_a is not ""
    call cache.delete using stmts.cms_cache, ("route:" joined with path_a)
  end
  if path_b is not ""
    call cache.delete using stmts.cms_cache, ("route:" joined with path_b)
  end
  call cache.delete using stmts.cms_cache, "route:/"
  if type_slug is not ""
    call cache.delete using stmts.cms_cache, ("archive:" joined with type_slug)
  end
  call cache.delete using stmts.cms_cache, "home_entries"
  call invalidate_menu_caches using stmts, ""
  call bump_query_cache_epochs using stmts, type_slug
end

# ==============================================================================
# Module 4: Native Hooks & Filters Registry (Core + Single Active Theme Only)
# ==============================================================================

make is_allowed_hook_handler_ref using source, handler_name
  if source is "core"
    set core_handlers to ["core_normalize_entry_before_save", "core_invalidate_after_publish", "core_default_head_meta", "core_prepare_render_context", "core_clamp_query_args"]
    for each h in core_handlers
      if h is handler_name
        give back yes
      end
    end
    give back no
  end
  give back is_allowed_theme_handler using handler_name
end

make create_hook_registry using active_slug
  give back record {active_slug: active_slug, hooks: {}, filters: {}, next_seq: 0}
end

make validate_hook_source using registry, source
  if source is "core"
    give back yes
  end
  set expected to "theme:" joined with registry.active_slug
  if source is expected
    give back yes
  end
  give back no
end

make sort_registrations using items
  set sorted to []
  for each item in items
    set inserted to no
    set next_list to []
    for each existing in sorted
      if (not inserted) and ((item.priority is less than existing.priority) or (item.priority is existing.priority and item.seq is less than existing.seq))
        set next_list to collections.append using next_list, item
        set inserted to yes
      end
      set next_list to collections.append using next_list, existing
    end
    if not inserted
      set next_list to collections.append using next_list, item
    end
    set sorted to next_list
  end
  give back sorted
end

make registerHook using registry, hook_name, source, priority, handler_name
  if not (validate_hook_source using registry, source)
    give back record {ok: no, registry: registry, error: "GRAB-E401: hook source denied (zero-plugin active-theme isolation): " joined with source}
  end
  if not (is_allowed_hook_handler_ref using source, handler_name)
    give back record {ok: no, registry: registry, error: "GRAB-E401: unregistered or unsafe hook handler: " joined with handler_name}
  end
  set seq to registry.next_seq
  set entry to record {name: hook_name, kind: "hook", source: source, priority: priority, seq: seq, handler: handler_name}
  set existing to []
  if has_map_key using registry.hooks, hook_name
    set existing to registry.hooks at hook_name
  end
  set updated to sort_registrations using (collections.append using existing, entry)
  set next_hooks to collections.put using registry.hooks, hook_name, updated
  give back record {ok: yes, registry: (record {active_slug: registry.active_slug, hooks: next_hooks, filters: registry.filters, next_seq: (seq plus 1)}), error: ""}
end

make registerFilter using registry, filter_name, source, priority, handler_name
  if not (validate_hook_source using registry, source)
    give back record {ok: no, registry: registry, error: "GRAB-E401: filter source denied (zero-plugin active-theme isolation): " joined with source}
  end
  if not (is_allowed_hook_handler_ref using source, handler_name)
    give back record {ok: no, registry: registry, error: "GRAB-E401: unregistered or unsafe filter handler: " joined with handler_name}
  end
  set seq to registry.next_seq
  set entry to record {name: filter_name, kind: "filter", source: source, priority: priority, seq: seq, handler: handler_name}
  set existing to []
  if has_map_key using registry.filters, filter_name
    set existing to registry.filters at filter_name
  end
  set updated to sort_registrations using (collections.append using existing, entry)
  set next_filters to collections.put using registry.filters, filter_name, updated
  give back record {ok: yes, registry: (record {active_slug: registry.active_slug, hooks: registry.hooks, filters: next_filters, next_seq: (seq plus 1)}), error: ""}
end

make execute_hook_handler using stmts, handler_name, payload
  if handler_name is "core_invalidate_after_publish"
    set full_path to ""
    set old_path to ""
    set type_slug to ""
    if payload has "full_path"
      set full_path to text.from using (payload at "full_path")
    end
    if payload has "old_path"
      set old_path to text.from using (payload at "old_path")
    end
    if payload has "content_type_slug"
      set type_slug to text.from using (payload at "content_type_slug")
    end
    call invalidate_route_caches using stmts, old_path, full_path, type_slug
    give back record {ok: yes, executed: handler_name}
  end
  if handler_name is "core_prepare_render_context"
    give back record {ok: yes, executed: handler_name}
  end
  if handler_name is "theme_before_render_badge"
    give back record {ok: yes, executed: handler_name}
  end
  give back record {ok: yes, executed: handler_name}
end

make execute_filter_handler using handler_name, val, ctx
  if handler_name is "core_normalize_entry_before_save"
    set out to val
    set title_val to ""
    if has_map_key using out, "title"
      set title_val to text.trim using (text.from using (out at "title"))
      set out to collections.put using out, "title", title_val
    end
    if (not (has_map_key using out, "meta_title")) or ((out at "meta_title") is "")
      set out to collections.put using out, "meta_title", title_val
    end
    if (not (has_map_key using out, "meta_description")) or ((out at "meta_description") is "")
      if has_map_key using out, "body_html"
        set ex to make_excerpt using (out at "body_html")
        set out to collections.put using out, "meta_description", ex
      end
    end
    give back out
  end

  if handler_name is "theme_before_save_meta"
    set out to val
    if has_map_key using out, "meta_title"
      set mt to text.from using (out at "meta_title")
      if mt is not "" and (has_map_key using ctx, "theme_name")
        set suffix to " | " joined with (text.from using (ctx at "theme_name"))
        if not (text.ends_with using mt, suffix)
          set out to collections.put using out, "meta_title", (mt joined with suffix)
        end
      end
    end
    give back out
  end

  if handler_name is "core_default_head_meta"
    set tags to val
    set canon to "/"
    if has_map_key using ctx, "canonical_path"
      set canon to text.from using (ctx at "canonical_path")
    end
    if is_safe_url using canon
      set tags to collections.append using tags, ("<link rel=\"canonical\" href=\"" joined with (escape_html using canon) joined with "\">")
    end
    set og_title to "GrabLab CMS"
    if has_map_key using ctx, "page_title"
      set og_title to text.from using (ctx at "page_title")
    end
    set tags to collections.append using tags, ("<meta property=\"og:title\" content=\"" joined with (escape_html using og_title) joined with "\">")
    give back tags
  end

  if handler_name is "theme_meta_generator"
    set tags to val
    set tslug to "default-starter"
    if has_map_key using ctx, "theme_slug"
      set tslug to text.from using (ctx at "theme_slug")
    end
    set tags to collections.append using tags, ("<meta name=\"generator\" content=\"GrabLab CMS v1.0.0 (" joined with (escape_html using tslug) joined with ")\">")
    give back tags
  end

  if handler_name is "theme_meta_brand"
    set tags to val
    set tname to "GrabLab Theme"
    if has_map_key using ctx, "theme_name"
      set tname to text.from using (ctx at "theme_name")
    end
    set tags to collections.append using tags, ("<meta name=\"theme-name\" content=\"" joined with (escape_html using tname) joined with "\">")
    give back tags
  end

  if handler_name is "core_clamp_query_args"
    set args to val
    set p to args.page
    if p is less than 1
      set p to 1
    end
    set pp to args.per_page
    if pp is less than 1
      set pp to 1
    end
    if pp is greater than 100
      set pp to 100
    end
    set st to args.status
    if args.is_public
      set st to "published"
    end
    give back record {content_type: args.content_type, status: st, field_key: args.field_key, field_op: args.field_op, field_value: args.field_value, term_taxonomy: args.term_taxonomy, term_slug: args.term_slug, term_id: args.term_id, include_children: args.include_children, search: args.search, sort_by: args.sort_by, sort_dir: args.sort_dir, page: p, per_page: pp, is_public: args.is_public}
  end

  if handler_name is "theme_query_defaults"
    give back val
  end

  give back val
end

make runHook using stmts, registry, hook_name, payload
  set executed to []
  if not (has_map_key using registry.hooks, hook_name)
    give back executed
  end
  set handlers to registry.hooks at hook_name
  for each reg in handlers
    call execute_hook_handler using stmts, reg.handler, payload
    set executed to collections.append using executed, record {source: reg.source, priority: reg.priority, handler: reg.handler}
  end
  give back executed
end

make applyFilter using registry, filter_name, initial_val, ctx
  set current to initial_val
  if not (has_map_key using registry.filters, filter_name)
    give back current
  end
  set handlers to registry.filters at filter_name
  for each reg in handlers
    set current to execute_filter_handler using reg.handler, current, ctx
  end
  give back current
end

make build_active_hook_registry using theme
  set reg to create_hook_registry using theme.slug
  set r1 to registerFilter using reg, "content:before_save", "core", 10, "core_normalize_entry_before_save"
  set reg to r1.registry
  set r2 to registerHook using reg, "content:after_publish", "core", 10, "core_invalidate_after_publish"
  set reg to r2.registry
  set r3 to registerFilter using reg, "theme:head_meta", "core", 10, "core_default_head_meta"
  set reg to r3.registry
  set r4 to registerHook using reg, "theme:before_render", "core", 10, "core_prepare_render_context"
  set reg to r4.registry
  set r5 to registerFilter using reg, "query:modify_args", "core", 10, "core_clamp_query_args"
  set reg to r5.registry

  set tsrc to "theme:" joined with theme.slug
  for each th in theme.themeHooks
    set hname to text.from using (th at "hook")
    set handler to text.from using (th at "handler")
    set prio to 20
    if th has "priority"
      set prio to text.to_integer using (text.from using (th at "priority"))
    end
    if hname is "theme:before_render" or hname is "content:after_publish"
      set res to registerHook using reg, hname, tsrc, prio, handler
      if res.ok
        set reg to res.registry
      end
    otherwise
      set res to registerFilter using reg, hname, tsrc, prio, handler
      if res.ok
        set reg to res.registry
      end
    end
  end
  give back reg
end

# ==============================================================================
# Module 5: Query Loop Engine (query_entries + use cache Invalidation)
# ==============================================================================

make is_allowed_sort_by using raw
  set allowed to ["published_at", "created_at", "updated_at", "title", "id"]
  for each item in allowed
    if item is raw
      give back yes
    end
  end
  give back no
end

make is_allowed_field_op using raw
  set allowed to ["eq", "neq", "contains"]
  for each item in allowed
    if item is raw
      give back yes
    end
  end
  give back no
end

make normalize_query_args using raw_map, is_public
  set ct to ""
  if has_map_key using raw_map, "content_type"
    set ct to normalize_slug using (text.from using (raw_map at "content_type"))
    if ct is not "" and (not (is_valid_slug using ct))
      give back record {ok: no, args: nothing, error: "Invalid content_type slug"}
    end
  end

  set status to "published"
  if (not is_public) and (has_map_key using raw_map, "status")
    set st_raw to text.lower using (text.trim using (text.from using (raw_map at "status")))
    if st_raw is not ""
      if st_raw is not "published" and st_raw is not "draft" and st_raw is not "archived" and st_raw is not "all"
        give back record {ok: no, args: nothing, error: "Invalid query status"}
      end
      set status to st_raw
    end
  end

  set field_key to ""
  if has_map_key using raw_map, "field_key"
    set field_key to normalize_slug using (text.from using (raw_map at "field_key"))
    if field_key is not "" and (not (is_valid_field_key using field_key))
      give back record {ok: no, args: nothing, error: "Invalid field_key"}
    end
  end

  set field_op to "eq"
  if has_map_key using raw_map, "field_op"
    set fop_raw to text.lower using (text.trim using (text.from using (raw_map at "field_op")))
    if fop_raw is not ""
      if not (is_allowed_field_op using fop_raw)
        give back record {ok: no, args: nothing, error: "Unsupported field_op (allowed: eq, neq, contains)"}
      end
      set field_op to fop_raw
    end
  end

  set field_value to ""
  if has_map_key using raw_map, "field_value"
    set field_value to text.from using (raw_map at "field_value")
  end

  set sort_by to "published_at"
  if has_map_key using raw_map, "sort_by"
    set sb_raw to text.lower using (text.trim using (text.from using (raw_map at "sort_by")))
    if sb_raw is not ""
      if not (is_allowed_sort_by using sb_raw)
        give back record {ok: no, args: nothing, error: "Unsupported sort_by column"}
      end
      set sort_by to sb_raw
    end
  end

  set sort_dir to "desc"
  if has_map_key using raw_map, "sort_dir"
    set sd_raw to text.lower using (text.trim using (text.from using (raw_map at "sort_dir")))
    if sd_raw is not ""
      if sd_raw is not "asc" and sd_raw is not "desc"
        give back record {ok: no, args: nothing, error: "sort_dir must be asc or desc"}
      end
      set sort_dir to sd_raw
    end
  end

  set page to 1
  if has_map_key using raw_map, "page"
    set p_raw to text.trim using (text.from using (raw_map at "page"))
    if p_raw is not ""
      try
        set page to text.to_integer using p_raw
      catch err
        give back record {ok: no, args: nothing, error: "page must be an integer"}
      end
      if page is less than 1
        give back record {ok: no, args: nothing, error: "page must be >= 1"}
      end
    end
  end

  set per_page to 10
  if has_map_key using raw_map, "per_page"
    set pp_raw to text.trim using (text.from using (raw_map at "per_page"))
    if pp_raw is not ""
      try
        set per_page to text.to_integer using pp_raw
      catch err
        give back record {ok: no, args: nothing, error: "per_page must be an integer"}
      end
      if per_page is less than 1 or per_page is greater than 100
        give back record {ok: no, args: nothing, error: "per_page must be between 1 and 100"}
      end
    end
  end

  set term_taxonomy to ""
  set term_slug to ""
  set term_id to 0
  set include_children to no

  if has_map_key using raw_map, "term_id"
    set tid_raw to text.trim using (text.from using (raw_map at "term_id"))
    if tid_raw is not "" and tid_raw is not "0"
      try
        set term_id to text.to_integer using tid_raw
      catch err
        give back record {ok: no, args: nothing, error: "term_id must be an integer"}
      end
    end
  end
  if has_map_key using raw_map, "taxonomy"
    set term_taxonomy to normalize_slug using (text.from using (raw_map at "taxonomy"))
  end
  if has_map_key using raw_map, "term_slug"
    set term_slug to normalize_slug using (text.from using (raw_map at "term_slug"))
  end
  if has_map_key using raw_map, "include_children"
    set ic_raw to text.lower using (text.trim using (text.from using (raw_map at "include_children")))
    if ic_raw is "yes" or ic_raw is "true" or ic_raw is "1"
      set include_children to yes
    end
  end
  if has_map_key using raw_map, "filter_by_term"
    set fbt to raw_map at "filter_by_term"
    if fbt is not nothing
      if fbt has "term_id"
        try
          set term_id to text.to_integer using (text.from using (fbt at "term_id"))
        catch err
          give back record {ok: no, args: nothing, error: "filter_by_term.term_id must be an integer"}
        end
      end
      if fbt has "taxonomy"
        set term_taxonomy to normalize_slug using (text.from using (fbt at "taxonomy"))
      end
      if fbt has "term_slug"
        set term_slug to normalize_slug using (text.from using (fbt at "term_slug"))
      end
      if fbt has "include_children"
        set fbt_ic to text.lower using (text.trim using (text.from using (fbt at "include_children")))
        if fbt_ic is "yes" or fbt_ic is "true" or fbt_ic is "1"
          set include_children to yes
        end
      end
    end
  end

  set search_q to ""
  if has_map_key using raw_map, "search"
    set search_q to text.trim using (text.from using (raw_map at "search"))
  end

  give back record {ok: yes, args: (record {content_type: ct, status: status, field_key: field_key, field_op: field_op, field_value: field_value, term_taxonomy: term_taxonomy, term_slug: term_slug, term_id: term_id, include_children: include_children, search: search_q, sort_by: sort_by, sort_dir: sort_dir, page: page, per_page: per_page, is_public: is_public}), error: ""}
end

make select_query_stmt using stmts, sort_by, sort_dir
  if sort_by is "published_at"
    if sort_dir is "asc"
      give back stmts.query_published_at_asc
    end
    give back stmts.query_published_at_desc
  end
  if sort_by is "created_at"
    if sort_dir is "asc"
      give back stmts.query_created_at_asc
    end
    give back stmts.query_created_at_desc
  end
  if sort_by is "updated_at"
    if sort_dir is "asc"
      give back stmts.query_updated_at_asc
    end
    give back stmts.query_updated_at_desc
  end
  if sort_by is "title"
    if sort_dir is "asc"
      give back stmts.query_title_asc
    end
    give back stmts.query_title_desc
  end
  if sort_dir is "asc"
    give back stmts.query_id_asc
  end
  give back stmts.query_id_desc
end

make matches_custom_field_filter using cf_json_text, field_key, field_op, field_value
  if field_key is ""
    give back yes
  end
  try
    set cf_map to json.parse using cf_json_text
    if not (has_map_key using cf_map, field_key)
      if field_op is "neq"
        give back yes
      end
      give back no
    end
    set raw_val to text.from using (cf_map at field_key)
    if field_op is "eq"
      give back (raw_val is field_value)
    end
    if field_op is "neq"
      give back (raw_val is not field_value)
    end
    if field_op is "contains"
      give back (text.contains using (text.lower using raw_val), (text.lower using field_value))
    end
    give back no
  catch err
    give back no
  end
end

make format_query_item using row
  set cf_parsed to {}
  try
    set cf_parsed to json.parse using row.custom_fields_json
  catch err
    set cf_parsed to {}
  end
  set pub_at to ""
  if row.published_at is not nothing
    set pub_at to row.published_at
  end
  give back record {id: row.id, content_type_slug: row.content_type_slug, content_type_label: row.content_type_label, slug: row.slug, full_path: row.full_path, title: row.title, status: row.status, excerpt: (make_excerpt using row.body_html), custom_fields: cf_parsed, meta_title: row.meta_title, meta_description: row.meta_description, published_at: pub_at, created_at: row.created_at, updated_at: row.updated_at}
end

make compute_total_pages using total_items, per_page
  if total_items is at most 0
    give back 0
  end
  set pages to 0
  set rem to total_items
  while rem is greater than 0
    set rem to rem minus per_page
    set pages to pages plus 1
  end
  give back pages
end

make collect_term_filter_ids using stmts, term_taxonomy, term_slug, term_id, include_children
  if term_id is less than 1 and term_taxonomy is "" and term_slug is ""
    give back record {active: no, ids: []}
  end
  set root_term to nothing
  if term_id is greater than 0
    set root_term to data.one using stmts.get_term_by_id, record {id: term_id}
  otherwise
    if term_taxonomy is "" or term_slug is ""
      give back record {active: yes, ids: []}
    end
    set tax_row to data.one using stmts.get_taxonomy_by_slug, record {slug: term_taxonomy}
    if tax_row is nothing
      give back record {active: yes, ids: []}
    end
    set root_term to data.one using stmts.get_term_by_tax_slug, record {taxonomy_id: tax_row.id, slug: term_slug}
  end
  if root_term is nothing
    give back record {active: yes, ids: []}
  end

  set out_ids to [root_term.id]
  if (not include_children) or (root_term.is_hierarchical is not 1)
    give back record {active: yes, ids: out_ids}
  end

  set all_terms to data.query using stmts.list_terms_by_tax, record {taxonomy_id: root_term.taxonomy_id}
  set frontier to [root_term.id]
  set seen to collections.put using {}, (text.from using root_term.id), yes
  set depth to 0
  while depth is less than 8 and (collections.length using frontier) is greater than 0
    set next_frontier to []
    for each t in all_terms
      if t.parent_id is not nothing
        set pid_str to text.from using t.parent_id
        set tid_str to text.from using t.id
        set is_parent_in_frontier to no
        for each fid in frontier
          if (text.from using fid) is pid_str
            set is_parent_in_frontier to yes
          end
        end
        if is_parent_in_frontier and (not (has_map_key using seen, tid_str))
          set seen to collections.put using seen, tid_str, yes
          set out_ids to collections.append using out_ids, t.id
          set next_frontier to collections.append using next_frontier, t.id
        end
      end
    end
    set frontier to next_frontier
    set depth to depth plus 1
  end
  give back record {active: yes, ids: out_ids}
end

make matches_search_text using row, search_q
  if search_q is ""
    give back yes
  end
  set ql to text.lower using search_q
  if text.contains using (text.lower using row.title), ql
    give back yes
  end
  if text.contains using (text.lower using row.body_html), ql
    give back yes
  end
  if text.contains using (text.lower using row.slug), ql
    give back yes
  end
  give back no
end

make build_term_in_params using ids, filter_type, ct_id, filter_status, st_val, limit_rows, offset_rows
  set first_id to ids at 0
  set p_list to []
  set idx to 0
  set n_ids to collections.length using ids
  while idx is less than 16
    if idx is less than n_ids
      set p_list to collections.append using p_list, (ids at idx)
    otherwise
      set p_list to collections.append using p_list, first_id
    end
    set idx to idx plus 1
  end
  give back record {t0: (p_list at 0), t1: (p_list at 1), t2: (p_list at 2), t3: (p_list at 3), t4: (p_list at 4), t5: (p_list at 5), t6: (p_list at 6), t7: (p_list at 7), t8: (p_list at 8), t9: (p_list at 9), t10: (p_list at 10), t11: (p_list at 11), t12: (p_list at 12), t13: (p_list at 13), t14: (p_list at 14), t15: (p_list at 15), filter_type: filter_type, content_type_id: ct_id, filter_status: filter_status, status: st_val, limit_rows: limit_rows, offset_rows: offset_rows}
end

make query_entries using stmts, theme, registry, raw_map, is_public
  set norm_res to normalize_query_args using raw_map, is_public
  if not norm_res.ok
    give back record {ok: no, data: nothing, error: norm_res.error}
  end
  set args to applyFilter using registry, "query:modify_args", norm_res.args, {"theme_slug": theme.slug}

  set t_epoch to get_cache_epoch using stmts, "cache_epoch:theme"
  set g_epoch to get_cache_epoch using stmts, "cache_epoch:query"
  set ct_epoch to 1
  if args.content_type is not ""
    set ct_epoch to get_cache_epoch using stmts, ("cache_epoch:type:" joined with args.content_type)
  end
  set epoch_tag to (text.from using t_epoch) joined with ":" joined with (text.from using g_epoch) joined with ":" joined with (text.from using ct_epoch)
  set ic_flag to "0"
  if args.include_children
    set ic_flag to "1"
  end
  set cache_key to "query:" joined with epoch_tag joined with ":" joined with theme.slug joined with ":" joined with args.content_type joined with ":" joined with args.status joined with ":" joined with args.sort_by joined with ":" joined with args.sort_dir joined with ":" joined with (text.from using args.page) joined with ":" joined with (text.from using args.per_page) joined with ":" joined with args.field_key joined with ":" joined with args.field_op joined with ":" joined with args.field_value joined with ":t:" joined with args.term_taxonomy joined with ":" joined with args.term_slug joined with ":" joined with (text.from using args.term_id) joined with ":" joined with ic_flag joined with ":q:" joined with args.search

  set cached to cache.get using stmts.cms_cache, cache_key
  if cached.found
    set hit_data to cached.value
    give back record {ok: yes, data: (record {items: hit_data.items, pagination: hit_data.pagination, cache: (record {hit: yes, epoch: epoch_tag, key: cache_key})}), error: ""}
  end

  set filter_type to 0
  set ct_id to 0
  if args.content_type is not ""
    set ct_row to data.one using stmts.get_type_by_slug, record {slug: args.content_type}
    if ct_row is nothing
      set empty_res to record {items: [], pagination: (record {page: args.page, per_page: args.per_page, total_items: 0, total_pages: 0, has_prev: no, has_next: no})}
      call cache.set using stmts.cms_cache, cache_key, empty_res, 120000
      give back record {ok: yes, data: (record {items: [], pagination: empty_res.pagination, cache: (record {hit: no, epoch: epoch_tag, key: cache_key})}), error: ""}
    end
    set filter_type to 1
    set ct_id to ct_row.id
  end

  set filter_status to 1
  set st_val to args.status
  if st_val is "all"
    set filter_status to 0
    set st_val to ""
  end

  set term_filter to collect_term_filter_ids using stmts, args.term_taxonomy, args.term_slug, args.term_id, args.include_children
  if term_filter.active and (collections.length using term_filter.ids) is 0
    set empty_res to record {items: [], pagination: (record {page: args.page, per_page: args.per_page, total_items: 0, total_pages: 0, has_prev: no, has_next: no})}
    call cache.set using stmts.cms_cache, cache_key, empty_res, 120000
    give back record {ok: yes, data: (record {items: [], pagination: empty_res.pagination, cache: (record {hit: no, epoch: epoch_tag, key: cache_key})}), error: ""}
  end

  set stmt to select_query_stmt using stmts, args.sort_by, args.sort_dir
  set items to []
  set total_items to 0

  if term_filter.active
    set tid_slice to collections.slice using term_filter.ids, 0, (math.min using 16, (collections.length using term_filter.ids))
    if args.field_key is "" and args.search is "" and (collections.length using term_filter.ids) is at most 16
      set tp_count to build_term_in_params using tid_slice, filter_type, ct_id, filter_status, st_val, 1, 0
      set cnt_row to data.one using stmts.count_entries_by_term, record {t0: tp_count.t0, t1: tp_count.t1, t2: tp_count.t2, t3: tp_count.t3, t4: tp_count.t4, t5: tp_count.t5, t6: tp_count.t6, t7: tp_count.t7, t8: tp_count.t8, t9: tp_count.t9, t10: tp_count.t10, t11: tp_count.t11, t12: tp_count.t12, t13: tp_count.t13, t14: tp_count.t14, t15: tp_count.t15, filter_type: filter_type, content_type_id: ct_id, filter_status: filter_status, status: st_val}
      if cnt_row is not nothing
        set total_items to cnt_row.total
      end
      set offset_val to (args.page minus 1) times args.per_page
      set rows to data.query using stmts.query_entries_by_term, (build_term_in_params using tid_slice, filter_type, ct_id, filter_status, st_val, args.per_page, offset_val)
      for each row in rows
        set items to collections.append using items, (format_query_item using row)
      end
    otherwise
      set all_trows to data.query using stmts.query_entries_by_term, (build_term_in_params using tid_slice, filter_type, ct_id, filter_status, st_val, 5000, 0)
      set matched to []
      for each row in all_trows
        if (matches_custom_field_filter using row.custom_fields_json, args.field_key, args.field_op, args.field_value) and (matches_search_text using row, args.search)
          set matched to collections.append using matched, (format_query_item using row)
        end
      end
      set total_items to collections.length using matched
      set start_idx to (args.page minus 1) times args.per_page
      if start_idx is less than total_items
        set end_idx to start_idx plus args.per_page
        if end_idx is greater than total_items
          set end_idx to total_items
        end
        set items to collections.slice using matched, start_idx, end_idx
      end
    end
  otherwise
    if args.field_key is "" and args.search is ""
      set cnt_row to data.one using stmts.count_entries_filtered, record {filter_type: filter_type, content_type_id: ct_id, filter_status: filter_status, status: st_val}
      if cnt_row is not nothing
        set total_items to cnt_row.total
      end
      set offset_val to (args.page minus 1) times args.per_page
      set rows to data.query using stmt, record {filter_type: filter_type, content_type_id: ct_id, filter_status: filter_status, status: st_val, limit_rows: args.per_page, offset_rows: offset_val}
      for each row in rows
        set items to collections.append using items, (format_query_item using row)
      end
    otherwise
      set all_rows to data.query using stmt, record {filter_type: filter_type, content_type_id: ct_id, filter_status: filter_status, status: st_val, limit_rows: 5000, offset_rows: 0}
      set matched to []
      for each row in all_rows
        if (matches_custom_field_filter using row.custom_fields_json, args.field_key, args.field_op, args.field_value) and (matches_search_text using row, args.search)
          set matched to collections.append using matched, (format_query_item using row)
        end
      end
      set total_items to collections.length using matched
      set start_idx to (args.page minus 1) times args.per_page
      if start_idx is less than total_items
        set end_idx to start_idx plus args.per_page
        if end_idx is greater than total_items
          set end_idx to total_items
        end
        set items to collections.slice using matched, start_idx, end_idx
      end
    end
  end

  set total_pages to compute_total_pages using total_items, args.per_page
  set has_prev to (args.page is greater than 1) and (total_pages is greater than 0)
  set has_next to (args.page is less than total_pages)
  set pagination to record {page: args.page, per_page: args.per_page, total_items: total_items, total_pages: total_pages, has_prev: has_prev, has_next: has_next}
  set to_cache to record {items: items, pagination: pagination}
  call cache.set using stmts.cms_cache, cache_key, to_cache, 120000
  give back record {ok: yes, data: (record {items: items, pagination: pagination, cache: (record {hit: no, epoch: epoch_tag, key: cache_key})}), error: ""}
end

# ==============================================================================
# Module 6: Reusable Template Parts & Grex Visual Theme Renderer
# ==============================================================================

make load_visual_grex_doc using stmts, theme
  set ckey to "grex_doc:" joined with theme.slug
  set cached to cache.get using stmts.cms_cache, ckey
  if cached.found
    give back cached.value
  end
  set path to "themes/" joined with theme.slug joined with "/" joined with theme.grexElements
  set doc to {}
  try
    set raw to files.read_text using path
    set doc to json.parse using raw
  catch err
    set doc to {}
  end
  call cache.set using stmts.cms_cache, ckey, doc, 300000
  give back doc
end

make resolve_grex_bind_text using raw_text, ctx
  set out to text.from using raw_text
  set keys to collections.keys using ctx
  for each k in keys
    set token to "{" joined with k joined with "}"
    if text.contains using out, token
      set val_str to text.from using (ctx at k)
      set out to text.replace using out, token, val_str
    end
  end
  give back out
end

make default_tag_for_grex_element using el_name, props
  if el_name is "Fragment" or el_name is "TemplatePart"
    give back ""
  end
  if el_name is "Section"
    give back "section"
  end
  if el_name is "Container" or el_name is "Stack" or el_name is "Grid"
    give back "section"
  end
  if el_name is "Card"
    give back "article"
  end
  if el_name is "Nav"
    give back "nav"
  end
  if el_name is "Heading"
    set lvl to "2"
    if has_map_key using props, "level"
      set lval to text.from using (props at "level")
      if lval is "1" or lval is "2" or lval is "3" or lval is "4" or lval is "5" or lval is "6"
        set lvl to lval
      end
    end
    give back "h" joined with lvl
  end
  if el_name is "Text" or el_name is "RichText"
    give back "p"
  end
  if el_name is "Link"
    give back "a"
  end
  if el_name is "Button"
    give back "button"
  end
  if el_name is "Image"
    give back "img"
  end
  if el_name is "ForEach"
    give back "section"
  end
  give back "section"
end

make render_grex_node using stmts, theme, registry, node, ctx, depth
  if depth is greater than 24
    give back ""
  end
  set el_name to text.from using (node at "element")
  set props to {}
  if node has "props"
    set props to node at "props"
  end

  if el_name is "Nav"
    if has_map_key using props, "location"
      set nav_loc to text.from using (props at "location")
      set cur_p to "/"
      if has_map_key using ctx, "current_path"
        set cur_p to text.from using (ctx at "current_path")
      end
      give back render_menu using stmts, nav_loc, cur_p
    end
  end

  if el_name is "TemplatePart"
    set pname to ""
    if has_map_key using props, "name"
      set pname to text.from using (props at "name")
    end
    if pname is ""
      give back ""
    end
    give back render_part using stmts, theme, registry, pname, ctx
  end

  if el_name is "ForEach"
    set qargs to {}
    if has_map_key using props, "query"
      set qargs to props at "query"
    end
    set qres to query_entries using stmts, theme, registry, qargs, yes
    if not qres.ok
      give back ""
    end
    set out_items to ""
    for each item in qres.data.items
      set item_ctx to collections.put using ctx, "title", item.title
      set item_ctx to collections.put using item_ctx, "full_path", item.full_path
      set item_ctx to collections.put using item_ctx, "content_type_label", item.content_type_label
      set item_ctx to collections.put using item_ctx, "published_at", item.published_at
      set item_ctx to collections.put using item_ctx, "excerpt", item.excerpt
      if node has "children"
        for each ch in (node at "children")
          set out_items to out_items joined with (render_grex_node using stmts, theme, registry, ch, item_ctx, (depth plus 1))
        end
      otherwise
        set out_items to out_items joined with (render_part using stmts, theme, registry, "card", item_ctx)
      end
    end
    set cls_attr to ""
    if has_map_key using props, "class"
      set cls_attr to " class=\"" joined with (escape_html using (text.from using (props at "class"))) joined with "\""
    end
    set q_json to escape_html using (json.stringify using qargs)
    give back "<section" joined with cls_attr joined with " data-grex-foreach=\"query\" data-grex-query=\"" joined with q_json joined with "\">" joined with out_items joined with "</section>"
  end

  set tag to default_tag_for_grex_element using el_name, props
  if node has "tag"
    set req_tag to text.lower using (text.from using (node at "tag"))
    if is_allowed_grex_tag using req_tag
      set tag to req_tag
    end
  end

  set inner to ""
  if has_map_key using props, "text"
    set bound_txt to resolve_grex_bind_text using (text.from using (props at "text")), ctx
    set inner to escape_html using bound_txt
  end
  if node has "children"
    for each ch in (node at "children")
      set inner to inner joined with (render_grex_node using stmts, theme, registry, ch, ctx, (depth plus 1))
    end
  end

  if tag is ""
    give back inner
  end

  set attrs to ""
  if has_map_key using props, "class"
    set attrs to attrs joined with " class=\"" joined with (escape_html using (text.from using (props at "class"))) joined with "\""
  end
  if has_map_key using props, "id"
    set attrs to attrs joined with " data-grex-id=\"" joined with (escape_html using (text.from using (props at "id"))) joined with "\""
  end
  if has_map_key using props, "href"
    set href_val to resolve_grex_bind_text using (text.from using (props at "href")), ctx
    if is_safe_url using href_val
      set attrs to attrs joined with " href=\"" joined with (escape_html using href_val) joined with "\""
    end
  end
  if has_map_key using props, "src"
    set src_val to resolve_grex_bind_text using (text.from using (props at "src")), ctx
    if is_safe_url using src_val
      set attrs to attrs joined with " src=\"" joined with (escape_html using src_val) joined with "\""
    end
  end
  if has_map_key using props, "alt"
    set alt_val to resolve_grex_bind_text using (text.from using (props at "alt")), ctx
    set attrs to attrs joined with " alt=\"" joined with (escape_html using alt_val) joined with "\""
  end
  if has_map_key using props, "aria-label"
    set aria_val to resolve_grex_bind_text using (text.from using (props at "aria-label")), ctx
    set attrs to attrs joined with " aria-label=\"" joined with (escape_html using aria_val) joined with "\""
  end

  if tag is "img"
    give back "<img" joined with attrs joined with ">"
  end
  give back "<" joined with tag joined with attrs joined with ">" joined with inner joined with "</" joined with tag joined with ">"
end

make render_part using stmts, theme, registry, part_name, ctx
  if theme.mode is "visual"
    set gdoc to load_visual_grex_doc using stmts, theme
    if gdoc has "parts"
      set gparts to gdoc at "parts"
      if has_map_key using gparts, part_name
        set pnode to gparts at part_name
        if pnode is not nothing
          give back render_grex_node using stmts, theme, registry, pnode, ctx, 0
        end
      end
    end
    give back ""
  end

  if not (has_map_key using theme.parts, part_name)
    give back ""
  end
  set part_rel_raw to theme.parts at part_name
  if part_rel_raw is nothing
    give back ""
  end
  set part_rel to text.from using part_rel_raw
  if part_rel is ""
    give back ""
  end
  set tmpl_path to "../themes/" joined with theme.slug joined with "/" joined with part_rel
  set rendered to server.html using tmpl_path, ctx, 200
  give back rendered.body
end

make render_query_cards using stmts, theme, registry, items, base_ctx
  set out to ""
  for each item in items
    set item_ctx to collections.put using base_ctx, "title", item.title
    set item_ctx to collections.put using item_ctx, "full_path", item.full_path
    set item_ctx to collections.put using item_ctx, "content_type_label", item.content_type_label
    set item_ctx to collections.put using item_ctx, "published_at", item.published_at
    set item_ctx to collections.put using item_ctx, "excerpt", item.excerpt
    set out to out joined with (render_part using stmts, theme, registry, "card", item_ctx)
  end
  give back out
end

make render_theme_page using stmts, slot_name, page_data, status, query_items
  set theme to get_active_theme_context using stmts
  set settings to get_site_settings_map using stmts
  set registry to build_active_hook_registry using theme

  set tokens_css_url to safe_asset_url using "/static/grex/tokens.css"
  set theme_css_url to safe_asset_url using ("/static/themes/" joined with theme.slug joined with "/theme.css")
  set grex_js_url to safe_asset_url using "/static/grex/grex.js"

  set merged to collections.put using page_data, "site_title", (settings at "site_title")
  set merged to collections.put using merged, "site_tagline", (settings at "site_tagline")
  set merged to collections.put using merged, "theme_name", theme.name
  set merged to collections.put using merged, "theme_slug", theme.slug
  set merged to collections.put using merged, "tokens_css_url", tokens_css_url
  set merged to collections.put using merged, "theme_css_url", theme_css_url
  if not (has_map_key using merged, "published_count")
    set merged to collections.put using merged, "published_count", "0"
  end

  call runHook using stmts, registry, "theme:before_render", {"slot": slot_name, "theme_slug": theme.slug}

  set meta_title to settings at "site_title"
  if has_map_key using merged, "page_title"
    set meta_title to text.from using (merged at "page_title")
  end
  if has_map_key using merged, "meta_title"
    set meta_title to text.from using (merged at "meta_title")
  end
  set canon_path to "/"
  if has_map_key using merged, "current_path"
    set canon_path to text.from using (merged at "current_path")
  otherwise
    if has_map_key using merged, "full_path"
      set canon_path to text.from using (merged at "full_path")
    end
    if has_map_key using merged, "archive_slug"
      set canon_path to "/" joined with (text.from using (merged at "archive_slug"))
    end
    set merged to collections.put using merged, "current_path", canon_path
  end
  set head_tags to applyFilter using registry, "theme:head_meta", [], {"theme_slug": theme.slug, "theme_name": theme.name, "page_title": meta_title, "canonical_path": canon_path}
  set head_meta_html to text.join using head_tags, "\n  "

  if theme.mode is "visual"
    set gdoc to load_visual_grex_doc using stmts, theme
    set tmpls to gdoc at "templates"
    set slot_node to tmpls at slot_name
    set body_inner to render_grex_node using stmts, theme, registry, slot_node, merged, 0
    set css_links to "<link rel=\"stylesheet\" href=\"" joined with (escape_html using tokens_css_url) joined with "\">"
    if theme_css_url is not ""
      set css_links to css_links joined with "\n  <link rel=\"stylesheet\" href=\"" joined with (escape_html using theme_css_url) joined with "\">"
    end
    set grex_script to ""
    if grex_js_url is not ""
      set grex_script to "\n  <script defer src=\"" joined with (escape_html using grex_js_url) joined with "\"></script>"
    end
    set doc_html to "<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>" joined with (escape_html using meta_title) joined with " — " joined with (escape_html using (settings at "site_title")) joined with "</title>\n  " joined with css_links joined with "\n  " joined with head_meta_html joined with grex_script joined with "\n</head>\n<body>\n" joined with body_inner joined with "\n</body>\n</html>\n"
    give back server.response using record {status: status, headers: {"Content-Type": "text/html; charset=utf-8"}, body: doc_html}
  end

  set tmpl_rel to "templates/" joined with slot_name joined with ".grab.html"
  if has_map_key using theme.templates, slot_name
    set tmpl_rel to text.from using (theme.templates at slot_name)
  end
  set tmpl_path to "../themes/" joined with theme.slug joined with "/" joined with tmpl_rel

  set base_resp to server.html using tmpl_path, merged, status
  set html_out to base_resp.body

  if text.contains using html_out, "<!-- @hook:theme_head_meta -->"
    set html_out to text.replace using html_out, "<!-- @hook:theme_head_meta -->", head_meta_html
  end
  if text.contains using html_out, "<!-- @part:header -->"
    set header_html to render_part using stmts, theme, registry, "header", merged
    set html_out to text.replace using html_out, "<!-- @part:header -->", header_html
  end
  if text.contains using html_out, "<!-- @part:footer -->"
    set footer_html to render_part using stmts, theme, registry, "footer", merged
    set html_out to text.replace using html_out, "<!-- @part:footer -->", footer_html
  end
  if text.contains using html_out, "<!-- @part:sidebar -->"
    set sidebar_html to render_part using stmts, theme, registry, "sidebar", merged
    set html_out to text.replace using html_out, "<!-- @part:sidebar -->", sidebar_html
  end
  if text.contains using html_out, "<!-- @part:query_cards -->"
    set cards_html to render_query_cards using stmts, theme, registry, query_items, merged
    set html_out to text.replace using html_out, "<!-- @part:query_cards -->", cards_html
  end
  if text.contains using html_out, "<!-- @menu:primary -->"
    set nav_primary to render_menu using stmts, "primary", canon_path
    set html_out to text.replace using html_out, "<!-- @menu:primary -->", nav_primary
  end
  if text.contains using html_out, "<!-- @menu:footer -->"
    set nav_footer to render_menu using stmts, "footer", canon_path
    set html_out to text.replace using html_out, "<!-- @menu:footer -->", nav_footer
  end
  if text.contains using html_out, "<!-- @menu:mobile -->"
    set nav_mobile to render_menu using stmts, "mobile", canon_path
    set html_out to text.replace using html_out, "<!-- @menu:mobile -->", nav_mobile
  end

  give back server.response using record {status: status, headers: {"Content-Type": "text/html; charset=utf-8"}, body: html_out}
end

# ==============================================================================
# Module 8: Media Library, Base64/Magic-Byte Sniffing & Raster Dimension Parser
# ==============================================================================

make get_upload_dir
  set dir_val to "uploads"
  try
    if env.has using "GRABLAB_UPLOAD_DIR"
      set raw to text.trim using (env.get using "GRABLAB_UPLOAD_DIR")
      if raw is not ""
        set dir_val to raw
      end
    end
  catch err
    set dir_val to "uploads"
  end
  if (text.contains using dir_val, "..") or (text.contains using (json.stringify using dir_val), "\\u000")
    give back ""
  end
  while (text.length using dir_val) is greater than 1 and (text.ends_with using dir_val, "/")
    set chars to text.split using dir_val, ""
    set dir_val to text.join using (collections.slice using chars, 0, ((collections.length using chars) minus 1)), ""
  end
  give back dir_val
end

make get_max_upload_bytes
  set max_b to 10485760
  try
    if env.has using "GRABLAB_MAX_UPLOAD_BYTES"
      set raw to text.trim using (env.get using "GRABLAB_MAX_UPLOAD_BYTES")
      if raw is not ""
        set parsed to text.to_integer using raw
        if parsed is greater than 0
          set max_b to parsed
        end
      end
    end
  catch err
    set max_b to 10485760
  end
  give back max_b
end

make build_b64_lookup
  set alpha to "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
  set chars to text.split using alpha, ""
  set tbl to {}
  set idx to 0
  for each ch in chars
    set tbl to collections.put using tbl, ch, idx
    set idx to idx plus 1
  end
  give back tbl
end

make ascii_char_code using c
  set table to " !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~"
  set chars to text.split using table, ""
  set code to 32
  for each item in chars
    if item is c
      give back code
    end
    set code to code plus 1
  end
  give back 0
end

make strip_data_uri_and_ws using raw_b64
  set s to text.trim using raw_b64
  if text.starts_with using (text.lower using s), "data:"
    set parts to text.split using s, ","
    if (collections.length using parts) is at least 2
      set s to parts at 1
    end
  end
  set s to text.replace using s, "\r", ""
  set s to text.replace using s, "\n", ""
  set s to text.replace using s, " ", ""
  set s to text.replace using s, "\t", ""
  give back s
end

make validate_and_decode_b64_prefix using clean_b64, max_decode_bytes
  set b64_tbl to call build_b64_lookup
  set n to text.length using clean_b64
  if n is less than 4 or ((n modulo 4) is not 0)
    give back record {ok: no, byte_size: 0, bytes: [], error: "Invalid base64 payload length"}
  end
  set chars to text.split using clean_b64, ""
  set pad to 0
  if (chars at (n minus 1)) is "="
    set pad to pad plus 1
  end
  if (chars at (n minus 2)) is "="
    set pad to pad plus 1
  end
  set byte_size to ((math.floor using (n divided by 4)) times 3) minus pad
  if byte_size is at most 0
    give back record {ok: no, byte_size: 0, bytes: [], error: "Empty media payload"}
  end

  set max_chars to ((math.floor using (max_decode_bytes divided by 3)) plus 1) times 4
  if max_chars is greater than n
    set max_chars to n
  end
  set out_bytes to []
  set i to 0
  while i is less than max_chars
    set c0 to chars at i
    set c1 to chars at (i plus 1)
    set c2 to chars at (i plus 2)
    set c3 to chars at (i plus 3)
    if (not (has_map_key using b64_tbl, c0)) or (not (has_map_key using b64_tbl, c1))
      give back record {ok: no, byte_size: 0, bytes: [], error: "Invalid base64 character in payload"}
    end
    set v0 to b64_tbl at c0
    set v1 to b64_tbl at c1
    set b0 to (v0 times 4) plus (math.floor using (v1 divided by 16))
    set out_bytes to collections.append using out_bytes, b0
    if c2 is not "="
      if not (has_map_key using b64_tbl, c2)
        give back record {ok: no, byte_size: 0, bytes: [], error: "Invalid base64 character in payload"}
      end
      set v2 to b64_tbl at c2
      set b1 to ((v1 modulo 16) times 16) plus (math.floor using (v2 divided by 4))
      set out_bytes to collections.append using out_bytes, b1
      if c3 is not "="
        if not (has_map_key using b64_tbl, c3)
          give back record {ok: no, byte_size: 0, bytes: [], error: "Invalid base64 character in payload"}
        end
        set v3 to b64_tbl at c3
        set b2 to ((v2 modulo 4) times 64) plus v3
        set out_bytes to collections.append using out_bytes, b2
      end
    end
    set i to i plus 4
  end
  give back record {ok: yes, byte_size: byte_size, bytes: out_bytes, error: ""}
end

make bytes_prefix_to_ascii_lower using b_list, max_len
  set ascii_tbl to " !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~"
  set ascii_chars to text.split using ascii_tbl, ""
  set lim to math.min using max_len, (collections.length using b_list)
  set out_chars to []
  set idx to 0
  while idx is less than lim
    set code to b_list at idx
    if code is at least 32 and code is at most 126
      set out_chars to collections.append using out_chars, (ascii_chars at (code minus 32))
    otherwise
      set out_chars to collections.append using out_chars, " "
    end
    set idx to idx plus 1
  end
  give back text.lower using (text.join using out_chars, "")
end

make read_u16_be using b_list, off
  give back ((b_list at off) times 256) plus (b_list at (off plus 1))
end

make read_u16_le using b_list, off
  give back (b_list at off) plus ((b_list at (off plus 1)) times 256)
end

make read_u32_be using b_list, off
  give back ((b_list at off) times 16777216) plus ((b_list at (off plus 1)) times 65536) plus ((b_list at (off plus 2)) times 256) plus (b_list at (off plus 3))
end

make sniff_media_magic using b_list
  set n to collections.length using b_list
  if n is less than 4
    give back record {ok: no, mime: "", ext: "", error: "Unsupported or unrecognized file signature"}
  end
  set ascii_head to bytes_prefix_to_ascii_lower using b_list, 512
  if (text.contains using ascii_head, "<svg") or (text.contains using ascii_head, "<?xml") or (text.contains using ascii_head, "<html") or (text.contains using ascii_head, "<!doctype") or (text.contains using ascii_head, "<script") or (text.contains using ascii_head, "<iframe")
    give back record {ok: no, mime: "", ext: "", error: "SVG, HTML, XML, and active script payloads are blocked"}
  end
  if (b_list at 0) is 77 and (b_list at 1) is 90
    give back record {ok: no, mime: "", ext: "", error: "Executable payloads are blocked"}
  end
  if (b_list at 0) is 127 and (b_list at 1) is 69 and (b_list at 2) is 76 and (b_list at 3) is 70
    give back record {ok: no, mime: "", ext: "", error: "ELF executable payloads are blocked"}
  end
  if (b_list at 0) is 35 and (b_list at 1) is 33
    give back record {ok: no, mime: "", ext: "", error: "Shell script payloads are blocked"}
  end
  if n is at least 8 and (b_list at 0) is 137 and (b_list at 1) is 80 and (b_list at 2) is 78 and (b_list at 3) is 71 and (b_list at 4) is 13 and (b_list at 5) is 10 and (b_list at 6) is 26 and (b_list at 7) is 10
    give back record {ok: yes, mime: "image/png", ext: "png", error: ""}
  end
  if n is at least 3 and (b_list at 0) is 255 and (b_list at 1) is 216 and (b_list at 2) is 255
    give back record {ok: yes, mime: "image/jpeg", ext: "jpg", error: ""}
  end
  if n is at least 6 and (b_list at 0) is 71 and (b_list at 1) is 73 and (b_list at 2) is 70 and (b_list at 3) is 56 and ((b_list at 4) is 55 or (b_list at 4) is 57) and (b_list at 5) is 97
    give back record {ok: yes, mime: "image/gif", ext: "gif", error: ""}
  end
  if n is at least 12 and (b_list at 0) is 82 and (b_list at 1) is 73 and (b_list at 2) is 70 and (b_list at 3) is 70 and (b_list at 8) is 87 and (b_list at 9) is 69 and (b_list at 10) is 66 and (b_list at 11) is 80
    give back record {ok: yes, mime: "image/webp", ext: "webp", error: ""}
  end
  if n is at least 5 and (b_list at 0) is 37 and (b_list at 1) is 80 and (b_list at 2) is 68 and (b_list at 3) is 70 and (b_list at 4) is 45
    give back record {ok: yes, mime: "application/pdf", ext: "pdf", error: ""}
  end
  give back record {ok: no, mime: "", ext: "", error: "Unsupported media type signature"}
end

make parse_raster_dimensions using mime, b_list
  set n to collections.length using b_list
  if mime is "application/pdf"
    give back record {ok: yes, width: nothing, height: nothing, error: ""}
  end
  if mime is "image/png"
    if n is less than 24 or (b_list at 12) is not 73 or (b_list at 13) is not 72 or (b_list at 14) is not 68 or (b_list at 15) is not 82
      give back record {ok: no, width: nothing, height: nothing, error: "Corrupt or truncated PNG header"}
    end
    set w to read_u32_be using b_list, 16
    set h to read_u32_be using b_list, 20
    if w is less than 1 or h is less than 1 or w is greater than 65535 or h is greater than 65535
      give back record {ok: no, width: nothing, height: nothing, error: "Invalid PNG dimensions"}
    end
    give back record {ok: yes, width: w, height: h, error: ""}
  end
  if mime is "image/gif"
    if n is less than 10
      give back record {ok: no, width: nothing, height: nothing, error: "Corrupt or truncated GIF header"}
    end
    set w to read_u16_le using b_list, 6
    set h to read_u16_le using b_list, 8
    if w is less than 1 or h is less than 1
      give back record {ok: no, width: nothing, height: nothing, error: "Invalid GIF dimensions"}
    end
    give back record {ok: yes, width: w, height: h, error: ""}
  end
  if mime is "image/webp"
    if n is less than 30
      give back record {ok: no, width: nothing, height: nothing, error: "Corrupt or truncated WebP header"}
    end
    if (b_list at 12) is 86 and (b_list at 13) is 80 and (b_list at 14) is 56 and (b_list at 15) is 32
      if (b_list at 23) is not 157 or (b_list at 24) is not 1 or (b_list at 25) is not 42
        give back record {ok: no, width: nothing, height: nothing, error: "Corrupt WebP VP8 frame"}
      end
      set w to (read_u16_le using b_list, 26) modulo 16384
      set h to (read_u16_le using b_list, 28) modulo 16384
      give back record {ok: yes, width: w, height: h, error: ""}
    end
    if (b_list at 12) is 86 and (b_list at 13) is 80 and (b_list at 14) is 56 and (b_list at 15) is 76
      if (b_list at 20) is not 47
        give back record {ok: no, width: nothing, height: nothing, error: "Corrupt WebP VP8L header"}
      end
      set v0 to b_list at 21
      set v1 to b_list at 22
      set v2 to b_list at 23
      set v3 to b_list at 24
      set w to ((v0 plus ((v1 modulo 64) times 256)) plus 1)
      set h to ((math.floor using (v1 divided by 64)) plus (v2 times 4) plus ((v3 modulo 16) times 1024) plus 1)
      give back record {ok: yes, width: w, height: h, error: ""}
    end
    if (b_list at 12) is 86 and (b_list at 13) is 80 and (b_list at 14) is 56 and (b_list at 15) is 88
      set w to (b_list at 24) plus ((b_list at 25) times 256) plus ((b_list at 26) times 65536) plus 1
      set h to (b_list at 27) plus ((b_list at 28) times 256) plus ((b_list at 29) times 65536) plus 1
      give back record {ok: yes, width: w, height: h, error: ""}
    end
    give back record {ok: no, width: nothing, height: nothing, error: "Unsupported or corrupt WebP chunk"}
  end
  if mime is "image/jpeg"
    set pos to 2
    while (pos plus 1) is less than n
      if (b_list at pos) is not 255
        give back record {ok: no, width: nothing, height: nothing, error: "Corrupt JPEG marker stream"}
      end
      while (pos plus 1) is less than n and (b_list at pos) is 255
        set pos to pos plus 1
      end
      set marker to b_list at pos
      set pos to pos plus 1
      if marker is 217 or marker is 218
        give back record {ok: no, width: nothing, height: nothing, error: "Truncated JPEG before SOF dimensions"}
      end
      set is_sof to (marker is 192 or marker is 193 or marker is 194 or marker is 195 or marker is 197 or marker is 198 or marker is 199 or marker is 201 or marker is 202 or marker is 203 or marker is 205 or marker is 206 or marker is 207)
      if is_sof
        if (pos plus 7) is greater than n
          give back record {ok: no, width: nothing, height: nothing, error: "Truncated JPEG SOF frame"}
        end
        set h to read_u16_be using b_list, (pos plus 3)
        set w to read_u16_be using b_list, (pos plus 5)
        if w is less than 1 or h is less than 1
          give back record {ok: no, width: nothing, height: nothing, error: "Invalid JPEG dimensions"}
        end
        give back record {ok: yes, width: w, height: h, error: ""}
      end
      if marker is not 0 and (not (marker is at least 208 and marker is at most 215)) and marker is not 1
        if (pos plus 2) is greater than n
          give back record {ok: no, width: nothing, height: nothing, error: "Truncated JPEG segment"}
        end
        set seg_len to read_u16_be using b_list, pos
        if seg_len is less than 2
          give back record {ok: no, width: nothing, height: nothing, error: "Invalid JPEG segment length"}
        end
        set pos to pos plus seg_len
      end
    end
    give back record {ok: no, width: nothing, height: nothing, error: "Truncated JPEG without dimensions"}
  end
  give back record {ok: no, width: nothing, height: nothing, error: "Unsupported media format"}
end

make sanitize_media_filename using raw_name
  set name to text.trim using raw_name
  if name is ""
    give back record {ok: no, name: "", ext: "", error: "Filename is required"}
  end
  if (text.contains using name, "..") or (text.contains using name, "/") or (text.contains using name, "\\") or (text.contains using (json.stringify using name), "\\u000") or (text.contains using (text.lower using name), "%00")
    give back record {ok: no, name: "", ext: "", error: "Invalid filename: path separators and traversal segments are forbidden"}
  end
  set trimmed to text_truncate using name, 255
  set ext to ""
  set parts to text.split using trimmed, "."
  if (collections.length using parts) is at least 2
    set ext to text.lower using (text.trim using (parts at ((collections.length using parts) minus 1)))
  end
  give back record {ok: yes, name: trimmed, ext: ext, error: ""}
end

make ext_matches_mime using ext, sniffed_mime
  if ext is ""
    give back yes
  end
  if sniffed_mime is "image/png"
    give back ext is "png"
  end
  if sniffed_mime is "image/jpeg"
    give back (ext is "jpg" or ext is "jpeg")
  end
  if sniffed_mime is "image/webp"
    give back ext is "webp"
  end
  if sniffed_mime is "image/gif"
    give back ext is "gif"
  end
  if sniffed_mime is "application/pdf"
    give back ext is "pdf"
  end
  give back no
end

make declared_mime_matches using declared, sniffed_mime
  set d to text.lower using (text.trim using declared)
  if d is "" or d is "application/octet-stream"
    give back yes
  end
  if d is sniffed_mime
    give back yes
  end
  if (d is "image/jpg") and (sniffed_mime is "image/jpeg")
    give back yes
  end
  give back no
end

make format_media_record using row
  set dec_flag to (row.is_decorative is 1)
  give back record {id: row.id, filename: row.filename, original_name: row.original_name, url: ("/media/" joined with (text.from using row.id) joined with "/" joined with row.filename), mime_type: row.mime_type, byte_size: row.byte_size, width: row.width, height: row.height, alt_text: row.alt_text, is_decorative: dec_flag, caption: row.caption, sha256_hex: row.sha256_hex, uploader_id: row.uploader_id, created_at: row.created_at, updated_at: row.updated_at}
end

# ==============================================================================
# Module 9: Navigation Menus, Validation & Semantic Grex Rendering
# ==============================================================================

make is_valid_menu_location using loc
  give back (loc is "" or loc is "primary" or loc is "footer" or loc is "mobile")
end

make is_valid_external_menu_url using raw_url
  set u to text.trim using raw_url
  if u is "" or (text.contains using u, "\r") or (text.contains using u, "\n") or (text.contains using (json.stringify using u), "\\u000") or (text.contains using u, " ") or (text.contains using u, "\\")
    give back no
  end
  if u is "/" or u is "/blog"
    give back yes
  end
  set low to text.lower using u
  if (text.starts_with using low, "https://") or (text.starts_with using low, "http://")
    give back (text.length using u) is greater than 8
  end
  give back no
end

make resolve_menu_item_url using item, include_unpublished
  if item.link_type is "external"
    if item.external_url is nothing
      give back ""
    end
    set eu to text.trim using item.external_url
    if is_valid_external_menu_url using eu
      give back eu
    end
    give back ""
  end
  if item.link_type is "entry"
    if item.entry_full_path is nothing
      give back ""
    end
    if (not include_unpublished) and (item.entry_status is not "published")
      give back ""
    end
    give back item.entry_full_path
  end
  give back ""
end

make build_menu_children using rows, parent_id_val, depth, include_unpublished
  if depth is greater than 4
    give back []
  end
  set out to []
  for each item in rows
    set match_parent to no
    if parent_id_val is nothing
      if item.parent_id is nothing
        set match_parent to yes
      end
    otherwise
      if item.parent_id is not nothing and item.parent_id is parent_id_val
        set match_parent to yes
      end
    end
    if match_parent
      set resolved_url to resolve_menu_item_url using item, include_unpublished
      if resolved_url is not "" or include_unpublished
        set kids to build_menu_children using rows, item.id, (depth plus 1), include_unpublished
        set out to collections.append using out, record {id: item.id, parent_id: item.parent_id, label: item.label, link_type: item.link_type, entry_id: item.entry_id, external_url: item.external_url, url: resolved_url, target_blank: (item.target_blank is 1), css_class: item.css_class, sort_order: item.sort_order, children: kids}
      end
    end
  end
  give back out
end

make get_menu_tree using stmts, location, include_unpublished
  if location is "" or (not (is_valid_menu_location using location))
    give back nothing
  end
  set ckey to "menu:loc:" joined with location
  if not include_unpublished
    set cached to cache.get using stmts.cms_cache, ckey
    if cached.found
      give back cached.value
    end
  end
  set menu_row to data.one using stmts.get_menu_by_location, record {location: location}
  if menu_row is nothing
    give back nothing
  end
  set rows to data.query using stmts.list_menu_items_by_menu, record {menu_id: menu_row.id}
  set items_tree to build_menu_children using rows, nothing, 1, include_unpublished
  set tree_obj to record {id: menu_row.id, slug: menu_row.slug, name: menu_row.name, location: menu_row.location, items: items_tree}
  if not include_unpublished
    call cache.set using stmts.cms_cache, ckey, tree_obj, 120000
  end
  give back tree_obj
end

make render_menu_ul using nodes, current_path, depth
  if (collections.length using nodes) is 0 or depth is greater than 4
    give back ""
  end
  set cur_norm to normalize_path using current_path
  set li_parts to []
  for each node in nodes
    set href_safe to "#"
    if node.url is not ""
      set href_safe to node.url
    end
    set a_attrs to "href=\"" joined with (escape_html using href_safe) joined with "\""
    if (normalize_path using href_safe) is cur_norm
      set a_attrs to a_attrs joined with " aria-current=\"page\""
    end
    if node.target_blank
      set a_attrs to a_attrs joined with " target=\"_blank\" rel=\"noopener noreferrer\""
    end
    if node.css_class is not ""
      set a_attrs to a_attrs joined with " class=\"" joined with (escape_html using node.css_class) joined with "\""
    end
    set sub_ul to render_menu_ul using node.children, cur_norm, (depth plus 1)
    set li_html to "<li><a " joined with a_attrs joined with ">" joined with (escape_html using node.label) joined with "</a>" joined with sub_ul joined with "</li>"
    set li_parts to collections.append using li_parts, li_html
  end
  give back "<ul>" joined with (text.join using li_parts, "") joined with "</ul>"
end

make render_menu using stmts, location, current_path
  set tree to get_menu_tree using stmts, location, no
  if tree is nothing
    give back ""
  end
  set ul_html to render_menu_ul using tree.items, current_path, 1
  give back "<nav class=\"cms-nav cms-nav-" joined with (escape_html using location) joined with "\" aria-label=\"" joined with (escape_html using tree.name) joined with "\">" joined with ul_html joined with "</nav>"
end

make validate_menu_hierarchy using items_list
  set by_key to {}
  set idx to 0
  for each item in items_list
    set k to "idx:" joined with (text.from using idx)
    if (has_map_key using item, "client_id") and (text.trim using (text.from using (item at "client_id"))) is not ""
      set k to "cid:" joined with (text.trim using (text.from using (item at "client_id")))
    otherwise
      if (has_map_key using item, "id") and (item at "id") is not nothing
        set k to "id:" joined with (text.from using (item at "id"))
      end
    end
    if has_map_key using by_key, k
      give back record {ok: no, error: "Duplicate menu item key"}
    end
    set by_key to collections.put using by_key, k, item
    set idx to idx plus 1
  end

  set keys_all to collections.keys using by_key
  for each k in keys_all
    set depth to 1
    set cur to by_key at k
    set visited to collections.put using {}, k, yes
    while (has_map_key using cur, "parent_key") and (cur at "parent_key") is not nothing and (cur at "parent_key") is not ""
      set pk to text.from using (cur at "parent_key")
      if pk is k or (has_map_key using visited, pk)
        give back record {ok: no, error: "Cycle detected in menu hierarchy"}
      end
      if not (has_map_key using by_key, pk)
        give back record {ok: no, error: "Parent menu item does not belong to this menu"}
      end
      set visited to collections.put using visited, pk, yes
      set depth to depth plus 1
      if depth is greater than 4
        give back record {ok: no, error: "Menu nesting depth exceeds maximum of 4 levels"}
      end
      set cur to by_key at pk
    end
  end
  give back record {ok: yes, error: ""}
end

# ==============================================================================
# Module 10: Taxonomies, Hierarchical Terms & Entry Term Assignment
# ==============================================================================

make parse_content_type_slugs_json using raw_json
  try
    set parsed to json.parse using raw_json
    set out to []
    for each s in parsed
      set sn to normalize_slug using (text.from using s)
      if sn is not "" and (is_valid_slug using sn)
        set out to collections.append using out, sn
      end
    end
    give back out
  catch err
    give back []
  end
end

make check_term_parent_valid using stmts, tax_row, self_id, parent_id
  if parent_id is nothing
    give back record {ok: yes, error: ""}
  end
  if tax_row.is_hierarchical is not 1
    give back record {ok: no, error: "Flat taxonomies do not support parent terms"}
  end
  if self_id is not nothing and parent_id is self_id
    give back record {ok: no, error: "Term cannot be its own parent"}
  end
  set all_terms to data.query using stmts.list_terms_by_tax, record {taxonomy_id: tax_row.id}
  set by_id to {}
  for each t in all_terms
    set by_id to collections.put using by_id, (text.from using t.id), t
  end
  set pid_key to text.from using parent_id
  if not (has_map_key using by_id, pid_key)
    give back record {ok: no, error: "Parent term does not belong to this taxonomy"}
  end
  set cur_key to pid_key
  set steps to 0
  while cur_key is not "" and steps is less than 12
    if self_id is not nothing and cur_key is (text.from using self_id)
      give back record {ok: no, error: "Cycle detected in hierarchical terms"}
    end
    if not (has_map_key using by_id, cur_key)
      give back record {ok: yes, error: ""}
    end
    set node to by_id at cur_key
    if node.parent_id is nothing
      give back record {ok: yes, error: ""}
    end
    set cur_key to text.from using node.parent_id
    set steps to steps plus 1
  end
  give back record {ok: no, error: "Term hierarchy depth limit exceeded"}
end

make sync_entry_terms_tx using stmts, entry_id, term_ids_raw, now_iso, tx
  call data.execute using stmts.delete_entry_terms_by_entry, record {entry_id: entry_id}, tx
  set seen to {}
  for each tid_raw in term_ids_raw
    set tid to text.to_integer using (text.from using tid_raw)
    set tid_str to text.from using tid
    if not (has_map_key using seen, tid_str)
      set trow to data.one using stmts.get_term_by_id, record {id: tid}, tx
      if trow is nothing
        give back record {ok: no, error: "Unknown term_id: " joined with tid_str}
      end
      call data.execute using stmts.insert_entry_term, record {entry_id: entry_id, term_id: tid, created_at: now_iso}, tx
      set seen to collections.put using seen, tid_str, yes
    end
  end
  give back record {ok: yes, error: ""}
end

# ==============================================================================
# Module 11: Strict Grex Validation, WCAG AA auditAccessibility & grab mcp Tools
# ==============================================================================

make text_contains_unsafe_markup using raw
  set low to text.lower using raw
  if (text.contains using low, "<script") or (text.contains using low, "<iframe") or (text.contains using low, "<object") or (text.contains using low, "<div") or (text.contains using low, "javascript:") or (text.contains using low, "onerror=") or (text.contains using low, "onload=") or (text.contains using low, "onclick=") or (text.contains using low, "eval(")
    give back yes
  end
  give back no
end

make grex_node_has_accessible_name using node
  if node has "props"
    set props to node at "props"
    for each k in ["text", "label", "aria-label"]
      if has_map_key using props, k
        set v to text.trim using (text.from using (props at k))
        if v is not ""
          give back yes
        end
      end
    end
  end
  if node has "children"
    for each ch in (node at "children")
      if ch has "props"
        set cp to ch at "props"
        if has_map_key using cp, "text"
          if (text.trim using (text.from using (cp at "text"))) is not ""
            give back yes
          end
        end
      end
    end
  end
  give back no
end

make resolve_heading_level using node, tag_name
  if tag_name is "h1"
    give back 1
  end
  if tag_name is "h2"
    give back 2
  end
  if tag_name is "h3"
    give back 3
  end
  if tag_name is "h4"
    give back 4
  end
  if tag_name is "h5"
    give back 5
  end
  if tag_name is "h6"
    give back 6
  end
  if node has "props"
    set props to node at "props"
    if has_map_key using props, "level"
      try
        give back text.to_integer using (text.from using (props at "level"))
      catch err
        give back 0
      end
    end
  end
  give back 2
end

make audit_grex_tree_walk using stmts, node, depth, path_label, state
  set violations to state.violations
  set h1_count to state.h1_count
  set last_h to state.last_heading_level

  if depth is greater than 24
    set violations to collections.append using violations, record {rule: "schema-max-depth", path: path_label, message: "Grex layout nesting exceeds maximum depth (24)"}
    give back record {violations: violations, h1_count: h1_count, last_heading_level: last_h}
  end

  if not (node has "element")
    set violations to collections.append using violations, record {rule: "schema-element-required", path: path_label, message: "Grex layout node requires an element field"}
    give back record {violations: violations, h1_count: h1_count, last_heading_level: last_h}
  end

  set el_name to text.from using (node at "element")
  if not (is_allowed_grex_element using el_name)
    set violations to collections.append using violations, record {rule: "schema-element-allowlist", path: path_label, message: "Unsupported or unsafe Grex element: " joined with el_name}
    give back record {violations: violations, h1_count: h1_count, last_heading_level: last_h}
  end

  set tag_name to ""
  if node has "tag"
    set tag_name to text.lower using (text.from using (node at "tag"))
    if tag_name is "div"
      set violations to collections.append using violations, record {rule: "no-wrapper-div", path: path_label, message: "Wrapper <div> tags are strictly forbidden in Grex layouts"}
    otherwise
      if tag_name is "script" or tag_name is "iframe" or tag_name is "object" or tag_name is "style" or (not (is_allowed_grex_tag using tag_name))
        set violations to collections.append using violations, record {rule: "security-disallowed-tag", path: path_label, message: "Disallowed HTML tag in Grex layout: " joined with tag_name}
      end
    end
  end

  set props to {}
  if node has "props"
    set props to node at "props"
    set prop_keys to collections.keys using props
    for each pk in prop_keys
      set pkl to text.lower using pk
      if text.starts_with using pkl, "on"
        set violations to collections.append using violations, record {rule: "security-no-inline-events", path: path_label, message: "Inline event handler prop not allowed: " joined with pk}
      end
      if pkl is "dangerouslysetinnerhtml" or pkl is "innerhtml" or pkl is "outerhtml"
        set violations to collections.append using violations, record {rule: "zero-innerHTML", path: path_label, message: "Unsafe HTML sink prop not allowed: " joined with pk}
      end
      if pkl is "href" or pkl is "src" or pkl is "action" or pkl is "formaction"
        set u_val to text.from using (props at pk)
        if (not (is_safe_url using u_val)) and (not (is_binding_token using u_val))
          set violations to collections.append using violations, record {rule: "url-protocol-check", path: path_label, message: "Unsafe URL in prop " joined with pk}
        end
      end
      if pkl is "text" or pkl is "html" or pkl is "content"
        set txt_val to text.from using (props at pk)
        if text_contains_unsafe_markup using txt_val
          set violations to collections.append using violations, record {rule: "csp-safe", path: path_label, message: "Unsafe script/div/event markup inside " joined with pk}
        end
      end
    end
  end

  if el_name is "Image" or tag_name is "img"
    set has_alt to no
    if (has_map_key using props, "is_decorative") and (is_truthy_val using (props at "is_decorative"))
      set has_alt to yes
    end
    if (has_map_key using props, "aria-hidden") and (text.lower using (text.from using (props at "aria-hidden"))) is "true"
      set has_alt to yes
    end
    if has_map_key using props, "alt"
      if (text.trim using (text.from using (props at "alt"))) is not ""
        set has_alt to yes
      end
    end
    if (not has_alt) and (has_map_key using props, "media_id")
      try
        set mid to text.to_integer using (text.from using (props at "media_id"))
        set mrow to data.one using stmts.get_media_by_id, record {id: mid}
        if mrow is nothing
          set violations to collections.append using violations, record {rule: "a11y-media-exists", path: path_label, message: "Referenced media_id not found"}
        otherwise
          if (text.trim using mrow.alt_text) is not "" or mrow.is_decorative is 1
            set has_alt to yes
          end
        end
      catch merr
      end
    end
    if not has_alt
      set violations to collections.append using violations, record {rule: "a11y-image-alt", path: path_label, message: "Image requires non-empty alt text or explicit is_decorative: true"}
    end
  end

  if el_name is "Heading" or tag_name is "h1" or tag_name is "h2" or tag_name is "h3" or tag_name is "h4" or tag_name is "h5" or tag_name is "h6"
    set lvl to resolve_heading_level using node, tag_name
    if lvl is less than 1 or lvl is greater than 6
      set violations to collections.append using violations, record {rule: "a11y-heading-level", path: path_label, message: "Heading level must be between 1 and 6"}
    otherwise
      if lvl is 1
        set h1_count to h1_count plus 1
        if h1_count is greater than 1
          set violations to collections.append using violations, record {rule: "a11y-single-h1", path: path_label, message: "Multiple <h1> headings detected; only one <h1> is allowed per layout"}
        end
      end
      if last_h is greater than 0 and lvl is greater than (last_h plus 1)
        set violations to collections.append using violations, record {rule: "a11y-heading-order", path: path_label, message: "Skipped heading level from h" joined with (text.from using last_h) joined with " to h" joined with (text.from using lvl)}
      end
      set last_h to lvl
    end
  end

  if el_name is "Link" or el_name is "Button" or el_name is "Input" or el_name is "Select" or tag_name is "a" or tag_name is "button" or tag_name is "input" or tag_name is "select"
    if not (grex_node_has_accessible_name using node)
      set violations to collections.append using violations, record {rule: "a11y-interactive-label", path: path_label, message: "Interactive " joined with el_name joined with " requires accessible label (text, label, or aria-label)"}
    end
  end

  set cur_state to record {violations: violations, h1_count: h1_count, last_heading_level: last_h}
  if node has "children"
    set kids to node at "children"
    set idx to 0
    for each ch in kids
      set next_path to path_label joined with ".children[" joined with (text.from using idx) joined with "]"
      set cur_state to audit_grex_tree_walk using stmts, ch, (depth plus 1), next_path, cur_state
      set idx to idx plus 1
    end
  end
  give back cur_state
end

make render_validated_grex_html using stmts, node, depth
  if depth is greater than 24
    give back ""
  end
  set el_name to text.from using (node at "element")
  set props to {}
  if node has "props"
    set props to node at "props"
  end
  set tag to default_tag_for_grex_element using el_name, props
  if node has "tag"
    set req_tag to text.lower using (text.from using (node at "tag"))
    if is_allowed_grex_tag using req_tag
      set tag to req_tag
    end
  end
  if el_name is "Heading" and (not (node has "tag")) and (has_map_key using props, "level")
    set lvl_str to text.from using (props at "level")
    if lvl_str is "1" or lvl_str is "2" or lvl_str is "3" or lvl_str is "4" or lvl_str is "5" or lvl_str is "6"
      set tag to "h" joined with lvl_str
    end
  end

  set inner to ""
  if has_map_key using props, "text"
    set inner to escape_html using (text.from using (props at "text"))
  end
  if node has "children"
    for each ch in (node at "children")
      set inner to inner joined with (render_validated_grex_html using stmts, ch, (depth plus 1))
    end
  end
  if tag is ""
    give back inner
  end

  set attrs to ""
  if has_map_key using props, "class"
    set attrs to attrs joined with " class=\"" joined with (escape_html using (text.from using (props at "class"))) joined with "\""
  end
  if has_map_key using props, "href"
    set hv to text.from using (props at "href")
    if is_safe_url using hv
      set attrs to attrs joined with " href=\"" joined with (escape_html using hv) joined with "\""
    end
  end
  if el_name is "Image" or tag is "img"
    set src_val to ""
    set alt_val to ""
    set is_dec to no
    if has_map_key using props, "src"
      set src_val to text.from using (props at "src")
    end
    if has_map_key using props, "alt"
      set alt_val to text.from using (props at "alt")
    end
    if (has_map_key using props, "is_decorative") and (is_truthy_val using (props at "is_decorative"))
      set is_dec to yes
    end
    if has_map_key using props, "media_id"
      try
        set mrow to data.one using stmts.get_media_by_id, record {id: (text.to_integer using (text.from using (props at "media_id")))}
        if mrow is not nothing
          if src_val is ""
            set src_val to "/media/" joined with (text.from using mrow.id) joined with "/" joined with mrow.filename
          end
          if alt_val is "" and mrow.alt_text is not ""
            set alt_val to mrow.alt_text
          end
          if mrow.is_decorative is 1
            set is_dec to yes
          end
        end
      catch err
      end
    end
    if src_val is not "" and (is_safe_url using src_val)
      set attrs to attrs joined with " src=\"" joined with (escape_html using src_val) joined with "\""
    end
    if is_dec
      set attrs to attrs joined with " alt=\"\" aria-hidden=\"true\""
    otherwise
      set attrs to attrs joined with " alt=\"" joined with (escape_html using alt_val) joined with "\""
    end
    give back "<img" joined with attrs joined with ">"
  end
  if has_map_key using props, "aria-label"
    set attrs to attrs joined with " aria-label=\"" joined with (escape_html using (text.from using (props at "aria-label"))) joined with "\""
  end
  give back "<" joined with tag joined with attrs joined with ">" joined with inner joined with "</" joined with tag joined with ">"
end

make resolve_mcp_principal using stmts, req
  set bearer to extract_bearer_token using req
  if bearer is not ""
    set sess to resolve_session_token using stmts, bearer
    if sess is nothing
      give back record {ok: no, status: 401, session: nothing, via_bearer: yes, error: "Invalid or expired MCP bearer token"}
    end
    give back record {ok: yes, status: 200, session: sess, via_bearer: yes, error: ""}
  end
  set csess to resolve_session using stmts, req
  if csess is nothing
    give back record {ok: no, status: 401, session: nothing, via_bearer: no, error: "MCP authentication required (Bearer token or valid session)"}
  end
  if not (csrf_matches using req, csess)
    give back record {ok: no, status: 403, session: nothing, via_bearer: no, error: "Missing or invalid X-CSRF-Token for cookie-authenticated MCP call"}
  end
  give back record {ok: yes, status: 200, session: csess, via_bearer: no, error: ""}
end

make mcp_tool_schemas
  give back [record {name: "list_content_types", description: "List registered GrabLab content types and field definitions", inputSchema: (record {type: "object", properties: {}})}, record {name: "query_entries", description: "Query CMS entries with optional content_type, status, filter_by_term, search, limit, and offset", inputSchema: (record {type: "object", properties: {"content_type": {"type": "string"}, "status": {"type": "string"}, "filter_by_term": {"type": "object"}, "search": {"type": "string"}, "limit": {"type": "integer"}, "offset": {"type": "integer"}}})}, record {name: "create_entry_draft", description: "Create a new draft entry (status is always forced to draft)", inputSchema: (record {type: "object", required: ["content_type", "slug", "title"], properties: {"content_type": {"type": "string"}, "slug": {"type": "string"}, "title": {"type": "string"}}})}, record {name: "update_entry_layout", description: "Update an entry's Grex layout after grex.elements.json and WCAG AA auditAccessibility validation", inputSchema: (record {type: "object", required: ["entry_id", "layout"], properties: {"entry_id": {"type": "integer"}, "layout": {"type": "object"}}})}, record {name: "list_media", description: "List uploaded media assets", inputSchema: (record {type: "object", properties: {"mime_prefix": {"type": "string"}, "limit": {"type": "integer"}, "offset": {"type": "integer"}}})}, record {name: "list_menus", description: "List menus and resolved menu item hierarchies", inputSchema: (record {type: "object", properties: {}})}]
end

make execute_mcp_tool using stmts, sess, tool_name, args
  if tool_name is "list_content_types"
    if not (role_has_capability using sess.role, "admin:access")
      give back record {ok: no, status: 403, payload: record {error: "Forbidden: insufficient capability for list_content_types"}}
    end
    set types to data.query using stmts.list_types, record {}
    set out to []
    for each ct in types
      set fields to data.query using stmts.list_fields_by_type, record {content_type_id: ct.id}
      set out to collections.append using out, record {id: ct.id, slug: ct.slug, label_singular: ct.label_singular, label_plural: ct.label_plural, permalink_pattern: ct.permalink_pattern, has_archive: (ct.has_archive is 1), archive_slug: ct.archive_slug, fields: fields}
    end
    give back record {ok: yes, status: 200, payload: record {content_types: out}}
  end

  if tool_name is "query_entries"
    set req_status to "published"
    if args has "status" and (args at "status") is not nothing
      set req_status to text.lower using (text.trim using (text.from using (args at "status")))
    end
    if sess.role is "viewer" and req_status is not "published"
      give back record {ok: no, status: 403, payload: record {error: "Forbidden: viewer role cannot read non-published entries"}}
    end
    set limit_val to 20
    if args has "limit" and (args at "limit") is not nothing
      set limit_val to math.clamp using (text.to_integer using (text.from using (args at "limit"))), 1, 100
    end
    set offset_val to 0
    if args has "offset" and (args at "offset") is not nothing
      set offset_val to math.max using 0, (text.to_integer using (text.from using (args at "offset")))
    end
    set page_num to (math.floor using (offset_val divided by limit_val)) plus 1
    set q_map to {"status": req_status, "per_page": (text.from using limit_val), "page": (text.from using page_num)}
    if args has "content_type" and (args at "content_type") is not nothing
      set q_map to collections.put using q_map, "content_type", (text.from using (args at "content_type"))
    end
    if args has "filter_by_term" and (args at "filter_by_term") is not nothing
      set q_map to collections.put using q_map, "filter_by_term", (args at "filter_by_term")
    end
    if args has "search" and (args at "search") is not nothing
      set q_map to collections.put using q_map, "search", (text.from using (args at "search"))
    end
    set theme to get_active_theme_context using stmts
    set registry to build_active_hook_registry using theme
    if sess.role is "author"
      set raw_rows to data.query using stmts.list_entries, record {}
      set safe_rows to []
      for each r in raw_rows
        set can_see to (r.status is "published") or (r.author_id is not nothing and r.author_id is sess.user_id)
        if req_status is not "all" and r.status is not req_status
          set can_see to no
        end
        if can_see
          set safe_rows to collections.append using safe_rows, (format_query_item using r)
        end
      end
      give back record {ok: yes, status: 200, payload: record {items: safe_rows, pagination: record {page: 1, per_page: limit_val, total_items: (collections.length using safe_rows)}}}
    end
    set is_pub_q to (sess.role is "viewer")
    set qres to query_entries using stmts, theme, registry, q_map, is_pub_q
    if not qres.ok
      give back record {ok: no, status: 400, payload: record {error: qres.error}}
    end
    give back record {ok: yes, status: 200, payload: qres.data}
  end

  if tool_name is "create_entry_draft"
    if not (role_has_capability using sess.role, "entries:create")
      give back record {ok: no, status: 403, payload: record {error: "Forbidden: insufficient capability for create_entry_draft"}}
    end
    if (not (args has "content_type")) or (not (args has "slug")) or (not (args has "title"))
      give back record {ok: no, status: 400, payload: record {error: "Missing required fields: content_type, slug, title"}}
    end
    set ct_slug to normalize_slug using (text.from using (args at "content_type"))
    set ct to data.one using stmts.get_type_by_slug, record {slug: ct_slug}
    if ct is nothing
      give back record {ok: no, status: 404, payload: record {error: "Content type not found"}}
    end
    set slug to normalize_slug using (text.from using (args at "slug"))
    if not (is_valid_entry_slug using slug)
      give back record {ok: no, status: 400, payload: record {error: "Invalid entry slug"}}
    end
    set full_path to compute_full_path using ct.permalink_pattern, slug
    if is_reserved_path using full_path
      give back record {ok: no, status: 400, payload: record {error: "Computed permalink collides with reserved prefix"}}
    end
    set conflict to data.one using stmts.get_entry_by_full_path, record {full_path: full_path}
    if conflict is not nothing
      give back record {ok: no, status: 409, payload: record {error: "Entry already exists at " joined with full_path}}
    end
    set body_html to ""
    if args has "body_html" and (args at "body_html") is not nothing
      set bres to normalize_and_validate_body using (args at "body_html")
      if not bres.ok
        give back record {ok: no, status: 400, payload: record {error: bres.error}}
      end
      set body_html to bres.body_html
    end
    set cf_in to {}
    if args has "custom_fields" and (args at "custom_fields") is not nothing
      set cf_in to args at "custom_fields"
    end
    set cf_res to validate_custom_fields using stmts, ct.id, cf_in
    if not cf_res.ok
      give back record {ok: no, status: 400, payload: record {error: cf_res.error}}
    end
    set meta_t to ""
    if args has "meta_title" and (args at "meta_title") is not nothing
      set meta_t to text.from using (args at "meta_title")
    end
    set meta_d to ""
    if args has "meta_description" and (args at "meta_description") is not nothing
      set meta_d to text.from using (args at "meta_description")
    end
    set term_ids to []
    if args has "term_ids" and (args at "term_ids") is not nothing
      set term_ids to args at "term_ids"
    end
    set now_rec to call dates.now_utc
    set tx to data.begin using stmts.db
    try
      call data.execute using stmts.insert_entry, record {content_type_id: ct.id, slug: slug, full_path: full_path, title: (text.from using (args at "title")), status: "draft", body_html: body_html, custom_fields_json: cf_res.json_text, meta_title: meta_t, meta_description: meta_d, author_id: sess.user_id, published_at: nothing, created_at: now_rec.iso, updated_at: now_rec.iso}, tx
      set created to data.one using stmts.get_entry_by_full_path, record {full_path: full_path}, tx
      if (collections.length using term_ids) is greater than 0
        set tr to sync_entry_terms_tx using stmts, created.id, term_ids, now_rec.iso, tx
        if not tr.ok
          call data.rollback using tx
          give back record {ok: no, status: 400, payload: record {error: tr.error}}
        end
      end
      call data.commit using tx
      call invalidate_route_caches using stmts, full_path, "", ct.slug
      give back record {ok: yes, status: 201, payload: record {entry: created, status_enforced: "draft"}}
    catch tx_err
      call data.rollback using tx
      give back record {ok: no, status: 500, payload: record {error: tx_err.message}}
    end
  end

  if tool_name is "update_entry_layout"
    if not (role_has_capability using sess.role, "entries:update:own")
      give back record {ok: no, status: 403, payload: record {error: "Forbidden: insufficient capability for update_entry_layout"}}
    end
    if (not (args has "entry_id")) or (not (args has "layout"))
      give back record {ok: no, status: 400, payload: record {error: "Missing required fields: entry_id, layout"}}
    end
    set entry_id to text.to_integer using (text.from using (args at "entry_id"))
    set existing to data.one using stmts.get_entry_by_id, record {id: entry_id}
    if existing is nothing
      give back record {ok: no, status: 404, payload: record {error: "Entry not found"}}
    end
    if not (role_has_capability using sess.role, "entries:update:any")
      if existing.author_id is nothing or existing.author_id is not sess.user_id
        give back record {ok: no, status: 403, payload: record {error: "Forbidden: can only update layout of your own entries"}}
      end
    end
    set layout_node to args at "layout"
    set audit_res to audit_grex_tree_walk using stmts, layout_node, 0, "layout", record {violations: [], h1_count: 0, last_heading_level: 0}
    if (collections.length using audit_res.violations) is greater than 0
      give back record {ok: no, status: 422, payload: record {error: "grex_validation_failed", violations: audit_res.violations}}
    end
    set rendered_html to render_validated_grex_html using stmts, layout_node, 0
    set cf_map to {}
    try
      set parsed_cf to json.parse using existing.custom_fields_json
      if parsed_cf is not nothing
        for each cfk in (collections.keys using parsed_cf)
          set cf_map to collections.put using cf_map, cfk, (parsed_cf at cfk)
        end
      end
    catch err
      set cf_map to {}
    end
    set cf_map to collections.put using cf_map, "_grex_layout", layout_node
    set next_cf_json to json.stringify using cf_map
    set now_rec to call dates.now_utc
    call data.execute using stmts.update_entry, record {slug: existing.slug, full_path: existing.full_path, title: existing.title, status: existing.status, body_html: rendered_html, custom_fields_json: next_cf_json, meta_title: existing.meta_title, meta_description: existing.meta_description, published_at: existing.published_at, updated_at: now_rec.iso, id: entry_id}
    set updated to data.one using stmts.get_entry_by_id, record {id: entry_id}
    call invalidate_route_caches using stmts, existing.full_path, "", existing.content_type_slug
    give back record {ok: yes, status: 200, payload: record {entry: updated, body_html: rendered_html, grex_layout_json: layout_node, violations: []}}
  end

  if tool_name is "list_media"
    if not (role_has_capability using sess.role, "media:read")
      give back record {ok: no, status: 403, payload: record {error: "Forbidden: insufficient capability for list_media"}}
    end
    set mime_prefix to ""
    set mime_like to "%"
    if args has "mime_prefix" and (args at "mime_prefix") is not nothing
      set mime_prefix to text.lower using (text.trim using (text.from using (args at "mime_prefix")))
      if mime_prefix is not ""
        set mime_like to mime_prefix joined with "%"
      end
    end
    set lim to 50
    if args has "limit" and (args at "limit") is not nothing
      set lim to math.clamp using (text.to_integer using (text.from using (args at "limit"))), 1, 100
    end
    set off to 0
    if args has "offset" and (args at "offset") is not nothing
      set off to math.max using 0, (text.to_integer using (text.from using (args at "offset")))
    end
    set rows to data.query using stmts.list_media, record {mime_filter: mime_prefix, mime_like: mime_like, limit_rows: lim, offset_rows: off}
    set items to []
    for each r in rows
      set items to collections.append using items, (format_media_record using r)
    end
    give back record {ok: yes, status: 200, payload: record {media: items}}
  end

  if tool_name is "list_menus"
    if not (role_has_capability using sess.role, "admin:access")
      give back record {ok: no, status: 403, payload: record {error: "Forbidden: insufficient capability for list_menus"}}
    end
    set menus_rows to data.query using stmts.list_menus, record {}
    set out to []
    for each m in menus_rows
      set m_items to data.query using stmts.list_menu_items_by_menu, record {menu_id: m.id}
      set tree to build_menu_children using m_items, nothing, 1, yes
      set out to collections.append using out, record {id: m.id, slug: m.slug, name: m.name, location: m.location, items: tree}
    end
    give back record {ok: yes, status: 200, payload: record {menus: out}}
  end

  give back record {ok: no, status: 404, payload: record {error: "Unknown MCP tool: " joined with tool_name}}
end

# ==============================================================================
# Module 7: Pretty Permalink Resolution & 301 Redirect Helper
# ==============================================================================

make build_entries_summary using items
  set parts to []
  for each e in items
    set line to e.title joined with " (" joined with e.full_path joined with ")"
    set parts to collections.append using parts, line
  end
  if (collections.length using parts) is 0
    give back "No published entries yet."
  end
  give back text.join using parts, " | "
end

make render_single_entry using stmts, entry
  set meta_title to entry.meta_title
  if meta_title is ""
    set meta_title to entry.title
  end
  set published_at to ""
  if entry.published_at is not nothing
    set published_at to entry.published_at
  end
  set page_data to {"title": entry.title, "meta_title": meta_title, "meta_description": entry.meta_description, "content_type_label": entry.content_type_label, "full_path": entry.full_path, "published_at": published_at, "body_text": entry.body_html, "custom_fields_summary": entry.custom_fields_json}
  give back render_theme_page using stmts, "single", page_data, 200, []
end

make resolve_public_path using stmts, req_path
  set norm_path to normalize_path using req_path
  if (has_unsafe_path_chars using req_path) or (is_reserved_path using norm_path)
    give back render_theme_page using stmts, "404", {"requested_path": norm_path}, 404, []
  end

  set entry to data.one using stmts.get_published_entry_by_path, record {full_path: norm_path}
  if entry is not nothing
    give back render_single_entry using stmts, entry
  end

  set redir to data.one using stmts.find_redirect_by_old_path, record {old_path: norm_path}
  if redir is not nothing
    give back server.redirect using redir.target_path, 301
  end

  give back render_theme_page using stmts, "404", {"requested_path": norm_path}, 404, []
end

# ==============================================================================
# Reserved System Routes (/setup, /login, /admin, /api, /_health, /_ready)
# ==============================================================================

make get_query_param using req, pname
  if not (has_map_key using req.query, pname)
    give back ""
  end
  give back text.trim using (text.from using (req.query at pname))
end

make is_truthy_val using val
  if val is nothing
    give back no
  end
  if val is yes or val is 1
    give back yes
  end
  set s to text.lower using (text.trim using (text.from using val))
  give back (s is "yes" or s is "true" or s is "1")
end

make require_admin_html using stmts, req, cap
  set cnt_row to data.one using stmts.count_users, record {}
  if cnt_row is nothing or cnt_row.total is 0
    give back record {ok: no, session: nothing, response: (server.redirect using "/setup", 302)}
  end
  set sess to resolve_session using stmts, req
  if sess is nothing
    give back record {ok: no, session: nothing, response: (server.redirect using "/login", 302)}
  end
  if cap is not "" and (not (role_has_capability using sess.role, cap))
    give back record {ok: no, session: nothing, response: (server.text using 403, "Forbidden: insufficient role capability")}
  end
  give back record {ok: yes, session: sess, response: nothing}
end

make activate_theme_by_slug using stmts, raw_slug
  set slug to normalize_slug using raw_slug
  set check_res to validate_theme_manifest using slug
  if not check_res.ok
    give back record {ok: no, status: 400, error: check_res.error, active_theme: nothing, mode: ""}
  end

  set now_rec to call dates.now_utc
  set tx to data.begin using stmts.db
  try
    call upsert_theme_row using stmts, slug, check_res, now_rec.iso, tx
    call data.execute using stmts.deactivate_all_themes, record {}, tx
    call data.execute using stmts.activate_theme_slug, record {slug: slug}, tx
    call upsert_setting using stmts, "active_theme_slug", slug, now_rec.iso, tx
    set active_row to data.one using stmts.get_theme_by_slug, record {slug: slug}, tx
    call data.commit using tx

    call cache.delete using stmts.cms_cache, "active_theme"
    call cache.delete using stmts.cms_cache, "site_settings"
    call cache.delete using stmts.cms_cache, ("grex_doc:" joined with slug)
    call bump_cache_epoch using stmts, "cache_epoch:theme"
    call bump_cache_epoch using stmts, "cache_epoch:query"
    give back record {ok: yes, status: 200, error: "", active_theme: active_row, mode: check_res.mode}
  catch tx_err
    call data.rollback using tx
    give back record {ok: no, status: 500, error: tx_err.message, active_theme: nothing, mode: ""}
  end
end

route "GET" "/setup"
  set cnt_row to data.one using stmts.count_users, record {}
  if cnt_row is not nothing and cnt_row.total is greater than 0
    give back server.redirect using "/login", 302
  end
  set settings to get_site_settings_map using stmts
  set assets to call admin_asset_urls
  set rendered to server.html using "views/admin/setup.grab.html", record {site_title: (settings at "site_title"), tokens_css_url: assets.tokens, admin_css_url: assets.admin_css, grex_js_url: assets.grex, admin_js_url: assets.admin_js}
  give back server.response using record {status: 200, headers: {"Content-Type": "text/html; charset=utf-8", "Cache-Control": "no-store"}, body: rendered.body}
end

route "GET" "/login" using req
  set cnt_row to data.one using stmts.count_users, record {}
  if cnt_row is nothing or cnt_row.total is 0
    give back server.redirect using "/setup", 302
  end
  set sess to resolve_session using stmts, req
  if sess is not nothing and (role_has_capability using sess.role, "admin:access")
    give back server.redirect using "/admin", 302
  end
  set settings to get_site_settings_map using stmts
  set assets to call admin_asset_urls
  set oauth_cfg to get_oauth_providers_config using stmts
  set social_html to render_social_login_buttons using oauth_cfg
  set rendered to server.html using "views/admin/login.grab.html", record {site_title: (settings at "site_title"), tokens_css_url: assets.tokens, admin_css_url: assets.admin_css, grex_js_url: assets.grex, admin_js_url: assets.admin_js}
  set final_html to text.replace using rendered.body, "<!-- @slot:social_login -->", social_html
  give back server.response using record {status: 200, headers: {"Content-Type": "text/html; charset=utf-8", "Cache-Control": "no-store"}, body: final_html}
end

