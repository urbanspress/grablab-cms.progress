set stmt_get_term_by_id to data.prepare using db, "SELECT t.id, t.taxonomy_id, t.parent_id, t.slug, t.name, t.description, t.sort_order, t.created_at, t.updated_at, tx.slug AS taxonomy_slug, tx.archive_slug AS taxonomy_archive_slug, tx.is_hierarchical FROM terms t JOIN taxonomies tx ON tx.id = t.taxonomy_id WHERE t.id = :id", record {params: record {id: "integer"}, columns: record {id: "integer", taxonomy_id: "integer", parent_id: record {type: "integer", nullable: yes}, slug: "text", name: "text", description: "text", sort_order: "integer", created_at: "text", updated_at: "text", taxonomy_slug: "text", taxonomy_archive_slug: "text", is_hierarchical: "integer"}}
set stmt_get_term_by_tax_slug to data.prepare using db, "SELECT t.id, t.taxonomy_id, t.parent_id, t.slug, t.name, t.description, t.sort_order, t.created_at, t.updated_at, tx.slug AS taxonomy_slug, tx.archive_slug AS taxonomy_archive_slug, tx.is_hierarchical FROM terms t JOIN taxonomies tx ON tx.id = t.taxonomy_id WHERE t.taxonomy_id = :taxonomy_id AND t.slug = :slug", record {params: record {taxonomy_id: "integer", slug: "text"}, columns: record {id: "integer", taxonomy_id: "integer", parent_id: record {type: "integer", nullable: yes}, slug: "text", name: "text", description: "text", sort_order: "integer", created_at: "text", updated_at: "text", taxonomy_slug: "text", taxonomy_archive_slug: "text", is_hierarchical: "integer"}}
set stmt_insert_term to data.prepare using db, "INSERT INTO terms (taxonomy_id, parent_id, slug, name, description, sort_order, created_at, updated_at) VALUES (:taxonomy_id, :parent_id, :slug, :name, :description, :sort_order, :created_at, :updated_at)", record {params: record {taxonomy_id: "integer", parent_id: record {type: "integer", nullable: yes}, slug: "text", name: "text", description: "text", sort_order: "integer", created_at: "text", updated_at: "text"}, columns: record {}}
set stmt_update_term to data.prepare using db, "UPDATE terms SET parent_id = :parent_id, slug = :slug, name = :name, description = :description, sort_order = :sort_order, updated_at = :updated_at WHERE id = :id", record {params: record {parent_id: record {type: "integer", nullable: yes}, slug: "text", name: "text", description: "text", sort_order: "integer", updated_at: "text", id: "integer"}, columns: record {}}
set stmt_delete_term to data.prepare using db, "DELETE FROM terms WHERE id = :id", record {params: record {id: "integer"}, columns: record {}}

set stmt_list_entry_terms to data.prepare using db, "SELECT et.entry_id, et.term_id, t.slug AS term_slug, t.name AS term_name, t.parent_id, tx.id AS taxonomy_id, tx.slug AS taxonomy_slug, tx.label_singular AS taxonomy_label, tx.archive_slug AS taxonomy_archive_slug FROM entry_terms et JOIN terms t ON t.id = et.term_id JOIN taxonomies tx ON tx.id = t.taxonomy_id WHERE et.entry_id = :entry_id ORDER BY tx.id ASC, t.sort_order ASC, t.id ASC", record {params: record {entry_id: "integer"}, columns: record {entry_id: "integer", term_id: "integer", term_slug: "text", term_name: "text", parent_id: record {type: "integer", nullable: yes}, taxonomy_id: "integer", taxonomy_slug: "text", taxonomy_label: "text", taxonomy_archive_slug: "text"}}
set stmt_delete_entry_terms_by_entry to data.prepare using db, "DELETE FROM entry_terms WHERE entry_id = :entry_id", record {params: record {entry_id: "integer"}, columns: record {}}
