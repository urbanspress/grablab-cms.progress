# ==============================================================================
# Authentication, Session & OAuth2/PKCE API (/api/auth/*)
# ==============================================================================

route "POST" "/api/auth/setup" using req
  set ip_rl to check_auth_ip_limit using stmts, req
  if not ip_rl.ok
    give back ip_rl.response
  end

  set cnt_row to data.one using stmts.count_users, record {}
  if cnt_row is not nothing and cnt_row.total is greater than 0
    give back server.json using 403, record {error: "Initial setup is already complete"}
  end

  try
    set payload to server.parse_json using req
    if (not (payload has "email")) or (not (payload has "display_name")) or (not (payload has "password"))
      give back server.json using 400, record {error: "Missing required fields: email, display_name, password"}
    end
    set email_norm to normalize_email using (payload at "email")
    if not (is_valid_email using email_norm)
      give back server.json using 400, record {error: "Invalid email address"}
    end
    set display_name to text.trim using (text.from using (payload at "display_name"))
    if display_name is ""
      give back server.json using 400, record {error: "Display name is required"}
    end
    set raw_pw to text.from using (payload at "password")
    if not (is_valid_password using raw_pw)
      give back server.json using 400, record {error: "Password must be 10 to 1024 characters"}
    end

    set pw_hash to crypto.hash_password using raw_pw
    set now_rec to call dates.now_utc
    set created to nothing
    set tx to data.begin using stmts.db
    try
      set recheck to data.one using stmts.count_users, record {}, tx
      if recheck is not nothing and recheck.total is greater than 0
        call data.rollback using tx
        give back server.json using 403, record {error: "Initial setup is already complete"}
      end
      call data.execute using stmts.insert_user, record {email: email_norm, display_name: display_name, role: "admin", password_hash: pw_hash, email_verified: 1, is_active: 1, last_login_at: now_rec.iso, created_at: now_rec.iso, updated_at: now_rec.iso}, tx
      set created to data.one using stmts.get_user, record {lookup: "email", iv: 0, sv: email_norm}, tx
      call data.commit using tx
    catch tx_err
      call data.rollback using tx
      give back server.json using 500, record {error: tx_err.message}
    end

    set sres to create_rotated_session using stmts, req, created.id, ""
    if not sres.ok
      give back server.json using 500, record {error: sres.error}
    end
    set cookie_hdr to build_cookie using "grablab_session", sres.raw_token, "/", 604800, (is_https_req using req)
    set body_json to json.stringify using (record {user: (record {id: created.id, email: created.email, display_name: created.display_name, role: created.role}), csrf_token: sres.csrf_secret, expires_at: sres.expires_at})
    give back server.response using record {status: 201, headers: {"Content-Type": "application/json; charset=utf-8", "Cache-Control": "no-store", "Set-Cookie": cookie_hdr}, body: body_json}
  catch err
    give back server.json using 400, record {error: err.message}
  end
end

route "POST" "/api/auth/login" using req
  set ip_rl to check_auth_ip_limit using stmts, req
  if not ip_rl.ok
    give back ip_rl.response
  end

  try
    set payload to server.parse_json using req
    if (not (payload has "email")) or (not (payload has "password"))
      give back server.json using 400, record {error: "Missing required fields: email, password"}
    end
    set email_norm to normalize_email using (payload at "email")
    set raw_pw to text.from using (payload at "password")
    if email_norm is "" or raw_pw is ""
      give back server.json using 400, record {error: "Email and password are required"}
    end

    set login_rl to check_login_rate_limit using stmts, req, email_norm
    if not login_rl.ok
      give back login_rl.response
    end

    set user to data.one using stmts.get_user, record {lookup: "email", iv: 0, sv: email_norm}
    set valid_pw to no
    if user is not nothing and user.is_active is 1 and user.password_hash is not nothing
      try
        set valid_pw to crypto.verify_password using raw_pw, user.password_hash
      catch v_err
        set valid_pw to no
      end
    end
    if not valid_pw
      set err_json to json.stringify using (record {error: "Invalid email or password"})
      give back server.response using record {status: 401, headers: {"Content-Type": "application/json; charset=utf-8", "Cache-Control": "no-store"}, body: err_json}
    end

    call clear_login_rate_limit using stmts, req, email_norm
    set old_raw to extract_cookie using req, "grablab_session"
    set old_hash to ""
    if old_raw is not ""
      set old_hash to crypto.sha256_hex using old_raw
    end
    set sres to create_rotated_session using stmts, req, user.id, old_hash
    if not sres.ok
      give back server.json using 500, record {error: sres.error}
    end
    call rotate_cart_on_auth using stmts, req, user.id
    set cookie_hdr to build_cookie using "grablab_session", sres.raw_token, "/", 604800, (is_https_req using req)
    set body_json to json.stringify using (record {user: (record {id: user.id, email: user.email, display_name: user.display_name, role: user.role}), csrf_token: sres.csrf_secret, expires_at: sres.expires_at})
    give back server.response using record {status: 200, headers: {"Content-Type": "application/json; charset=utf-8", "Cache-Control": "no-store", "Set-Cookie": cookie_hdr}, body: body_json}
  catch err
    give back server.json using 400, record {error: err.message}
  end
end

route "POST" "/api/auth/logout" using req
  set auth to require_api_auth using stmts, req, "", yes
  if not auth.ok
    give back auth.response
  end
  call data.execute using stmts.delete_sessions, record {lookup: "id", sv: auth.session.session_id, iv: 0}
  call rotate_cart_on_auth using stmts, req, 0
  set cleared to clear_session_cookie using (is_https_req using req)
  give back server.response using record {status: 200, headers: {"Content-Type": "application/json; charset=utf-8", "Cache-Control": "no-store", "Set-Cookie": cleared}, body: (json.stringify using (record {ok: yes}))}
end

route "GET" "/api/auth/session" using req
  set sess to resolve_session using stmts, req
  if sess is nothing
    give back server.response using record {status: 401, headers: {"Content-Type": "application/json; charset=utf-8", "Cache-Control": "no-store"}, body: (json.stringify using (record {authenticated: no}))}
  end
  set body_json to json.stringify using (record {authenticated: yes, user: (record {id: sess.user_id, email: sess.email, display_name: sess.display_name, role: sess.role, email_verified: sess.email_verified}), csrf_token: sess.csrf_secret, expires_at: sess.expires_at})
  give back server.response using record {status: 200, headers: {"Content-Type": "application/json; charset=utf-8", "Cache-Control": "no-store"}, body: body_json}
end

route "POST" "/api/auth/mcp-token" using req
  set auth to require_api_auth using stmts, req, "", yes
  if not auth.ok
    give back auth.response
  end
  set tok_res to create_rotated_session using stmts, req, auth.session.user_id, ""
  if not tok_res.ok
    give back server.json using 500, record {error: tok_res.error}
  end
  give back server.response using record {status: 201, headers: {"Content-Type": "application/json; charset=utf-8", "Cache-Control": "no-store"}, body: (json.stringify using (record {token: tok_res.raw_token, expires_at: tok_res.expires_at, user_id: auth.session.user_id, role: auth.session.role}))}
end

route "GET" "/api/auth/oauth/{provider}/start" using req
  set ip_rl to check_auth_ip_limit using stmts, req
  if not ip_rl.ok
    give back ip_rl.response
  end

  set provider to text.lower using (text.trim using req.params.provider)
  if not (is_supported_oauth_provider using provider)
    give back server.json using 404, record {error: "Unknown OAuth provider"}
  end
  set cfg to get_oauth_providers_config using stmts
  set pcfg to cfg at provider
  if (not (pcfg at "enabled")) or ((pcfg at "client_id") is "") or ((pcfg at "client_secret_enc") is "")
    give back server.json using 404, record {error: "OAuth provider is disabled or unconfigured"}
  end

  set master_key to call get_master_key
  if master_key is ""
    give back server.json using 503, record {error: "GRABLAB_MASTER_KEY environment capability required for OAuth login"}
  end

  set verifier to crypto.random_urlsafe using 48
  set challenge to crypto.sha256_base64url using verifier
  set state_tok to crypto.random_urlsafe using 32
  set tx_id to crypto.random_urlsafe using 24
  set scheme to req.scheme
  if scheme is ""
    set scheme to "http"
  end
  set redir_uri to scheme joined with "://" joined with req.host joined with "/api/auth/oauth/" joined with provider joined with "/callback"

  set tx_payload to json.stringify using (record {provider: provider, code_verifier: verifier, tx_id: tx_id, redirect_uri: redir_uri})
  call cache.set using stmts.cms_cache, ("oauth_state:" joined with state_tok), tx_payload, 300000

  set test_base to call get_oauth_test_base_url
  set endpoints to resolve_provider_endpoints using provider, test_base
  set auth_url to endpoints.authorize_url joined with "?client_id=" joined with (url_encode using (pcfg at "client_id")) joined with "&redirect_uri=" joined with (url_encode using redir_uri) joined with "&response_type=code&scope=" joined with (url_encode using endpoints.scope) joined with "&state=" joined with (url_encode using state_tok) joined with "&code_challenge=" joined with (url_encode using challenge) joined with "&code_challenge_method=S256"

  set tx_cookie to build_cookie using "grablab_oauth_tx", tx_id, "/api/auth/oauth", 300, (is_https_req using req)
  give back server.response using record {status: 302, headers: {"Location": auth_url, "Cache-Control": "no-store", "Set-Cookie": tx_cookie}, body: ""}
end

route "GET" "/api/auth/oauth/{provider}/callback" using req
  set ip_rl to check_auth_ip_limit using stmts, req
  if not ip_rl.ok
    give back ip_rl.response
  end

  set provider to text.lower using (text.trim using req.params.provider)
  if not (is_supported_oauth_provider using provider)
    give back server.json using 404, record {error: "Unknown OAuth provider"}
  end
  set cfg to get_oauth_providers_config using stmts
  set pcfg to cfg at provider
  if (not (pcfg at "enabled")) or ((pcfg at "client_id") is "") or ((pcfg at "client_secret_enc") is "")
    give back server.json using 404, record {error: "OAuth provider is disabled or unconfigured"}
  end

  set err_param to get_query_param using req, "error"
  if err_param is not ""
    give back server.json using 401, record {error: "OAuth authorization failed: " joined with err_param}
  end

  set state_tok to get_query_param using req, "state"
  set code_val to get_query_param using req, "code"
  if state_tok is "" or code_val is ""
    give back server.json using 400, record {error: "Missing state or authorization code"}
  end

  set tx_cookie to extract_cookie using req, "grablab_oauth_tx"
  if tx_cookie is ""
    give back server.json using 403, record {error: "Missing OAuth transaction cookie"}
  end

  set cache_key to "oauth_state:" joined with state_tok
  set tx_cached to cache.get using stmts.cms_cache, cache_key
  if (not tx_cached.found) or tx_cached.value is nothing or (text.from using tx_cached.value) is ""
    give back server.json using 403, record {error: "Invalid or expired OAuth state"}
  end
  call cache.delete using stmts.cms_cache, cache_key

  set tx_rec to json.parse using (text.from using tx_cached.value)
  if (tx_rec at "provider") is not provider or (tx_rec at "tx_id") is not tx_cookie
    give back server.json using 403, record {error: "OAuth state/transaction validation failed"}
  end

  set master_key to call get_master_key
  if master_key is ""
    give back server.json using 503, record {error: "GRABLAB_MASTER_KEY environment capability required"}
  end
  set client_secret to ""
  try
    set client_secret to crypto.decrypt_aead using (pcfg at "client_secret_enc"), master_key
  catch dec_err
    give back server.json using 503, record {error: "Unable to decrypt provider secret with GRABLAB_MASTER_KEY"}
  end

  set test_base to call get_oauth_test_base_url
  set endpoints to resolve_provider_endpoints using provider, test_base
  set redir_uri to text.from using (tx_rec at "redirect_uri")
  set verifier to text.from using (tx_rec at "code_verifier")
  set token_body to "grant_type=authorization_code&code=" joined with (url_encode using code_val) joined with "&redirect_uri=" joined with (url_encode using redir_uri) joined with "&client_id=" joined with (url_encode using (pcfg at "client_id")) joined with "&client_secret=" joined with (url_encode using client_secret) joined with "&code_verifier=" joined with (url_encode using verifier)

  try
    set tok_res to http.post using endpoints.token_url, token_body, record {headers: {"Content-Type": "application/x-www-form-urlencoded", "Accept": "application/json"}, timeout_ms: 5000}
    if not tok_res.ok
      give back server.json using 502, record {error: "OAuth token exchange failed"}
    end
    set tok_json to json.parse using tok_res.body
    if not (has_map_key using tok_json, "access_token")
      give back server.json using 401, record {error: "OAuth provider omitted access_token"}
    end
    set access_token to text.from using (tok_json at "access_token")

    set provider_uid to ""
    set email_raw to ""
    set display_name to ""
    set email_verified to no

    if endpoints.userinfo_url is not ""
      set ures to http.get using endpoints.userinfo_url, record {headers: {"Authorization": ("Bearer " joined with access_token), "Accept": "application/json", "User-Agent": "GrabLab-CMS/1.0.0"}, timeout_ms: 5000}
      if not ures.ok
        give back server.json using 502, record {error: "OAuth profile fetch failed"}
      end
      set ujson to json.parse using ures.body
      if has_map_key using ujson, "sub"
        set provider_uid to text.from using (ujson at "sub")
      end
      if provider_uid is "" and (has_map_key using ujson, "id")
        set provider_uid to text.from using (ujson at "id")
      end
      if (has_map_key using ujson, "email") and (ujson at "email") is not nothing
        set email_raw to text.from using (ujson at "email")
      end
      if has_map_key using ujson, "email_verified"
        set email_verified to is_truthy_val using (ujson at "email_verified")
      end
      if (not email_verified) and (has_map_key using ujson, "verified")
        set email_verified to is_truthy_val using (ujson at "verified")
      end
      if (has_map_key using ujson, "name") and (ujson at "name") is not nothing
        set display_name to text.from using (ujson at "name")
      end
      if display_name is "" and (has_map_key using ujson, "login") and (ujson at "login") is not nothing
        set display_name to text.from using (ujson at "login")
      end
      if display_name is "" and (has_map_key using ujson, "username") and (ujson at "username") is not nothing
        set display_name to text.from using (ujson at "username")
      end
    end

    if (not email_verified or email_raw is "") and provider is "github" and endpoints.emails_url is not ""
      set eres to http.get using endpoints.emails_url, record {headers: {"Authorization": ("Bearer " joined with access_token), "Accept": "application/json", "User-Agent": "GrabLab-CMS/1.0.0"}, timeout_ms: 5000}
      if eres.ok
        set elist to json.parse using eres.body
        for each eitem in elist
          if (has_map_key using eitem, "primary") and (is_truthy_val using (eitem at "primary")) and (has_map_key using eitem, "verified") and (is_truthy_val using (eitem at "verified"))
            set email_raw to text.from using (eitem at "email")
            set email_verified to yes
          end
        end
      end
    end

    set email_norm to normalize_email using email_raw
    if (not email_verified) or (not (is_valid_email using email_norm))
      give back server.json using 403, record {error: "OAuth account must provide a verified email address"}
    end
    if not (email_domain_allowed using email_norm, (pcfg at "allowed_domains"))
      give back server.json using 403, record {error: "Email domain is not permitted for this OAuth provider"}
    end
    if provider_uid is ""
      give back server.json using 502, record {error: "OAuth provider omitted unique user ID"}
    end
    if display_name is ""
      set display_name to email_norm
    end

    set settings to get_site_settings_map using stmts
    set allow_signup to no
    if has_map_key using settings, "oauth_allow_signup"
      set allow_signup to is_truthy_val using (settings at "oauth_allow_signup")
    end
    set resolved to resolve_or_create_oauth_user using stmts, provider, provider_uid, email_norm, display_name, allow_signup
    if not resolved.ok
      give back server.json using 403, record {error: resolved.error}
    end

    set old_raw to extract_cookie using req, "grablab_session"
    set old_hash to ""
    if old_raw is not ""
      set old_hash to crypto.sha256_hex using old_raw
    end
    set sres to create_rotated_session using stmts, req, resolved.user.id, old_hash
    if not sres.ok
      give back server.json using 500, record {error: sres.error}
    end
    set dest to "/admin"
    if not (role_has_capability using resolved.user.role, "admin:access")
      set dest to "/"
    end
    set cookie_hdr to build_cookie using "grablab_session", sres.raw_token, "/", 604800, (is_https_req using req)
    give back server.response using record {status: 302, headers: {"Location": dest, "Cache-Control": "no-store", "Set-Cookie": cookie_hdr}, body: ""}
  catch http_err
    give back server.json using 502, record {error: "OAuth network or verification error: " joined with http_err.message}
  end
end

# ==============================================================================
# Admin Dashboard API (/api/admin/*)
# ==============================================================================

route "GET" "/api/admin/overview" using req
  set auth to require_api_auth using stmts, req, "admin:access", no
  if not auth.ok
    give back auth.response
  end
  set entries to []
  if auth.session.role is "author"
    set entries to data.query using stmts.get_entry_by_id, record {id: (0 minus auth.session.user_id)}
  otherwise
    set entries to data.query using stmts.get_entry_by_id, record {id: 0}
  end
  set types to data.query using stmts.get_type, record {lookup: "all", sv: "", iv: 0}
  set redirects to data.query using stmts.find_redirect_by_old_path, record {old_path: "__ALL__"}
  set theme to get_active_theme_context using stmts
  set recent to collections.slice using entries, 0, (math.min using 8, (collections.length using entries))
  give back server.json using 200, record {entry_count: (collections.length using entries), type_count: (collections.length using types), redirect_count: (collections.length using redirects), active_theme_slug: theme.slug, active_theme_mode: theme.mode, recent_entries: recent}
end

route "GET" "/api/admin/settings" using req
  set auth to require_api_auth using stmts, req, "settings:manage", no
  if not auth.ok
    give back auth.response
  end
  set settings to get_site_settings_map using stmts
  set oauth_cfg to get_oauth_providers_config using stmts
  set allow_signup to no
  if has_map_key using settings, "oauth_allow_signup"
    set allow_signup to is_truthy_val using (settings at "oauth_allow_signup")
  end
  give back server.json using 200, record {general: (record {site_title: (settings at "site_title"), site_tagline: (settings at "site_tagline"), home_entry_id: (settings at "home_entry_id")}), oauth_allow_signup: allow_signup, oauth_providers: (mask_oauth_providers using oauth_cfg)}
end

route "PUT" "/api/admin/settings/general" using req
  set auth to require_api_auth using stmts, req, "settings:manage", yes
  if not auth.ok
    give back auth.response
  end
  try
    set payload to server.parse_json using req
    if not (payload has "site_title")
      give back server.json using 400, record {error: "Missing site_title"}
    end
    set title to text.trim using (text.from using (payload at "site_title"))
    if title is ""
      give back server.json using 400, record {error: "site_title cannot be blank"}
    end
    set tagline to ""
    if payload has "site_tagline" and (payload at "site_tagline") is not nothing
      set tagline to text.from using (payload at "site_tagline")
    end
    set home_id to ""
    if payload has "home_entry_id" and (payload at "home_entry_id") is not nothing
      set raw_hid to text.trim using (text.from using (payload at "home_entry_id"))
      if raw_hid is not ""
        set hid_num to text.to_integer using raw_hid
        set home_id to text.from using hid_num
      end
    end

    set now_rec to call dates.now_utc
    set tx to data.begin using stmts.db
    try
      call upsert_setting using stmts, "site_title", title, now_rec.iso, tx
      call upsert_setting using stmts, "site_tagline", tagline, now_rec.iso, tx
      call upsert_setting using stmts, "home_entry_id", home_id, now_rec.iso, tx
      call data.commit using tx
      call cache.delete using stmts.cms_cache, "site_settings"
      call bump_cache_epoch using stmts, "cache_epoch:theme"
      give back server.json using 200, record {ok: yes, general: (record {site_title: title, site_tagline: tagline, home_entry_id: home_id})}
    catch tx_err
      call data.rollback using tx
      give back server.json using 500, record {error: tx_err.message}
    end
  catch err
    give back server.json using 400, record {error: err.message}
  end
end

route "PUT" "/api/admin/settings/oauth" using req
  set auth to require_api_auth using stmts, req, "settings:manage", yes
  if not auth.ok
    give back auth.response
  end
  try
    set payload to server.parse_json using req
    set current_cfg to get_oauth_providers_config using stmts
    set allow_signup to no
    if payload has "oauth_allow_signup"
      set allow_signup to is_truthy_val using (payload at "oauth_allow_signup")
    end
    set incoming_providers to {}
    if payload has "providers" and (payload at "providers") is not nothing
      set incoming_providers to payload at "providers"
    end

    set master_key to call get_master_key
    set keys to ["google", "github", "discord", "apple"]
    set next_cfg to {}
    for each k in keys
      set prev to current_cfg at k
      set updated to prev
      if has_map_key using incoming_providers, k
        set inc to incoming_providers at k
        set next_enabled to is_truthy_val using (inc at "enabled")
        set next_cid to prev at "client_id"
        if (has_map_key using inc, "client_id") and (inc at "client_id") is not nothing
          set next_cid to text.trim using (text.from using (inc at "client_id"))
        end
        set next_domains to prev at "allowed_domains"
        if (has_map_key using inc, "allowed_domains") and (inc at "allowed_domains") is not nothing
          set next_domains to text.trim using (text.from using (inc at "allowed_domains"))
        end
        set next_sec_enc to prev at "client_secret_enc"
        set next_hint to prev at "secret_hint"
        if (has_map_key using inc, "client_secret") and (inc at "client_secret") is not nothing
          set raw_sec to text.trim using (text.from using (inc at "client_secret"))
          if raw_sec is not ""
            if master_key is ""
              give back server.json using 503, record {error: "GRABLAB_MASTER_KEY environment capability required to encrypt OAuth client secrets"}
            end
            set next_sec_enc to crypto.encrypt_aead using raw_sec, master_key
            set next_hint to build_secret_hint using raw_sec
          end
        end
        if next_enabled and (next_cid is "" or next_sec_enc is "")
          give back server.json using 400, record {error: ("Provider " joined with k joined with " requires client_id and client_secret before enabling")}
        end
        if next_enabled and master_key is ""
          give back server.json using 503, record {error: "GRABLAB_MASTER_KEY environment capability required when OAuth providers are enabled"}
        end
        set updated to {"enabled": next_enabled, "client_id": next_cid, "client_secret_enc": next_sec_enc, "secret_hint": next_hint, "allowed_domains": next_domains}
      end
      set next_cfg to collections.put using next_cfg, k, updated
    end

    set now_rec to call dates.now_utc
    set signup_str to "false"
    if allow_signup
      set signup_str to "true"
    end
    set tx to data.begin using stmts.db
    try
      call upsert_setting using stmts, "oauth_allow_signup", signup_str, now_rec.iso, tx
      call upsert_setting using stmts, "oauth_providers_json", (json.stringify using next_cfg), now_rec.iso, tx
      call data.commit using tx
      call cache.delete using stmts.cms_cache, "site_settings"
      give back server.json using 200, record {ok: yes, oauth_allow_signup: allow_signup, oauth_providers: (mask_oauth_providers using next_cfg)}
    catch tx_err
      call data.rollback using tx
      give back server.json using 500, record {error: tx_err.message}
    end
  catch err
    give back server.json using 400, record {error: err.message}
  end
end

route "GET" "/api/admin/users" using req
  set auth to require_api_auth using stmts, req, "users:manage", no
  if not auth.ok
    give back auth.response
  end
  set raw_users to data.query using stmts.get_user, record {lookup: "all", iv: 0, sv: ""}
  set users to []
  for each u in raw_users
    set users to collections.append using users, record {id: u.id, email: u.email, display_name: u.display_name, role: u.role, email_verified: u.email_verified, is_active: u.is_active, last_login_at: u.last_login_at, created_at: u.created_at, updated_at: u.updated_at}
  end
  give back server.json using 200, record {users: users}
end

route "POST" "/api/admin/users" using req
  set auth to require_api_auth using stmts, req, "users:manage", yes
  if not auth.ok
    give back auth.response
  end
  try
    set payload to server.parse_json using req
    if (not (payload has "email")) or (not (payload has "display_name")) or (not (payload has "role")) or (not (payload has "password"))
      give back server.json using 400, record {error: "Missing required fields: email, display_name, role, password"}
    end
    set email_norm to normalize_email using (payload at "email")
    if not (is_valid_email using email_norm)
      give back server.json using 400, record {error: "Invalid email address"}
    end
    set display_name to text.trim using (text.from using (payload at "display_name"))
    if display_name is ""
      give back server.json using 400, record {error: "Display name is required"}
    end
    set role to text.lower using (text.trim using (text.from using (payload at "role")))
    if not (is_valid_role using role)
      give back server.json using 400, record {error: "Role must be admin, editor, author, or viewer"}
    end
    set raw_pw to text.from using (payload at "password")
    if not (is_valid_password using raw_pw)
      give back server.json using 400, record {error: "Password must be 10 to 1024 characters"}
    end

    set dup to data.one using stmts.get_user, record {lookup: "email", iv: 0, sv: email_norm}
    if dup is not nothing
      give back server.json using 409, record {error: "User email already exists"}
    end

    set pw_hash to crypto.hash_password using raw_pw
    set now_rec to call dates.now_utc
    set created to nothing
    set tx to data.begin using stmts.db
    try
      call data.execute using stmts.insert_user, record {email: email_norm, display_name: display_name, role: role, password_hash: pw_hash, email_verified: 1, is_active: 1, last_login_at: nothing, created_at: now_rec.iso, updated_at: now_rec.iso}, tx
      set created to data.one using stmts.get_user, record {lookup: "email", iv: 0, sv: email_norm}, tx
      call data.commit using tx
      give back server.json using 201, record {user: (record {id: created.id, email: created.email, display_name: created.display_name, role: created.role, email_verified: created.email_verified, is_active: created.is_active, created_at: created.created_at})}
    catch tx_err
      call data.rollback using tx
      give back server.json using 500, record {error: tx_err.message}
    end
  catch err
    give back server.json using 400, record {error: err.message}
  end
end

route "PATCH" "/api/admin/users/{id}" using req
  set auth to require_api_auth using stmts, req, "users:manage", yes
  if not auth.ok
    give back auth.response
  end
  try
    set target_id to text.to_integer using req.params.id
    set target to data.one using stmts.get_user, record {lookup: "id", iv: target_id, sv: ""}
    if target is nothing
      give back server.json using 404, record {error: "User not found"}
    end
    set payload to server.parse_json using req
    set next_name to target.display_name
    if payload has "display_name" and (payload at "display_name") is not nothing
      set next_name to text.trim using (text.from using (payload at "display_name"))
    end
    set next_role to target.role
    if payload has "role" and (payload at "role") is not nothing
      set next_role to text.lower using (text.trim using (text.from using (payload at "role")))
      if not (is_valid_role using next_role)
        give back server.json using 400, record {error: "Invalid role"}
      end
    end
    set next_active to target.is_active
    if payload has "is_active" and (payload at "is_active") is not nothing
      if is_truthy_val using (payload at "is_active")
        set next_active to 1
      otherwise
        set next_active to 0
      end
    end
    set next_verified to target.email_verified
    if payload has "email_verified" and (payload at "email_verified") is not nothing
      if is_truthy_val using (payload at "email_verified")
        set next_verified to 1
      otherwise
        set next_verified to 0
      end
    end
    if target.id is auth.session.user_id and (next_active is 0 or next_role is not "admin")
      give back server.json using 400, record {error: "Cannot demote or deactivate your own active admin account"}
    end

    set now_rec to call dates.now_utc
    set tx to data.begin using stmts.db
    try
      call data.execute using stmts.update_user, record {display_name: next_name, role: next_role, is_active: next_active, email_verified: next_verified, last_login_at: nothing, updated_at: now_rec.iso, id: target.id}, tx
      if (next_role is not target.role) or (next_active is 0)
        call data.execute using stmts.delete_sessions, record {lookup: "user", sv: "", iv: target.id}, tx
      end
      call data.commit using tx
      give back server.json using 200, record {user: (record {id: target.id, email: target.email, display_name: next_name, role: next_role, is_active: next_active, email_verified: next_verified})}
    catch tx_err
      call data.rollback using tx
      give back server.json using 500, record {error: tx_err.message}
    end
  catch err
    give back server.json using 400, record {error: err.message}
  end
end

route "POST" "/api/admin/themes/activate" using req
  set auth to require_api_auth using stmts, req, "themes:manage", yes
  if not auth.ok
    give back auth.response
  end
  try
    set payload to server.parse_json using req
    if not (payload has "slug")
      give back server.json using 400, record {error: "Missing theme slug"}
    end
    set res to activate_theme_by_slug using stmts, (text.from using (payload at "slug"))
    if not res.ok
      give back server.json using res.status, record {error: res.error}
    end
    give back server.json using 200, record {active_theme: res.active_theme, mode: res.mode}
  catch err
    give back server.json using 400, record {error: err.message}
  end
end

# ==============================================================================
# Content Type & Custom Field Registry API (/api/content-types)
# ==============================================================================

route "GET" "/api/content-types"
  set types to data.query using stmts.get_type, record {lookup: "all", sv: "", iv: 0}
  set enriched to []
  for each ct in types
    set fields to data.query using stmts.get_field_by_key, record {content_type_id: ct.id, field_key: ""}
    set enriched to collections.append using enriched, record {id: ct.id, slug: ct.slug, label_singular: ct.label_singular, label_plural: ct.label_plural, permalink_pattern: ct.permalink_pattern, has_archive: ct.has_archive, archive_slug: ct.archive_slug, is_system: ct.is_system, fields: fields}
  end
  give back server.json using 200, record {content_types: enriched}
end

route "POST" "/api/content-types" using req
  set auth to require_api_auth using stmts, req, "types:manage", yes
  if not auth.ok
    give back auth.response
  end
  try
    set payload to server.parse_json using req
    if (not (payload has "slug")) or (not (payload has "label_singular")) or (not (payload has "label_plural")) or (not (payload has "permalink_pattern"))
      give back server.json using 400, record {error: "Missing required fields: slug, label_singular, label_plural, permalink_pattern"}
    end

    set slug to normalize_slug using (text.from using (payload at "slug"))
    if not (is_valid_slug using slug)
      give back server.json using 400, record {error: "Invalid content type slug"}
    end

    set pattern to text.lower using (text.trim using (text.from using (payload at "permalink_pattern")))
    if (not (text.starts_with using pattern, "/")) or (not (text.contains using pattern, ":slug")) or (has_unsafe_path_chars using pattern)
      give back server.json using 400, record {error: "permalink_pattern must start with '/' and contain ':slug'"}
    end
    set test_sample to compute_full_path using pattern, "sample"
    if is_reserved_path using test_sample
      give back server.json using 400, record {error: "permalink_pattern collides with a reserved system prefix"}
    end

    set has_archive to 1
    if payload has "has_archive"
      set ha_val to text.lower using (text.from using (payload at "has_archive"))
      if ha_val is "no" or ha_val is "false" or ha_val is "0"
        set has_archive to 0
      end
    end

    set archive_slug to nothing
    if has_archive is 1
      if payload has "archive_slug" and (payload at "archive_slug") is not nothing
        set archive_slug to normalize_slug using (text.from using (payload at "archive_slug"))
      otherwise
        set archive_slug to slug
      end
      if not (is_valid_slug using archive_slug)
        give back server.json using 400, record {error: "Invalid archive_slug"}
      end
      if is_reserved_path using ("/" joined with archive_slug)
        give back server.json using 400, record {error: "archive_slug collides with a reserved system prefix"}
      end
      set archive_clash to data.one using stmts.get_type, record {lookup: "archive", sv: archive_slug, iv: 0}
      if archive_clash is not nothing
        give back server.json using 409, record {error: "archive_slug is already used by another content type"}
      end
      set tax_clash to data.one using stmts.get_taxonomy, record {lookup: "archive", iv: 0, sv: archive_slug}
      if tax_clash is not nothing
        give back server.json using 409, record {error: "archive_slug collides with an existing taxonomy"}
      end
    end

    set existing to data.one using stmts.get_type, record {lookup: "slug", sv: slug, iv: 0}
    if existing is not nothing
      give back server.json using 409, record {error: "Content type slug already exists"}
    end

    set now_rec to call dates.now_utc
    set tx to data.begin using stmts.db
    try
      call data.execute using stmts.insert_type, record {slug: slug, label_singular: (text.from using (payload at "label_singular")), label_plural: (text.from using (payload at "label_plural")), permalink_pattern: pattern, has_archive: has_archive, archive_slug: archive_slug, is_system: 0, created_at: now_rec.iso}, tx
      set created to data.one using stmts.get_type, record {lookup: "slug", sv: slug, iv: 0}, tx
      call data.commit using tx
      call bump_query_cache_epochs using stmts, slug
      give back server.json using 201, record {content_type: created}
    catch tx_err
      call data.rollback using tx
      give back server.json using 500, record {error: tx_err.message}
    end
  catch err
    give back server.json using 400, record {error: err.message}
  end
end

route "POST" "/api/content-types/{slug}/fields" using req
  set auth to require_api_auth using stmts, req, "types:manage", yes
  if not auth.ok
    give back auth.response
  end
  try
    set ct_slug to normalize_slug using req.params.slug
    set ct to data.one using stmts.get_type, record {lookup: "slug", sv: ct_slug, iv: 0}
    if ct is nothing
      give back server.json using 404, record {error: "Content type not found"}
    end

    set payload to server.parse_json using req
    if (not (payload has "field_key")) or (not (payload has "label")) or (not (payload has "field_type"))
      give back server.json using 400, record {error: "Missing required fields: field_key, label, field_type"}
    end

    set fkey to normalize_slug using (text.from using (payload at "field_key"))
    if not (is_valid_field_key using fkey)
      give back server.json using 400, record {error: "Invalid field_key"}
    end

    set ftype to text.lower using (text.trim using (text.from using (payload at "field_type")))
    if not (is_valid_field_type using ftype)
      give back server.json using 400, record {error: "Unsupported field_type"}
    end

    set is_req to 0
    if payload has "is_required"
      set req_str to text.lower using (text.from using (payload at "is_required"))
      if req_str is "yes" or req_str is "true" or req_str is "1"
        set is_req to 1
      end
    end

    set def_val to nothing
    if payload has "default_value" and (payload at "default_value") is not nothing
      set def_check to validate_single_field_value using ftype, (payload at "default_value")
      if not def_check.ok
        give back server.json using 400, record {error: "Invalid default_value: " joined with def_check.error}
      end
      set def_val to text.from using (payload at "default_value")
    end

    set sort_order to 0
    if payload has "sort_order"
      set sort_order to text.to_integer using (text.from using (payload at "sort_order"))
    end

    set dup to data.one using stmts.get_field_by_key, record {content_type_id: ct.id, field_key: fkey}
    if dup is not nothing
      give back server.json using 409, record {error: "Field key already exists on content type"}
    end

    set tx to data.begin using stmts.db
    try
      call data.execute using stmts.insert_field, record {content_type_id: ct.id, field_key: fkey, label: (text.from using (payload at "label")), field_type: ftype, is_required: is_req, default_value: def_val, sort_order: sort_order}, tx
      set created to data.one using stmts.get_field_by_key, record {content_type_id: ct.id, field_key: fkey}, tx
      call data.commit using tx
      call bump_query_cache_epochs using stmts, ct.slug
      give back server.json using 201, record {field: created}
    catch tx_err
      call data.rollback using tx
      give back server.json using 500, record {error: tx_err.message}
    end
  catch err
    give back server.json using 400, record {error: err.message}
  end
end

# ==============================================================================
# Entry Store, Slug History & Hook Integration API (/api/entries, /api/redirects)
# ==============================================================================

route "GET" "/api/entries" using req
  set auth to require_api_auth using stmts, req, "entries:read", no
  if not auth.ok
    give back auth.response
  end
  set rows to []
  if auth.session.role is "author"
    set rows to data.query using stmts.get_entry_by_id, record {id: (0 minus auth.session.user_id)}
  otherwise
    set rows to data.query using stmts.get_entry_by_id, record {id: 0}
  end
  give back server.json using 200, record {entries: rows}
end

route "POST" "/api/entries" using req
  set auth to require_api_auth using stmts, req, "entries:create", yes
  if not auth.ok
    give back auth.response
  end
  try
    set payload to server.parse_json using req
    if (not (payload has "content_type")) or (not (payload has "slug")) or (not (payload has "title"))
      give back server.json using 400, record {error: "Missing required fields: content_type, slug, title"}
    end

    set ct_slug to normalize_slug using (text.from using (payload at "content_type"))
    set ct to data.one using stmts.get_type, record {lookup: "slug", sv: ct_slug, iv: 0}
    if ct is nothing
      give back server.json using 404, record {error: "Content type not found"}
    end

    set slug to normalize_slug using (text.from using (payload at "slug"))
    if not (is_valid_entry_slug using slug)
      give back server.json using 400, record {error: "Invalid entry slug"}
    end

    set full_path to compute_full_path using ct.permalink_pattern, slug
    if is_reserved_path using full_path
      give back server.json using 400, record {error: "Computed permalink collides with a reserved system prefix"}
    end

    set conflict to data.one using stmts.get_entry_by_full_path, record {full_path: full_path}
    if conflict is not nothing
      give back server.json using 409, record {error: "An entry already exists at " joined with full_path}
    end

    set status to "draft"
    if payload has "status"
      set status to text.lower using (text.trim using (text.from using (payload at "status")))
    end
    if status is not "draft" and status is not "published" and status is not "archived"
      give back server.json using 400, record {error: "Status must be draft, published, or archived"}
    end
    if status is "published" and (not (role_has_capability using auth.session.role, "entries:publish"))
      give back server.json using 403, record {error: "Forbidden: insufficient capability to publish entries"}
    end

    set body_html to ""
    if payload has "body_html" and (payload at "body_html") is not nothing
      set body_res to normalize_and_validate_body using (payload at "body_html")
      if not body_res.ok
        give back server.json using 400, record {error: body_res.error}
      end
      set body_html to body_res.body_html
    end

    set cf_input to {}
    if payload has "custom_fields" and (payload at "custom_fields") is not nothing
      set cf_input to payload at "custom_fields"
    end
    set cf_res to validate_custom_fields using stmts, ct.id, cf_input
    if not cf_res.ok
      give back server.json using 400, record {error: cf_res.error}
    end

    set meta_title to ""
    if payload has "meta_title" and (payload at "meta_title") is not nothing
      set meta_title to text.from using (payload at "meta_title")
    end
    set meta_desc to ""
    if payload has "meta_description" and (payload at "meta_description") is not nothing
      set meta_desc to text.from using (payload at "meta_description")
    end

    set active_theme to get_active_theme_context using stmts
    set registry to build_active_hook_registry using active_theme
    set draft_map to {"title": (text.from using (payload at "title")), "body_html": body_html, "meta_title": meta_title, "meta_description": meta_desc}
    set filtered_draft to applyFilter using registry, "content:before_save", draft_map, {"theme_slug": active_theme.slug, "theme_name": active_theme.name, "content_type": ct.slug}

    set now_rec to call dates.now_utc
    set pub_at to nothing
    if status is "published"
      set pub_at to now_rec.iso
    end

    set tx to data.begin using stmts.db
    try
      if status is "published"
        call data.execute using stmts.delete_redirect, record {lookup: "old_path", sv: full_path, iv: 0}, tx
      end
      call data.execute using stmts.insert_entry, record {content_type_id: ct.id, slug: slug, full_path: full_path, title: (filtered_draft at "title"), status: status, body_html: (filtered_draft at "body_html"), custom_fields_json: cf_res.json_text, meta_title: (filtered_draft at "meta_title"), meta_description: (filtered_draft at "meta_description"), author_id: auth.session.user_id, published_at: pub_at, created_at: now_rec.iso, updated_at: now_rec.iso}, tx
      set created to data.one using stmts.get_entry_by_full_path, record {full_path: full_path}, tx
      if payload has "term_ids" and (payload at "term_ids") is not nothing
        set tr to sync_entry_terms_tx using stmts, created.id, (payload at "term_ids"), now_rec.iso, tx
        if not tr.ok
          call data.rollback using tx
          give back server.json using 400, record {error: tr.error}
        end
      end
      call data.commit using tx
      if status is "published"
        call runHook using stmts, registry, "content:after_publish", {"full_path": full_path, "old_path": "", "content_type_slug": ct.slug, "entry_id": created.id}
      otherwise
        call invalidate_route_caches using stmts, full_path, "", ct.slug
      end
      give back server.json using 201, record {entry: created}
    catch tx_err
      call data.rollback using tx
      give back server.json using 500, record {error: tx_err.message}
    end
  catch err
    give back server.json using 400, record {error: err.message}
  end
end

route "PUT" "/api/entries/{id}" using req
  set auth to require_api_auth using stmts, req, "entries:update:own", yes
  if not auth.ok
    give back auth.response
  end
  try
    set entry_id to text.to_integer using req.params.id
    set existing to data.one using stmts.get_entry_by_id, record {id: entry_id}
    if existing is nothing
      give back server.json using 404, record {error: "Entry not found"}
    end
    if not (role_has_capability using auth.session.role, "entries:update:any")
      if existing.author_id is nothing or existing.author_id is not auth.session.user_id
        give back server.json using 403, record {error: "Forbidden: can only edit your own entries"}
      end
    end

    set ct to data.one using stmts.get_type, record {lookup: "id", sv: "", iv: existing.content_type_id}
    set payload to server.parse_json using req

    set new_slug to existing.slug
    if payload has "slug" and (payload at "slug") is not nothing
      set new_slug to normalize_slug using (text.from using (payload at "slug"))
    end
    if not (is_valid_entry_slug using new_slug)
      give back server.json using 400, record {error: "Invalid entry slug"}
    end

    set new_full_path to compute_full_path using ct.permalink_pattern, new_slug
    if is_reserved_path using new_full_path
      give back server.json using 400, record {error: "Computed permalink collides with a reserved system prefix"}
    end

    set collision to data.one using stmts.get_entry_by_full_path, record {full_path: new_full_path}
    if collision is not nothing and collision.id is not entry_id
      give back server.json using 409, record {error: "Another entry already owns " joined with new_full_path}
    end

    set new_title to existing.title
    if payload has "title" and (payload at "title") is not nothing
      set new_title to text.from using (payload at "title")
    end

    set new_status to existing.status
    if payload has "status" and (payload at "status") is not nothing
      set new_status to text.lower using (text.trim using (text.from using (payload at "status")))
    end
    if new_status is not "draft" and new_status is not "published" and new_status is not "archived"
      give back server.json using 400, record {error: "Status must be draft, published, or archived"}
    end
    if new_status is "published" and (not (role_has_capability using auth.session.role, "entries:publish"))
      give back server.json using 403, record {error: "Forbidden: insufficient capability to publish entries"}
    end

    set new_body to existing.body_html
    if payload has "body_html" and (payload at "body_html") is not nothing
      set body_res to normalize_and_validate_body using (payload at "body_html")
      if not body_res.ok
        give back server.json using 400, record {error: body_res.error}
      end
      set new_body to body_res.body_html
    end

    set new_cf_json to existing.custom_fields_json
    if payload has "custom_fields" and (payload at "custom_fields") is not nothing
      set cf_res to validate_custom_fields using stmts, ct.id, (payload at "custom_fields")
      if not cf_res.ok
        give back server.json using 400, record {error: cf_res.error}
      end
      set new_cf_json to cf_res.json_text
    end

    set new_meta_title to existing.meta_title
    if payload has "meta_title" and (payload at "meta_title") is not nothing
      set new_meta_title to text.from using (payload at "meta_title")
    end

    set new_meta_desc to existing.meta_description
    if payload has "meta_description" and (payload at "meta_description") is not nothing
      set new_meta_desc to text.from using (payload at "meta_description")
    end

    set active_theme to get_active_theme_context using stmts
    set registry to build_active_hook_registry using active_theme
    set draft_map to {"title": new_title, "body_html": new_body, "meta_title": new_meta_title, "meta_description": new_meta_desc}
    set filtered_draft to applyFilter using registry, "content:before_save", draft_map, {"theme_slug": active_theme.slug, "theme_name": active_theme.name, "content_type": ct.slug}

    set now_rec to call dates.now_utc
    set new_pub_at to existing.published_at
    if new_status is "published" and new_pub_at is nothing
      set new_pub_at to now_rec.iso
    end

    set tx to data.begin using stmts.db
    try
      call data.execute using stmts.delete_redirect, record {lookup: "old_path", sv: new_full_path, iv: 0}, tx
      if (new_full_path is not existing.full_path) and (existing.status is "published") and (new_status is "published")
        call data.execute using stmts.delete_redirect, record {lookup: "old_path", sv: existing.full_path, iv: 0}, tx
        call data.execute using stmts.insert_redirect, record {old_path: existing.full_path, entry_id: entry_id, created_at: now_rec.iso}, tx
      end
      call data.execute using stmts.update_entry, record {slug: new_slug, full_path: new_full_path, title: (filtered_draft at "title"), status: new_status, body_html: (filtered_draft at "body_html"), custom_fields_json: new_cf_json, meta_title: (filtered_draft at "meta_title"), meta_description: (filtered_draft at "meta_description"), published_at: new_pub_at, updated_at: now_rec.iso, id: entry_id}, tx
      if payload has "term_ids" and (payload at "term_ids") is not nothing
        set tr to sync_entry_terms_tx using stmts, entry_id, (payload at "term_ids"), now_rec.iso, tx
        if not tr.ok
          call data.rollback using tx
          give back server.json using 400, record {error: tr.error}
        end
      end
      set updated to data.one using stmts.get_entry_by_id, record {id: entry_id}, tx
      call data.commit using tx
      if new_status is "published" or existing.status is "published"
        call runHook using stmts, registry, "content:after_publish", {"full_path": new_full_path, "old_path": existing.full_path, "content_type_slug": ct.slug, "entry_id": entry_id}
      otherwise
        call invalidate_route_caches using stmts, existing.full_path, new_full_path, ct.slug
      end
      if stmts.commerce_ready and ct.slug is "product"
        set cp to data.one using stmts.commerce.products, record {mode: "entry", iv: entry_id, sv: ""}
        if cp is not nothing
          call invalidate_commerce_caches using stmts, cp.id
        otherwise
          call invalidate_commerce_caches using stmts, 0
        end
      end
      if stmts.author_ready and (ct.slug is "book" or ct.slug is "series" or ct.slug is "author" or ct.slug is "chapter")
        call invalidate_author_caches using stmts, 0, 0, 0, 0
      end
      give back server.json using 200, record {entry: updated}
    catch tx_err
      call data.rollback using tx
      give back server.json using 500, record {error: tx_err.message}
    end
  catch err
    give back server.json using 400, record {error: err.message}
  end
end

route "DELETE" "/api/entries/{id}" using req
  set auth to require_api_auth using stmts, req, "entries:delete:own", yes
  if not auth.ok
    give back auth.response
  end
  try
    set entry_id to text.to_integer using req.params.id
    set existing to data.one using stmts.get_entry_by_id, record {id: entry_id}
    if existing is nothing
      give back server.json using 404, record {error: "Entry not found"}
    end
    if not (role_has_capability using auth.session.role, "entries:delete:any")
      if existing.author_id is nothing or existing.author_id is not auth.session.user_id
        give back server.json using 403, record {error: "Forbidden: can only delete your own entries"}
      end
    end
    set tx to data.begin using stmts.db
    try
      call data.execute using stmts.delete_redirect, record {lookup: "entry_id", sv: "", iv: entry_id}, tx
      call data.execute using stmts.delete_entry_by_id, record {id: entry_id}, tx
      call data.commit using tx
      call invalidate_route_caches using stmts, existing.full_path, "", existing.content_type_slug
      if stmts.commerce_ready and existing.content_type_slug is "product"
        call invalidate_commerce_caches using stmts, 0
      end
      if stmts.author_ready and (existing.content_type_slug is "book" or existing.content_type_slug is "series" or existing.content_type_slug is "author" or existing.content_type_slug is "chapter")
        call invalidate_author_caches using stmts, 0, 0, 0, 0
      end
      give back server.json using 200, record {deleted: yes, id: entry_id}
    catch tx_err
      call data.rollback using tx
      give back server.json using 500, record {error: tx_err.message}
    end
  catch err
    give back server.json using 400, record {error: err.message}
  end
end

route "GET" "/api/redirects" using req
  set auth to require_api_auth using stmts, req, "entries:read", no
  if not auth.ok
    give back auth.response
  end
  set rows to data.query using stmts.find_redirect_by_old_path, record {old_path: "__ALL__"}
  give back server.json using 200, record {redirects: rows}
end

# ==============================================================================
# Exclusive Theme Manager, Package Validation, Hooks & Query API
# ==============================================================================

route "GET" "/api/themes"
  set rows to data.query using stmts.get_theme, record {lookup: "all", sv: ""}
  set active to get_active_theme_context using stmts
  give back server.json using 200, record {active_theme_slug: active.slug, active_theme_mode: active.mode, themes: rows}
end

route "POST" "/api/themes/validate-package" using req
  set auth to require_api_auth using stmts, req, "themes:manage", yes
  if not auth.ok
    give back auth.response
  end
  try
    set payload to server.parse_json using req
    set res to validate_theme_package_bundle using payload
    if not res.ok
      give back server.json using 400, record {ok: no, error: res.error}
    end
    give back server.json using 200, record {ok: yes, slug: res.slug, mode: res.mode, file_count: res.file_count, total_bytes: res.total_bytes}
  catch err
    give back server.json using 400, record {ok: no, error: err.message}
  end
end

route "POST" "/api/themes/register" using req
  set auth to require_api_auth using stmts, req, "themes:manage", yes
  if not auth.ok
    give back auth.response
  end
  try
    set payload to server.parse_json using req
    if not (payload has "slug")
      give back server.json using 400, record {error: "Missing theme slug"}
    end
    set slug to normalize_slug using (text.from using (payload at "slug"))
    set check_res to validate_theme_manifest using slug
    if not check_res.ok
      give back server.json using 400, record {error: check_res.error}
    end

    set now_rec to call dates.now_utc
    set tx to data.begin using stmts.db
    try
      call upsert_theme_row using stmts, slug, check_res, now_rec.iso, tx
      set row to data.one using stmts.get_theme, record {lookup: "slug", sv: slug}, tx
      call data.commit using tx
      give back server.json using 200, record {theme: row}
    catch tx_err
      call data.rollback using tx
      give back server.json using 500, record {error: tx_err.message}
    end
  catch err
    give back server.json using 400, record {error: err.message}
  end
end

route "POST" "/api/themes/activate" using req
  set auth to require_api_auth using stmts, req, "themes:manage", yes
  if not auth.ok
    give back auth.response
  end
  try
    set payload to server.parse_json using req
    if not (payload has "slug")
      give back server.json using 400, record {error: "Missing theme slug"}
    end
    set res to activate_theme_by_slug using stmts, (text.from using (payload at "slug"))
    if not res.ok
      give back server.json using res.status, record {error: res.error}
    end
    give back server.json using 200, record {active_theme: res.active_theme, mode: res.mode}
  catch err
    give back server.json using 400, record {error: err.message}
  end
end

route "GET" "/api/hooks"
  set theme to get_active_theme_context using stmts
  set reg to build_active_hook_registry using theme
  give back server.json using 200, record {active_theme_slug: theme.slug, hooks: reg.hooks, filters: reg.filters}
end

route "POST" "/api/hooks/register-check" using req
  set auth to require_api_auth using stmts, req, "themes:manage", yes
  if not auth.ok
    give back auth.response
  end
  try
    set payload to server.parse_json using req
    set theme to get_active_theme_context using stmts
    set reg to create_hook_registry using theme.slug
    if not (payload has "registrations")
      give back server.json using 400, record {error: "Missing registrations array"}
    end
    set items to payload at "registrations"
    for each item in items
      set kind to text.from using (item at "kind")
      set name to text.from using (item at "name")
      set src to text.from using (item at "source")
      set prio to text.to_integer using (text.from using (item at "priority"))
      set handler to text.from using (item at "handler")
      if kind is "hook"
        set res to registerHook using reg, name, src, prio, handler
        if not res.ok
          give back server.json using 403, record {error: res.error}
        end
        set reg to res.registry
      otherwise
        set res to registerFilter using reg, name, src, prio, handler
        if not res.ok
          give back server.json using 403, record {error: res.error}
        end
        set reg to res.registry
      end
    end
    give back server.json using 200, record {ok: yes, hooks: reg.hooks, filters: reg.filters}
  catch err
    give back server.json using 400, record {error: err.message}
  end
end

route "GET" "/api/query" using req
  set theme to get_active_theme_context using stmts
  set registry to build_active_hook_registry using theme
  set qres to query_entries using stmts, theme, registry, req.query, yes
  if not qres.ok
    give back server.json using 400, record {error: qres.error}
  end
  give back server.json using 200, qres.data
end

# ==============================================================================
# Media Library API (/api/admin/media/*, /api/media/upload) & Public /media/*
# ==============================================================================

make handle_media_upload using stmts, req, auth
  try
    set payload to server.parse_json using req
    set raw_name to ""
    if payload has "original_name" and (payload at "original_name") is not nothing
      set raw_name to text.from using (payload at "original_name")
    otherwise
      if payload has "filename" and (payload at "filename") is not nothing
        set raw_name to text.from using (payload at "filename")
      end
    end
    set name_res to sanitize_media_filename using raw_name
    if not name_res.ok
      give back server.json using 400, record {error: "invalid_filename", message: name_res.error}
    end

    if (not (payload has "data_base64")) or (payload at "data_base64") is nothing
      give back server.json using 400, record {error: "data_base64 is required"}
    end
    set clean_b64 to strip_data_uri_and_ws using (text.from using (payload at "data_base64"))
    set b64_chars_len to text.length using clean_b64
    if b64_chars_len is less than 4 or ((b64_chars_len modulo 4) is not 0)
      give back server.json using 400, record {error: "Invalid base64 payload"}
    end

    set approx_bytes to (math.floor using (b64_chars_len divided by 4)) times 3
    set max_bytes to call get_max_upload_bytes
    if approx_bytes is greater than (max_bytes plus 3)
      give back server.json using 413, record {error: "payload_too_large", max_bytes: max_bytes}
    end

    set dec_res to validate_and_decode_b64_prefix using clean_b64, 16384
    if not dec_res.ok
      give back server.json using 400, record {error: dec_res.error}
    end
    if dec_res.byte_size is greater than max_bytes
      give back server.json using 413, record {error: "payload_too_large", max_bytes: max_bytes, byte_size: dec_res.byte_size}
    end

    set sniff_res to sniff_media_magic using dec_res.bytes
    if not sniff_res.ok
      give back server.json using 415, record {error: "unsupported_media_type", message: sniff_res.error}
    end

    set declared_mime to ""
    if payload has "mime_type" and (payload at "mime_type") is not nothing
      set declared_mime to text.from using (payload at "mime_type")
    end
    if (not (ext_matches_mime using name_res.ext, sniff_res.mime)) or (not (declared_mime_matches using declared_mime, sniff_res.mime))
      give back server.json using 415, record {error: "mime_mismatch", message: "Declared MIME type or extension does not match sniffed file signature"}
    end

    set dim_res to parse_raster_dimensions using sniff_res.mime, dec_res.bytes
    if not dim_res.ok
      give back server.json using 400, record {error: "corrupt_image", message: dim_res.error}
    end

    set alt_text to ""
    if payload has "alt_text" and (payload at "alt_text") is not nothing
      set alt_text to text.trim using (text.from using (payload at "alt_text"))
    end
    set is_dec to 0
    if payload has "is_decorative" and (is_truthy_val using (payload at "is_decorative"))
      set is_dec to 1
    end
    if (text.starts_with using sniff_res.mime, "image/") and alt_text is "" and is_dec is 0
      give back server.json using 422, record {error: "alt_text_required", message: "Image uploads require non-empty alt_text or explicit is_decorative: true"}
    end
    if is_dec is 1 and alt_text is ""
      set alt_text to ""
    end

    set caption to ""
    if payload has "caption" and (payload at "caption") is not nothing
      set caption to text.trim using (text.from using (payload at "caption"))
    end

    set upload_dir to call get_upload_dir
    if upload_dir is "" or (not (files.exists using upload_dir))
      give back server.json using 503, record {error: "Upload directory is not available or unconfigured"}
    end

    set rand_hex to crypto.random_hex using 16
    set safe_filename to rand_hex joined with "." joined with sniff_res.ext
    set storage_path to safe_filename joined with ".b64"
    set dest_path to upload_dir joined with "/" joined with storage_path
    set sha_hex to crypto.sha256_hex using clean_b64

    try
      call files.write_text using dest_path, clean_b64
    catch w_err
      give back server.json using 503, record {error: "Unable to write upload inside isolated upload directory"}
    end

    set now_rec to call dates.now_utc
    set tx to data.begin using stmts.db
    try
      call data.execute using stmts.insert_media, record {filename: safe_filename, original_name: name_res.name, storage_path: storage_path, mime_type: sniff_res.mime, byte_size: dec_res.byte_size, width: dim_res.width, height: dim_res.height, alt_text: alt_text, is_decorative: is_dec, caption: caption, sha256_hex: sha_hex, uploader_id: auth.session.user_id, created_at: now_rec.iso, updated_at: now_rec.iso}, tx
      set created to data.one using stmts.get_media, record {lookup: "filename", iv: 0, sv: safe_filename}, tx
      call data.commit using tx
      give back server.json using 201, record {media: (format_media_record using created)}
    catch tx_err
      call data.rollback using tx
      give back server.json using 500, record {error: tx_err.message}
    end
  catch err
    give back server.json using 400, record {error: err.message}
  end
end

route "POST" "/api/admin/media/upload" using req
  set auth to require_api_auth using stmts, req, "media:upload", yes
  if not auth.ok
    give back auth.response
  end
  give back handle_media_upload using stmts, req, auth
end

route "POST" "/api/media/upload" using req
  set auth to require_api_auth using stmts, req, "media:upload", yes
  if not auth.ok
    give back auth.response
  end
  give back handle_media_upload using stmts, req, auth
end

route "GET" "/api/admin/media" using req
  set auth to require_api_auth using stmts, req, "media:read", no
  if not auth.ok
    give back auth.response
  end
  set mime_prefix to text.lower using (get_query_param using req, "mime_prefix")
  set mime_like to "%"
  if mime_prefix is not ""
    set mime_like to mime_prefix joined with "%"
  end
  set lim to 50
  set off to 0
  set lim_raw to get_query_param using req, "limit"
  if lim_raw is not ""
    try
      set lim to math.clamp using (text.to_integer using lim_raw), 1, 100
    catch err
    end
  end
  set off_raw to get_query_param using req, "offset"
  if off_raw is not ""
    try
      set off to math.max using 0, (text.to_integer using off_raw)
    catch err
    end
  end
  set cnt_row to data.one using stmts.count_media, record {mime_filter: mime_prefix, mime_like: mime_like}
  set rows to data.query using stmts.list_media, record {mime_filter: mime_prefix, mime_like: mime_like, limit_rows: lim, offset_rows: off}
  set out to []
  for each r in rows
    set out to collections.append using out, (format_media_record using r)
  end
  set total to 0
  if cnt_row is not nothing
    set total to cnt_row.total
  end
  give back server.json using 200, record {media: out, total: total}
end

route "PATCH" "/api/admin/media/{id}" using req
  set auth to require_api_auth using stmts, req, "media:update_own", yes
  if not auth.ok
    give back auth.response
  end
  try
    set media_id to text.to_integer using req.params.id
    set existing to data.one using stmts.get_media, record {lookup: "id", iv: media_id, sv: ""}
    if existing is nothing
      give back server.json using 404, record {error: "Media asset not found"}
    end
    if not (role_has_capability using auth.session.role, "media:update_any")
      if existing.uploader_id is nothing or existing.uploader_id is not auth.session.user_id
        give back server.json using 403, record {error: "Forbidden: can only update your own media assets"}
      end
    end
    set payload to server.parse_json using req
    set next_alt to existing.alt_text
    if payload has "alt_text" and (payload at "alt_text") is not nothing
      set next_alt to text.trim using (text.from using (payload at "alt_text"))
    end
    set next_dec to existing.is_decorative
    if payload has "is_decorative" and (payload at "is_decorative") is not nothing
      if is_truthy_val using (payload at "is_decorative")
        set next_dec to 1
      otherwise
        set next_dec to 0
      end
    end
    if (text.starts_with using existing.mime_type, "image/") and next_alt is "" and next_dec is 0
      give back server.json using 422, record {error: "alt_text_required", message: "Image assets require non-empty alt_text or is_decorative: true"}
    end
    set next_cap to existing.caption
    if payload has "caption" and (payload at "caption") is not nothing
      set next_cap to text.trim using (text.from using (payload at "caption"))
    end
    set now_rec to call dates.now_utc
    call data.execute using stmts.update_media, record {alt_text: next_alt, is_decorative: next_dec, caption: next_cap, updated_at: now_rec.iso, id: media_id}
    set updated to data.one using stmts.get_media, record {lookup: "id", iv: media_id, sv: ""}
    give back server.json using 200, record {media: (format_media_record using updated)}
  catch err
    give back server.json using 400, record {error: err.message}
  end
end

route "DELETE" "/api/admin/media/{id}" using req
  set auth to require_api_auth using stmts, req, "media:delete_own", yes
  if not auth.ok
    give back auth.response
  end
  try
    set media_id to text.to_integer using req.params.id
    set existing to data.one using stmts.get_media, record {lookup: "id", iv: media_id, sv: ""}
    if existing is nothing
      give back server.json using 404, record {error: "Media asset not found"}
    end
    if not (role_has_capability using auth.session.role, "media:delete_any")
      if existing.uploader_id is nothing or existing.uploader_id is not auth.session.user_id
        give back server.json using 403, record {error: "Forbidden: can only delete your own media assets"}
      end
    end
    set upload_dir to call get_upload_dir
    if upload_dir is not "" and (not (text.contains using existing.storage_path, ".."))
      try
        set fp to upload_dir joined with "/" joined with existing.storage_path
        if files.exists using fp
          call files.write_text using fp, ""
        end
      catch w_err
      end
    end
    call data.execute using stmts.delete_media, record {id: media_id}
    give back server.json using 200, record {deleted: yes, id: media_id}
  catch err
    give back server.json using 400, record {error: err.message}
  end
end

route "GET" "/media/{id}/{filename}" using req
  try
    set media_id to text.to_integer using req.params.id
    set row to data.one using stmts.get_media, record {lookup: "id", iv: media_id, sv: ""}
    if row is nothing or row.filename is not req.params.filename
      give back server.json using 404, record {error: "Media asset not found"}
    end
    if (text.contains using row.storage_path, "..") or (text.contains using row.storage_path, "/") or (text.contains using row.storage_path, "\\")
      give back server.json using 404, record {error: "Invalid media path"}
    end
    set etag_val to "\"" joined with row.sha256_hex joined with "\""
    set inm to text.trim using (get_req_header using req, "if-none-match")
    if inm is etag_val or inm is row.sha256_hex
      give back server.response using record {status: 304, headers: {"X-Content-Type-Options": "nosniff", "Content-Security-Policy": "default-src 'none'", "ETag": etag_val, "Cache-Control": "public, max-age=31536000, immutable"}, body: ""}
    end
    set upload_dir to call get_upload_dir
    set file_path to upload_dir joined with "/" joined with row.storage_path
    if not (files.exists using file_path)
      give back server.json using 404, record {error: "Media payload missing from storage"}
    end
    set raw_b64 to files.read_text using file_path
    give back server.response using record {status: 200, headers: {"Content-Type": row.mime_type, "X-Content-Type-Options": "nosniff", "Content-Security-Policy": "default-src 'none'", "ETag": etag_val, "Cache-Control": "public, max-age=31536000, immutable", "X-GrabLab-Payload-Encoding": "base64"}, body: raw_b64}
  catch err
    give back server.json using 404, record {error: "Media asset not found"}
  end
end

# ==============================================================================
# Navigation Menus API (/api/menus/{location}, /api/admin/menus/*)
# ==============================================================================

route "GET" "/api/menus/{location}" using req
  set loc to text.lower using (text.trim using req.params.location)
  if loc is "" or (not (is_valid_menu_location using loc))
    give back server.json using 404, record {error: "Unknown menu location"}
  end
  set tree to get_menu_tree using stmts, loc, no
  if tree is nothing
    give back server.json using 404, record {error: "No menu assigned to location " joined with loc}
  end
  give back server.json using 200, record {menu: tree}
end

route "GET" "/api/admin/menus" using req
  set auth to require_api_auth using stmts, req, "menus:manage", no
  if not auth.ok
    give back auth.response
  end
  set mrows to data.query using stmts.get_menu, record {lookup: "all", iv: 0, sv: ""}
  set out to []
  for each m in mrows
    set items_rows to data.query using stmts.list_menu_items_by_menu, record {menu_id: m.id}
    set tree to build_menu_children using items_rows, nothing, 1, yes
    set out to collections.append using out, record {id: m.id, slug: m.slug, name: m.name, location: m.location, items: tree, flat_items: items_rows, created_at: m.created_at, updated_at: m.updated_at}
  end
  give back server.json using 200, record {menus: out}
end

route "POST" "/api/admin/menus" using req
  set auth to require_api_auth using stmts, req, "menus:manage", yes
  if not auth.ok
    give back auth.response
  end
  try
    set payload to server.parse_json using req
    if (not (payload has "slug")) or (not (payload has "name"))
      give back server.json using 400, record {error: "Missing required fields: slug, name"}
    end
    set slug to normalize_slug using (text.from using (payload at "slug"))
    if not (is_valid_slug using slug)
      give back server.json using 400, record {error: "Invalid menu slug"}
    end
    set name to text.trim using (text.from using (payload at "name"))
    if name is ""
      give back server.json using 400, record {error: "Menu name cannot be empty"}
    end
    set loc_val to nothing
    set loc_str to ""
    if payload has "location" and (payload at "location") is not nothing
      set loc_str to text.lower using (text.trim using (text.from using (payload at "location")))
      if not (is_valid_menu_location using loc_str)
        give back server.json using 400, record {error: "Invalid location (allowed: primary, footer, mobile, or null)"}
      end
      if loc_str is not ""
        set loc_val to loc_str
      end
    end
    set dup to data.one using stmts.get_menu, record {lookup: "slug", iv: 0, sv: slug}
    if dup is not nothing
      give back server.json using 409, record {error: "Menu slug already exists"}
    end
    set now_rec to call dates.now_utc
    set tx to data.begin using stmts.db
    try
      if loc_val is not nothing
        call data.execute using stmts.clear_menu_location, record {updated_at: now_rec.iso, location: loc_val}, tx
      end
      call data.execute using stmts.insert_menu, record {slug: slug, name: name, location: loc_val, created_at: now_rec.iso, updated_at: now_rec.iso}, tx
      set created to data.one using stmts.get_menu, record {lookup: "slug", iv: 0, sv: slug}, tx
      call data.commit using tx
      call invalidate_menu_caches using stmts, loc_str
      give back server.json using 201, record {menu: created}
    catch tx_err
      call data.rollback using tx
      give back server.json using 500, record {error: tx_err.message}
    end
  catch err
    give back server.json using 400, record {error: err.message}
  end
end

route "PUT" "/api/admin/menus/{id}" using req
  set auth to require_api_auth using stmts, req, "menus:manage", yes
  if not auth.ok
    give back auth.response
  end
  try
    set menu_id to text.to_integer using req.params.id
    set existing to data.one using stmts.get_menu, record {lookup: "id", iv: menu_id, sv: ""}
    if existing is nothing
      give back server.json using 404, record {error: "Menu not found"}
    end
    set payload to server.parse_json using req
    set next_name to existing.name
    if payload has "name" and (payload at "name") is not nothing
      set next_name to text.trim using (text.from using (payload at "name"))
      if next_name is ""
        give back server.json using 400, record {error: "Menu name cannot be empty"}
      end
    end
    set next_loc to existing.location
    if payload has "location"
      if (payload at "location") is nothing or (text.trim using (text.from using (payload at "location"))) is ""
        set next_loc to nothing
      otherwise
        set cand to text.lower using (text.trim using (text.from using (payload at "location")))
        if not (is_valid_menu_location using cand)
          give back server.json using 400, record {error: "Invalid menu location"}
        end
        set next_loc to cand
      end
    end
    set now_rec to call dates.now_utc
    set tx to data.begin using stmts.db
    try
      if next_loc is not nothing
        call data.execute using stmts.clear_menu_location, record {updated_at: now_rec.iso, location: next_loc}, tx
      end
      call data.execute using stmts.update_menu, record {name: next_name, location: next_loc, updated_at: now_rec.iso, id: menu_id}, tx
      set updated to data.one using stmts.get_menu, record {lookup: "id", iv: menu_id, sv: ""}, tx
      call data.commit using tx
      call invalidate_menu_caches using stmts, ""
      give back server.json using 200, record {menu: updated}
    catch tx_err
      call data.rollback using tx
      give back server.json using 500, record {error: tx_err.message}
    end
  catch err
    give back server.json using 400, record {error: err.message}
  end
end

route "DELETE" "/api/admin/menus/{id}" using req
  set auth to require_api_auth using stmts, req, "menus:manage", yes
  if not auth.ok
    give back auth.response
  end
  try
    set menu_id to text.to_integer using req.params.id
    set existing to data.one using stmts.get_menu, record {lookup: "id", iv: menu_id, sv: ""}
    if existing is nothing
      give back server.json using 404, record {error: "Menu not found"}
    end
    call data.execute using stmts.delete_menu, record {id: menu_id}
    call invalidate_menu_caches using stmts, ""
    give back server.json using 200, record {deleted: yes, id: menu_id}
  catch err
    give back server.json using 400, record {error: err.message}
  end
end

route "POST" "/api/admin/menus/{id}/items" using req
  set auth to require_api_auth using stmts, req, "menus:manage", yes
  if not auth.ok
    give back auth.response
  end
  try
    set menu_id to text.to_integer using req.params.id
    set menu_row to data.one using stmts.get_menu, record {lookup: "id", iv: menu_id, sv: ""}
    if menu_row is nothing
      give back server.json using 404, record {error: "Menu not found"}
    end
    set payload to server.parse_json using req
    if (not (payload has "label")) or (not (payload has "link_type"))
      give back server.json using 400, record {error: "Missing required fields: label, link_type"}
    end
    set label to text.trim using (text.from using (payload at "label"))
    if label is ""
      give back server.json using 400, record {error: "Menu item label is required"}
    end
    set ltype to text.lower using (text.trim using (text.from using (payload at "link_type")))
    if ltype is not "entry" and ltype is not "external"
      give back server.json using 400, record {error: "link_type must be entry or external"}
    end
    set entry_id_val to nothing
    set ext_url_val to nothing
    if ltype is "entry"
      if (not (payload has "entry_id")) or (payload at "entry_id") is nothing
        give back server.json using 400, record {error: "entry_id is required when link_type is entry"}
      end
      set eid to text.to_integer using (text.from using (payload at "entry_id"))
      set erow to data.one using stmts.get_entry_by_id, record {id: eid}
      if erow is nothing
        give back server.json using 400, record {error: "Referenced entry_id does not exist"}
      end
      set entry_id_val to eid
    otherwise
      if (not (payload has "external_url")) or (payload at "external_url") is nothing
        give back server.json using 400, record {error: "external_url is required when link_type is external"}
      end
      set eu to text.trim using (text.from using (payload at "external_url"))
      if not (is_valid_external_menu_url using eu)
        give back server.json using 400, record {error: "External URL must start with https:// or http://"}
      end
      set ext_url_val to eu
    end

    set existing_items to data.query using stmts.list_menu_items_by_menu, record {menu_id: menu_id}
    set parent_id_val to nothing
    if payload has "parent_id" and (payload at "parent_id") is not nothing and (text.trim using (text.from using (payload at "parent_id"))) is not ""
      set pid to text.to_integer using (text.from using (payload at "parent_id"))
      set parent_map to {}
      for each it in existing_items
        set parent_map to collections.put using parent_map, (text.from using it.id), it.parent_id
      end
      set cur_key to text.from using pid
      if not (has_map_key using parent_map, cur_key)
        give back server.json using 400, record {error: "parent_id must belong to this menu"}
      end
      set depth to 2
      set seen_p to collections.put using {}, cur_key, yes
      while (parent_map at cur_key) is not nothing
        set next_k to text.from using (parent_map at cur_key)
        if has_map_key using seen_p, next_k
          give back server.json using 400, record {error: "Cycle detected in menu hierarchy"}
        end
        set seen_p to collections.put using seen_p, next_k, yes
        set depth to depth plus 1
        set cur_key to next_k
      end
      if depth is greater than 4
        give back server.json using 400, record {error: "Menu nesting depth cannot exceed 4 levels"}
      end
      set parent_id_val to pid
    end

    set target_blank to 0
    if payload has "target_blank" and (is_truthy_val using (payload at "target_blank"))
      set target_blank to 1
    end
    set css_cls to ""
    if payload has "css_class" and (payload at "css_class") is not nothing
      set css_cls to text.trim using (text.from using (payload at "css_class"))
    end
    set sort_ord to collections.length using existing_items
    if payload has "sort_order" and (payload at "sort_order") is not nothing
      set sort_ord to text.to_integer using (text.from using (payload at "sort_order"))
    end

    set now_rec to call dates.now_utc
    call data.execute using stmts.insert_menu_item, record {menu_id: menu_id, parent_id: parent_id_val, label: label, link_type: ltype, entry_id: entry_id_val, external_url: ext_url_val, target_blank: target_blank, css_class: css_cls, sort_order: sort_ord, created_at: now_rec.iso, updated_at: now_rec.iso}
    call invalidate_menu_caches using stmts, ""
    set updated_items to data.query using stmts.list_menu_items_by_menu, record {menu_id: menu_id}
    give back server.json using 201, record {items: (build_menu_children using updated_items, nothing, 1, yes), flat_items: updated_items}
  catch err
    give back server.json using 400, record {error: err.message}
  end
end

route "PUT" "/api/admin/menus/{id}/items" using req
  set auth to require_api_auth using stmts, req, "menus:manage", yes
  if not auth.ok
    give back auth.response
  end
  try
    set menu_id to text.to_integer using req.params.id
    set menu_row to data.one using stmts.get_menu, record {lookup: "id", iv: menu_id, sv: ""}
    if menu_row is nothing
      give back server.json using 404, record {error: "Menu not found"}
    end
    set payload to server.parse_json using req
    if not (payload has "items")
      give back server.json using 400, record {error: "items array is required"}
    end
    set items_in to payload at "items"
    set norm_list to []
    set idx to 0
    for each it in items_in
      set lbl to ""
      if it has "label" and (it at "label") is not nothing
        set lbl to text.trim using (text.from using (it at "label"))
      end
      if lbl is ""
        give back server.json using 400, record {error: "Every menu item requires a non-empty label"}
      end
      set lt to ""
      if it has "link_type" and (it at "link_type") is not nothing
        set lt to text.lower using (text.trim using (text.from using (it at "link_type")))
      end
      if lt is not "entry" and lt is not "external"
        give back server.json using 400, record {error: "Menu item link_type must be entry or external"}
      end
      set eid_v to nothing
      set eu_v to nothing
      if lt is "entry"
        if (not (it has "entry_id")) or (it at "entry_id") is nothing
          give back server.json using 400, record {error: "entry_id required for entry link"}
        end
        set eid_v to text.to_integer using (text.from using (it at "entry_id"))
        if (data.one using stmts.get_entry_by_id, record {id: eid_v}) is nothing
          give back server.json using 400, record {error: "Referenced entry_id not found"}
        end
      otherwise
        if (not (it has "external_url")) or (it at "external_url") is nothing
          give back server.json using 400, record {error: "external_url required for external link"}
        end
        set eu_raw to text.trim using (text.from using (it at "external_url"))
        if not (is_valid_external_menu_url using eu_raw)
          give back server.json using 400, record {error: "Invalid external_url (must use https:// or http://)"}
        end
        set eu_v to eu_raw
      end
      set c_key to "idx:" joined with (text.from using idx)
      if it has "client_id" and (it at "client_id") is not nothing and (text.trim using (text.from using (it at "client_id"))) is not ""
        set c_key to text.trim using (text.from using (it at "client_id"))
      otherwise
        if it has "id" and (it at "id") is not nothing
          set c_key to "id:" joined with (text.from using (it at "id"))
        end
      end
      set p_key to ""
      if it has "parent_key" and (it at "parent_key") is not nothing
        set p_key to text.trim using (text.from using (it at "parent_key"))
      otherwise
        if it has "parent_id" and (it at "parent_id") is not nothing and (text.trim using (text.from using (it at "parent_id"))) is not ""
          set p_key to "id:" joined with (text.trim using (text.from using (it at "parent_id")))
        end
      end
      set tb_v to 0
      if it has "target_blank" and (is_truthy_val using (it at "target_blank"))
        set tb_v to 1
      end
      set cc_v to ""
      if it has "css_class" and (it at "css_class") is not nothing
        set cc_v to text.trim using (text.from using (it at "css_class"))
      end
      set norm_list to collections.append using norm_list, record {key: c_key, parent_key: p_key, label: lbl, link_type: lt, entry_id: eid_v, external_url: eu_v, target_blank: tb_v, css_class: cc_v, sort_order: idx}
      set idx to idx plus 1
    end

    set by_key to {}
    for each ni in norm_list
      if has_map_key using by_key, ni.key
        give back server.json using 400, record {error: "Duplicate menu item key"}
      end
      set by_key to collections.put using by_key, ni.key, ni
    end
    for each ni in norm_list
      set depth to 1
      set cur to ni
      set visited to collections.put using {}, ni.key, yes
      while cur.parent_key is not ""
        if (cur.parent_key is ni.key) or (has_map_key using visited, cur.parent_key)
          give back server.json using 400, record {error: "Cycle detected in menu hierarchy"}
        end
        if not (has_map_key using by_key, cur.parent_key)
          give back server.json using 400, record {error: "Parent menu item missing from menu"}
        end
        set visited to collections.put using visited, cur.parent_key, yes
        set depth to depth plus 1
        if depth is greater than 4
          give back server.json using 400, record {error: "Menu nesting depth exceeds maximum of 4 levels"}
        end
        set next_pk to cur.parent_key
        set cur to by_key at next_pk
      end
    end

    set now_rec to call dates.now_utc
    set tx to data.begin using stmts.db
    try
      call data.execute using stmts.delete_menu_items, record {lookup: "menu", iv: menu_id}, tx
      set remaining to norm_list
      set id_by_key to {}
      set pass_num to 0
      while (collections.length using remaining) is greater than 0 and pass_num is less than 6
        set next_rem to []
        for each ni in remaining
          set resolved_pid to nothing
          set ready to no
          if ni.parent_key is ""
            set ready to yes
          otherwise
            set ni_pk to ni.parent_key
            if has_map_key using id_by_key, ni_pk
              set resolved_pid to id_by_key at ni_pk
              set ready to yes
            end
          end
          if ready
            call data.execute using stmts.insert_menu_item, record {menu_id: menu_id, parent_id: resolved_pid, label: ni.label, link_type: ni.link_type, entry_id: ni.entry_id, external_url: ni.external_url, target_blank: ni.target_blank, css_class: ni.css_class, sort_order: ni.sort_order, created_at: now_rec.iso, updated_at: now_rec.iso}, tx
            set latest_rows to data.query using stmts.list_menu_items_by_menu, record {menu_id: menu_id}, tx
            set max_id to 0
            for each lr in latest_rows
              if lr.id is greater than max_id
                set max_id to lr.id
              end
            end
            set id_by_key to collections.put using id_by_key, ni.key, max_id
          otherwise
            set next_rem to collections.append using next_rem, ni
          end
        end
        set remaining to next_rem
        set pass_num to pass_num plus 1
      end
      call data.commit using tx
      call invalidate_menu_caches using stmts, ""
      set final_rows to data.query using stmts.list_menu_items_by_menu, record {menu_id: menu_id}
      give back server.json using 200, record {items: (build_menu_children using final_rows, nothing, 1, yes), flat_items: final_rows}
    catch tx_err
      call data.rollback using tx
      give back server.json using 500, record {error: tx_err.message}
    end
  catch err
    give back server.json using 400, record {error: err.message}
  end
end

route "DELETE" "/api/admin/menus/{id}/items/{item_id}" using req
  set auth to require_api_auth using stmts, req, "menus:manage", yes
  if not auth.ok
    give back auth.response
  end
  try
    set menu_id to text.to_integer using req.params.id
    set item_id to text.to_integer using req.params.item_id
    set existing to data.one using stmts.list_menu_items_by_menu, record {menu_id: (0 minus item_id)}
    if existing is nothing or existing.menu_id is not menu_id
      give back server.json using 404, record {error: "Menu item not found"}
    end
    call data.execute using stmts.delete_menu_items, record {lookup: "id", iv: item_id}
    call invalidate_menu_caches using stmts, ""
    give back server.json using 200, record {deleted: yes, id: item_id}
  catch err
    give back server.json using 400, record {error: err.message}
  end
end

# ==============================================================================
# Taxonomies, Terms & Entry Term Assignment API
# ==============================================================================

route "GET" "/api/taxonomies"
  set trows to data.query using stmts.get_taxonomy, record {lookup: "all", iv: 0, sv: ""}
  set out to []
  for each txrow in trows
    set terms to data.query using stmts.get_term, record {lookup: "tax", id: 0, taxonomy_id: txrow.id, slug: ""}
    set out to collections.append using out, record {id: txrow.id, slug: txrow.slug, label_singular: txrow.label_singular, label_plural: txrow.label_plural, is_hierarchical: (txrow.is_hierarchical is 1), archive_slug: txrow.archive_slug, content_type_slugs: (parse_content_type_slugs_json using txrow.content_type_slugs_json), is_system: (txrow.is_system is 1), terms: terms}
  end
  give back server.json using 200, record {taxonomies: out}
end

route "GET" "/api/admin/taxonomies" using req
  set auth to require_api_auth using stmts, req, "admin:access", no
  if not auth.ok
    give back auth.response
  end
  set trows to data.query using stmts.get_taxonomy, record {lookup: "all", iv: 0, sv: ""}
  set out to []
  for each txrow in trows
    set terms to data.query using stmts.get_term, record {lookup: "tax", id: 0, taxonomy_id: txrow.id, slug: ""}
    set out to collections.append using out, record {id: txrow.id, slug: txrow.slug, label_singular: txrow.label_singular, label_plural: txrow.label_plural, is_hierarchical: (txrow.is_hierarchical is 1), archive_slug: txrow.archive_slug, content_type_slugs: (parse_content_type_slugs_json using txrow.content_type_slugs_json), is_system: (txrow.is_system is 1), terms: terms}
  end
  give back server.json using 200, record {taxonomies: out}
end

route "POST" "/api/admin/taxonomies" using req
  set auth to require_api_auth using stmts, req, "taxonomies:manage", yes
  if not auth.ok
    give back auth.response
  end
  try
    set payload to server.parse_json using req
    if (not (payload has "slug")) or (not (payload has "label_singular")) or (not (payload has "label_plural")) or (not (payload has "archive_slug"))
      give back server.json using 400, record {error: "Missing required fields: slug, label_singular, label_plural, archive_slug"}
    end
    set slug to normalize_slug using (text.from using (payload at "slug"))
    if not (is_valid_slug using slug)
      give back server.json using 400, record {error: "Invalid taxonomy slug"}
    end
    set arch_slug to normalize_slug using (text.from using (payload at "archive_slug"))
    if not (is_valid_slug using arch_slug)
      give back server.json using 400, record {error: "Invalid archive_slug"}
    end
    if is_reserved_path using ("/" joined with arch_slug)
      give back server.json using 409, record {error: "archive_slug collides with a reserved system prefix"}
    end
    if (data.one using stmts.get_type, record {lookup: "archive", sv: arch_slug, iv: 0}) is not nothing
      give back server.json using 409, record {error: "archive_slug collides with an existing content type archive_slug"}
    end
    if (data.one using stmts.get_taxonomy, record {lookup: "archive", iv: 0, sv: arch_slug}) is not nothing
      give back server.json using 409, record {error: "archive_slug is already used by another taxonomy"}
    end
    if (data.one using stmts.get_taxonomy, record {lookup: "slug", iv: 0, sv: slug}) is not nothing
      give back server.json using 409, record {error: "Taxonomy slug already exists"}
    end
    set is_hier to 0
    if payload has "is_hierarchical" and (is_truthy_val using (payload at "is_hierarchical"))
      set is_hier to 1
    end
    set ct_list to ["post"]
    if payload has "content_type_slugs" and (payload at "content_type_slugs") is not nothing
      set parsed_cts to []
      for each cts in (payload at "content_type_slugs")
        set ctn to normalize_slug using (text.from using cts)
        if ctn is not "" and (is_valid_slug using ctn)
          set parsed_cts to collections.append using parsed_cts, ctn
        end
      end
      set ct_list to parsed_cts
    end
    set ct_json to json.stringify using ct_list
    set now_rec to call dates.now_utc
    call data.execute using stmts.insert_taxonomy, record {slug: slug, label_singular: (text.trim using (text.from using (payload at "label_singular"))), label_plural: (text.trim using (text.from using (payload at "label_plural"))), is_hierarchical: is_hier, archive_slug: arch_slug, content_type_slugs_json: ct_json, is_system: 0, created_at: now_rec.iso}
    set created to data.one using stmts.get_taxonomy, record {lookup: "slug", iv: 0, sv: slug}
    call bump_query_cache_epochs using stmts, ""
    give back server.json using 201, record {taxonomy: created}
  catch err
    give back server.json using 400, record {error: err.message}
  end
end

route "DELETE" "/api/admin/taxonomies/{id}" using req
  set auth to require_api_auth using stmts, req, "taxonomies:manage", yes
  if not auth.ok
    give back auth.response
  end
  try
    set tid to text.to_integer using req.params.id
    set existing to data.one using stmts.get_taxonomy, record {lookup: "id", iv: tid, sv: ""}
    if existing is nothing
      give back server.json using 404, record {error: "Taxonomy not found"}
    end
    if existing.is_system is 1
      give back server.json using 400, record {error: "Built-in system taxonomies cannot be deleted"}
    end
    call data.execute using stmts.delete_taxonomy, record {id: tid}
    call invalidate_route_caches using stmts, "", "", ""
    give back server.json using 200, record {deleted: yes, id: tid}
  catch err
    give back server.json using 400, record {error: err.message}
  end
end

route "GET" "/api/admin/taxonomies/{slug}/terms" using req
  set auth to require_api_auth using stmts, req, "admin:access", no
  if not auth.ok
    give back auth.response
  end
  set tslug to normalize_slug using req.params.slug
  set txrow to data.one using stmts.get_taxonomy, record {lookup: "slug", iv: 0, sv: tslug}
  if txrow is nothing
    give back server.json using 404, record {error: "Taxonomy not found"}
  end
  set rows to data.query using stmts.get_term, record {lookup: "tax", id: 0, taxonomy_id: txrow.id, slug: ""}
  give back server.json using 200, record {taxonomy: txrow, terms: rows}
end

route "POST" "/api/admin/taxonomies/{slug}/terms" using req
  set auth to require_api_auth using stmts, req, "taxonomies:manage", yes
  if not auth.ok
    give back auth.response
  end
  try
    set tslug to normalize_slug using req.params.slug
    set txrow to data.one using stmts.get_taxonomy, record {lookup: "slug", iv: 0, sv: tslug}
    if txrow is nothing
      give back server.json using 404, record {error: "Taxonomy not found"}
    end
    set payload to server.parse_json using req
    if (not (payload has "slug")) or (not (payload has "name"))
      give back server.json using 400, record {error: "Missing required fields: slug, name"}
    end
    set slug to normalize_slug using (text.from using (payload at "slug"))
    if not (is_valid_entry_slug using slug)
      give back server.json using 400, record {error: "Invalid term slug"}
    end
    set name to text.trim using (text.from using (payload at "name"))
    if name is ""
      give back server.json using 400, record {error: "Term name is required"}
    end
    set dup to data.one using stmts.get_term, record {lookup: "tax_slug", id: 0, taxonomy_id: txrow.id, slug: slug}
    if dup is not nothing
      give back server.json using 409, record {error: "Term slug already exists in this taxonomy"}
    end
    set parent_id_val to nothing
    if payload has "parent_id" and (payload at "parent_id") is not nothing and (text.trim using (text.from using (payload at "parent_id"))) is not ""
      set parent_id_val to text.to_integer using (text.from using (payload at "parent_id"))
    end
    set pcheck to check_term_parent_valid using stmts, txrow, nothing, parent_id_val
    if not pcheck.ok
      give back server.json using 400, record {error: pcheck.error}
    end
    set desc to ""
    if payload has "description" and (payload at "description") is not nothing
      set desc to text.trim using (text.from using (payload at "description"))
    end
    set sort_ord to 0
    if payload has "sort_order" and (payload at "sort_order") is not nothing
      set sort_ord to text.to_integer using (text.from using (payload at "sort_order"))
    end
    set now_rec to call dates.now_utc
    call data.execute using stmts.insert_term, record {taxonomy_id: txrow.id, parent_id: parent_id_val, slug: slug, name: name, description: desc, sort_order: sort_ord, created_at: now_rec.iso, updated_at: now_rec.iso}
    set created to data.one using stmts.get_term, record {lookup: "tax_slug", id: 0, taxonomy_id: txrow.id, slug: slug}
    call bump_query_cache_epochs using stmts, ""
    give back server.json using 201, record {term: created}
  catch err
    give back server.json using 400, record {error: err.message}
  end
end

route "DELETE" "/api/admin/terms/{id}" using req
  set auth to require_api_auth using stmts, req, "taxonomies:manage", yes
  if not auth.ok
    give back auth.response
  end
  try
    set tid to text.to_integer using req.params.id
    set existing to data.one using stmts.get_term, record {lookup: "id", id: tid, taxonomy_id: 0, slug: ""}
    if existing is nothing
      give back server.json using 404, record {error: "Term not found"}
    end
    call data.execute using stmts.delete_term, record {id: tid}
    call invalidate_route_caches using stmts, "", "", ""
    give back server.json using 200, record {deleted: yes, id: tid}
  catch err
    give back server.json using 400, record {error: err.message}
  end
end

route "GET" "/api/admin/entries/{id}/terms" using req
  set auth to require_api_auth using stmts, req, "entries:read", no
  if not auth.ok
    give back auth.response
  end
  try
    set entry_id to text.to_integer using req.params.id
    set entry to data.one using stmts.get_entry_by_id, record {id: entry_id}
    if entry is nothing
      give back server.json using 404, record {error: "Entry not found"}
    end
    set rows to data.query using stmts.list_entry_terms, record {entry_id: entry_id}
    give back server.json using 200, record {entry_id: entry_id, terms: rows}
  catch err
    give back server.json using 400, record {error: err.message}
  end
end

route "PUT" "/api/admin/entries/{id}/terms" using req
  set auth to require_api_auth using stmts, req, "entries:update:own", yes
  if not auth.ok
    give back auth.response
  end
  try
    set entry_id to text.to_integer using req.params.id
    set existing to data.one using stmts.get_entry_by_id, record {id: entry_id}
    if existing is nothing
      give back server.json using 404, record {error: "Entry not found"}
    end
    if not (role_has_capability using auth.session.role, "entries:update:any")
      if existing.author_id is nothing or existing.author_id is not auth.session.user_id
        give back server.json using 403, record {error: "Forbidden: can only assign terms on your own entries"}
      end
    end
    set payload to server.parse_json using req
    if (not (payload has "term_ids")) or (payload at "term_ids") is nothing
      give back server.json using 400, record {error: "term_ids array is required"}
    end
    set now_rec to call dates.now_utc
    set tx to data.begin using stmts.db
    try
      set tr to sync_entry_terms_tx using stmts, entry_id, (payload at "term_ids"), now_rec.iso, tx
      if not tr.ok
        call data.rollback using tx
        give back server.json using 400, record {error: tr.error}
      end
      set updated_terms to data.query using stmts.list_entry_terms, record {entry_id: entry_id}, tx
      call data.commit using tx
      call invalidate_route_caches using stmts, existing.full_path, "", existing.content_type_slug
      give back server.json using 200, record {entry_id: entry_id, terms: updated_terms}
    catch tx_err
      call data.rollback using tx
      give back server.json using 500, record {error: tx_err.message}
    end
  catch err
    give back server.json using 400, record {error: err.message}
  end
end

# ==============================================================================
# Capability-Gated grab mcp CMS Tools (/api/mcp, /api/mcp/tools/*)
# ==============================================================================

route "GET" "/api/mcp/tools" using req
  set bearer to extract_bearer_token using req
  set sess to nothing
  if bearer is not ""
    set sess to resolve_session_token using stmts, bearer
  otherwise
    set sess to resolve_session using stmts, req
  end
  if sess is nothing
    give back server.json using 401, record {error: "MCP authentication required"}
  end
  give back server.json using 200, record {tools: (mcp_tool_schemas using stmts), user_role: sess.role}
end

route "POST" "/api/mcp/tools/{name}" using req
  set principal to resolve_mcp_principal using stmts, req
  if not principal.ok
    give back server.json using principal.status, record {error: principal.error}
  end
  try
    set body_map to server.parse_json using req
    set args to body_map
    if body_map has "arguments" and (body_map at "arguments") is not nothing
      set args to body_map at "arguments"
    end
    set res to execute_mcp_tool using stmts, principal.session, req.params.name, args
    give back server.json using res.status, res.payload
  catch err
    give back server.json using 400, record {error: err.message}
  end
end

route "POST" "/api/mcp" using req
  set principal to resolve_mcp_principal using stmts, req
  if not principal.ok
    give back server.json using principal.status, record {error: principal.error}
  end
  try
    set rpc to server.parse_json using req
    set rpc_id to nothing
    if rpc has "id"
      set rpc_id to rpc at "id"
    end
    set method to ""
    if rpc has "method" and (rpc at "method") is not nothing
      set method to text.from using (rpc at "method")
    end
    if method is "initialize"
      give back server.json using 200, record {jsonrpc: "2.0", id: rpc_id, result: (record {protocolVersion: "2024-11-05", serverInfo: (record {name: "grablab-cms-mcp", version: "1.4.0"}), capabilities: (record {tools: {}})})}
    end
    if method is "ping"
      give back server.json using 200, record {jsonrpc: "2.0", id: rpc_id, result: {}}
    end
    if method is "tools/list"
      give back server.json using 200, record {jsonrpc: "2.0", id: rpc_id, result: (record {tools: (mcp_tool_schemas using stmts)})}
    end
    if method is "tools/call"
      set params to {}
      if rpc has "params" and (rpc at "params") is not nothing
        set params to rpc at "params"
      end
      set tname to ""
      if params has "name" and (params at "name") is not nothing
        set tname to text.from using (params at "name")
      end
      set targs to {}
      if params has "arguments" and (params at "arguments") is not nothing
        set targs to params at "arguments"
      end
      set res to execute_mcp_tool using stmts, principal.session, tname, targs
      if not res.ok
        if res.status is 422 or res.status is 400
          give back server.json using 200, record {jsonrpc: "2.0", id: rpc_id, result: (record {isError: yes, status: res.status, errorCode: -32602, content: [record {type: "text", text: (json.stringify using res.payload)}], structuredContent: res.payload})}
        end
        give back server.json using 200, record {jsonrpc: "2.0", id: rpc_id, result: (record {isError: yes, status: res.status, content: [record {type: "text", text: (json.stringify using res.payload)}], structuredContent: res.payload})}
      end
      give back server.json using 200, record {jsonrpc: "2.0", id: rpc_id, result: (record {isError: no, status: res.status, content: [record {type: "text", text: (json.stringify using res.payload)}], structuredContent: res.payload})}
    end
    give back server.json using 200, record {jsonrpc: "2.0", id: rpc_id, error: (record {code: -32601, message: ("Method not found: " joined with method)})}
  catch err
    give back server.json using 400, record {jsonrpc: "2.0", id: nothing, error: (record {code: -32700, message: err.message})}
  end
end

# ==============================================================================
# Zero-Plugin E-Commerce Public & Admin JSON API (/api/commerce/*, /api/admin/commerce/*)
# ==============================================================================

route "GET" "/api/commerce/products" using req
  if not stmts.commerce_ready
    give back commerce_error using 404, "commerce_disabled", "Storefront is not configured", ""
  end
  set cfg to get_commerce_config using stmts
  if not cfg.enabled
    give back commerce_error using 404, "commerce_disabled", "Storefront is currently disabled", ""
  end
  call run_commerce_sweep using stmts, no
  set rows to data.query using stmts.commerce.products, record {mode: "pub", iv: 0, sv: ""}
  set out to []
  for each p in rows
    set ckey to "commerce:product:" joined with (text.from using p.id)
    set formatted to format_product_api_row using p
    call cache.set using stmts.cms_cache, ckey, formatted, 60000
    set out to collections.append using out, formatted
  end
  give back server.json using 200, {"currency": cfg.currency, "products": out}
end

route "GET" "/api/commerce/session" using req
  if not stmts.commerce_ready
    give back commerce_error using 404, "commerce_disabled", "Storefront is not configured", ""
  end
  set cfg to get_commerce_config using stmts
  if not cfg.enabled
    give back commerce_error using 404, "commerce_disabled", "Storefront is currently disabled", ""
  end
  call run_commerce_sweep using stmts, no
  set existing_cart to resolve_cart_from_cookie using stmts, req
  if existing_cart is not nothing
    set payload to build_cart_response_payload using stmts, existing_cart
    set payload to collections.put using payload, "csrf_token", existing_cart.csrf_secret
    give back server.response using record {status: 200, headers: {"Content-Type": "application/json; charset=utf-8", "Cache-Control": "no-store"}, body: (json.stringify using payload)}
  end

  set user_sess to resolve_session using stmts, req
  set user_id_val to nothing
  if user_sess is not nothing
    set user_id_val to user_sess.user_id
    set user_cart to data.one using stmts.commerce.get_cart, record {lookup: "user", sv: "", iv: user_sess.user_id}
    if user_cart is not nothing
      set now_rec to call dates.now_utc
      set fresh_tok to crypto.random_urlsafe using 32
      set fresh_hash to crypto.sha256_hex using fresh_tok
      call data.execute using stmts.commerce.upd_cart, record {token_hash: fresh_hash, csrf_secret: user_cart.csrf_secret, customer_id: user_cart.customer_id, user_id: user_cart.user_id, status: "open", coupon_code: user_cart.coupon_code, last_activity_at: now_rec.iso, id: user_cart.id, req_open: 1}
      set chdr to build_cookie using "gl_cart", fresh_tok, "/", 2592000, (is_https_req using req)
      set payload to build_cart_response_payload using stmts, user_cart
      set payload to collections.put using payload, "csrf_token", user_cart.csrf_secret
      give back server.response using record {status: 200, headers: {"Content-Type": "application/json; charset=utf-8", "Cache-Control": "no-store", "Set-Cookie": chdr}, body: (json.stringify using payload)}
    end
  end

  set now_rec to call dates.now_utc
  set cart_id to "crt_" joined with (crypto.random_hex using 16)
  set raw_tok to crypto.random_urlsafe using 32
  set tok_hash to crypto.sha256_hex using raw_tok
  set csrf_sec to crypto.random_urlsafe using 32
  call data.execute using stmts.commerce.ins_cart, record {id: cart_id, token_hash: tok_hash, csrf_secret: csrf_sec, customer_id: nothing, user_id: user_id_val, status: "open", currency: cfg.currency, coupon_code: nothing, last_activity_at: now_rec.iso, created_at: now_rec.iso}
  set created_cart to data.one using stmts.commerce.get_cart, record {lookup: "id", sv: cart_id, iv: 0}
  set cookie_hdr to build_cookie using "gl_cart", raw_tok, "/", 2592000, (is_https_req using req)
  set payload to build_cart_response_payload using stmts, created_cart
  set payload to collections.put using payload, "csrf_token", csrf_sec
  give back server.response using record {status: 200, headers: {"Content-Type": "application/json; charset=utf-8", "Cache-Control": "no-store", "Set-Cookie": cookie_hdr}, body: (json.stringify using payload)}
end

route "POST" "/api/commerce/cart" using req
  if not stmts.commerce_ready
    give back commerce_error using 404, "commerce_disabled", "Storefront is not configured", ""
  end
  set cfg to get_commerce_config using stmts
  if not cfg.enabled
    give back commerce_error using 404, "commerce_disabled", "Storefront is currently disabled", ""
  end
  set rl to check_commerce_rate_limit using stmts, req, "cart", 60, 60000
  if not rl.ok
    give back rl.response
  end
  set bl to check_commerce_body_limit using req
  if not bl.ok
    give back bl.response
  end
  set cart to resolve_cart_record_from_cookie using stmts, req
  if cart is nothing or (not (cart_csrf_matches using req, cart))
    give back commerce_error using 403, "commerce_csrf_invalid", "Missing or invalid commerce cart CSRF token", ""
  end
  if cart.status is not "open"
    give back commerce_error using 409, "cart_not_open", "Cart is no longer open for modification", ""
  end
  call run_commerce_sweep using stmts, no
  try
    set payload to server.parse_json using req
    set pf_chk to reject_client_price_fields using payload
    if not pf_chk.ok
      give back commerce_error using 422, "client_price_not_allowed", "Client-supplied prices or totals are forbidden", pf_chk.field
    end
    set action to "get"
    if payload has "action" and (payload at "action") is not nothing
      set action to text.lower using (text.trim using (text.from using (payload at "action")))
    end
    if action is "get"
      set res_p to build_cart_response_payload using stmts, cart
      give back server.response using record {status: 200, headers: {"Content-Type": "application/json; charset=utf-8", "Cache-Control": "no-store"}, body: (json.stringify using res_p)}
    end

    set now_rec to call dates.now_utc
    if action is "set_customer"
      if not (payload has "email")
        give back commerce_error using 422, "invalid_email", "Customer email is required", "email"
      end
      set email_norm to normalize_email using (payload at "email")
      if not (is_valid_email using email_norm)
        give back commerce_error using 422, "invalid_email", "Valid customer email is required", "email"
      end
      set dname to ""
      if payload has "display_name" and (payload at "display_name") is not nothing
        set dname to text_truncate using (text.trim using (text.from using (payload at "display_name"))), 120
      end
      set consent_val to 0
      if payload has "marketing_consent" and (payload at "marketing_consent") is not nothing
        set pc to parse_grab_integer using (payload at "marketing_consent"), 0, 1
        if not pc.ok
          set st_c to 422
          give back commerce_error using st_c, pc.code, pc.error, "marketing_consent"
        end
        set consent_val to pc.val
      otherwise
        if payload has "marketing_opt_in" and (payload at "marketing_opt_in") is yes
          set consent_val to 1
        end
      end
      set sess_u to resolve_session using stmts, req
      set linked_uid to nothing
      if sess_u is not nothing
        set linked_uid to sess_u.user_id
      end
      set cust to data.one using stmts.commerce.get_customers, record {mode: "email", iv: 0, sv: email_norm}
      set tx to data.begin using stmts.db
      try
        if cust is nothing
          call data.execute using stmts.commerce.ins_customer, record {user_id: linked_uid, email: email_norm, display_name: dname, marketing_consent: consent_val, created_at: now_rec.iso, updated_at: now_rec.iso}, tx
          set cust to data.one using stmts.commerce.get_customers, record {mode: "email", iv: 0, sv: email_norm}, tx
        otherwise
          set next_uid to cust.user_id
          if linked_uid is not nothing
            set next_uid to linked_uid
          end
          call data.execute using stmts.commerce.upd_customer, record {user_id: next_uid, email: email_norm, display_name: dname, marketing_consent: consent_val, updated_at: now_rec.iso, id: cust.id}, tx
        end
        call data.execute using stmts.commerce.upd_cart, record {token_hash: cart.token_hash, csrf_secret: cart.csrf_secret, customer_id: cust.id, user_id: cart.user_id, status: "open", coupon_code: cart.coupon_code, last_activity_at: now_rec.iso, id: cart.id, req_open: 1}, tx
        set fresh_c to data.one using stmts.commerce.get_cart, record {lookup: "id", sv: cart.id, iv: 0}, tx
        call data.commit using tx
        set res_p to build_cart_response_payload using stmts, fresh_c
        give back server.response using record {status: 200, headers: {"Content-Type": "application/json; charset=utf-8", "Cache-Control": "no-store"}, body: (json.stringify using res_p)}
      catch tx_err
        call data.rollback using tx
        give back commerce_error using 500, "db_error", tx_err.message, ""
      end
    end

    if action is not "add" and action is not "set_qty" and action is not "remove"
      give back commerce_error using 400, "invalid_action", "Unsupported cart action", "action"
    end
    if not (payload has "product_id")
      give back commerce_error using 400, "missing_product_id", "product_id is required", "product_id"
    end
    set p_pid to parse_grab_integer using (payload at "product_id"), 1, 2147483647
    if not p_pid.ok
      give back commerce_error using 422, p_pid.code, p_pid.error, "product_id"
    end
    set qty_in to 1
    if action is "remove"
      set qty_in to 0
    otherwise
      if payload has "qty"
        set min_q to 0
        if action is "add"
          set min_q to 1
        end
        set p_q to parse_grab_integer using (payload at "qty"), min_q, 999
        if not p_q.ok
          give back commerce_error using 422, p_q.code, p_q.error, "qty"
        end
        set qty_in to p_q.val
      end
    end

    set prod to data.one using stmts.commerce.products, record {mode: "id", iv: p_pid.val, sv: ""}
    if prod is nothing or prod.status is not "published" or prod.active is not 1
      give back commerce_error using 404, "product_not_found", "Product not found", "product_id"
    end

    set cur_items to data.query using stmts.commerce.list_cart_items, record {cart_id: cart.id}
    set cur_qty to 0
    for each ci in cur_items
      if ci.product_id is prod.id
        set cur_qty to ci.qty
      end
    end
    set next_qty to qty_in
    if action is "add"
      set next_qty to cur_qty plus qty_in
      if next_qty is greater than 999
        give back commerce_error using 422, "out_of_range", "Cart item quantity cannot exceed 999", "qty"
      end
    end
    if next_qty is greater than 0 and prod.stock_qty is not nothing
      if next_qty is greater than prod.stock_qty
        give back commerce_error using 409, "out_of_stock", "Requested quantity exceeds available stock", "qty"
      end
    end

    set tx to data.begin using stmts.db
    try
      call data.execute using stmts.commerce.del_cart_item, record {cart_id: cart.id, pid: prod.id}, tx
      if next_qty is greater than 0
        call data.execute using stmts.commerce.ins_cart_item, record {cart_id: cart.id, product_id: prod.id, qty: next_qty, unit_price_cents: prod.price_cents, created_at: now_rec.iso, updated_at: now_rec.iso}, tx
      end
      call data.execute using stmts.commerce.upd_cart, record {token_hash: cart.token_hash, csrf_secret: cart.csrf_secret, customer_id: cart.customer_id, user_id: cart.user_id, status: "open", coupon_code: cart.coupon_code, last_activity_at: now_rec.iso, id: cart.id, req_open: 1}, tx
      set fresh_c to data.one using stmts.commerce.get_cart, record {lookup: "id", sv: cart.id, iv: 0}, tx
      call data.commit using tx
      set res_p to build_cart_response_payload using stmts, fresh_c
      give back server.response using record {status: 200, headers: {"Content-Type": "application/json; charset=utf-8", "Cache-Control": "no-store"}, body: (json.stringify using res_p)}
    catch tx_err
      call data.rollback using tx
      give back commerce_error using 500, "db_error", tx_err.message, ""
    end
  catch err
    give back commerce_error using 400, "invalid_json", err.message, ""
  end
end

route "POST" "/api/commerce/coupon/apply" using req
  if not stmts.commerce_ready
    give back commerce_error using 404, "commerce_disabled", "Storefront is not configured", ""
  end
  set cfg to get_commerce_config using stmts
  if not cfg.enabled
    give back commerce_error using 404, "commerce_disabled", "Storefront is currently disabled", ""
  end
  set rl to check_commerce_rate_limit using stmts, req, "coupon", 60, 60000
  if not rl.ok
    give back rl.response
  end
  set bl to check_commerce_body_limit using req
  if not bl.ok
    give back bl.response
  end
  set cart to resolve_cart_record_from_cookie using stmts, req
  if cart is nothing or (not (cart_csrf_matches using req, cart))
    give back commerce_error using 403, "commerce_csrf_invalid", "Missing or invalid commerce cart CSRF token", ""
  end
  set crl to check_coupon_rate_limit using stmts, req, cart.id
  if not crl.ok
    give back crl.response
  end
  if cart.status is not "open"
    give back commerce_error using 409, "cart_not_open", "Cart is no longer open for modification", ""
  end
  call run_commerce_sweep using stmts, no
  try
    set payload to server.parse_json using req
    set pf_chk to reject_client_price_fields using payload
    if not pf_chk.ok
      give back commerce_error using 422, "client_price_not_allowed", "Client-supplied prices or totals are forbidden", pf_chk.field
    end
    set raw_code to ""
    if payload has "code" and (payload at "code") is not nothing
      set raw_code to text.upper using (text.trim using (text.from using (payload at "code")))
    end
    set now_rec to call dates.now_utc
    if raw_code is ""
      call data.execute using stmts.commerce.upd_cart, record {token_hash: cart.token_hash, csrf_secret: cart.csrf_secret, customer_id: cart.customer_id, user_id: cart.user_id, status: "open", coupon_code: nothing, last_activity_at: now_rec.iso, id: cart.id, req_open: 1}
      set fresh_c to data.one using stmts.commerce.get_cart, record {lookup: "id", sv: cart.id, iv: 0}
      set res_p to build_cart_response_payload using stmts, fresh_c
      give back server.response using record {status: 200, headers: {"Content-Type": "application/json; charset=utf-8", "Cache-Control": "no-store"}, body: (json.stringify using res_p)}
    end

    set coupon to data.one using stmts.commerce.get_coupons, record {mode: "code", iv: 0, sv: raw_code}
    set items to data.query using stmts.commerce.list_cart_items, record {cart_id: cart.id}
    set sub_c to 0
    for each it in items
      set sub_c to sub_c plus (it.live_price_cents times it.qty)
    end
    set v_res to validate_coupon_for_cart using stmts, coupon, sub_c, now_rec.iso
    if not v_res.ok
      give back server.json using 422, {"error": "coupon_invalid", "reason": v_res.reason, "message": v_res.message}
    end
    call data.execute using stmts.commerce.upd_cart, record {token_hash: cart.token_hash, csrf_secret: cart.csrf_secret, customer_id: cart.customer_id, user_id: cart.user_id, status: "open", coupon_code: coupon.code, last_activity_at: now_rec.iso, id: cart.id, req_open: 1}
    set fresh_c to data.one using stmts.commerce.get_cart, record {lookup: "id", sv: cart.id, iv: 0}
    set res_p to build_cart_response_payload using stmts, fresh_c
    give back server.response using record {status: 200, headers: {"Content-Type": "application/json; charset=utf-8", "Cache-Control": "no-store"}, body: (json.stringify using res_p)}
  catch err
    give back commerce_error using 400, "invalid_json", err.message, ""
  end
end

route "POST" "/api/commerce/checkout" using req
  if not stmts.commerce_ready
    give back commerce_error using 404, "commerce_disabled", "Storefront is not configured", ""
  end
  set cfg to get_commerce_config using stmts
  if not cfg.enabled
    give back commerce_error using 404, "commerce_disabled", "Storefront is currently disabled", ""
  end
  set rl to check_commerce_rate_limit using stmts, req, "checkout", 60, 60000
  if not rl.ok
    give back rl.response
  end
  set bl to check_commerce_body_limit using req
  if not bl.ok
    give back bl.response
  end
  set cart to resolve_cart_record_from_cookie using stmts, req
  if cart is nothing or (not (cart_csrf_matches using req, cart))
    give back commerce_error using 403, "commerce_csrf_invalid", "Missing or invalid commerce cart CSRF token", ""
  end
  if cfg.payment_allowlist is "" or cfg.payment_template is ""
    give back commerce_error using 503, "payment_not_configured", "Payment redirect settings have not been configured by an administrator", ""
  end

  set idem_key to get_req_header using req, "idempotency-key"
  if not (is_allowed_chars using idem_key, "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789_-", 16, 64)
    give back commerce_error using 400, "idempotency_key_required", "Idempotency-Key header (16-64 safe chars) is required", "Idempotency-Key"
  end

  set payload to {}
  try
    set payload to server.parse_json using req
  catch err
    give back commerce_error using 400, "invalid_json", err.message, ""
  end
  set pf_chk to reject_client_price_fields using payload
  if not pf_chk.ok
    give back commerce_error using 422, "client_price_not_allowed", "Client-supplied prices or totals are forbidden", pf_chk.field
  end
  if (has_map_key using payload, "cart_id") and ((payload at "cart_id") is not nothing)
    if (text.from using (payload at "cart_id")) is not cart.id
      give back commerce_error using 403, "cross_shopper_cart_forbidden", "Cannot checkout another shopper's cart", "cart_id"
    end
  end

  set now_rec to call dates.now_utc
  set stale_cut_rec to dates.from_unix using (now_rec.unix minus 60)
  set req_hash to crypto.sha256_hex using req.body

  # Step A: claim per-cart idempotency key in its own short transaction
  set claim_ok to no
  set claim_resp to nothing
  set tx_a to data.begin using stmts.db
  try
    set existing_k to data.one using stmts.commerce.get_idem, record {scope: cart.id, key: idem_key}, tx_a
    if existing_k is not nothing
      if existing_k.state is "done"
        if existing_k.request_hash is req_hash
          set ord_ex to data.one using stmts.commerce.get_orders, record {mode: "id", iv: existing_k.order_id, sv: ""}, tx_a
          set onum to ""
          if ord_ex is not nothing
            set onum to ord_ex.number
          end
          call data.rollback using tx_a
          give back server.json using 409, {"error": "idempotency_conflict", "message": "Duplicate checkout request; returning original order reference", "order_number": onum, "redirect_url": existing_k.redirect_url}
        otherwise
          call data.rollback using tx_a
          give back commerce_error using 422, "idempotency_key_reuse", "Idempotency-Key reused with a different checkout payload", "Idempotency-Key"
        end
      end
      if existing_k.created_at is greater than stale_cut_rec.iso
        call data.rollback using tx_a
        give back commerce_error using 409, "idempotency_conflict", "Checkout already in progress for this Idempotency-Key", "Idempotency-Key"
      end
      set reclaim to data.execute using stmts.commerce.upd_idem, record {request_hash: req_hash, state: "in_flight", order_id: nothing, redirect_url: nothing, created_at: now_rec.iso, scope: cart.id, key: idem_key, req_state: "in_flight"}, tx_a
      if reclaim.rows_affected is not 1
        call data.rollback using tx_a
        give back commerce_error using 409, "idempotency_conflict", "Concurrent checkout claimed this Idempotency-Key", "Idempotency-Key"
      end
      call data.commit using tx_a
      set claim_ok to yes
    otherwise
      call data.execute using stmts.commerce.ins_idem, record {scope: cart.id, key: idem_key, request_hash: req_hash, state: "in_flight", order_id: nothing, redirect_url: nothing, created_at: now_rec.iso}, tx_a
      call data.commit using tx_a
      set claim_ok to yes
    end
  catch claim_err
    try
      call data.rollback using tx_a
    catch rb_err
    end
    set check_after to data.one using stmts.commerce.get_idem, record {scope: cart.id, key: idem_key}
    if check_after is not nothing
      if check_after.state is "done" and check_after.request_hash is req_hash
        set ord_after to data.one using stmts.commerce.get_orders, record {mode: "id", iv: check_after.order_id, sv: ""}
        set onum2 to ""
        if ord_after is not nothing
          set onum2 to ord_after.number
        end
        give back server.json using 409, {"error": "idempotency_conflict", "message": "Duplicate checkout request; returning original order reference", "order_number": onum2, "redirect_url": check_after.redirect_url}
      end
      if check_after.request_hash is not req_hash
        give back commerce_error using 422, "idempotency_key_reuse", "Idempotency-Key reused with a different checkout payload", "Idempotency-Key"
      end
    end
    give back commerce_error using 409, "idempotency_conflict", "Concurrent checkout conflict; retry with the same Idempotency-Key", "Idempotency-Key"
  end

  if not claim_ok
    give back commerce_error using 409, "idempotency_conflict", "Checkout claim failed", "Idempotency-Key"
  end

  call run_commerce_sweep using stmts, no

  # Step B: serializable order creation transaction
  set tx_b to data.begin using stmts.db
  set step_b_error_status to 0
  set step_b_error_payload to {}
  set refresh_cart_prices to no
  set committed_ord_num to ""
  set committed_tot to nothing
  set committed_redir_url to ""
  set committed_ret_url to ""
  set touched_pids to []

  try
    set cur_cart to data.one using stmts.commerce.get_cart, record {lookup: "id", sv: cart.id, iv: 0}, tx_b
    if cur_cart is nothing or cur_cart.status is not "open"
      set step_b_error_status to 409
      set step_b_error_payload to {"error": "cart_not_open", "message": "Cart is no longer open for checkout"}
    otherwise
      set items to data.query using stmts.commerce.list_cart_items, record {cart_id: cur_cart.id}, tx_b
      if (collections.length using items) is 0
        set step_b_error_status to 400
        set step_b_error_payload to {"error": "empty_cart", "message": "Cannot checkout with an empty cart"}
      otherwise
        set all_pub to yes
        set any_price_changed to no
        for each it in items
          set touched_pids to collections.append using touched_pids, it.product_id
          if it.entry_status is not "published" or it.active is not 1
            set all_pub to no
          end
          if it.live_price_cents is not it.unit_price_cents
            set any_price_changed to yes
          end
        end
        if not all_pub
          set step_b_error_status to 409
          set step_b_error_payload to {"error": "product_unavailable", "message": "One or more items in the cart are no longer published or active"}
        otherwise
          if any_price_changed
            set refresh_cart_prices to yes
            set step_b_error_status to 409
            set step_b_error_payload to {"error": "price_changed", "message": "One or more product prices changed since added to cart; please review updated totals"}
          otherwise
            set carrier_res to validate_carrier_constraints using items
            if not carrier_res.ok
              set step_b_error_status to 422
              set step_b_error_payload to {"error": carrier_res.code, "message": carrier_res.message}
            otherwise
              # Customer email & guest/logged-in resolution
              set email_raw to ""
              if payload has "email" and (payload at "email") is not nothing
                set email_raw to normalize_email using (payload at "email")
              otherwise
                if cur_cart.customer_id is not nothing
                  set existing_cust to data.one using stmts.commerce.get_customers, record {mode: "id", iv: cur_cart.customer_id, sv: ""}, tx_b
                  if existing_cust is not nothing
                    set email_raw to existing_cust.email
                  end
                end
              end
              if not (is_valid_email using email_raw)
                set step_b_error_status to 422
                set step_b_error_payload to {"error": "invalid_email", "message": "A valid email address is required for checkout", "field": "email"}
              otherwise
                set logged_sess to resolve_session using stmts, req
                if (not cfg.guest_checkout) and logged_sess is nothing
                  set step_b_error_status to 401
                  set step_b_error_payload to {"error": "login_required", "message": "Guest checkout is disabled; please sign in first"}
                otherwise
                  set linked_user_id to nothing
                  if logged_sess is not nothing
                    set linked_user_id to logged_sess.user_id
                  otherwise
                    if payload has "create_account" and (payload at "create_account") is yes
                      set acct_pw to ""
                      if payload has "password" and (payload at "password") is not nothing
                        set acct_pw to text.from using (payload at "password")
                      end
                      if not (is_valid_password using acct_pw)
                        set step_b_error_status to 422
                        set step_b_error_payload to {"error": "invalid_password", "message": "Optional account password must be at least 10 characters", "field": "password"}
                      otherwise
                        set ex_user to data.one using stmts.get_user, record {lookup: "email", iv: 0, sv: email_raw}, tx_b
                        if ex_user is nothing
                          set dname_u to email_raw
                          if payload has "display_name" and (payload at "display_name") is not nothing and (text.trim using (text.from using (payload at "display_name"))) is not ""
                            set dname_u to text_truncate using (text.trim using (text.from using (payload at "display_name"))), 120
                          end
                          set pw_h to crypto.hash_password using acct_pw
                          call data.execute using stmts.insert_user, record {email: email_raw, display_name: dname_u, role: "viewer", password_hash: pw_h, email_verified: 0, is_active: 1, last_login_at: now_rec.iso, created_at: now_rec.iso, updated_at: now_rec.iso}, tx_b
                          set created_u to data.one using stmts.get_user, record {lookup: "email", iv: 0, sv: email_raw}, tx_b
                          if created_u is not nothing
                            set linked_user_id to created_u.id
                          end
                        end
                      end
                    end
                  end

                  set ship_addr_json to "{}"
                  if step_b_error_status is 0
                    if carrier_res.has_physical
                      if (not (payload has "shipping_address")) or (not (is_record_value using (payload at "shipping_address")))
                        set step_b_error_status to 422
                        set step_b_error_payload to {"error": "shipping_address_required", "message": "Physical items require a shipping_address object", "field": "shipping_address"}
                      otherwise
                        set sa to payload at "shipping_address"
                        set sa_name to ""
                        if sa has "name" and (sa at "name") is not nothing
                          set sa_name to text.trim using (text.from using (sa at "name"))
                        end
                        set sa_l1 to ""
                        if sa has "line1" and (sa at "line1") is not nothing
                          set sa_l1 to text.trim using (text.from using (sa at "line1"))
                        end
                        set sa_city to ""
                        if sa has "city" and (sa at "city") is not nothing
                          set sa_city to text.trim using (text.from using (sa at "city"))
                        end
                        set sa_st to ""
                        if sa has "state" and (sa at "state") is not nothing
                          set sa_st to text.trim using (text.from using (sa at "state"))
                        end
                        set sa_zip to ""
                        if sa has "postal_code" and (sa at "postal_code") is not nothing
                          set sa_zip to text.trim using (text.from using (sa at "postal_code"))
                        end
                        set sa_ctry to "US"
                        if sa has "country" and (sa at "country") is not nothing and (text.trim using (text.from using (sa at "country"))) is not ""
                          set sa_ctry to text.upper using (text.trim using (text.from using (sa at "country")))
                        end
                        if sa_l1 is "" or sa_city is "" or sa_st is "" or sa_zip is ""
                          set step_b_error_status to 422
                          set step_b_error_payload to {"error": "shipping_address_required", "message": "shipping_address requires line1, city, state, postal_code", "field": "shipping_address"}
                        otherwise
                          set ship_addr_json to json.stringify using {"name": sa_name, "line1": sa_l1, "city": sa_city, "state": sa_st, "postal_code": sa_zip, "country": sa_ctry}
                        end
                      end
                    end
                  end

                  if step_b_error_status is 0
                    set dname_c to ""
                    if payload has "display_name" and (payload at "display_name") is not nothing
                      set dname_c to text_truncate using (text.trim using (text.from using (payload at "display_name"))), 120
                    end
                    set mkt_consent to 0
                    if payload has "marketing_consent" and (payload at "marketing_consent") is not nothing
                      set pmc to parse_grab_integer using (payload at "marketing_consent"), 0, 1
                      if not pmc.ok
                        set step_b_error_status to 422
                        set step_b_error_payload to {"error": pmc.code, "message": pmc.error, "field": "marketing_consent"}
                      otherwise
                        set mkt_consent to pmc.val
                      end
                    otherwise
                      if payload has "marketing_opt_in" and (payload at "marketing_opt_in") is yes
                        set mkt_consent to 1
                      end
                    end

                    if step_b_error_status is 0
                      set cust to data.one using stmts.commerce.get_customers, record {mode: "email", iv: 0, sv: email_raw}, tx_b
                      if cust is nothing
                        call data.execute using stmts.commerce.ins_customer, record {user_id: linked_user_id, email: email_raw, display_name: dname_c, marketing_consent: mkt_consent, created_at: now_rec.iso, updated_at: now_rec.iso}, tx_b
                        set cust to data.one using stmts.commerce.get_customers, record {mode: "email", iv: 0, sv: email_raw}, tx_b
                      otherwise
                        set next_cuid to cust.user_id
                        if linked_user_id is not nothing
                          set next_cuid to linked_user_id
                        end
                        set next_c_consent to cust.marketing_consent
                        if (payload has "marketing_consent") or (payload has "marketing_opt_in")
                          set next_c_consent to mkt_consent
                        end
                        call data.execute using stmts.commerce.upd_customer, record {user_id: next_cuid, email: email_raw, display_name: dname_c, marketing_consent: next_c_consent, updated_at: now_rec.iso, id: cust.id}, tx_b
                      end

                      set coupon_row to nothing
                      if cur_cart.coupon_code is not nothing and cur_cart.coupon_code is not ""
                        set coupon_row to data.one using stmts.commerce.get_coupons, record {mode: "code", iv: 0, sv: cur_cart.coupon_code}, tx_b
                        set pre_sub to 0
                        for each it in items
                          set pre_sub to pre_sub plus (it.live_price_cents times it.qty)
                        end
                        set cv to validate_coupon_for_cart using stmts, coupon_row, pre_sub, now_rec.iso
                        if not cv.ok
                          if cv.reason is "exhausted"
                            set step_b_error_status to 409
                            set step_b_error_payload to {"error": "coupon_exhausted", "message": cv.message}
                          otherwise
                            set step_b_error_status to 422
                            set step_b_error_payload to {"error": "coupon_invalid", "reason": cv.reason, "message": cv.message}
                          end
                        end
                      end

                      if step_b_error_status is 0
                        set tot to compute_cart_totals using items, coupon_row, cfg, carrier_res
                        if not tot.ok
                          set step_b_error_status to 422
                          set step_b_error_payload to {"error": tot.code, "message": tot.error}
                        otherwise
                          # Conditional stock decrement
                          set stock_ok to yes
                          for each it in items
                            if stock_ok and it.stock_qty is not nothing
                              set dec_res to data.execute using stmts.commerce.adj_stock, record {delta: (0 minus it.qty), updated_at: now_rec.iso, id: it.product_id, min_check: 1}, tx_b
                              if dec_res.rows_affected is not 1
                                set stock_ok to no
                              end
                            end
                          end
                          if not stock_ok
                            set step_b_error_status to 409
                            set step_b_error_payload to {"error": "out_of_stock", "message": "Insufficient inventory to fulfill order"}
                          otherwise
                            set cpn_ok to yes
                            set claimed_cpn_id to nothing
                            if coupon_row is not nothing
                              set cpn_claim to data.execute using stmts.commerce.claim_coupon, record {updated_at: now_rec.iso, id: coupon_row.id}, tx_b
                              if cpn_claim.rows_affected is not 1
                                set cpn_ok to no
                              otherwise
                                set claimed_cpn_id to coupon_row.id
                              end
                            end
                            if not cpn_ok
                              set step_b_error_status to 409
                              set step_b_error_payload to {"error": "coupon_exhausted", "message": "Coupon redemption limit was reached concurrently"}
                            otherwise
                              set ord_hex to text.join using (collections.slice using (text.split using (crypto.random_hex using 16), ""), 0, 8), ""
                              set ord_num to "ORD-" joined with (text.from using now_rec.unix) joined with "-" joined with (text.upper using ord_hex)
                              set raw_access to crypto.random_urlsafe using 32
                              set access_hash to crypto.sha256_hex using raw_access
                              set due_rec to dates.from_unix using (now_rec.unix plus (cfg.ttl_minutes times 60))
                              call data.execute using stmts.commerce.ins_order, record {number: ord_num, cart_id: cur_cart.id, customer_id: cust.id, user_id: linked_user_id, status: "pending_payment", subtotal_cents: tot.subtotal_cents, discount_cents: tot.discount_cents, tax_cents: tot.tax_cents, shipping_cents: tot.shipping_cents, total_cents: tot.total_cents, currency: cfg.currency, coupon_id: claimed_cpn_id, payment_ref: "", access_token_hash: access_hash, shipping_address_json: ship_addr_json, needs_review: 0, review_note: "", created_at: now_rec.iso, payment_due_by: due_rec.iso, paid_at: nothing}, tx_b
                              set created_ord to data.one using stmts.commerce.get_orders, record {mode: "number", iv: 0, sv: ord_num}, tx_b
                              for each it in items
                                set car_str to ""
                                if it.carrier is not nothing
                                  set car_str to text.from using it.carrier
                                end
                                set usps_str to ""
                                if it.usps_service is not nothing
                                  set usps_str to text.from using it.usps_service
                                end
                                set lulu_str to ""
                                if it.lulu_sku is not nothing
                                  set lulu_str to text.from using it.lulu_sku
                                end
                                call data.execute using stmts.commerce.ins_order_item, record {order_id: created_ord.id, product_id: it.product_id, sku: it.sku, title: it.title, kind: it.kind, qty: it.qty, unit_price_cents: it.live_price_cents, carrier: car_str, usps_service: usps_str, lulu_sku: lulu_str}, tx_b
                              end
                              if claimed_cpn_id is not nothing
                                call data.execute using stmts.commerce.ins_coupon_redemption, record {coupon_id: claimed_cpn_id, order_id: created_ord.id, created_at: now_rec.iso}, tx_b
                              end
                              call data.execute using stmts.commerce.ins_order_audit, record {order_id: created_ord.id, actor: "shopper", from_status: "", to_status: "pending_payment", reason: "checkout_created", created_at: now_rec.iso}, tx_b
                              call data.execute using stmts.commerce.upd_cart, record {token_hash: cur_cart.token_hash, csrf_secret: cur_cart.csrf_secret, customer_id: cust.id, user_id: linked_user_id, status: "checked_out", coupon_code: cur_cart.coupon_code, last_activity_at: now_rec.iso, id: cur_cart.id, req_open: 1}, tx_b

                              set scheme_v to req.scheme
                              if scheme_v is ""
                                set scheme_v to "http"
                              end
                              set host_v to req.host
                              if host_v is ""
                                set host_v to "localhost"
                              end
                              set ret_path to "/shop/order/" joined with ord_num joined with "?t=" joined with raw_access
                              set ret_full to scheme_v joined with "://" joined with host_v joined with ret_path
                              set tot_str to format_cents_usd using tot.total_cents
                              set built_url to build_payment_redirect_url using cfg.payment_template, ord_num, tot_str, cfg.currency, ret_full
                              if not built_url.ok
                                set step_b_error_status to 502
                                set step_b_error_payload to {"error": "payment_redirect_blocked", "code": "GRAB-E402", "message": built_url.error}
                              otherwise
                                set allow_chk to validate_https_url_against_allowlist using built_url.url, cfg.payment_allowlist
                                if not allow_chk.ok
                                  set step_b_error_status to 502
                                  set step_b_error_payload to {"error": "payment_redirect_blocked", "code": "GRAB-E402", "message": allow_chk.error}
                                otherwise
                                  call data.commit using tx_b
                                  set committed_ord_num to ord_num
                                  set committed_tot to tot
                                  set committed_redir_url to allow_chk.url
                                  set committed_ret_url to ret_path
                                  call data.execute using stmts.commerce.upd_idem, record {request_hash: req_hash, state: "done", order_id: created_ord.id, redirect_url: committed_redir_url, created_at: now_rec.iso, scope: cur_cart.id, key: idem_key, req_state: "in_flight"}
                                end
                              end
                            end
                          end
                        end
                      end
                    end
                  end
                end
              end
            end
          end
        end
      end
    end
  catch tx_b_err
    set step_b_error_status to 500
    set step_b_error_payload to {"error": "checkout_failed", "message": tx_b_err.message}
  end

  if step_b_error_status is not 0
    try
      call data.rollback using tx_b
    catch rb2
    end
    try
      call data.execute using stmts.commerce.del_idem, record {scope: cart.id, key: idem_key, req_state: "in_flight"}
    catch dk
    end
    if refresh_cart_prices
      try
        set items_ref to data.query using stmts.commerce.list_cart_items, record {cart_id: cart.id}
        set tx_sync to data.begin using stmts.db
        try
          for each ir in items_ref
            call data.execute using stmts.commerce.del_cart_item, record {cart_id: cart.id, pid: ir.product_id}, tx_sync
            call data.execute using stmts.commerce.ins_cart_item, record {cart_id: cart.id, product_id: ir.product_id, qty: ir.qty, unit_price_cents: ir.live_price_cents, created_at: now_rec.iso, updated_at: now_rec.iso}, tx_sync
          end
          call data.commit using tx_sync
        catch s_err
          call data.rollback using tx_sync
        end
      catch r_err
      end
      set refreshed_cart to build_cart_response_payload using stmts, cart
      set step_b_error_payload to collections.put using step_b_error_payload, "cart", refreshed_cart
    end
    give back server.response using record {status: step_b_error_status, headers: {"Content-Type": "application/json; charset=utf-8", "Cache-Control": "no-store"}, body: (json.stringify using step_b_error_payload)}
  end

  for each tpid in touched_pids
    call invalidate_commerce_caches using stmts, tpid
  end
  set resp_body to {"order_number": committed_ord_num, "currency": cfg.currency, "subtotal": (format_cents_usd using committed_tot.subtotal_cents), "discount_total": (format_cents_usd using committed_tot.discount_cents), "tax_total": (format_cents_usd using committed_tot.tax_cents), "shipping_total": (format_cents_usd using committed_tot.shipping_cents), "total": (format_cents_usd using committed_tot.total_cents), "redirect_url": committed_redir_url, "return_url": committed_ret_url}
  give back server.response using record {status: 201, headers: {"Content-Type": "application/json; charset=utf-8", "Cache-Control": "no-store"}, body: (json.stringify using resp_body)}
end

route "GET" "/api/commerce/download/{token}" using req
  if not stmts.commerce_ready
    give back commerce_error using 404, "commerce_disabled", "Storefront is not configured", ""
  end
  set cfg to get_commerce_config using stmts
  if not cfg.enabled
    give back commerce_error using 404, "commerce_disabled", "Storefront is currently disabled", ""
  end
  set raw_tok to text.trim using req.params.token
  if raw_tok is ""
    give back commerce_error using 404, "download_unavailable", "Download link is invalid or expired", ""
  end
  set tok_hash to crypto.sha256_hex using raw_tok
  set now_rec to call dates.now_utc
  set grant to data.one using stmts.commerce.get_download_grants, record {lookup: "token", sv: tok_hash, iv: 0}
  if grant is nothing or grant.remaining is at most 0 or now_rec.iso is greater than grant.expires_at
    give back commerce_error using 404, "download_unavailable", "Download link is invalid or expired", ""
  end
  if (has_unsafe_path_chars using grant.storage_path) or (text.contains using grant.storage_path, "/")
    give back commerce_error using 404, "download_unavailable", "Invalid storage asset path", ""
  end
  set upload_dir to call get_upload_dir
  set file_path to upload_dir joined with "/" joined with grant.storage_path
  if not (files.exists using file_path)
    give back commerce_error using 404, "download_unavailable", "Asset missing from storage", ""
  end
  set dec_res to data.execute using stmts.commerce.upd_download_grant, record {token_hash: grant.token_hash, dec: 1, id: grant.id}
  if dec_res.rows_affected is not 1
    give back commerce_error using 404, "download_unavailable", "Download limit reached", ""
  end
  set safe_fname to text.replace using (text.replace using grant.original_name, "\"", ""), "/", "_"
  set raw_b64 to files.read_text using file_path
  give back server.response using record {status: 200, headers: {"Content-Type": grant.mime_type, "X-Content-Type-Options": "nosniff", "Content-Security-Policy": "default-src 'none'", "Cache-Control": "no-store", "Referrer-Policy": "no-referrer", "Content-Disposition": ("attachment; filename=\"" joined with safe_fname joined with "\""), "X-GrabLab-Payload-Encoding": "base64"}, body: raw_b64}
end

make require_commerce_admin_api using stmts, req, cap, require_csrf
  set bearer to extract_bearer_token using req
  if bearer is not ""
    give back record {ok: no, session: nothing, response: (commerce_error using 401, "bearer_not_allowed", "Admin commerce endpoints require cookie session authentication, not MCP Bearer tokens", "")}
  end
  give back require_api_auth using stmts, req, cap, require_csrf
end

make format_order_admin_row using o, cfg
  give back {"id": o.id, "number": o.number, "cart_id": o.cart_id, "customer_id": o.customer_id, "customer_email": o.customer_email, "customer_name": o.customer_name, "user_id": o.user_id, "status": o.status, "subtotal": (format_cents_usd using o.subtotal_cents), "discount_total": (format_cents_usd using o.discount_cents), "tax_total": (format_cents_usd using o.tax_cents), "shipping_total": (format_cents_usd using o.shipping_cents), "total": (format_cents_usd using o.total_cents), "currency": o.currency, "coupon_id": o.coupon_id, "payment_ref": o.payment_ref, "needs_review": (o.needs_review is 1), "review_note": o.review_note, "created_at": o.created_at, "payment_due_by": o.payment_due_by, "paid_at": o.paid_at}
end

make format_coupon_api_row using c
  give back {"id": c.id, "code": c.code, "type": c.type, "value": c.value, "min_subtotal": (format_cents_usd using c.min_subtotal_cents), "max_redemptions": c.max_redemptions, "redeemed_count": c.redeemed_count, "starts_at": c.starts_at, "ends_at": c.ends_at, "active": (c.active is 1), "created_by": c.created_by, "created_at": c.created_at, "updated_at": c.updated_at}
end

route "GET" "/api/admin/commerce/status" using req
  set auth to require_commerce_admin_api using stmts, req, "admin:access", no
  if not auth.ok
    give back auth.response
  end
  set enabled to no
  if stmts.commerce_ready
    set cfg to get_commerce_config using stmts
    set enabled to cfg.enabled
  end
  give back server.json using 200, {"ready": stmts.commerce_ready, "enabled": enabled, "can_manage": (role_has_capability using auth.session.role, "commerce:manage"), "can_settings": (role_has_capability using auth.session.role, "commerce:settings")}
end

route "GET" "/api/admin/commerce/overview" using req
  set auth to require_commerce_admin_api using stmts, req, "commerce:manage", no
  if not auth.ok
    give back auth.response
  end
  if not stmts.commerce_ready
    give back commerce_error using 404, "commerce_not_migrated", "Migration 004 has not been applied", ""
  end
  call run_commerce_sweep using stmts, no
  set cfg to get_commerce_config using stmts
  set prods to data.query using stmts.commerce.products, record {mode: "all", iv: 0, sv: ""}
  set ords to data.query using stmts.commerce.get_orders, record {mode: "all", iv: 0, sv: ""}
  set rev_ords to data.query using stmts.commerce.get_orders, record {mode: "review", iv: 0, sv: ""}
  set cpns to data.query using stmts.commerce.get_coupons, record {mode: "all", iv: 0, sv: ""}
  set custs to data.query using stmts.commerce.get_customers, record {mode: "all", iv: 0, sv: ""}
  set evs to data.query using stmts.commerce.commerce_events, record {mode: "list", after_id: 0, sv: "", subj: "", lim: 50}
  set rev_out to []
  for each ro in rev_ords
    set rev_out to collections.append using rev_out, (format_order_admin_row using ro, cfg)
  end
  give back server.json using 200, {"enabled": cfg.enabled, "currency": cfg.currency, "counts": {"products": (collections.length using prods), "orders": (collections.length using ords), "needs_review": (collections.length using rev_ords), "coupons": (collections.length using cpns), "customers": (collections.length using custs), "events": (collections.length using evs)}, "needs_review_orders": rev_out}
end

route "GET" "/api/admin/commerce/products" using req
  set auth to require_commerce_admin_api using stmts, req, "commerce:manage", no
  if not auth.ok
    give back auth.response
  end
  if not stmts.commerce_ready
    give back commerce_error using 404, "commerce_not_migrated", "Migration 004 has not been applied", ""
  end
  call run_commerce_sweep using stmts, no
  set prods to data.query using stmts.commerce.products, record {mode: "all", iv: 0, sv: ""}
  set out to []
  for each p in prods
    set row_obj to format_product_api_row using p
    set dfs to data.query using stmts.commerce.list_digital_files, record {product_id: p.id}
    set row_obj to collections.put using row_obj, "digital_files", dfs
    set out to collections.append using out, row_obj
  end
  give back server.json using 200, {"products": out}
end

route "POST" "/api/admin/commerce/products" using req
  set auth to require_commerce_admin_api using stmts, req, "commerce:manage", yes
  if not auth.ok
    give back auth.response
  end
  if not stmts.commerce_ready
    give back commerce_error using 404, "commerce_not_migrated", "Migration 004 has not been applied", ""
  end
  set bl to check_commerce_body_limit using req
  if not bl.ok
    give back bl.response
  end
  try
    set payload to server.parse_json using req
    call ensure_commerce_salt_and_type using stmts
    set ct to data.one using stmts.get_type, record {lookup: "slug", sv: "product", iv: 0}
    if ct is nothing
      give back commerce_error using 500, "missing_product_type", "Product content type could not be initialized", ""
    end

    if (not (payload has "sku")) or (not (payload has "price"))
      give back commerce_error using 400, "missing_fields", "sku and price are required", ""
    end
    set sku_val to text.trim using (text.from using (payload at "sku"))
    if not (is_allowed_chars using sku_val, "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789_-", 1, 64)
      give back commerce_error using 422, "invalid_sku", "SKU must be 1-64 safe characters", "sku"
    end
    set p_price to parse_money_cents using (payload at "price"), no, 9999999999
    if not p_price.ok
      give back commerce_error using 422, p_price.code, p_price.error, "price"
    end
    set comp_cents to nothing
    if payload has "compare_at_price" and (payload at "compare_at_price") is not nothing and (text.from using (payload at "compare_at_price")) is not ""
      set p_comp to parse_money_cents using (payload at "compare_at_price"), no, 9999999999
      if not p_comp.ok
        give back commerce_error using 422, p_comp.code, p_comp.error, "compare_at_price"
      end
      set comp_cents to p_comp.cents
    end

    set kind_val to "physical"
    if payload has "kind" and (payload at "kind") is not nothing
      set kind_val to text.lower using (text.trim using (text.from using (payload at "kind")))
    end
    if kind_val is not "physical" and kind_val is not "digital"
      give back commerce_error using 422, "invalid_kind", "Product kind must be physical or digital", "kind"
    end

    set stock_val to nothing
    if payload has "stock_qty" and (payload at "stock_qty") is not nothing and (text.from using (payload at "stock_qty")) is not ""
      set p_st to parse_grab_integer using (payload at "stock_qty"), 0, 999999
      if not p_st.ok
        give back commerce_error using 422, p_st.code, p_st.error, "stock_qty"
      end
      set stock_val to p_st.val
    end

    set weight_val to 0
    if kind_val is "physical"
      if payload has "weight_g" and (payload at "weight_g") is not nothing
        set p_wg to parse_grab_integer using (payload at "weight_g"), 1, 31751
        if not p_wg.ok
          give back commerce_error using 422, p_wg.code, p_wg.error, "weight_g"
        end
        set weight_val to p_wg.val
      otherwise
        set weight_val to 250
      end
    end

    set tax_class to "standard"
    if kind_val is "digital"
      set tax_class to "digital"
    end
    if payload has "tax_class" and (payload at "tax_class") is not nothing
      set tc_in to text.lower using (text.trim using (text.from using (payload at "tax_class")))
      if tc_in is not "standard" and tc_in is not "reduced" and tc_in is not "digital" and tc_in is not "exempt"
        give back commerce_error using 422, "invalid_tax_class", "Unsupported tax_class", "tax_class"
      end
      set tax_class to tc_in
    end

    set active_val to 1
    if payload has "active" and (payload at "active") is not nothing
      if (payload at "active") is no or (payload at "active") is 0
        set active_val to 0
      end
    end

    set carrier_val to "usps"
    set lulu_sku_val to ""
    set usps_svc to "ground_advantage"
    set max_wg to 31751
    set media_mail_el to 0
    if kind_val is "physical"
      if payload has "carrier" and (payload at "carrier") is not nothing
        set carrier_val to text.lower using (text.trim using (text.from using (payload at "carrier")))
      end
      if carrier_val is not "usps" and carrier_val is not "lulu_direct"
        give back commerce_error using 422, "LULU-USPS-001", "Physical products support only usps or lulu_direct carriers (UPS/FedEx/DHL disallowed)", "carrier"
      end
      if carrier_val is "usps"
        if payload has "usps_service" and (payload at "usps_service") is not nothing
          set usps_svc to text.lower using (text.trim using (text.from using (payload at "usps_service")))
        end
        if usps_svc is not "ground_advantage" and usps_svc is not "priority" and usps_svc is not "media_mail"
          give back commerce_error using 422, "LULU-USPS-001", "Unsupported USPS service tier", "usps_service"
        end
        if payload has "max_weight_g" and (payload at "max_weight_g") is not nothing
          set p_mw to parse_grab_integer using (payload at "max_weight_g"), 1, 31751
          if not p_mw.ok
            give back commerce_error using 422, p_mw.code, p_mw.error, "max_weight_g"
          end
          set max_wg to p_mw.val
        end
        if weight_val is greater than max_wg
          give back commerce_error using 422, "weight_exceeds_carrier_limit", "Product weight exceeds max_weight_g", "weight_g"
        end
        if payload has "media_mail_eligible" and (payload at "media_mail_eligible") is not nothing
          if (payload at "media_mail_eligible") is yes or (payload at "media_mail_eligible") is 1
            set media_mail_el to 1
          end
        end
      otherwise
        if payload has "lulu_sku" and (payload at "lulu_sku") is not nothing
          set lulu_sku_val to text.trim using (text.from using (payload at "lulu_sku"))
        end
        if lulu_sku_val is ""
          give back commerce_error using 422, "lulu_sku_required", "lulu_direct carrier requires non-empty lulu_sku", "lulu_sku"
        end
      end
    end

    set dup_sku to data.one using stmts.commerce.products, record {mode: "sku", iv: 0, sv: sku_val}
    if dup_sku is not nothing
      give back commerce_error using 409, "duplicate_sku", "A product with this SKU already exists", "sku"
    end

    set now_rec to call dates.now_utc
    set entry_id_val to 0
    set create_new_entry to yes
    if payload has "entry_id" and (payload at "entry_id") is not nothing
      set pe to parse_grab_integer using (payload at "entry_id"), 1, 2147483647
      if not pe.ok
        give back commerce_error using 422, pe.code, pe.error, "entry_id"
      end
      set existing_ent to data.one using stmts.get_entry_by_id, record {id: pe.val}
      if existing_ent is nothing or existing_ent.content_type_slug is not "product"
        give back commerce_error using 404, "entry_not_found", "Referenced product entry not found", "entry_id"
      end
      set dup_pe to data.one using stmts.commerce.products, record {mode: "entry", iv: pe.val, sv: ""}
      if dup_pe is not nothing
        give back commerce_error using 409, "duplicate_product_entry", "Entry already has a product record", "entry_id"
      end
      set entry_id_val to pe.val
      set create_new_entry to no
    end

    set ent_slug to ""
    set ent_full_path to ""
    set ent_title to ""
    set ent_status to "published"
    set ent_body to ""
    set ent_cf_json to "{}"
    set ent_meta_t to ""
    set ent_meta_d to ""
    if create_new_entry
      if (not (payload has "title")) or (not (payload has "slug"))
        give back commerce_error using 400, "missing_entry_fields", "title and slug (or entry_id) are required", ""
      end
      set ent_slug to normalize_slug using (text.from using (payload at "slug"))
      if not (is_valid_entry_slug using ent_slug)
        give back commerce_error using 400, "invalid_slug", "Invalid product slug", "slug"
      end
      set ent_full_path to compute_full_path using ct.permalink_pattern, ent_slug
      if is_reserved_path using ent_full_path
        give back commerce_error using 400, "reserved_path", "Product permalink collides with reserved route", "slug"
      end
      set path_col to data.one using stmts.get_entry_by_full_path, record {full_path: ent_full_path}
      if path_col is not nothing
        give back commerce_error using 409, "duplicate_slug", "An entry already exists at " joined with ent_full_path, "slug"
      end
      set ent_title to text.trim using (text.from using (payload at "title"))
      if ent_title is ""
        give back commerce_error using 400, "missing_title", "Product title cannot be empty", "title"
      end
      if payload has "status" and (payload at "status") is not nothing
        set ent_status to text.lower using (text.trim using (text.from using (payload at "status")))
      end
      if ent_status is not "draft" and ent_status is not "published" and ent_status is not "archived"
        give back commerce_error using 400, "invalid_status", "Status must be draft, published, or archived", "status"
      end
      if ent_status is "published" and (not (role_has_capability using auth.session.role, "entries:publish"))
        give back commerce_error using 403, "forbidden", "Insufficient role capability to publish products", "status"
      end
      if payload has "body_html" and (payload at "body_html") is not nothing
        set bres to normalize_and_validate_body using (payload at "body_html")
        if not bres.ok
          give back commerce_error using 400, "invalid_body", bres.error, "body_html"
        end
        set ent_body to bres.body_html
      end
      set cf_in to {}
      if payload has "custom_fields" and (payload at "custom_fields") is not nothing
        set cf_in to payload at "custom_fields"
      end
      set cf_res to validate_custom_fields using stmts, ct.id, cf_in
      if not cf_res.ok
        give back commerce_error using 422, "invalid_custom_fields", cf_res.error, "custom_fields"
      end
      set ent_cf_json to cf_res.json_text
      if payload has "meta_title" and (payload at "meta_title") is not nothing
        set ent_meta_t to text.from using (payload at "meta_title")
      end
      if payload has "meta_description" and (payload at "meta_description") is not nothing
        set ent_meta_d to text.from using (payload at "meta_description")
      end
    end

    set tx to data.begin using stmts.db
    try
      if create_new_entry
        set pub_at to nothing
        if ent_status is "published"
          set pub_at to now_rec.iso
        end
        call data.execute using stmts.insert_entry, record {content_type_id: ct.id, slug: ent_slug, full_path: ent_full_path, title: ent_title, status: ent_status, body_html: ent_body, custom_fields_json: ent_cf_json, meta_title: ent_meta_t, meta_description: ent_meta_d, author_id: auth.session.user_id, published_at: pub_at, created_at: now_rec.iso, updated_at: now_rec.iso}, tx
        set created_e to data.one using stmts.get_entry_by_full_path, record {full_path: ent_full_path}, tx
        set entry_id_val to created_e.id
      end
      call data.execute using stmts.commerce.ins_product, record {entry_id: entry_id_val, sku: sku_val, kind: kind_val, price_cents: p_price.cents, compare_at_cents: comp_cents, currency: "USD", stock_qty: stock_val, weight_g: weight_val, tax_class: tax_class, active: active_val, created_at: now_rec.iso, updated_at: now_rec.iso}, tx
      set created_p to data.one using stmts.commerce.products, record {mode: "sku", iv: 0, sv: sku_val}, tx
      if kind_val is "physical"
        call data.execute using stmts.commerce.ins_fulfillment, record {product_id: created_p.id, carrier: carrier_val, lulu_sku: lulu_sku_val, usps_service: usps_svc, max_weight_g: max_wg, media_mail_eligible: media_mail_el, ships_from_country: "US"}, tx
      end
      if kind_val is "digital" and (payload has "digital_media_id") and (payload at "digital_media_id") is not nothing
        set pm to parse_grab_integer using (payload at "digital_media_id"), 1, 2147483647
        if not pm.ok
          call data.rollback using tx
          give back commerce_error using 422, pm.code, pm.error, "digital_media_id"
        end
        set m_row to data.one using stmts.get_media, record {lookup: "id", iv: pm.val, sv: ""}, tx
        if m_row is nothing
          call data.rollback using tx
          give back commerce_error using 404, "media_not_found", "Referenced digital media asset not found", "digital_media_id"
        end
        set dl_lim to 5
        if payload has "download_limit" and (payload at "download_limit") is not nothing
          set pdl to parse_grab_integer using (payload at "download_limit"), 1, 100
          if pdl.ok
            set dl_lim to pdl.val
          end
        end
        set dl_exp to 72
        if payload has "expiry_hours" and (payload at "expiry_hours") is not nothing
          set pde to parse_grab_integer using (payload at "expiry_hours"), 1, 8760
          if pde.ok
            set dl_exp to pde.val
          end
        end
        call data.execute using stmts.commerce.ins_digital_file, record {product_id: created_p.id, media_id: m_row.id, download_limit: dl_lim, expiry_hours: dl_exp, created_at: now_rec.iso}, tx
      end
      set final_p to data.one using stmts.commerce.products, record {mode: "id", iv: created_p.id, sv: ""}, tx
      call data.commit using tx
      call invalidate_commerce_caches using stmts, created_p.id
      call invalidate_route_caches using stmts, final_p.full_path, "", "product"
      give back server.json using 201, {"product": (format_product_api_row using final_p)}
    catch tx_err
      call data.rollback using tx
      give back commerce_error using 500, "db_error", tx_err.message, ""
    end
  catch err
    give back commerce_error using 400, "invalid_json", err.message, ""
  end
end

route "PUT" "/api/admin/commerce/products/{id}" using req
  set auth to require_commerce_admin_api using stmts, req, "commerce:manage", yes
  if not auth.ok
    give back auth.response
  end
  if not stmts.commerce_ready
    give back commerce_error using 404, "commerce_not_migrated", "Migration 004 has not been applied", ""
  end
  set bl to check_commerce_body_limit using req
  if not bl.ok
    give back bl.response
  end
  try
    set pid to text.to_integer using req.params.id
    set existing to data.one using stmts.commerce.products, record {mode: "id", iv: pid, sv: ""}
    if existing is nothing
      give back commerce_error using 404, "product_not_found", "Product not found", ""
    end
    set payload to server.parse_json using req
    set now_rec to call dates.now_utc

    set next_sku to existing.sku
    if payload has "sku" and (payload at "sku") is not nothing
      set next_sku to text.trim using (text.from using (payload at "sku"))
      if not (is_allowed_chars using next_sku, "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789_-", 1, 64)
        give back commerce_error using 422, "invalid_sku", "Invalid SKU", "sku"
      end
      set sku_col to data.one using stmts.commerce.products, record {mode: "sku", iv: 0, sv: next_sku}
      if sku_col is not nothing and sku_col.id is not pid
        give back commerce_error using 409, "duplicate_sku", "Another product already owns this SKU", "sku"
      end
    end

    set next_price_c to existing.price_cents
    if payload has "price" and (payload at "price") is not nothing
      set pp to parse_money_cents using (payload at "price"), no, 9999999999
      if not pp.ok
        give back commerce_error using 422, pp.code, pp.error, "price"
      end
      set next_price_c to pp.cents
    end

    set next_comp_c to existing.compare_at_cents
    if payload has "compare_at_price"
      if (payload at "compare_at_price") is nothing or (text.from using (payload at "compare_at_price")) is ""
        set next_comp_c to nothing
      otherwise
        set pc to parse_money_cents using (payload at "compare_at_price"), no, 9999999999
        if not pc.ok
          give back commerce_error using 422, pc.code, pc.error, "compare_at_price"
        end
        set next_comp_c to pc.cents
      end
    end

    set next_kind to existing.kind
    if payload has "kind" and (payload at "kind") is not nothing
      set next_kind to text.lower using (text.trim using (text.from using (payload at "kind")))
      if next_kind is not "physical" and next_kind is not "digital"
        give back commerce_error using 422, "invalid_kind", "Invalid product kind", "kind"
      end
    end

    set next_stock to existing.stock_qty
    if payload has "stock_qty"
      if (payload at "stock_qty") is nothing or (text.from using (payload at "stock_qty")) is ""
        set next_stock to nothing
      otherwise
        set ps to parse_grab_integer using (payload at "stock_qty"), 0, 999999
        if not ps.ok
          give back commerce_error using 422, ps.code, ps.error, "stock_qty"
        end
        set next_stock to ps.val
      end
    end

    set next_weight to existing.weight_g
    if payload has "weight_g" and (payload at "weight_g") is not nothing
      set pw to parse_grab_integer using (payload at "weight_g"), 0, 31751
      if not pw.ok
        give back commerce_error using 422, pw.code, pw.error, "weight_g"
      end
      set next_weight to pw.val
    end

    set next_tax to existing.tax_class
    if payload has "tax_class" and (payload at "tax_class") is not nothing
      set tc to text.lower using (text.trim using (text.from using (payload at "tax_class")))
      if tc is not "standard" and tc is not "reduced" and tc is not "digital" and tc is not "exempt"
        give back commerce_error using 422, "invalid_tax_class", "Unsupported tax_class", "tax_class"
      end
      set next_tax to tc
    end

    set next_active to existing.active
    if payload has "active" and (payload at "active") is not nothing
      if (payload at "active") is yes or (payload at "active") is 1
        set next_active to 1
      otherwise
        set next_active to 0
      end
    end

    set next_carrier to "usps"
    if existing.carrier is not nothing and existing.carrier is not ""
      set next_carrier to existing.carrier
    end
    if payload has "carrier" and (payload at "carrier") is not nothing
      set next_carrier to text.lower using (text.trim using (text.from using (payload at "carrier")))
    end
    set next_lulu to ""
    if existing.lulu_sku is not nothing
      set next_lulu to existing.lulu_sku
    end
    if payload has "lulu_sku" and (payload at "lulu_sku") is not nothing
      set next_lulu to text.trim using (text.from using (payload at "lulu_sku"))
    end
    set next_usps to "ground_advantage"
    if existing.usps_service is not nothing and existing.usps_service is not ""
      set next_usps to existing.usps_service
    end
    if payload has "usps_service" and (payload at "usps_service") is not nothing
      set next_usps to text.lower using (text.trim using (text.from using (payload at "usps_service")))
    end
    set next_max_wg to 31751
    if existing.max_weight_g is not nothing
      set next_max_wg to existing.max_weight_g
    end
    if payload has "max_weight_g" and (payload at "max_weight_g") is not nothing
      set pmw to parse_grab_integer using (payload at "max_weight_g"), 1, 31751
      if not pmw.ok
        give back commerce_error using 422, pmw.code, pmw.error, "max_weight_g"
      end
      set next_max_wg to pmw.val
    end
    set next_mm to 0
    if existing.media_mail_eligible is 1
      set next_mm to 1
    end
    if payload has "media_mail_eligible" and (payload at "media_mail_eligible") is not nothing
      if (payload at "media_mail_eligible") is yes or (payload at "media_mail_eligible") is 1
        set next_mm to 1
      otherwise
        set next_mm to 0
      end
    end
    if next_kind is "physical"
      if next_carrier is not "usps" and next_carrier is not "lulu_direct"
        give back commerce_error using 422, "LULU-USPS-001", "Physical products support only usps or lulu_direct carriers", "carrier"
      end
      if next_carrier is "usps"
        if next_usps is not "ground_advantage" and next_usps is not "priority" and next_usps is not "media_mail"
          give back commerce_error using 422, "LULU-USPS-001", "Unsupported USPS service tier", "usps_service"
        end
        if next_weight is greater than next_max_wg
          give back commerce_error using 422, "weight_exceeds_carrier_limit", "Product weight exceeds max_weight_g", "weight_g"
        end
      otherwise
        if next_lulu is ""
          give back commerce_error using 422, "lulu_sku_required", "lulu_direct requires non-empty lulu_sku", "lulu_sku"
        end
      end
    end

    set tx to data.begin using stmts.db
    try
      call data.execute using stmts.commerce.upd_product, record {sku: next_sku, kind: next_kind, price_cents: next_price_c, compare_at_cents: next_comp_c, stock_qty: next_stock, weight_g: next_weight, tax_class: next_tax, active: next_active, updated_at: now_rec.iso, id: pid}, tx
      call data.execute using stmts.commerce.del_fulfillment, record {product_id: pid}, tx
      if next_kind is "physical"
        call data.execute using stmts.commerce.ins_fulfillment, record {product_id: pid, carrier: next_carrier, lulu_sku: next_lulu, usps_service: next_usps, max_weight_g: next_max_wg, media_mail_eligible: next_mm, ships_from_country: "US"}, tx
      end
      if next_kind is "digital" and (payload has "digital_media_id") and (payload at "digital_media_id") is not nothing
        set pm to parse_grab_integer using (payload at "digital_media_id"), 1, 2147483647
        if not pm.ok
          call data.rollback using tx
          give back commerce_error using 422, pm.code, pm.error, "digital_media_id"
        end
        set m_row to data.one using stmts.get_media, record {lookup: "id", iv: pm.val, sv: ""}, tx
        if m_row is nothing
          call data.rollback using tx
          give back commerce_error using 404, "media_not_found", "Media asset not found", "digital_media_id"
        end
        call data.execute using stmts.commerce.del_digital_files, record {product_id: pid}, tx
        call data.execute using stmts.commerce.ins_digital_file, record {product_id: pid, media_id: m_row.id, download_limit: 5, expiry_hours: 72, created_at: now_rec.iso}, tx
      end
      set updated_p to data.one using stmts.commerce.products, record {mode: "id", iv: pid, sv: ""}, tx
      call data.commit using tx
      call invalidate_commerce_caches using stmts, pid
      call invalidate_route_caches using stmts, updated_p.full_path, "", "product"
      give back server.json using 200, {"product": (format_product_api_row using updated_p)}
    catch tx_err
      call data.rollback using tx
      give back commerce_error using 500, "db_error", tx_err.message, ""
    end
  catch err
    give back commerce_error using 400, "invalid_json", err.message, ""
  end
end

route "GET" "/api/admin/commerce/orders" using req
  set auth to require_commerce_admin_api using stmts, req, "commerce:manage", no
  if not auth.ok
    give back auth.response
  end
  if not stmts.commerce_ready
    give back commerce_error using 404, "commerce_not_migrated", "Migration 004 has not been applied", ""
  end
  call run_commerce_sweep using stmts, no
  set cfg to get_commerce_config using stmts
  set mode_v to "all"
  set sv_v to ""
  set nr_q to get_query_param using req, "needs_review"
  if nr_q is "1" or nr_q is "true"
    set mode_v to "review"
  otherwise
    set st_q to text.lower using (get_query_param using req, "status")
    if st_q is not ""
      set mode_v to "status"
      set sv_v to st_q
    end
  end
  set rows to data.query using stmts.commerce.get_orders, record {mode: mode_v, iv: 0, sv: sv_v}
  set out to []
  for each o in rows
    set out to collections.append using out, (format_order_admin_row using o, cfg)
  end
  give back server.json using 200, {"orders": out}
end

route "GET" "/api/admin/commerce/orders/{id}" using req
  set auth to require_commerce_admin_api using stmts, req, "commerce:manage", no
  if not auth.ok
    give back auth.response
  end
  if not stmts.commerce_ready
    give back commerce_error using 404, "commerce_not_migrated", "Migration 004 has not been applied", ""
  end
  try
    set oid to text.to_integer using req.params.id
    set ord to data.one using stmts.commerce.get_orders, record {mode: "id", iv: oid, sv: ""}
    if ord is nothing
      give back commerce_error using 404, "order_not_found", "Order not found", ""
    end
    set cfg to get_commerce_config using stmts
    set items to data.query using stmts.commerce.list_order_items, record {order_id: oid}
    set audits to data.query using stmts.commerce.list_order_audit, record {order_id: oid}
    set items_out to []
    for each oi in items
      set items_out to collections.append using items_out, {"id": oi.id, "product_id": oi.product_id, "sku": oi.sku, "title": oi.title, "kind": oi.kind, "qty": oi.qty, "unit_price": (format_cents_usd using oi.unit_price_cents), "carrier": oi.carrier, "usps_service": oi.usps_service, "lulu_sku": oi.lulu_sku}
    end
    set saddr to {}
    try
      set saddr to json.parse using ord.shipping_address_json
    catch err
    end
    set o_obj to format_order_admin_row using ord, cfg
    set o_obj to collections.put using o_obj, "shipping_address", saddr
    give back server.json using 200, {"order": o_obj, "items": items_out, "audit": audits}
  catch err
    give back commerce_error using 400, "invalid_order_id", err.message, ""
  end
end

route "POST" "/api/admin/commerce/orders/{id}/transition" using req
  set auth to require_commerce_admin_api using stmts, req, "commerce:manage", yes
  if not auth.ok
    give back auth.response
  end
  if not stmts.commerce_ready
    give back commerce_error using 404, "commerce_not_migrated", "Migration 004 has not been applied", ""
  end
  set bl to check_commerce_body_limit using req
  if not bl.ok
    give back bl.response
  end
  try
    set oid to text.to_integer using req.params.id
    set ord to data.one using stmts.commerce.get_orders, record {mode: "id", iv: oid, sv: ""}
    if ord is nothing
      give back commerce_error using 404, "order_not_found", "Order not found", ""
    end
    set payload to server.parse_json using req
    set pf_chk to reject_client_price_fields using payload
    if not pf_chk.ok
      give back commerce_error using 422, "client_price_not_allowed", "Order totals are read-only and cannot be edited", pf_chk.field
    end
    set to_st to ""
    if payload has "status" and (payload at "status") is not nothing
      set to_st to text.lower using (text.trim using (text.from using (payload at "status")))
    end
    set reason_v to "admin_transition"
    if payload has "reason" and (payload at "reason") is not nothing and (text.trim using (text.from using (payload at "reason"))) is not ""
      set reason_v to text_truncate using (text.trim using (text.from using (payload at "reason"))), 200
    end
    set is_admin to (auth.session.role is "admin")
    if not (is_valid_order_transition using ord.status, to_st, is_admin)
      give back commerce_error using 409, "invalid_transition", "Disallowed or unauthorized order status transition from " joined with ord.status joined with " to " joined with to_st, "status"
    end

    set now_rec to call dates.now_utc
    set actor_v to "user:" joined with (text.from using auth.session.user_id)
    set cfg to get_commerce_config using stmts
    set tx to data.begin using stmts.db
    try
      if ord.status is "pending_payment" and (to_st is "cancelled" or to_st is "expired" or to_st is "payment_failed")
        set ok_rel to release_order_reservations_tx using stmts, ord, to_st, actor_v, reason_v, now_rec.iso, tx
        if not ok_rel
          call data.rollback using tx
          give back commerce_error using 409, "invalid_transition", "Concurrent order state change", "status"
        end
      otherwise
        set next_nr to ord.needs_review
        set next_rn to ord.review_note
        if (ord.status is "paid" or ord.status is "fulfilling") and to_st is "cancelled"
          set next_nr to 1
          set next_rn to "Admin cancelled paid order — process refund out of band: " joined with reason_v
        end
        set next_paid_at to ord.paid_at
        if to_st is "paid" and next_paid_at is nothing
          set next_paid_at to now_rec.iso
        end
        set upd to data.execute using stmts.commerce.upd_order, record {number: ord.number, status: to_st, needs_review: next_nr, review_note: next_rn, shipping_address_json: ord.shipping_address_json, paid_at: next_paid_at, payment_ref: ord.payment_ref, id: oid, req_status: ord.status}, tx
        if upd.rows_affected is not 1
          call data.rollback using tx
          give back commerce_error using 409, "invalid_transition", "Concurrent order state change", "status"
        end
        call data.execute using stmts.commerce.ins_order_audit, record {order_id: oid, actor: actor_v, from_status: ord.status, to_status: to_st, reason: reason_v, created_at: now_rec.iso}, tx
      end
      set updated_ord to data.one using stmts.commerce.get_orders, record {mode: "id", iv: oid, sv: ""}, tx
      set audits to data.query using stmts.commerce.list_order_audit, record {order_id: oid}, tx
      call data.commit using tx
      give back server.json using 200, {"order": (format_order_admin_row using updated_ord, cfg), "audit": audits}
    catch tx_err
      call data.rollback using tx
      give back commerce_error using 500, "db_error", tx_err.message, ""
    end
  catch err
    give back commerce_error using 400, "invalid_json", err.message, ""
  end
end

route "POST" "/api/admin/commerce/orders/{id}/resolve-review" using req
  set auth to require_commerce_admin_api using stmts, req, "commerce:manage", yes
  if not auth.ok
    give back auth.response
  end
  if not stmts.commerce_ready
    give back commerce_error using 404, "commerce_not_migrated", "Migration 004 has not been applied", ""
  end
  try
    set oid to text.to_integer using req.params.id
    set ord to data.one using stmts.commerce.get_orders, record {mode: "id", iv: oid, sv: ""}
    if ord is nothing
      give back commerce_error using 404, "order_not_found", "Order not found", ""
    end
    set payload to server.parse_json using req
    set note_v to "Review acknowledged by merchant"
    if payload has "note" and (payload at "note") is not nothing and (text.trim using (text.from using (payload at "note"))) is not ""
      set note_v to text_truncate using (text.trim using (text.from using (payload at "note"))), 200
    end
    set now_rec to call dates.now_utc
    set actor_v to "user:" joined with (text.from using auth.session.user_id)
    set tx to data.begin using stmts.db
    try
      call data.execute using stmts.commerce.upd_order, record {number: ord.number, status: ord.status, needs_review: 0, review_note: note_v, shipping_address_json: ord.shipping_address_json, paid_at: ord.paid_at, payment_ref: ord.payment_ref, id: oid, req_status: ""}, tx
      call data.execute using stmts.commerce.ins_order_audit, record {order_id: oid, actor: actor_v, from_status: ord.status, to_status: ord.status, reason: ("review_resolved: " joined with note_v), created_at: now_rec.iso}, tx
      set updated to data.one using stmts.commerce.get_orders, record {mode: "id", iv: oid, sv: ""}, tx
      call data.commit using tx
      set cfg to get_commerce_config using stmts
      give back server.json using 200, {"order": (format_order_admin_row using updated, cfg)}
    catch tx_err
      call data.rollback using tx
      give back commerce_error using 500, "db_error", tx_err.message, ""
    end
  catch err
    give back commerce_error using 400, "invalid_json", err.message, ""
  end
end

route "GET" "/api/admin/commerce/coupons" using req
  set auth to require_commerce_admin_api using stmts, req, "commerce:manage", no
  if not auth.ok
    give back auth.response
  end
  if not stmts.commerce_ready
    give back commerce_error using 404, "commerce_not_migrated", "Migration 004 has not been applied", ""
  end
  set rows to data.query using stmts.commerce.get_coupons, record {mode: "all", iv: 0, sv: ""}
  set out to []
  for each c in rows
    set out to collections.append using out, (format_coupon_api_row using c)
  end
  give back server.json using 200, {"coupons": out}
end

route "POST" "/api/admin/commerce/coupons" using req
  set auth to require_commerce_admin_api using stmts, req, "commerce:manage", yes
  if not auth.ok
    give back auth.response
  end
  if not stmts.commerce_ready
    give back commerce_error using 404, "commerce_not_migrated", "Migration 004 has not been applied", ""
  end
  set bl to check_commerce_body_limit using req
  if not bl.ok
    give back bl.response
  end
  try
    set payload to server.parse_json using req
    if (not (payload has "code")) or (not (payload has "type")) or (not (payload has "value"))
      give back commerce_error using 400, "missing_fields", "code, type, and value are required", ""
    end
    set code_u to text.upper using (text.trim using (text.from using (payload at "code")))
    if not (is_allowed_chars using code_u, "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_-", 3, 40)
      give back commerce_error using 422, "invalid_coupon_code", "Coupon code must be 3-40 uppercase alphanumeric characters (_ or -)", "code"
    end
    set ctype to text.lower using (text.trim using (text.from using (payload at "type")))
    if ctype is not "percent_bp" and ctype is not "fixed_cents"
      give back commerce_error using 422, "invalid_coupon_type", "Coupon type must be percent_bp or fixed_cents", "type"
    end
    set val_max to 9999999999
    if ctype is "percent_bp"
      set val_max to 10000
    end
    set p_val to parse_grab_integer using (payload at "value"), 1, val_max
    if not p_val.ok
      give back commerce_error using 422, p_val.code, p_val.error, "value"
    end
    set min_sub_c to 0
    if payload has "min_subtotal" and (payload at "min_subtotal") is not nothing and (text.from using (payload at "min_subtotal")) is not ""
      set p_min to parse_money_cents using (payload at "min_subtotal"), yes, 9999999999
      if not p_min.ok
        give back commerce_error using 422, p_min.code, p_min.error, "min_subtotal"
      end
      set min_sub_c to p_min.cents
    end
    set max_red to 100
    if payload has "max_redemptions" and (payload at "max_redemptions") is not nothing
      set p_max to parse_grab_integer using (payload at "max_redemptions"), 1, 1000000
      if not p_max.ok
        give back commerce_error using 422, p_max.code, p_max.error, "max_redemptions"
      end
      set max_red to p_max.val
    end
    set active_v to 1
    if payload has "active" and (payload at "active") is not nothing
      if (payload at "active") is no or (payload at "active") is 0
        set active_v to 0
      end
    end
    set dup to data.one using stmts.commerce.get_coupons, record {mode: "code", iv: 0, sv: code_u}
    if dup is not nothing
      give back commerce_error using 409, "duplicate_coupon", "Coupon code already exists", "code"
    end
    set starts_at to nothing
    if payload has "starts_at" and (payload at "starts_at") is not nothing and (text.trim using (text.from using (payload at "starts_at"))) is not ""
      set starts_at to text.trim using (text.from using (payload at "starts_at"))
    end
    set ends_at to nothing
    if payload has "ends_at" and (payload at "ends_at") is not nothing and (text.trim using (text.from using (payload at "ends_at"))) is not ""
      set ends_at to text.trim using (text.from using (payload at "ends_at"))
    end
    set now_rec to call dates.now_utc
    set cby to "admin:" joined with (text.from using auth.session.user_id)
    call data.execute using stmts.commerce.ins_coupon, record {code: code_u, type: ctype, value: p_val.val, min_subtotal_cents: min_sub_c, max_redemptions: max_red, redeemed_count: 0, starts_at: starts_at, ends_at: ends_at, active: active_v, created_by: cby, created_at: now_rec.iso, updated_at: now_rec.iso}
    set created to data.one using stmts.commerce.get_coupons, record {mode: "code", iv: 0, sv: code_u}
    give back server.json using 201, {"coupon": (format_coupon_api_row using created)}
  catch err
    give back commerce_error using 400, "invalid_json", err.message, ""
  end
end

route "PUT" "/api/admin/commerce/coupons/{id}" using req
  set auth to require_commerce_admin_api using stmts, req, "commerce:manage", yes
  if not auth.ok
    give back auth.response
  end
  if not stmts.commerce_ready
    give back commerce_error using 404, "commerce_not_migrated", "Migration 004 has not been applied", ""
  end
  try
    set cid to text.to_integer using req.params.id
    set existing to data.one using stmts.commerce.get_coupons, record {mode: "id", iv: cid, sv: ""}
    if existing is nothing
      give back commerce_error using 404, "coupon_not_found", "Coupon not found", ""
    end
    set payload to server.parse_json using req
    set next_act to existing.active
    if payload has "active" and (payload at "active") is not nothing
      if (payload at "active") is yes or (payload at "active") is 1
        set next_act to 1
      otherwise
        set next_act to 0
      end
    end
    set next_max to existing.max_redemptions
    if payload has "max_redemptions" and (payload at "max_redemptions") is not nothing
      set pm to parse_grab_integer using (payload at "max_redemptions"), 1, 1000000
      if not pm.ok
        give back commerce_error using 422, pm.code, pm.error, "max_redemptions"
      end
      set next_max to pm.val
    end
    set next_st to existing.starts_at
    if payload has "starts_at"
      if (payload at "starts_at") is nothing or (text.trim using (text.from using (payload at "starts_at"))) is ""
        set next_st to nothing
      otherwise
        set next_st to text.trim using (text.from using (payload at "starts_at"))
      end
    end
    set next_en to existing.ends_at
    if payload has "ends_at"
      if (payload at "ends_at") is nothing or (text.trim using (text.from using (payload at "ends_at"))) is ""
        set next_en to nothing
      otherwise
        set next_en to text.trim using (text.from using (payload at "ends_at"))
      end
    end
    set now_rec to call dates.now_utc
    call data.execute using stmts.commerce.upd_coupon, record {active: next_act, max_redemptions: next_max, starts_at: next_st, ends_at: next_en, updated_at: now_rec.iso, id: cid}
    set updated to data.one using stmts.commerce.get_coupons, record {mode: "id", iv: cid, sv: ""}
    give back server.json using 200, {"coupon": (format_coupon_api_row using updated)}
  catch err
    give back commerce_error using 400, "invalid_json", err.message, ""
  end
end

route "GET" "/api/admin/commerce/customers" using req
  set auth to require_commerce_admin_api using stmts, req, "commerce:manage", no
  if not auth.ok
    give back auth.response
  end
  if not stmts.commerce_ready
    give back commerce_error using 404, "commerce_not_migrated", "Migration 004 has not been applied", ""
  end
  set rows to data.query using stmts.commerce.get_customers, record {mode: "all", iv: 0, sv: ""}
  set out to []
  for each c in rows
    set out to collections.append using out, {"id": c.id, "user_id": c.user_id, "email": c.email, "email_masked": (mask_email using c.email), "display_name": c.display_name, "marketing_consent": (c.marketing_consent is 1), "created_at": c.created_at, "updated_at": c.updated_at}
  end
  give back server.json using 200, {"customers": out}
end

route "GET" "/api/admin/commerce/customers/{id}/export" using req
  set auth to require_commerce_admin_api using stmts, req, "commerce:manage", no
  if not auth.ok
    give back auth.response
  end
  if not stmts.commerce_ready
    give back commerce_error using 404, "commerce_not_migrated", "Migration 004 has not been applied", ""
  end
  try
    set cid to text.to_integer using req.params.id
    set cust to data.one using stmts.commerce.get_customers, record {mode: "id", iv: cid, sv: ""}
    if cust is nothing
      give back commerce_error using 404, "customer_not_found", "Customer not found", ""
    end
    set cfg to get_commerce_config using stmts
    set ords to data.query using stmts.commerce.get_orders, record {mode: "customer", iv: cid, sv: ""}
    set ords_out to []
    for each o in ords
      set ords_out to collections.append using ords_out, (format_order_admin_row using o, cfg)
    end
    give back server.json using 200, {"customer": cust, "orders": ords_out}
  catch err
    give back commerce_error using 400, "invalid_customer_id", err.message, ""
  end
end

route "DELETE" "/api/admin/commerce/customers/{id}" using req
  set auth to require_commerce_admin_api using stmts, req, "commerce:manage", yes
  if not auth.ok
    give back auth.response
  end
  if not stmts.commerce_ready
    give back commerce_error using 404, "commerce_not_migrated", "Migration 004 has not been applied", ""
  end
  try
    set cid to text.to_integer using req.params.id
    set cust to data.one using stmts.commerce.get_customers, record {mode: "id", iv: cid, sv: ""}
    if cust is nothing
      give back commerce_error using 404, "customer_not_found", "Customer not found", ""
    end
    set now_rec to call dates.now_utc
    set anon_email to "redacted-" joined with (text.from using cid) joined with "@anonymized.invalid"
    set tx to data.begin using stmts.db
    try
      call data.execute using stmts.commerce.upd_customer, record {user_id: nothing, email: anon_email, display_name: "Redacted Customer", marketing_consent: 0, updated_at: now_rec.iso, id: cid}, tx
      set cust_orders to data.query using stmts.commerce.get_orders, record {mode: "customer", iv: cid, sv: ""}, tx
      for each co in cust_orders
        call data.execute using stmts.commerce.upd_order, record {number: co.number, status: co.status, needs_review: co.needs_review, review_note: co.review_note, shipping_address_json: "{}", paid_at: co.paid_at, payment_ref: co.payment_ref, id: co.id, req_status: ""}, tx
      end
      call data.commit using tx
      give back server.json using 200, {"anonymized": yes, "customer_id": cid}
    catch tx_err
      call data.rollback using tx
      give back commerce_error using 500, "db_error", tx_err.message, ""
    end
  catch err
    give back commerce_error using 400, "invalid_customer_id", err.message, ""
  end
end

route "GET" "/api/admin/commerce/settings" using req
  set auth to require_commerce_admin_api using stmts, req, "commerce:settings", no
  if not auth.ok
    give back auth.response
  end
  if not stmts.commerce_ready
    give back commerce_error using 404, "commerce_not_migrated", "Migration 004 has not been applied", ""
  end
  set cfg to get_commerce_config using stmts
  set primary_set to no
  set next_set to no
  try
    set s1 to text.trim using (env.get using "GRABLAB_PAYMENT_WEBHOOK_SECRET")
    if s1 is not ""
      set primary_set to yes
    end
  catch e1
  end
  try
    set s2 to text.trim using (env.get using "GRABLAB_PAYMENT_WEBHOOK_SECRET_NEXT")
    if s2 is not ""
      set next_set to yes
    end
  catch e2
  end
  give back server.json using 200, {"commerce_enabled": cfg.enabled, "currency": cfg.currency, "guest_checkout": cfg.guest_checkout, "tax_rates": {"standard_bp": cfg.tax_standard_bp, "reduced_bp": cfg.tax_reduced_bp, "digital_bp": cfg.tax_digital_bp}, "shipping_rates": {"usps_ground_advantage": (format_cents_usd using cfg.ship_usps_ground), "usps_priority": (format_cents_usd using cfg.ship_usps_priority), "usps_media_mail": (format_cents_usd using cfg.ship_usps_media), "lulu_direct": (format_cents_usd using cfg.ship_lulu)}, "pending_ttl_minutes": cfg.ttl_minutes, "abandoned_after_minutes": cfg.abandoned_minutes, "payment_redirect_template": cfg.payment_template, "payment_redirect_allowlist": cfg.payment_allowlist, "webhook_primary_configured": primary_set, "webhook_next_configured": next_set}
end

route "PUT" "/api/admin/commerce/settings" using req
  set auth to require_commerce_admin_api using stmts, req, "commerce:settings", yes
  if not auth.ok
    give back auth.response
  end
  if not stmts.commerce_ready
    give back commerce_error using 404, "commerce_not_migrated", "Migration 004 has not been applied", ""
  end
  set bl to check_commerce_body_limit using req
  if not bl.ok
    give back bl.response
  end
  try
    set payload to server.parse_json using req
    if (payload has "webhook_secret") or (payload has "webhook_secret_next") or (payload has "commerce_email_salt")
      give back commerce_error using 422, "secret_settings_read_only", "Webhook secrets come only from environment variables and cannot be stored in settings", ""
    end
    set cur to get_commerce_config using stmts
    set now_rec to call dates.now_utc

    set next_en to cur.enabled
    if payload has "commerce_enabled" and (payload at "commerce_enabled") is not nothing
      set next_en to ((payload at "commerce_enabled") is yes or (payload at "commerce_enabled") is 1 or (payload at "commerce_enabled") is "1")
    end
    if payload has "currency" and (payload at "currency") is not nothing
      set c_str to text.upper using (text.trim using (text.from using (payload at "currency")))
      if c_str is not "USD"
        give back commerce_error using 422, "unsupported_currency", "Only USD is supported in v1.1.0", "currency"
      end
    end
    set next_guest to cur.guest_checkout
    if payload has "guest_checkout" and (payload at "guest_checkout") is not nothing
      set next_guest to ((payload at "guest_checkout") is yes or (payload at "guest_checkout") is 1 or (payload at "guest_checkout") is "1")
    end

    set tax_std to cur.tax_standard_bp
    set tax_red to cur.tax_reduced_bp
    set tax_dig to cur.tax_digital_bp
    if payload has "tax_rates" and (is_record_value using (payload at "tax_rates"))
      set tr to payload at "tax_rates"
      if tr has "standard_bp"
        set p1 to parse_grab_integer using (tr at "standard_bp"), 0, 5000
        if not p1.ok
          give back commerce_error using 422, p1.code, p1.error, "tax_rates.standard_bp"
        end
        set tax_std to p1.val
      end
      if tr has "reduced_bp"
        set p2 to parse_grab_integer using (tr at "reduced_bp"), 0, 5000
        if not p2.ok
          give back commerce_error using 422, p2.code, p2.error, "tax_rates.reduced_bp"
        end
        set tax_red to p2.val
      end
      if tr has "digital_bp"
        set p3 to parse_grab_integer using (tr at "digital_bp"), 0, 5000
        if not p3.ok
          give back commerce_error using 422, p3.code, p3.error, "tax_rates.digital_bp"
        end
        set tax_dig to p3.val
      end
    end

    set s_g to format_cents_usd using cur.ship_usps_ground
    set s_p to format_cents_usd using cur.ship_usps_priority
    set s_m to format_cents_usd using cur.ship_usps_media
    set s_l to format_cents_usd using cur.ship_lulu
    if payload has "shipping_rates" and (is_record_value using (payload at "shipping_rates"))
      set sr to payload at "shipping_rates"
      if sr has "usps_ground_advantage"
        set m1 to parse_money_cents using (sr at "usps_ground_advantage"), yes, 9999999999
        if not m1.ok
          give back commerce_error using 422, m1.code, m1.error, "shipping_rates.usps_ground_advantage"
        end
        set s_g to m1.formatted
      end
      if sr has "usps_priority"
        set m2 to parse_money_cents using (sr at "usps_priority"), yes, 9999999999
        if not m2.ok
          give back commerce_error using 422, m2.code, m2.error, "shipping_rates.usps_priority"
        end
        set s_p to m2.formatted
      end
      if sr has "usps_media_mail"
        set m3 to parse_money_cents using (sr at "usps_media_mail"), yes, 9999999999
        if not m3.ok
          give back commerce_error using 422, m3.code, m3.error, "shipping_rates.usps_media_mail"
        end
        set s_m to m3.formatted
      end
      if sr has "lulu_direct"
        set m4 to parse_money_cents using (sr at "lulu_direct"), yes, 9999999999
        if not m4.ok
          give back commerce_error using 422, m4.code, m4.error, "shipping_rates.lulu_direct"
        end
        set s_l to m4.formatted
      end
    end

    set next_ttl to cur.ttl_minutes
    if payload has "pending_ttl_minutes" and (payload at "pending_ttl_minutes") is not nothing
      set pt to parse_grab_integer using (payload at "pending_ttl_minutes"), 1, 1440
      if not pt.ok
        give back commerce_error using 422, pt.code, pt.error, "pending_ttl_minutes"
      end
      set next_ttl to pt.val
    end
    set next_ab to cur.abandoned_minutes
    if payload has "abandoned_after_minutes" and (payload at "abandoned_after_minutes") is not nothing
      set pa to parse_grab_integer using (payload at "abandoned_after_minutes"), 1, 10080
      if not pa.ok
        give back commerce_error using 422, pa.code, pa.error, "abandoned_after_minutes"
      end
      set next_ab to pa.val
    end

    set next_allow to cur.payment_allowlist
    if payload has "payment_redirect_allowlist" and (payload at "payment_redirect_allowlist") is not nothing
      set next_allow to text.trim using (text.from using (payload at "payment_redirect_allowlist"))
    end
    set allow_res to validate_allowlist_hosts using next_allow
    if not allow_res.ok
      give back commerce_error using 422, "GRAB-E402", allow_res.error, "payment_redirect_allowlist"
    end

    set next_tmpl to cur.payment_template
    if payload has "payment_redirect_template" and (payload at "payment_redirect_template") is not nothing
      set next_tmpl to text.trim using (text.from using (payload at "payment_redirect_template"))
    end
    if next_tmpl is not ""
      set built to build_payment_redirect_url using next_tmpl, "ORD-TEST-1", "1.00", "USD", "https://example.com/shop/order/ORD-TEST-1"
      if not built.ok
        give back commerce_error using 422, "GRAB-E402", built.error, "payment_redirect_template"
      end
      set url_chk to validate_https_url_against_allowlist using built.url, next_allow
      if not url_chk.ok
        give back commerce_error using 422, "GRAB-E402", url_chk.error, "payment_redirect_template"
      end
    end

    set en_str to "0"
    if next_en
      set en_str to "1"
    end
    set guest_str to "0"
    if next_guest
      set guest_str to "1"
    end
    set tx to data.begin using stmts.db
    try
      call upsert_setting using stmts, "commerce_enabled", en_str, now_rec.iso, tx
      call upsert_setting using stmts, "commerce_currency", "USD", now_rec.iso, tx
      call upsert_setting using stmts, "commerce_guest_checkout", guest_str, now_rec.iso, tx
      call upsert_setting using stmts, "commerce_tax_rates_json", (json.stringify using {"standard_bp": tax_std, "reduced_bp": tax_red, "digital_bp": tax_dig}), now_rec.iso, tx
      call upsert_setting using stmts, "commerce_shipping_rates_json", (json.stringify using {"usps_ground_advantage": s_g, "usps_priority": s_p, "usps_media_mail": s_m, "lulu_direct": s_l}), now_rec.iso, tx
      call upsert_setting using stmts, "commerce_pending_ttl_minutes", (text.from using next_ttl), now_rec.iso, tx
      call upsert_setting using stmts, "commerce_abandoned_after_minutes", (text.from using next_ab), now_rec.iso, tx
      call upsert_setting using stmts, "commerce_payment_redirect_template", next_tmpl, now_rec.iso, tx
      call upsert_setting using stmts, "commerce_payment_redirect_allowlist", next_allow, now_rec.iso, tx
      call data.commit using tx
    catch tx_err
      call data.rollback using tx
      give back commerce_error using 500, "db_error", tx_err.message, ""
    end
    if next_en
      call ensure_commerce_salt_and_type using stmts
    end
    call invalidate_commerce_caches using stmts, 0
    call invalidate_route_caches using stmts, "/shop", "/shop/cart", "product"
    set refreshed to get_commerce_config using stmts
    give back server.json using 200, {"commerce_enabled": refreshed.enabled, "currency": refreshed.currency, "guest_checkout": refreshed.guest_checkout, "tax_rates": {"standard_bp": refreshed.tax_standard_bp, "reduced_bp": refreshed.tax_reduced_bp, "digital_bp": refreshed.tax_digital_bp}, "shipping_rates": {"usps_ground_advantage": (format_cents_usd using refreshed.ship_usps_ground), "usps_priority": (format_cents_usd using refreshed.ship_usps_priority), "usps_media_mail": (format_cents_usd using refreshed.ship_usps_media), "lulu_direct": (format_cents_usd using refreshed.ship_lulu)}, "pending_ttl_minutes": refreshed.ttl_minutes, "abandoned_after_minutes": refreshed.abandoned_minutes, "payment_redirect_template": refreshed.payment_template, "payment_redirect_allowlist": refreshed.payment_allowlist}
  catch err
    give back commerce_error using 400, "invalid_json", err.message, ""
  end
end

# ==============================================================================
# Author Mode & Embedded Bestseller Radar Admin API (/api/admin/author/*)
# ==============================================================================

route "GET" "/api/admin/author/status" using req
  set auth to require_author_admin_api using stmts, req, "admin:access", no
  if not auth.ok
    give back auth.response
  end
  set enabled to no
  set groxy_orig to ""
  if stmts.author_ready
    set cfg to get_author_config using stmts
    set enabled to cfg.enabled
    set groxy_orig to cfg.groxy_ai_origin
  end
  give back server.json using 200, {"ready": stmts.author_ready, "author_err": stmts.author.err, "enabled": enabled, "groxy_ai_origin": groxy_orig, "can_manage": (role_has_capability using auth.session.role, "author:manage"), "can_settings": (role_has_capability using auth.session.role, "author:settings")}
end

route "GET" "/api/admin/author/settings" using req
  set auth to require_author_admin_api using stmts, req, "author:settings", no
  if not auth.ok
    give back auth.response
  end
  if not stmts.author_ready
    give back author_error using 404, "author_not_migrated", "Migration 005 has not been applied", "", "not_migrated"
  end
  set cfg to get_author_config using stmts
  give back server.json using 200, {"author_mode_enabled": cfg.enabled, "groxy_ai_origin": cfg.groxy_ai_origin}
end

make handle_author_settings_save using stmts, req
  set auth to require_author_admin_api using stmts, req, "author:settings", yes
  if not auth.ok
    give back auth.response
  end
  if not stmts.author_ready
    give back author_error using 404, "author_not_migrated", "Migration 005 has not been applied", "", "not_migrated"
  end
  set bl to check_commerce_body_limit using req
  if not bl.ok
    give back bl.response
  end
  try
    set payload to server.parse_json using req
    set cur to get_author_config using stmts
    set next_en to cur.enabled
    if payload has "author_mode_enabled" and (payload at "author_mode_enabled") is not nothing
      set next_en to ((payload at "author_mode_enabled") is yes or (payload at "author_mode_enabled") is 1 or (payload at "author_mode_enabled") is "1")
    end
    set next_origin to cur.groxy_ai_origin
    if payload has "groxy_ai_origin" and (payload at "groxy_ai_origin") is not nothing
      set orig_chk to validate_groxy_origin using (text.from using (payload at "groxy_ai_origin")), yes
      if not orig_chk.ok
        give back author_error using 422, "GRAB-E402", orig_chk.error, "groxy_ai_origin", "GRAB-E402"
      end
      set next_origin to orig_chk.origin
    end
    set now_rec to call dates.now_utc
    set en_str to "0"
    if next_en
      set en_str to "1"
    end
    set tx to data.begin using stmts.db
    try
      call upsert_setting using stmts, "author_mode_enabled", en_str, now_rec.iso, tx
      call upsert_setting using stmts, "groxy_ai_origin", next_origin, now_rec.iso, tx
      call data.commit using tx
    catch tx_err
      call data.rollback using tx
      give back author_error using 500, "db_error", tx_err.message, "", "db_error"
    end
    if next_en
      call ensure_author_types using stmts
    end
    call invalidate_author_caches using stmts, 0, 0, 0, 0
    call invalidate_route_caches using stmts, "/books", "/series", "book"
    set ref to get_author_config using stmts
    give back server.json using 200, {"author_mode_enabled": ref.enabled, "groxy_ai_origin": ref.groxy_ai_origin}
  catch err
    give back author_error using 400, "invalid_json", err.message, "", "invalid_json"
  end
end

route "POST" "/api/admin/author/settings" using req
  give back handle_author_settings_save using stmts, req
end

route "PUT" "/api/admin/author/settings" using req
  give back handle_author_settings_save using stmts, req
end

route "GET" "/api/admin/author/overview" using req
  set auth to require_author_admin_api using stmts, req, "author:manage", no
  if not auth.ok
    give back auth.response
  end
  if not stmts.author_ready
    give back author_error using 404, "author_disabled", "Author Mode not migrated", "", "not_migrated"
  end
  set cfg to get_author_config using stmts
  if not cfg.enabled
    give back author_error using 404, "author_disabled", "Author Mode is disabled", "", "disabled"
  end
  set a_rows to data.query using stmts.author.authors, record {mode: "all", iv: 0, sv: ""}
  set s_rows to data.query using stmts.author.series, record {mode: "all", iv: 0, sv: ""}
  set b_rows to data.query using stmts.author.books, record {mode: "all", iv: 0, sv: ""}
  set c_rows to data.query using stmts.author.chapters, record {mode: "all", iv: 0, sv: "", sv2: ""}
  set r_rows to data.query using stmts.author.get_radar, record {mode: "all", sv: ""}
  set can_see_all to role_has_capability using auth.session.role, "entries:read_all"
  set rec_books to []
  for each br in b_rows
    if can_see_all or br.owner_user_id is auth.session.user_id
      set rec_books to collections.append using rec_books, (format_book_api_row using br)
    end
  end
  give back server.json using 200, {"enabled": yes, "groxy_ai_origin": cfg.groxy_ai_origin, "counts": {"authors": (collections.length using a_rows), "series": (collections.length using s_rows), "books": (collections.length using rec_books), "chapters": (collections.length using c_rows), "radar_imports": (collections.length using r_rows)}, "recent_books": rec_books}
end

route "GET" "/api/admin/author/authors" using req
  set auth to require_author_admin_api using stmts, req, "author:manage", no
  if not auth.ok
    give back auth.response
  end
  if not stmts.author_ready or (not (get_author_config using stmts).enabled)
    give back author_error using 404, "author_disabled", "Author Mode is disabled", "", "disabled"
  end
  set rows to data.query using stmts.author.authors, record {mode: "all", iv: 0, sv: ""}
  set can_see_all to role_has_capability using auth.session.role, "entries:read_all"
  set out to []
  for each r in rows
    if can_see_all or r.owner_user_id is auth.session.user_id
      set out to collections.append using out, (format_author_api_row using r)
    end
  end
  give back server.json using 200, {"authors": out}
end

route "POST" "/api/admin/author/authors" using req
  set auth to require_author_admin_api using stmts, req, "author:manage", yes
  if not auth.ok
    give back auth.response
  end
  if not stmts.author_ready or (not (get_author_config using stmts).enabled)
    give back author_error using 404, "author_disabled", "Author Mode is disabled", "", "disabled"
  end
  try
    set payload to server.parse_json using req
    if (not (payload has "pen_name")) or (not (payload has "slug"))
      give back author_error using 400, "missing_fields", "pen_name and slug are required", "", "missing_fields"
    end
    set pen_name to text.trim using (text.from using (payload at "pen_name"))
    set slug to normalize_slug using (text.from using (payload at "slug"))
    if pen_name is "" or (not (is_valid_entry_slug using slug))
      give back author_error using 422, "author_validation_failed", "Valid pen_name and slug are required", "slug", "invalid_slug"
    end
    call ensure_author_types using stmts
    set ct to data.one using stmts.get_type, record {lookup: "slug", sv: "author", iv: 0}
    set full_path to compute_full_path using ct.permalink_pattern, slug
    if is_author_reserved_slug using slug, full_path
      give back author_error using 409, "reserved_slug_collision", "Author slug collides with reserved system prefix", "slug", "reserved_path"
    end
    set dup to data.one using stmts.get_entry_by_full_path, record {full_path: full_path}
    if dup is not nothing
      give back author_error using 409, "duplicate_slug", ("Author already exists at " joined with full_path), "slug", "duplicate_slug"
    end
    set bio_s to ""
    if payload has "bio_summary" and (payload at "bio_summary") is not nothing
      set bres to normalize_and_validate_body using (payload at "bio_summary")
      if not bres.ok
        give back author_error using 422, "author_validation_failed", bres.error, "bio_summary", "unsafe_html"
      end
      set bio_s to bres.body_html
    end
    set web_s to ""
    if payload has "website_url" and (payload at "website_url") is not nothing and (text.trim using (text.from using (payload at "website_url"))) is not ""
      set web_s to text.trim using (text.from using (payload at "website_url"))
      if not (is_safe_url using web_s)
        give back author_error using 422, "author_validation_failed", "Unsafe website_url", "website_url", "unsafe_url"
      end
    end
    set status_s to "draft"
    if payload has "status" and (payload at "status") is not nothing
      set status_s to text.lower using (text.trim using (text.from using (payload at "status")))
    end
    if status_s is not "draft" and status_s is not "published"
      give back author_error using 422, "author_validation_failed", "status must be draft or published", "status", "invalid_status"
    end
    if status_s is "published" and (not (role_has_capability using auth.session.role, "entries:publish"))
      give back author_error using 403, "forbidden", "Insufficient capability to publish author profile", "status", "forbidden"
    end
    set now_rec to call dates.now_utc
    set pub_at to nothing
    if status_s is "published"
      set pub_at to now_rec.iso
    end
    set tx to data.begin using stmts.db
    try
      call data.execute using stmts.insert_entry, record {content_type_id: ct.id, slug: slug, full_path: full_path, title: pen_name, status: status_s, body_html: bio_s, custom_fields_json: "{}", meta_title: pen_name, meta_description: bio_s, author_id: auth.session.user_id, published_at: pub_at, created_at: now_rec.iso, updated_at: now_rec.iso}, tx
      set ent to data.one using stmts.get_entry_by_full_path, record {full_path: full_path}, tx
      call data.execute using stmts.author.ins_author, record {entry_id: ent.id, pen_name: pen_name, bio_summary: bio_s, website_url: web_s, social_links_json: "{}", active: 1, created_at: now_rec.iso, updated_at: now_rec.iso}, tx
      set created to data.one using stmts.author.authors, record {mode: "entry", iv: ent.id, sv: ""}, tx
      call data.commit using tx
      call invalidate_author_caches using stmts, 0, 0, 0, created.id
      call invalidate_route_caches using stmts, full_path, "", "author"
      give back server.json using 201, {"author": (format_author_api_row using created)}
    catch tx_err
      call data.rollback using tx
      give back author_error using 500, "db_error", tx_err.message, "", "db_error"
    end
  catch err
    give back author_error using 400, "invalid_json", err.message, "", "invalid_json"
  end
end

route "PUT" "/api/admin/author/authors/{id}" using req
  set auth to require_author_admin_api using stmts, req, "author:manage", yes
  if not auth.ok
    give back auth.response
  end
  if not stmts.author_ready or (not (get_author_config using stmts).enabled)
    give back author_error using 404, "author_disabled", "Author Mode is disabled", "", "disabled"
  end
  try
    set aid to text.to_integer using req.params.id
    set existing to data.one using stmts.author.authors, record {mode: "id", iv: aid, sv: ""}
    if existing is nothing
      give back author_error using 404, "author_not_found", "Author not found", "", "not_found"
    end
    if not (role_has_capability using auth.session.role, "entries:update:any")
      if existing.owner_user_id is nothing or existing.owner_user_id is not auth.session.user_id
        give back author_error using 403, "forbidden", "Cannot edit another user's author profile", "", "forbidden"
      end
    end
    set payload to server.parse_json using req
    set ct to data.one using stmts.get_type, record {lookup: "slug", sv: "author", iv: 0}
    set new_slug to existing.slug
    if payload has "slug" and (payload at "slug") is not nothing
      set new_slug to normalize_slug using (text.from using (payload at "slug"))
    end
    if not (is_valid_entry_slug using new_slug)
      give back author_error using 422, "author_validation_failed", "Invalid author slug", "slug", "invalid_slug"
    end
    set new_path to compute_full_path using ct.permalink_pattern, new_slug
    if is_author_reserved_slug using new_slug, new_path
      give back author_error using 409, "reserved_slug_collision", "Author slug collides with reserved system prefix", "slug", "reserved_path"
    end
    set col to data.one using stmts.get_entry_by_full_path, record {full_path: new_path}
    if col is not nothing and col.id is not existing.entry_id
      give back author_error using 409, "duplicate_slug", "Another entry already owns this slug", "slug", "duplicate_slug"
    end
    set new_pen to existing.pen_name
    if payload has "pen_name" and (payload at "pen_name") is not nothing
      set new_pen to text.trim using (text.from using (payload at "pen_name"))
    end
    set new_bio to existing.bio_summary
    if payload has "bio_summary" and (payload at "bio_summary") is not nothing
      set bres to normalize_and_validate_body using (payload at "bio_summary")
      if not bres.ok
        give back author_error using 422, "author_validation_failed", bres.error, "bio_summary", "unsafe_html"
      end
      set new_bio to bres.body_html
    end
    set new_web to existing.website_url
    if payload has "website_url" and (payload at "website_url") is not nothing
      set new_web to text.trim using (text.from using (payload at "website_url"))
      if new_web is not "" and (not (is_safe_url using new_web))
        give back author_error using 422, "author_validation_failed", "Unsafe website_url", "website_url", "unsafe_url"
      end
    end
    set new_status to existing.status
    if payload has "status" and (payload at "status") is not nothing
      set new_status to text.lower using (text.trim using (text.from using (payload at "status")))
    end
    if new_status is "published" and (not (role_has_capability using auth.session.role, "entries:publish"))
      give back author_error using 403, "forbidden", "Insufficient capability to publish author profile", "status", "forbidden"
    end
    set now_rec to call dates.now_utc
    set ent_row to data.one using stmts.get_entry_by_id, record {id: existing.entry_id}
    set new_pub to ent_row.published_at
    if new_status is "published" and new_pub is nothing
      set new_pub to now_rec.iso
    end
    set tx to data.begin using stmts.db
    try
      call data.execute using stmts.delete_redirect, record {lookup: "old_path", sv: new_path, iv: 0}, tx
      if (new_path is not existing.full_path) and (existing.status is "published") and (new_status is "published")
        call data.execute using stmts.delete_redirect, record {lookup: "old_path", sv: existing.full_path, iv: 0}, tx
        call data.execute using stmts.insert_redirect, record {old_path: existing.full_path, entry_id: existing.entry_id, created_at: now_rec.iso}, tx
      end
      call data.execute using stmts.update_entry, record {slug: new_slug, full_path: new_path, title: new_pen, status: new_status, body_html: new_bio, custom_fields_json: ent_row.custom_fields_json, meta_title: new_pen, meta_description: new_bio, published_at: new_pub, updated_at: now_rec.iso, id: existing.entry_id}, tx
      call data.execute using stmts.author.upd_author, record {pen_name: new_pen, bio_summary: new_bio, website_url: new_web, social_links_json: existing.social_links_json, active: existing.active, updated_at: now_rec.iso, id: aid}, tx
      set updated to data.one using stmts.author.authors, record {mode: "id", iv: aid, sv: ""}, tx
      call data.commit using tx
      call invalidate_author_caches using stmts, 0, 0, 0, aid
      call invalidate_route_caches using stmts, existing.full_path, new_path, "author"
      give back server.json using 200, {"author": (format_author_api_row using updated)}
    catch tx_err
      call data.rollback using tx
      give back author_error using 500, "db_error", tx_err.message, "", "db_error"
    end
  catch err
    give back author_error using 400, "invalid_json", err.message, "", "invalid_json"
  end
end

route "GET" "/api/admin/author/series" using req
  set auth to require_author_admin_api using stmts, req, "author:manage", no
  if not auth.ok
    give back auth.response
  end
  if not stmts.author_ready or (not (get_author_config using stmts).enabled)
    give back author_error using 404, "author_disabled", "Author Mode is disabled", "", "disabled"
  end
  set rows to data.query using stmts.author.series, record {mode: "all", iv: 0, sv: ""}
  set can_see_all to role_has_capability using auth.session.role, "entries:read_all"
  set out to []
  for each r in rows
    if can_see_all or r.owner_user_id is auth.session.user_id
      set out to collections.append using out, (format_series_api_row using r)
    end
  end
  give back server.json using 200, {"series": out}
end

route "POST" "/api/admin/author/series" using req
  set auth to require_author_admin_api using stmts, req, "author:manage", yes
  if not auth.ok
    give back auth.response
  end
  if not stmts.author_ready or (not (get_author_config using stmts).enabled)
    give back author_error using 404, "author_disabled", "Author Mode is disabled", "", "disabled"
  end
  try
    set payload to server.parse_json using req
    if (not (payload has "title")) or (not (payload has "slug"))
      give back author_error using 400, "missing_fields", "title and slug are required", "", "missing_fields"
    end
    set s_title to text.trim using (text.from using (payload at "title"))
    set slug to normalize_slug using (text.from using (payload at "slug"))
    if s_title is "" or (not (is_valid_entry_slug using slug))
      give back author_error using 422, "author_validation_failed", "Valid series title and slug are required", "slug", "invalid_slug"
    end
    call ensure_author_types using stmts
    set ct to data.one using stmts.get_type, record {lookup: "slug", sv: "series", iv: 0}
    set full_path to compute_full_path using ct.permalink_pattern, slug
    if is_author_reserved_slug using slug, full_path
      give back author_error using 409, "reserved_slug_collision", "Series slug collides with reserved system prefix", "slug", "reserved_path"
    end
    set dup to data.one using stmts.get_entry_by_full_path, record {full_path: full_path}
    if dup is not nothing
      give back author_error using 409, "duplicate_slug", ("Series already exists at " joined with full_path), "slug", "duplicate_slug"
    end
    set ro_mode to "chronological"
    if payload has "reading_order_mode" and (payload at "reading_order_mode") is not nothing
      set ro_mode to text.lower using (text.trim using (text.from using (payload at "reading_order_mode")))
    end
    if ro_mode is not "chronological" and ro_mode is not "publication"
      give back author_error using 422, "author_validation_failed", "reading_order_mode must be chronological or publication", "reading_order_mode", "invalid_mode"
    end
    set total_planned to 1
    if payload has "total_planned_books" and (payload at "total_planned_books") is not nothing
      set ptp to parse_author_int using (payload at "total_planned_books"), 1, 999
      if not ptp.ok
        give back author_error using 422, "author_validation_failed", ptp.error, "total_planned_books", ptp.reason
      end
      set total_planned to ptp.val
    end
    set genre_s to ""
    if payload has "genre_slug" and (payload at "genre_slug") is not nothing
      set genre_s to text.lower using (text.trim using (text.from using (payload at "genre_slug")))
    end
    set body_s to ""
    if payload has "body_html" and (payload at "body_html") is not nothing
      set bres to normalize_and_validate_body using (payload at "body_html")
      if not bres.ok
        give back author_error using 422, "author_validation_failed", bres.error, "body_html", "unsafe_html"
      end
      set body_s to bres.body_html
    end
    set status_s to "draft"
    if payload has "status" and (payload at "status") is not nothing
      set status_s to text.lower using (text.trim using (text.from using (payload at "status")))
    end
    if status_s is not "draft" and status_s is not "published"
      give back author_error using 422, "author_validation_failed", "status must be draft or published", "status", "invalid_status"
    end
    if status_s is "published" and (not (role_has_capability using auth.session.role, "entries:publish"))
      give back author_error using 403, "forbidden", "Insufficient capability to publish series", "status", "forbidden"
    end
    set now_rec to call dates.now_utc
    set pub_at to nothing
    if status_s is "published"
      set pub_at to now_rec.iso
    end
    set tx to data.begin using stmts.db
    try
      set target_aid to 0
      if payload has "author_id" and (payload at "author_id") is not nothing
        set pai to parse_author_int using (payload at "author_id"), 1, 2147483647
        if not pai.ok
          call data.rollback using tx
          give back author_error using 422, "author_validation_failed", pai.error, "author_id", pai.reason
        end
        set ar to data.one using stmts.author.authors, record {mode: "id", iv: pai.val, sv: ""}, tx
        if ar is nothing
          call data.rollback using tx
          give back author_error using 404, "author_not_found", "Author not found", "author_id", "not_found"
        end
        set target_aid to ar.id
      otherwise
        set da to ensure_default_author_for_user using stmts, auth.session.user_id, auth.session.display_name, now_rec.iso, tx
        set target_aid to da.id
      end
      call data.execute using stmts.insert_entry, record {content_type_id: ct.id, slug: slug, full_path: full_path, title: s_title, status: status_s, body_html: body_s, custom_fields_json: "{}", meta_title: s_title, meta_description: body_s, author_id: auth.session.user_id, published_at: pub_at, created_at: now_rec.iso, updated_at: now_rec.iso}, tx
      set ent to data.one using stmts.get_entry_by_full_path, record {full_path: full_path}, tx
      call data.execute using stmts.author.ins_series, record {entry_id: ent.id, author_id: target_aid, genre_slug: genre_s, reading_order_mode: ro_mode, total_planned_books: total_planned, active: 1, created_at: now_rec.iso, updated_at: now_rec.iso}, tx
      set created to data.one using stmts.author.series, record {mode: "entry", iv: ent.id, sv: ""}, tx
      call data.commit using tx
      call invalidate_author_caches using stmts, 0, created.id, 0, target_aid
      call invalidate_route_caches using stmts, full_path, "", "series"
      give back server.json using 201, {"series": (format_series_api_row using created)}
    catch tx_err
      call data.rollback using tx
      give back author_error using 500, "db_error", tx_err.message, "", "db_error"
    end
  catch err
    give back author_error using 400, "invalid_json", err.message, "", "invalid_json"
  end
end

route "PUT" "/api/admin/author/series/{id}" using req
  set auth to require_author_admin_api using stmts, req, "author:manage", yes
  if not auth.ok
    give back auth.response
  end
  if not stmts.author_ready or (not (get_author_config using stmts).enabled)
    give back author_error using 404, "author_disabled", "Author Mode is disabled", "", "disabled"
  end
  try
    set sid to text.to_integer using req.params.id
    set existing to data.one using stmts.author.series, record {mode: "id", iv: sid, sv: ""}
    if existing is nothing
      give back author_error using 404, "series_not_found", "Series not found", "", "not_found"
    end
    if not (role_has_capability using auth.session.role, "entries:update:any")
      if existing.owner_user_id is nothing or existing.owner_user_id is not auth.session.user_id
        give back author_error using 403, "forbidden", "Cannot edit another user's series", "", "forbidden"
      end
    end
    set payload to server.parse_json using req
    set ct to data.one using stmts.get_type, record {lookup: "slug", sv: "series", iv: 0}
    set new_slug to existing.slug
    if payload has "slug" and (payload at "slug") is not nothing
      set new_slug to normalize_slug using (text.from using (payload at "slug"))
    end
    if not (is_valid_entry_slug using new_slug)
      give back author_error using 422, "author_validation_failed", "Invalid series slug", "slug", "invalid_slug"
    end
    set new_path to compute_full_path using ct.permalink_pattern, new_slug
    if is_author_reserved_slug using new_slug, new_path
      give back author_error using 409, "reserved_slug_collision", "Series slug collides with reserved system prefix", "slug", "reserved_path"
    end
    set col to data.one using stmts.get_entry_by_full_path, record {full_path: new_path}
    if col is not nothing and col.id is not existing.entry_id
      give back author_error using 409, "duplicate_slug", "Another entry owns this slug", "slug", "duplicate_slug"
    end
    set new_title to existing.title
    if payload has "title" and (payload at "title") is not nothing
      set new_title to text.trim using (text.from using (payload at "title"))
    end
    set new_status to existing.status
    if payload has "status" and (payload at "status") is not nothing
      set new_status to text.lower using (text.trim using (text.from using (payload at "status")))
    end
    if new_status is "published" and (not (role_has_capability using auth.session.role, "entries:publish"))
      give back author_error using 403, "forbidden", "Insufficient capability to publish series", "status", "forbidden"
    end
    set new_genre to existing.genre_slug
    if payload has "genre_slug" and (payload at "genre_slug") is not nothing
      set new_genre to text.lower using (text.trim using (text.from using (payload at "genre_slug")))
    end
    set now_rec to call dates.now_utc
    set ent_row to data.one using stmts.get_entry_by_id, record {id: existing.entry_id}
    set new_pub to ent_row.published_at
    if new_status is "published" and new_pub is nothing
      set new_pub to now_rec.iso
    end
    set tx to data.begin using stmts.db
    try
      call data.execute using stmts.delete_redirect, record {lookup: "old_path", sv: new_path, iv: 0}, tx
      if (new_path is not existing.full_path) and (existing.status is "published") and (new_status is "published")
        call data.execute using stmts.delete_redirect, record {lookup: "old_path", sv: existing.full_path, iv: 0}, tx
        call data.execute using stmts.insert_redirect, record {old_path: existing.full_path, entry_id: existing.entry_id, created_at: now_rec.iso}, tx
      end
      call data.execute using stmts.update_entry, record {slug: new_slug, full_path: new_path, title: new_title, status: new_status, body_html: ent_row.body_html, custom_fields_json: ent_row.custom_fields_json, meta_title: new_title, meta_description: ent_row.meta_description, published_at: new_pub, updated_at: now_rec.iso, id: existing.entry_id}, tx
      call data.execute using stmts.author.upd_series, record {author_id: existing.author_id, genre_slug: new_genre, reading_order_mode: existing.reading_order_mode, total_planned_books: existing.total_planned_books, active: existing.active, updated_at: now_rec.iso, id: sid}, tx
      set updated to data.one using stmts.author.series, record {mode: "id", iv: sid, sv: ""}, tx
      call data.commit using tx
      call invalidate_author_caches using stmts, 0, sid, 0, existing.author_id
      call invalidate_route_caches using stmts, existing.full_path, new_path, "series"
      give back server.json using 200, {"series": (format_series_api_row using updated)}
    catch tx_err
      call data.rollback using tx
      give back author_error using 500, "db_error", tx_err.message, "", "db_error"
    end
  catch err
    give back author_error using 400, "invalid_json", err.message, "", "invalid_json"
  end
end

route "POST" "/api/admin/author/series/reorder" using req
  set auth to require_author_admin_api using stmts, req, "author:manage", yes
  if not auth.ok
    give back auth.response
  end
  if not stmts.author_ready or (not (get_author_config using stmts).enabled)
    give back author_error using 404, "author_disabled", "Author Mode is disabled", "", "disabled"
  end
  try
    set payload to server.parse_json using req
    if (not (payload has "series_id")) or (not (payload has "book_ids"))
      give back author_error using 400, "missing_fields", "series_id and book_ids are required", "", "missing_fields"
    end
    set psid to parse_author_int using (payload at "series_id"), 1, 2147483647
    if not psid.ok
      give back author_error using 422, "author_validation_failed", psid.error, "series_id", psid.reason
    end
    set s_row to data.one using stmts.author.series, record {mode: "id", iv: psid.val, sv: ""}
    if s_row is nothing
      give back author_error using 404, "series_not_found", "Series not found", "series_id", "not_found"
    end
    if not (role_has_capability using auth.session.role, "entries:update:any")
      if s_row.owner_user_id is nothing or s_row.owner_user_id is not auth.session.user_id
        give back author_error using 403, "forbidden", "Cannot reorder another user's series", "", "forbidden"
      end
    end
    set bids to payload at "book_ids"
    set now_rec to call dates.now_utc
    set tx to data.begin using stmts.db
    try
      set pos to 1
      for each raw_bid in bids
        set pbid to parse_author_int using raw_bid, 1, 2147483647
        if not pbid.ok
          call data.rollback using tx
          give back author_error using 422, "author_validation_failed", pbid.error, "book_ids", pbid.reason
        end
        set bk_row to data.one using stmts.author.books, record {mode: "id", iv: pbid.val, sv: ""}, tx
        if bk_row is not nothing
          call data.execute using stmts.author.upd_book, record {author_id: bk_row.author_id, series_id: psid.val, series_position: pos, subtitle: bk_row.subtitle, isbn_13: bk_row.isbn_13, asin: bk_row.asin, edition_format: bk_row.edition_format, page_count: bk_row.page_count, word_count: bk_row.word_count, in_language: bk_row.in_language, genre_slug: bk_row.genre_slug, blurb: bk_row.blurb, list_price_cents: bk_row.list_price_cents, royalty_rate_bp: bk_row.royalty_rate_bp, product_id: bk_row.product_id, cover_media_id: bk_row.cover_media_id, active: bk_row.active, updated_at: now_rec.iso, id: pbid.val}, tx
        end
        set pos to pos plus 1
      end
      call data.commit using tx
      call invalidate_author_caches using stmts, 0, psid.val, 0, s_row.author_id
      call invalidate_route_caches using stmts, s_row.full_path, "", "series"
      set ordered to data.query using stmts.author.books, record {mode: "series", iv: psid.val, sv: ""}
      set out_books to []
      for each b in ordered
        set out_books to collections.append using out_books, (format_book_api_row using b)
      end
      give back server.json using 200, {"series_id": psid.val, "books": out_books}
    catch tx_err
      call data.rollback using tx
      give back author_error using 500, "db_error", tx_err.message, "", "db_error"
    end
  catch err
    give back author_error using 400, "invalid_json", err.message, "", "invalid_json"
  end
end

route "GET" "/api/admin/author/books" using req
  set auth to require_author_admin_api using stmts, req, "author:manage", no
  if not auth.ok
    give back auth.response
  end
  if not stmts.author_ready or (not (get_author_config using stmts).enabled)
    give back author_error using 404, "author_disabled", "Author Mode is disabled", "", "disabled"
  end
  set rows to data.query using stmts.author.books, record {mode: "all", iv: 0, sv: ""}
  set can_see_all to role_has_capability using auth.session.role, "entries:read_all"
  set out to []
  for each r in rows
    if can_see_all or r.owner_user_id is auth.session.user_id
      set item to format_book_api_row using r
      if stmts.commerce_ready and r.product_id is not nothing
        set prod to data.one using stmts.commerce.products, record {mode: "id", iv: r.product_id, sv: ""}
        if prod is not nothing
          set item to collections.put using item, "linked_product", (format_product_api_row using prod)
        end
      end
      set out to collections.append using out, item
    end
  end
  give back server.json using 200, {"books": out}
end

route "POST" "/api/admin/author/books" using req
  set auth to require_author_admin_api using stmts, req, "author:manage", yes
  if not auth.ok
    give back auth.response
  end
  if not stmts.author_ready or (not (get_author_config using stmts).enabled)
    give back author_error using 404, "author_disabled", "Author Mode is disabled", "", "disabled"
  end
  try
    set payload to server.parse_json using req
    if (not (payload has "title")) or (not (payload has "slug"))
      give back author_error using 400, "missing_fields", "title and slug are required", "", "missing_fields"
    end
    set b_title to text.trim using (text.from using (payload at "title"))
    set slug to normalize_slug using (text.from using (payload at "slug"))
    if b_title is "" or (not (is_valid_entry_slug using slug))
      give back author_error using 422, "author_validation_failed", "Valid book title and slug are required", "slug", "invalid_slug"
    end
    call ensure_author_types using stmts
    set ct to data.one using stmts.get_type, record {lookup: "slug", sv: "book", iv: 0}
    set full_path to compute_full_path using ct.permalink_pattern, slug
    if is_author_reserved_slug using slug, full_path
      give back author_error using 409, "reserved_slug_collision", "Book slug collides with reserved system prefix", "slug", "reserved_path"
    end
    set dup to data.one using stmts.get_entry_by_full_path, record {full_path: full_path}
    if dup is not nothing
      give back author_error using 409, "duplicate_slug", ("Book already exists at " joined with full_path), "slug", "duplicate_slug"
    end

    set price_in to "14.99"
    if payload has "list_price" and (payload at "list_price") is not nothing
      set price_in to payload at "list_price"
    end
    set p_price to parse_author_money_cents using price_in, "list_price"
    if not p_price.ok
      give back author_error using 422, "author_validation_failed", p_price.error, "list_price", p_price.reason
    end

    set roy_in to "70.00"
    if payload has "royalty_rate" and (payload at "royalty_rate") is not nothing
      set roy_in to payload at "royalty_rate"
    end
    set p_roy to parse_author_royalty_bp using roy_in, "royalty_rate"
    if not p_roy.ok
      give back author_error using 422, "author_validation_failed", p_roy.error, "royalty_rate", p_roy.reason
    end

    set isbn_in to nothing
    if payload has "isbn_13"
      set isbn_in to payload at "isbn_13"
    end
    set isbn_res to validate_isbn13_strict using isbn_in
    if not isbn_res.ok
      give back author_error using 422, "author_validation_failed", isbn_res.error, "isbn_13", "invalid_isbn_13"
    end
    set asin_in to nothing
    if payload has "asin"
      set asin_in to payload at "asin"
    end
    set asin_res to validate_asin_strict using asin_in
    if not asin_res.ok
      give back author_error using 422, "author_validation_failed", asin_res.error, "asin", "invalid_asin"
    end

    set ed_fmt to "paperback"
    if payload has "edition_format" and (payload at "edition_format") is not nothing
      set ed_fmt to text.lower using (text.trim using (text.from using (payload at "edition_format")))
    end
    if ed_fmt is not "ebook" and ed_fmt is not "paperback" and ed_fmt is not "hardcover" and ed_fmt is not "bundle"
      give back author_error using 422, "author_validation_failed", "edition_format must be ebook, paperback, hardcover, or bundle", "edition_format", "invalid_edition_format"
    end

    set pg_cnt to 0
    if payload has "page_count" and (payload at "page_count") is not nothing
      set ppg to parse_author_int using (payload at "page_count"), 0, 50000
      if not ppg.ok
        give back author_error using 422, "author_validation_failed", ppg.error, "page_count", ppg.reason
      end
      set pg_cnt to ppg.val
    end
    set wd_cnt to 0
    if payload has "word_count" and (payload at "word_count") is not nothing
      set pwd to parse_author_int using (payload at "word_count"), 0, 5000000
      if not pwd.ok
        give back author_error using 422, "author_validation_failed", pwd.error, "word_count", pwd.reason
      end
      set wd_cnt to pwd.val
    end

    set ser_id to nothing
    if payload has "series_id" and (payload at "series_id") is not nothing
      set psi to parse_author_int using (payload at "series_id"), 1, 2147483647
      if not psi.ok
        give back author_error using 422, "author_validation_failed", psi.error, "series_id", psi.reason
      end
      set sr_chk to data.one using stmts.author.series, record {mode: "id", iv: psi.val, sv: ""}
      if sr_chk is nothing
        give back author_error using 404, "series_not_found", "Referenced series not found", "series_id", "not_found"
      end
      set ser_id to psi.val
    end
    set ser_pos to nothing
    if payload has "series_position" and (payload at "series_position") is not nothing
      set psp to parse_author_int using (payload at "series_position"), 1, 9999
      if not psp.ok
        give back author_error using 422, "author_validation_failed", psp.error, "series_position", psp.reason
      end
      set ser_pos to psp.val
    end

    set cov_id to nothing
    if payload has "cover_media_id" and (payload at "cover_media_id") is not nothing
      set pcm to parse_author_int using (payload at "cover_media_id"), 1, 2147483647
      if not pcm.ok
        give back author_error using 422, "author_validation_failed", pcm.error, "cover_media_id", pcm.reason
      end
      set m_chk to data.one using stmts.get_media, record {lookup: "id", iv: pcm.val, sv: ""}
      if m_chk is nothing
        give back author_error using 404, "media_not_found", "Referenced cover media not found", "cover_media_id", "not_found"
      end
      set cov_id to pcm.val
    end

    set status_s to "draft"
    if payload has "status" and (payload at "status") is not nothing
      set status_s to text.lower using (text.trim using (text.from using (payload at "status")))
    end
    if status_s is not "draft" and status_s is not "published"
      give back author_error using 422, "author_validation_failed", "status must be draft or published", "status", "invalid_status"
    end
    if status_s is "published" and (not (role_has_capability using auth.session.role, "entries:publish"))
      give back author_error using 403, "forbidden", "Insufficient capability to publish book", "status", "forbidden"
    end

    set sub_s to ""
    if payload has "subtitle" and (payload at "subtitle") is not nothing
      set sub_s to text.trim using (text.from using (payload at "subtitle"))
    end
    set lang_s to "en"
    if payload has "in_language" and (payload at "in_language") is not nothing and (text.trim using (text.from using (payload at "in_language"))) is not ""
      set lang_s to text.trim using (text.from using (payload at "in_language"))
    end
    set genre_s to ""
    if payload has "genre_slug" and (payload at "genre_slug") is not nothing
      set genre_s to text.lower using (text.trim using (text.from using (payload at "genre_slug")))
    end
    set blurb_s to ""
    if payload has "blurb" and (payload at "blurb") is not nothing
      set bres to normalize_and_validate_body using (payload at "blurb")
      if not bres.ok
        give back author_error using 422, "author_validation_failed", bres.error, "blurb", "unsafe_html"
      end
      set blurb_s to bres.body_html
    end

    set now_rec to call dates.now_utc
    set pub_at to nothing
    if status_s is "published"
      set pub_at to now_rec.iso
    end
    set tx to data.begin using stmts.db
    try
      set target_aid to 0
      if payload has "author_id" and (payload at "author_id") is not nothing
        set pai to parse_author_int using (payload at "author_id"), 1, 2147483647
        if not pai.ok
          call data.rollback using tx
          give back author_error using 422, "author_validation_failed", pai.error, "author_id", pai.reason
        end
        set ar to data.one using stmts.author.authors, record {mode: "id", iv: pai.val, sv: ""}, tx
        if ar is nothing
          call data.rollback using tx
          give back author_error using 404, "author_not_found", "Author not found", "author_id", "not_found"
        end
        set target_aid to ar.id
      otherwise
        set da to ensure_default_author_for_user using stmts, auth.session.user_id, auth.session.display_name, now_rec.iso, tx
        set target_aid to da.id
      end
      set cf_json to json.stringify using {"isbn_13": isbn_res.canonical, "asin": asin_res.canonical, "subtitle": sub_s, "list_price": p_price.formatted}
      call data.execute using stmts.insert_entry, record {content_type_id: ct.id, slug: slug, full_path: full_path, title: b_title, status: status_s, body_html: blurb_s, custom_fields_json: cf_json, meta_title: b_title, meta_description: blurb_s, author_id: auth.session.user_id, published_at: pub_at, created_at: now_rec.iso, updated_at: now_rec.iso}, tx
      set ent to data.one using stmts.get_entry_by_full_path, record {full_path: full_path}, tx
      call data.execute using stmts.author.ins_book, record {entry_id: ent.id, author_id: target_aid, series_id: ser_id, series_position: ser_pos, subtitle: sub_s, isbn_13: isbn_res.canonical, asin: asin_res.canonical, edition_format: ed_fmt, page_count: pg_cnt, word_count: wd_cnt, in_language: lang_s, genre_slug: genre_s, blurb: blurb_s, list_price_cents: p_price.cents, royalty_rate_bp: p_roy.bp, currency: "USD", product_id: nothing, cover_media_id: cov_id, active: 1, created_at: now_rec.iso, updated_at: now_rec.iso}, tx
      set created to data.one using stmts.author.books, record {mode: "entry", iv: ent.id, sv: ""}, tx
      call data.commit using tx
      call invalidate_author_caches using stmts, created.id, ser_id, 0, target_aid
      call invalidate_route_caches using stmts, full_path, "", "book"
      give back server.json using 201, {"book": (format_book_api_row using created)}
    catch tx_err
      call data.rollback using tx
      give back author_error using 500, "db_error", tx_err.message, "", "db_error"
    end
  catch err
    give back author_error using 400, "invalid_json", err.message, "", "invalid_json"
  end
end

route "PUT" "/api/admin/author/books/{id}" using req
  set auth to require_author_admin_api using stmts, req, "author:manage", yes
  if not auth.ok
    give back auth.response
  end
  if not stmts.author_ready or (not (get_author_config using stmts).enabled)
    give back author_error using 404, "author_disabled", "Author Mode is disabled", "", "disabled"
  end
  try
    set bid to text.to_integer using req.params.id
    set existing to data.one using stmts.author.books, record {mode: "id", iv: bid, sv: ""}
    if existing is nothing
      give back author_error using 404, "book_not_found", "Book not found", "", "not_found"
    end
    if not (role_has_capability using auth.session.role, "entries:update:any")
      if existing.owner_user_id is nothing or existing.owner_user_id is not auth.session.user_id
        give back author_error using 403, "forbidden", "Cannot edit another user's book", "", "forbidden"
      end
    end
    set payload to server.parse_json using req
    set ct to data.one using stmts.get_type, record {lookup: "slug", sv: "book", iv: 0}
    set new_slug to existing.slug
    if payload has "slug" and (payload at "slug") is not nothing
      set new_slug to normalize_slug using (text.from using (payload at "slug"))
    end
    if not (is_valid_entry_slug using new_slug)
      give back author_error using 422, "author_validation_failed", "Invalid book slug", "slug", "invalid_slug"
    end
    set new_path to compute_full_path using ct.permalink_pattern, new_slug
    if is_author_reserved_slug using new_slug, new_path
      give back author_error using 409, "reserved_slug_collision", "Book slug collides with reserved system prefix", "slug", "reserved_path"
    end
    set col to data.one using stmts.get_entry_by_full_path, record {full_path: new_path}
    if col is not nothing and col.id is not existing.entry_id
      give back author_error using 409, "duplicate_slug", "Another entry owns this slug", "slug", "duplicate_slug"
    end
    set new_title to existing.title
    if payload has "title" and (payload at "title") is not nothing
      set new_title to text.trim using (text.from using (payload at "title"))
    end
    set new_status to existing.status
    if payload has "status" and (payload at "status") is not nothing
      set new_status to text.lower using (text.trim using (text.from using (payload at "status")))
    end
    if new_status is not "draft" and new_status is not "published"
      give back author_error using 422, "author_validation_failed", "status must be draft or published", "status", "invalid_status"
    end
    if new_status is "published" and (not (role_has_capability using auth.session.role, "entries:publish"))
      give back author_error using 403, "forbidden", "Insufficient capability to publish book", "status", "forbidden"
    end
    set new_price_cents to existing.list_price_cents
    if payload has "list_price" and (payload at "list_price") is not nothing
      set pp to parse_author_money_cents using (payload at "list_price"), "list_price"
      if not pp.ok
        give back author_error using 422, "author_validation_failed", pp.error, "list_price", pp.reason
      end
      set new_price_cents to pp.cents
    end
    set new_roy_bp to existing.royalty_rate_bp
    if payload has "royalty_rate" and (payload at "royalty_rate") is not nothing
      set pr to parse_author_royalty_bp using (payload at "royalty_rate"), "royalty_rate"
      if not pr.ok
        give back author_error using 422, "author_validation_failed", pr.error, "royalty_rate", pr.reason
      end
      set new_roy_bp to pr.bp
    end
    set new_isbn to existing.isbn_13
    if payload has "isbn_13"
      set ir to validate_isbn13_strict using (payload at "isbn_13")
      if not ir.ok
        give back author_error using 422, "author_validation_failed", ir.error, "isbn_13", "invalid_isbn_13"
      end
      set new_isbn to ir.canonical
    end
    set new_asin to existing.asin
    if payload has "asin"
      set ar to validate_asin_strict using (payload at "asin")
      if not ar.ok
        give back author_error using 422, "author_validation_failed", ar.error, "asin", "invalid_asin"
      end
      set new_asin to ar.canonical
    end
    set new_sub to existing.subtitle
    if payload has "subtitle" and (payload at "subtitle") is not nothing
      set new_sub to text.trim using (text.from using (payload at "subtitle"))
    end
    set new_blurb to existing.blurb
    if payload has "blurb" and (payload at "blurb") is not nothing
      set bres to normalize_and_validate_body using (payload at "blurb")
      if not bres.ok
        give back author_error using 422, "author_validation_failed", bres.error, "blurb", "unsafe_html"
      end
      set new_blurb to bres.body_html
    end
    set new_ser_id to existing.series_id
    if payload has "series_id"
      if (payload at "series_id") is nothing
        set new_ser_id to nothing
      otherwise
        set psi to parse_author_int using (payload at "series_id"), 1, 2147483647
        if not psi.ok
          give back author_error using 422, "author_validation_failed", psi.error, "series_id", psi.reason
        end
        set new_ser_id to psi.val
      end
    end
    set new_ser_pos to existing.series_position
    if payload has "series_position"
      if (payload at "series_position") is nothing
        set new_ser_pos to nothing
      otherwise
        set psp to parse_author_int using (payload at "series_position"), 1, 9999
        if not psp.ok
          give back author_error using 422, "author_validation_failed", psp.error, "series_position", psp.reason
        end
        set new_ser_pos to psp.val
      end
    end

    set now_rec to call dates.now_utc
    set ent_row to data.one using stmts.get_entry_by_id, record {id: existing.entry_id}
    set new_pub to ent_row.published_at
    if new_status is "published" and new_pub is nothing
      set new_pub to now_rec.iso
    end
    set cf_json to json.stringify using {"isbn_13": new_isbn, "asin": new_asin, "subtitle": new_sub, "list_price": (format_cents_usd using new_price_cents)}
    set tx to data.begin using stmts.db
    try
      call data.execute using stmts.delete_redirect, record {lookup: "old_path", sv: new_path, iv: 0}, tx
      if (new_path is not existing.full_path) and (existing.status is "published") and (new_status is "published")
        call data.execute using stmts.delete_redirect, record {lookup: "old_path", sv: existing.full_path, iv: 0}, tx
        call data.execute using stmts.insert_redirect, record {old_path: existing.full_path, entry_id: existing.entry_id, created_at: now_rec.iso}, tx
      end
      call data.execute using stmts.update_entry, record {slug: new_slug, full_path: new_path, title: new_title, status: new_status, body_html: new_blurb, custom_fields_json: cf_json, meta_title: new_title, meta_description: new_blurb, published_at: new_pub, updated_at: now_rec.iso, id: existing.entry_id}, tx
      call data.execute using stmts.author.upd_book, record {author_id: existing.author_id, series_id: new_ser_id, series_position: new_ser_pos, subtitle: new_sub, isbn_13: new_isbn, asin: new_asin, edition_format: existing.edition_format, page_count: existing.page_count, word_count: existing.word_count, in_language: existing.in_language, genre_slug: existing.genre_slug, blurb: new_blurb, list_price_cents: new_price_cents, royalty_rate_bp: new_roy_bp, product_id: existing.product_id, cover_media_id: existing.cover_media_id, active: existing.active, updated_at: now_rec.iso, id: bid}, tx
      set updated to data.one using stmts.author.books, record {mode: "id", iv: bid, sv: ""}, tx
      call data.commit using tx
      call invalidate_author_caches using stmts, bid, new_ser_id, 0, existing.author_id
      call invalidate_route_caches using stmts, existing.full_path, new_path, "book"
      give back server.json using 200, {"book": (format_book_api_row using updated)}
    catch tx_err
      call data.rollback using tx
      give back author_error using 500, "db_error", tx_err.message, "", "db_error"
    end
  catch err
    give back author_error using 400, "invalid_json", err.message, "", "invalid_json"
  end
end

route "POST" "/api/admin/author/books/{id}/sync-product" using req
  set auth to require_author_admin_api using stmts, req, "author:manage", yes
  if not auth.ok
    give back auth.response
  end
  if not (role_has_capability using auth.session.role, "commerce:manage")
    give back author_error using 403, "forbidden", "Requires both author:manage and commerce:manage capabilities", "", "forbidden"
  end
  if not stmts.author_ready or (not (get_author_config using stmts).enabled)
    give back author_error using 404, "author_disabled", "Author Mode is disabled", "", "disabled"
  end
  if not stmts.commerce_ready
    give back author_error using 404, "commerce_not_migrated", "Migration 004 commerce schema is required to sync products", "", "not_migrated"
  end
  try
    set bid to text.to_integer using req.params.id
    set book to data.one using stmts.author.books, record {mode: "id", iv: bid, sv: ""}
    if book is nothing
      give back author_error using 404, "book_not_found", "Book not found", "", "not_found"
    end
    if not (role_has_capability using auth.session.role, "entries:update:any")
      if book.owner_user_id is nothing or book.owner_user_id is not auth.session.user_id
        give back author_error using 403, "forbidden", "Cannot sync another user's book", "", "forbidden"
      end
    end
    if book.list_price_cents is at most 0
      give back author_error using 422, "author_validation_failed", "Commerce products require list_price > 0.00", "list_price", "invalid_money"
    end
    set payload to {}
    if req.body is not nothing and (text.trim using req.body) is not ""
      set payload to server.parse_json using req
    end
    set kind_val to "physical"
    if book.edition_format is "ebook"
      set kind_val to "digital"
    end
    if payload has "kind" and (payload at "kind") is not nothing
      set kind_val to text.lower using (text.trim using (text.from using (payload at "kind")))
    end
    if kind_val is not "physical" and kind_val is not "digital"
      give back author_error using 422, "author_validation_failed", "kind must be physical or digital", "kind", "invalid_kind"
    end

    set carrier_val to "lulu_direct"
    set lulu_sku_val to "LULU-USPS-001"
    set usps_svc to "media_mail"
    set max_wg to 31751
    set weight_val to 350
    set media_mail_el to 1
    set ships_from to "US"
    if kind_val is "physical"
      if payload has "carrier" and (payload at "carrier") is not nothing
        set carrier_val to text.lower using (text.trim using (text.from using (payload at "carrier")))
      end
      if carrier_val is not "usps" and carrier_val is not "lulu_direct"
        give back author_error using 422, "LULU-USPS-001", "Physical books support only usps or lulu_direct carriers (UPS/FedEx/DHL disallowed)", "carrier", "LULU-USPS-001"
      end
      if payload has "ships_from_country" and (payload at "ships_from_country") is not nothing
        set ships_from to text.upper using (text.trim using (text.from using (payload at "ships_from_country")))
      end
      if ships_from is not "US"
        give back author_error using 422, "LULU-USPS-001", "USPS/Lulu book fulfillment requires ships_from_country = US", "ships_from_country", "LULU-USPS-001"
      end
      if payload has "weight_g" and (payload at "weight_g") is not nothing
        set pwg to parse_author_int using (payload at "weight_g"), 1, 31751
        if not pwg.ok
          give back author_error using 422, "author_validation_failed", pwg.error, "weight_g", pwg.reason
        end
        set weight_val to pwg.val
      end
      if payload has "max_weight_g" and (payload at "max_weight_g") is not nothing
        set pmw to parse_author_int using (payload at "max_weight_g"), 1, 31751
        if not pmw.ok
          give back author_error using 422, "author_validation_failed", pmw.error, "max_weight_g", pmw.reason
        end
        set max_wg to pmw.val
      end
      if weight_val is greater than max_wg
        give back author_error using 422, "LULU-USPS-001", "Book weight exceeds max_weight_g (31751 g)", "weight_g", "weight_exceeds_carrier_limit"
      end
      if carrier_val is "usps"
        if payload has "usps_service" and (payload at "usps_service") is not nothing
          set usps_svc to text.lower using (text.trim using (text.from using (payload at "usps_service")))
        end
        if usps_svc is not "ground_advantage" and usps_svc is not "priority" and usps_svc is not "media_mail"
          give back author_error using 422, "LULU-USPS-001", "Unsupported USPS service tier", "usps_service", "LULU-USPS-001"
        end
        set lulu_sku_val to ""
      otherwise
        if payload has "lulu_sku" and (payload at "lulu_sku") is not nothing
          set lulu_sku_val to text.trim using (text.from using (payload at "lulu_sku"))
        end
        if lulu_sku_val is ""
          give back author_error using 422, "LULU-USPS-001", "lulu_direct requires non-empty lulu_sku", "lulu_sku", "lulu_sku_required"
        end
      end
    end

    set dig_media_id to nothing
    set dl_lim to 5
    set dl_exp to 72
    if kind_val is "digital" and payload has "digital_media_id" and (payload at "digital_media_id") is not nothing
      set pm to parse_author_int using (payload at "digital_media_id"), 1, 2147483647
      if not pm.ok
        give back author_error using 422, "author_validation_failed", pm.error, "digital_media_id", pm.reason
      end
      set m_row to data.one using stmts.get_media, record {lookup: "id", iv: pm.val, sv: ""}
      if m_row is nothing
        give back author_error using 404, "media_not_found", "Referenced digital media asset not found", "digital_media_id", "not_found"
      end
      set dig_media_id to m_row.id
      if payload has "download_limit" and (payload at "download_limit") is not nothing
        set pdl to parse_author_int using (payload at "download_limit"), 1, 100
        if pdl.ok
          set dl_lim to pdl.val
        end
      end
      if payload has "expiry_hours" and (payload at "expiry_hours") is not nothing
        set pde to parse_author_int using (payload at "expiry_hours"), 1, 8760
        if pde.ok
          set dl_exp to pde.val
        end
      end
    end

    set stock_val to 100
    if payload has "stock_qty" and (payload at "stock_qty") is not nothing
      set pst to parse_author_int using (payload at "stock_qty"), 0, 999999
      if not pst.ok
        give back author_error using 422, "author_validation_failed", pst.error, "stock_qty", pst.reason
      end
      set stock_val to pst.val
    end

    call ensure_commerce_salt_and_type using stmts
    set ct_p to data.one using stmts.get_type, record {lookup: "slug", sv: "product", iv: 0}
    set now_rec to call dates.now_utc
    set now_iso to now_rec.iso
    set tx to data.begin using stmts.db
    try
      set target_pid to book.product_id
      if payload has "product_id" and (payload at "product_id") is not nothing
        set ppid to parse_author_int using (payload at "product_id"), 1, 2147483647
        if not ppid.ok
          call data.rollback using tx
          give back author_error using 422, "author_validation_failed", ppid.error, "product_id", ppid.reason
        end
        set target_pid to ppid.val
      end
      set prod_row to nothing
      if target_pid is not nothing
        set prod_row to data.one using stmts.commerce.products, record {mode: "id", iv: target_pid, sv: ""}, tx
        if prod_row is nothing
          call data.rollback using tx
          give back author_error using 404, "product_not_found", "Referenced product_id not found", "product_id", "not_found"
        end
        set tax_c to "standard"
        if kind_val is "digital"
          set tax_c to "digital"
        end
        call data.execute using stmts.commerce.upd_product, record {sku: prod_row.sku, kind: kind_val, price_cents: book.list_price_cents, compare_at_cents: prod_row.compare_at_cents, stock_qty: stock_val, weight_g: weight_val, tax_class: tax_c, active: 1, updated_at: now_iso, id: prod_row.id}, tx
      otherwise
        set sku_val to "BOOK-" joined with (text.from using book.id) joined with "-" joined with (text.upper using book.edition_format)
        if payload has "sku" and (payload at "sku") is not nothing
          set sku_val to text.trim using (text.from using (payload at "sku"))
        end
        if not (is_allowed_chars using sku_val, "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789_-", 1, 64)
          call data.rollback using tx
          give back author_error using 422, "author_validation_failed", "Invalid SKU", "sku", "invalid_sku"
        end
        set p_slug to "book-" joined with book.slug
        set p_path to compute_full_path using ct_p.permalink_pattern, p_slug
        set existing_pe to data.one using stmts.get_entry_by_full_path, record {full_path: p_path}, tx
        if existing_pe is not nothing
          set p_slug to p_slug joined with "-" joined with (text.from using book.id)
          set p_path to compute_full_path using ct_p.permalink_pattern, p_slug
        end
        set cf_p to json.stringify using {"isbn_13": book.isbn_13, "subtitle": book.subtitle}
        set pub_p to nothing
        if book.status is "published"
          set pub_p to now_iso
        end
        call data.execute using stmts.insert_entry, record {content_type_id: ct_p.id, slug: p_slug, full_path: p_path, title: book.title, status: book.status, body_html: book.blurb, custom_fields_json: cf_p, meta_title: book.title, meta_description: book.blurb, author_id: auth.session.user_id, published_at: pub_p, created_at: now_iso, updated_at: now_iso}, tx
        set created_pe to data.one using stmts.get_entry_by_full_path, record {full_path: p_path}, tx
        set tax_c to "standard"
        if kind_val is "digital"
          set tax_c to "digital"
        end
        call data.execute using stmts.commerce.ins_product, record {entry_id: created_pe.id, sku: sku_val, kind: kind_val, price_cents: book.list_price_cents, compare_at_cents: nothing, currency: "USD", stock_qty: stock_val, weight_g: weight_val, tax_class: tax_c, active: 1, created_at: now_iso, updated_at: now_iso}, tx
        set prod_row to data.one using stmts.commerce.products, record {mode: "sku", iv: 0, sv: sku_val}, tx
      end
      call data.execute using stmts.commerce.del_fulfillment, record {product_id: prod_row.id}, tx
      if kind_val is "physical"
        call data.execute using stmts.commerce.ins_fulfillment, record {product_id: prod_row.id, carrier: carrier_val, lulu_sku: lulu_sku_val, usps_service: usps_svc, max_weight_g: max_wg, media_mail_eligible: media_mail_el, ships_from_country: ships_from}, tx
      end
      if kind_val is "digital" and dig_media_id is not nothing
        call data.execute using stmts.commerce.del_digital_files, record {product_id: prod_row.id}, tx
        call data.execute using stmts.commerce.ins_digital_file, record {product_id: prod_row.id, media_id: dig_media_id, download_limit: dl_lim, expiry_hours: dl_exp, created_at: now_iso}, tx
      end
      call data.execute using stmts.author.upd_book, record {author_id: book.author_id, series_id: book.series_id, series_position: book.series_position, subtitle: book.subtitle, isbn_13: book.isbn_13, asin: book.asin, edition_format: book.edition_format, page_count: book.page_count, word_count: book.word_count, in_language: book.in_language, genre_slug: book.genre_slug, blurb: book.blurb, list_price_cents: book.list_price_cents, royalty_rate_bp: book.royalty_rate_bp, product_id: prod_row.id, cover_media_id: book.cover_media_id, active: book.active, updated_at: now_iso, id: bid}, tx
      set updated_book to data.one using stmts.author.books, record {mode: "id", iv: bid, sv: ""}, tx
      set updated_prod to data.one using stmts.commerce.products, record {mode: "id", iv: prod_row.id, sv: ""}, tx
      call data.commit using tx
      call invalidate_author_caches using stmts, bid, book.series_id, 0, book.author_id
      call invalidate_commerce_caches using stmts, prod_row.id
      call invalidate_route_caches using stmts, book.full_path, updated_prod.full_path, "book"
      give back server.json using 200, {"synced": yes, "book": (format_book_api_row using updated_book), "product": (format_product_api_row using updated_prod)}
    catch tx_err
      call data.rollback using tx
      give back author_error using 500, "db_error", tx_err.message, "", "db_error"
    end
  catch err
    give back author_error using 400, "invalid_json", err.message, "", "invalid_json"
  end
end

route "GET" "/api/admin/author/chapters" using req
  set auth to require_author_admin_api using stmts, req, "author:manage", no
  if not auth.ok
    give back auth.response
  end
  if not stmts.author_ready or (not (get_author_config using stmts).enabled)
    give back author_error using 404, "author_disabled", "Author Mode is disabled", "", "disabled"
  end
  set rows to data.query using stmts.author.chapters, record {mode: "all", iv: 0, sv: "", sv2: ""}
  set can_see_all to role_has_capability using auth.session.role, "entries:read_all"
  set out to []
  for each r in rows
    if can_see_all or r.owner_user_id is auth.session.user_id
      set out to collections.append using out, (format_chapter_api_row using r)
    end
  end
  give back server.json using 200, {"chapters": out}
end

route "POST" "/api/admin/author/chapters" using req
  set auth to require_author_admin_api using stmts, req, "author:manage", yes
  if not auth.ok
    give back auth.response
  end
  if not stmts.author_ready or (not (get_author_config using stmts).enabled)
    give back author_error using 404, "author_disabled", "Author Mode is disabled", "", "disabled"
  end
  try
    set payload to server.parse_json using req
    if (not (payload has "book_id")) or (not (payload has "title")) or (not (payload has "slug"))
      give back author_error using 400, "missing_fields", "book_id, title, and slug are required", "", "missing_fields"
    end
    set pbid to parse_author_int using (payload at "book_id"), 1, 2147483647
    if not pbid.ok
      give back author_error using 422, "author_validation_failed", pbid.error, "book_id", pbid.reason
    end
    set book to data.one using stmts.author.books, record {mode: "id", iv: pbid.val, sv: ""}
    if book is nothing
      give back author_error using 404, "book_not_found", "Book not found", "book_id", "not_found"
    end
    if not (role_has_capability using auth.session.role, "entries:update:any")
      if book.owner_user_id is nothing or book.owner_user_id is not auth.session.user_id
        give back author_error using 403, "forbidden", "Cannot add chapter to another user's book", "", "forbidden"
      end
    end
    set c_title to text.trim using (text.from using (payload at "title"))
    set slug to normalize_slug using (text.from using (payload at "slug"))
    if c_title is "" or (not (is_valid_entry_slug using slug))
      give back author_error using 422, "author_validation_failed", "Valid chapter title and slug are required", "slug", "invalid_slug"
    end
    call ensure_author_types using stmts
    set ct to data.one using stmts.get_type, record {lookup: "slug", sv: "chapter", iv: 0}
    set full_path to compute_full_path using ct.permalink_pattern, slug
    if is_author_reserved_slug using slug, full_path
      give back author_error using 409, "reserved_slug_collision", "Chapter slug collides with reserved system prefix", "slug", "reserved_path"
    end
    set dup to data.one using stmts.get_entry_by_full_path, record {full_path: full_path}
    if dup is not nothing
      give back author_error using 409, "duplicate_slug", ("Chapter already exists at " joined with full_path), "slug", "duplicate_slug"
    end
    set c_num to 1
    if payload has "chapter_number" and (payload at "chapter_number") is not nothing
      set pcn to parse_author_int using (payload at "chapter_number"), 1, 9999
      if not pcn.ok
        give back author_error using 422, "author_validation_failed", pcn.error, "chapter_number", pcn.reason
      end
      set c_num to pcn.val
    end
    set sort_ord to c_num
    if payload has "sort_order" and (payload at "sort_order") is not nothing
      set pso to parse_author_int using (payload at "sort_order"), 0, 99999
      if not pso.ok
        give back author_error using 422, "author_validation_failed", pso.error, "sort_order", pso.reason
      end
      set sort_ord to pso.val
    end
    set wd_cnt to 0
    if payload has "word_count" and (payload at "word_count") is not nothing
      set pwd to parse_author_int using (payload at "word_count"), 0, 500000
      if not pwd.ok
        give back author_error using 422, "author_validation_failed", pwd.error, "word_count", pwd.reason
      end
      set wd_cnt to pwd.val
    end
    set read_min to 0
    if payload has "reading_minutes" and (payload at "reading_minutes") is not nothing
      set prm to parse_author_int using (payload at "reading_minutes"), 0, 9999
      if not prm.ok
        give back author_error using 422, "author_validation_failed", prm.error, "reading_minutes", prm.reason
      end
      set read_min to prm.val
    end
    set is_samp to 0
    if payload has "is_sample" and ((payload at "is_sample") is yes or (payload at "is_sample") is 1)
      set is_samp to 1
    end
    set c_hook to ""
    if payload has "cliffhanger_hook" and (payload at "cliffhanger_hook") is not nothing
      set c_hook to text.trim using (text.from using (payload at "cliffhanger_hook"))
    end
    set body_s to ""
    if payload has "body_html" and (payload at "body_html") is not nothing
      set bres to normalize_and_validate_body using (payload at "body_html")
      if not bres.ok
        give back author_error using 422, "author_validation_failed", bres.error, "body_html", "unsafe_html"
      end
      set body_s to bres.body_html
    end
    set status_s to "draft"
    if payload has "status" and (payload at "status") is not nothing
      set status_s to text.lower using (text.trim using (text.from using (payload at "status")))
    end
    if status_s is not "draft" and status_s is not "published"
      give back author_error using 422, "author_validation_failed", "status must be draft or published", "status", "invalid_status"
    end
    if status_s is "published" and (not (role_has_capability using auth.session.role, "entries:publish"))
      give back author_error using 403, "forbidden", "Insufficient capability to publish chapter", "status", "forbidden"
    end
    set now_rec to call dates.now_utc
    set pub_at to nothing
    if status_s is "published"
      set pub_at to now_rec.iso
    end
    set tx to data.begin using stmts.db
    try
      call data.execute using stmts.insert_entry, record {content_type_id: ct.id, slug: slug, full_path: full_path, title: c_title, status: status_s, body_html: body_s, custom_fields_json: "{}", meta_title: c_title, meta_description: c_hook, author_id: auth.session.user_id, published_at: pub_at, created_at: now_rec.iso, updated_at: now_rec.iso}, tx
      set ent to data.one using stmts.get_entry_by_full_path, record {full_path: full_path}, tx
      call data.execute using stmts.author.ins_chapter, record {entry_id: ent.id, book_id: book.id, chapter_number: c_num, sort_order: sort_ord, is_sample: is_samp, word_count: wd_cnt, reading_minutes: read_min, cliffhanger_hook: c_hook, readability_grade_bp: nothing, readability_score: nothing, created_at: now_rec.iso, updated_at: now_rec.iso}, tx
      set created to data.one using stmts.author.chapters, record {mode: "entry", iv: ent.id, sv: "", sv2: ""}, tx
      call data.commit using tx
      call invalidate_author_caches using stmts, book.id, book.series_id, created.id, book.author_id
      call invalidate_route_caches using stmts, full_path, book.full_path, "chapter"
      give back server.json using 201, {"chapter": (format_chapter_api_row using created)}
    catch tx_err
      call data.rollback using tx
      give back author_error using 500, "db_error", tx_err.message, "", "db_error"
    end
  catch err
    give back author_error using 400, "invalid_json", err.message, "", "invalid_json"
  end
end

route "PUT" "/api/admin/author/chapters/{id}" using req
  set auth to require_author_admin_api using stmts, req, "author:manage", yes
  if not auth.ok
    give back auth.response
  end
  if not stmts.author_ready or (not (get_author_config using stmts).enabled)
    give back author_error using 404, "author_disabled", "Author Mode is disabled", "", "disabled"
  end
  try
    set cid to text.to_integer using req.params.id
    set existing to data.one using stmts.author.chapters, record {mode: "id", iv: cid, sv: "", sv2: ""}
    if existing is nothing
      give back author_error using 404, "chapter_not_found", "Chapter not found", "", "not_found"
    end
    if not (role_has_capability using auth.session.role, "entries:update:any")
      if existing.owner_user_id is nothing or existing.owner_user_id is not auth.session.user_id
        give back author_error using 403, "forbidden", "Cannot edit another user's chapter", "", "forbidden"
      end
    end
    set payload to server.parse_json using req
    set ct to data.one using stmts.get_type, record {lookup: "slug", sv: "chapter", iv: 0}
    set new_slug to existing.slug
    if payload has "slug" and (payload at "slug") is not nothing
      set new_slug to normalize_slug using (text.from using (payload at "slug"))
    end
    if not (is_valid_entry_slug using new_slug)
      give back author_error using 422, "author_validation_failed", "Invalid chapter slug", "slug", "invalid_slug"
    end
    set new_path to compute_full_path using ct.permalink_pattern, new_slug
    if is_author_reserved_slug using new_slug, new_path
      give back author_error using 409, "reserved_slug_collision", "Chapter slug collides with reserved system prefix", "slug", "reserved_path"
    end
    set col to data.one using stmts.get_entry_by_full_path, record {full_path: new_path}
    if col is not nothing and col.id is not existing.entry_id
      give back author_error using 409, "duplicate_slug", "Another entry owns this slug", "slug", "duplicate_slug"
    end
    set new_title to existing.title
    if payload has "title" and (payload at "title") is not nothing
      set new_title to text.trim using (text.from using (payload at "title"))
    end
    set new_status to existing.status
    if payload has "status" and (payload at "status") is not nothing
      set new_status to text.lower using (text.trim using (text.from using (payload at "status")))
    end
    if new_status is "published" and (not (role_has_capability using auth.session.role, "entries:publish"))
      give back author_error using 403, "forbidden", "Insufficient capability to publish chapter", "status", "forbidden"
    end
    set new_body to existing.body_html
    if payload has "body_html" and (payload at "body_html") is not nothing
      set bres to normalize_and_validate_body using (payload at "body_html")
      if not bres.ok
        give back author_error using 422, "author_validation_failed", bres.error, "body_html", "unsafe_html"
      end
      set new_body to bres.body_html
    end
    set new_sample to existing.is_sample
    if payload has "is_sample" and (payload at "is_sample") is not nothing
      set new_sample to 0
      if (payload at "is_sample") is yes or (payload at "is_sample") is 1
        set new_sample to 1
      end
    end
    set now_rec to call dates.now_utc
    set ent_row to data.one using stmts.get_entry_by_id, record {id: existing.entry_id}
    set new_pub to ent_row.published_at
    if new_status is "published" and new_pub is nothing
      set new_pub to now_rec.iso
    end
    set tx to data.begin using stmts.db
    try
      call data.execute using stmts.delete_redirect, record {lookup: "old_path", sv: new_path, iv: 0}, tx
      if (new_path is not existing.full_path) and (existing.status is "published") and (new_status is "published")
        call data.execute using stmts.delete_redirect, record {lookup: "old_path", sv: existing.full_path, iv: 0}, tx
        call data.execute using stmts.insert_redirect, record {old_path: existing.full_path, entry_id: existing.entry_id, created_at: now_rec.iso}, tx
      end
      call data.execute using stmts.update_entry, record {slug: new_slug, full_path: new_path, title: new_title, status: new_status, body_html: new_body, custom_fields_json: ent_row.custom_fields_json, meta_title: new_title, meta_description: ent_row.meta_description, published_at: new_pub, updated_at: now_rec.iso, id: existing.entry_id}, tx
      call data.execute using stmts.author.upd_chapter, record {chapter_number: existing.chapter_number, sort_order: existing.sort_order, is_sample: new_sample, word_count: existing.word_count, reading_minutes: existing.reading_minutes, cliffhanger_hook: existing.cliffhanger_hook, readability_grade_bp: existing.readability_grade_bp, readability_score: existing.readability_score, updated_at: now_rec.iso, id: cid}, tx
      set updated to data.one using stmts.author.chapters, record {mode: "id", iv: cid, sv: "", sv2: ""}, tx
      call data.commit using tx
      call invalidate_author_caches using stmts, existing.book_id, 0, cid, 0
      call invalidate_route_caches using stmts, existing.full_path, new_path, "chapter"
      give back server.json using 200, {"chapter": (format_chapter_api_row using updated)}
    catch tx_err
      call data.rollback using tx
      give back author_error using 500, "db_error", tx_err.message, "", "db_error"
    end
  catch err
    give back author_error using 400, "invalid_json", err.message, "", "invalid_json"
  end
end

route "POST" "/api/admin/author/chapters/reorder" using req
  set auth to require_author_admin_api using stmts, req, "author:manage", yes
  if not auth.ok
    give back auth.response
  end
  if not stmts.author_ready or (not (get_author_config using stmts).enabled)
    give back author_error using 404, "author_disabled", "Author Mode is disabled", "", "disabled"
  end
  try
    set payload to server.parse_json using req
    if (not (payload has "book_id")) or (not (payload has "chapter_ids"))
      give back author_error using 400, "missing_fields", "book_id and chapter_ids are required", "", "missing_fields"
    end
    set pbid to parse_author_int using (payload at "book_id"), 1, 2147483647
    if not pbid.ok
      give back author_error using 422, "author_validation_failed", pbid.error, "book_id", pbid.reason
    end
    set book to data.one using stmts.author.books, record {mode: "id", iv: pbid.val, sv: ""}
    if book is nothing
      give back author_error using 404, "book_not_found", "Book not found", "book_id", "not_found"
    end
    if not (role_has_capability using auth.session.role, "entries:update:any")
      if book.owner_user_id is nothing or book.owner_user_id is not auth.session.user_id
        give back author_error using 403, "forbidden", "Cannot reorder another user's chapters", "", "forbidden"
      end
    end
    set cids to payload at "chapter_ids"
    set now_rec to call dates.now_utc
    set tx to data.begin using stmts.db
    try
      set pos to 1
      for each raw_cid in cids
        set pcid to parse_author_int using raw_cid, 1, 2147483647
        if not pcid.ok
          call data.rollback using tx
          give back author_error using 422, "author_validation_failed", pcid.error, "chapter_ids", pcid.reason
        end
        set ch_row to data.one using stmts.author.chapters, record {mode: "id", iv: pcid.val, sv: "", sv2: ""}, tx
        if ch_row is not nothing and ch_row.book_id is pbid.val
          call data.execute using stmts.author.upd_chapter, record {chapter_number: pos, sort_order: pos, is_sample: ch_row.is_sample, word_count: ch_row.word_count, reading_minutes: ch_row.reading_minutes, cliffhanger_hook: ch_row.cliffhanger_hook, readability_grade_bp: ch_row.readability_grade_bp, readability_score: ch_row.readability_score, updated_at: now_rec.iso, id: pcid.val}, tx
        end
        set pos to pos plus 1
      end
      call data.commit using tx
      call invalidate_author_caches using stmts, pbid.val, book.series_id, 0, book.author_id
      set ordered to data.query using stmts.author.chapters, record {mode: "book", iv: pbid.val, sv: "", sv2: ""}
      set out_c to []
      for each cr in ordered
        set out_c to collections.append using out_c, (format_chapter_api_row using cr)
      end
      give back server.json using 200, {"book_id": pbid.val, "chapters": out_c}
    catch tx_err
      call data.rollback using tx
      give back author_error using 500, "db_error", tx_err.message, "", "db_error"
    end
  catch err
    give back author_error using 400, "invalid_json", err.message, "", "invalid_json"
  end
end

route "POST" "/api/admin/author/radar/query" using req
  set auth to require_author_admin_api using stmts, req, "author:manage", yes
  if not auth.ok
    give back auth.response
  end
  if not stmts.author_ready or (not (get_author_config using stmts).enabled)
    give back author_error using 404, "author_disabled", "Author Mode is disabled", "", "disabled"
  end
  set rl to check_author_rate_limit using stmts, req, auth.session, "radar"
  if not rl.ok
    give back rl.response
  end
  set cfg to get_author_config using stmts
  set orig_chk to validate_groxy_origin using cfg.groxy_ai_origin, no
  if not orig_chk.ok
    give back author_error using 422, "GRAB-E402", orig_chk.error, "groxy_ai_origin", "GRAB-E402"
  end
  try
    set payload to server.parse_json using req
    set action_kind to "radar"
    if payload has "action" and (payload at "action") is not nothing
      set action_kind to text.lower using (text.trim using (text.from using (payload at "action")))
    end
    if action_kind is "genres"
      set gresp to http.get using (orig_chk.origin joined with "/api/groxy/author/genres"), record {timeout_ms: 5000}
      if not gresp.ok
        give back author_error using 502, "groxy_bridge_error", ("Groxy AI genres request failed with status " joined with (text.from using gresp.status)), "", "bridge_error"
      end
      give back server.json using 200, (json.parse using gresp.body)
    end
    set gslug to "urban-fiction"
    if payload has "genre_slug" and (payload at "genre_slug") is not nothing
      set gslug to text.lower using (text.trim using (text.from using (payload at "genre_slug")))
    end
    set tier_s to "14.99"
    if payload has "price_tier_usd" and (payload at "price_tier_usd") is not nothing
      set pt to parse_author_money_cents using (payload at "price_tier_usd"), "price_tier_usd"
      if not pt.ok
        give back author_error using 422, "author_validation_failed", pt.error, "price_tier_usd", pt.reason
      end
      set tier_s to pt.formatted
    end
    set g_csrf to groxy_fetch_csrf using orig_chk.origin
    set req_body to json.stringify using {"genre_slug": gslug, "target_consumer": "grablab_cms", "target_slot": "cms-draft", "price_tier_usd": tier_s}
    set hdrs to {"Content-Type": "application/json", "Accept": "application/json"}
    if g_csrf is not ""
      set hdrs to collections.put using hdrs, "X-CSRF-Token", g_csrf
    end
    set rresp to http.post using (orig_chk.origin joined with "/api/groxy/research/bestseller-radar"), req_body, record {headers: hdrs, timeout_ms: 8000}
    if not rresp.ok
      give back author_error using 502, "groxy_bridge_error", ("Groxy AI radar request failed (" joined with (text.from using rresp.status) joined with ")"), "", "bridge_error"
    end
    give back server.json using 200, (json.parse using rresp.body)
  catch err
    give back author_error using 502, "groxy_bridge_error", err.message, "", "bridge_error"
  end
end

route "POST" "/api/admin/author/radar/import" using req
  set auth to require_author_admin_api using stmts, req, "author:manage", yes
  if not auth.ok
    give back auth.response
  end
  if not stmts.author_ready or (not (get_author_config using stmts).enabled)
    give back author_error using 404, "author_disabled", "Author Mode is disabled", "", "disabled"
  end
  try
    set payload to server.parse_json using req
    if (not (payload has "radar_plan_id")) or (not (payload has "approval_token")) or (not (payload has "payload_sha256"))
      give back author_error using 400, "missing_fields", "radar_plan_id, approval_token, and payload_sha256 are required", "", "missing_fields"
    end
    set plan_id to text.trim using (text.from using (payload at "radar_plan_id"))
    set tok to text.trim using (text.from using (payload at "approval_token"))
    set p_sha to text.lower using (text.trim using (text.from using (payload at "payload_sha256")))
    if (not (is_allowed_chars using plan_id, "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789_-", 8, 120)) or (not (is_valid_radar_token using tok)) or (not (is_hex_str using p_sha, 64))
      give back author_error using 422, "author_validation_failed", "Invalid radar_plan_id, approval_token, or payload_sha256 format", "approval_token", "invalid_radar_token"
    end
    if payload has "canonical_payload" and (payload at "canonical_payload") is not nothing
      set comp_sha to crypto.sha256_hex using (text.from using (payload at "canonical_payload"))
      if comp_sha is not p_sha
        give back author_error using 403, "payload_digest_mismatch", "canonical_payload SHA-256 does not match payload_sha256", "payload_sha256", "digest_mismatch"
      end
    end

    set gslug to "urban-fiction"
    if payload has "genre_slug" and (payload at "genre_slug") is not nothing
      set gslug to text.lower using (text.trim using (text.from using (payload at "genre_slug")))
    end
    set t_type to "book"
    if payload has "target_type" and (payload at "target_type") is not nothing
      set t_type to text.lower using (text.trim using (text.from using (payload at "target_type")))
    end
    if t_type is not "series" and t_type is not "book" and t_type is not "chapter"
      give back author_error using 422, "author_validation_failed", "target_type must be series, book, or chapter", "target_type", "invalid_target_type"
    end
    set title_s to "Radar Draft " joined with plan_id
    if payload has "title" and (payload at "title") is not nothing and (text.trim using (text.from using (payload at "title"))) is not ""
      set title_s to text.trim using (text.from using (payload at "title"))
    end
    set slug_s to normalize_slug using plan_id
    if payload has "slug" and (payload at "slug") is not nothing and (text.trim using (text.from using (payload at "slug"))) is not ""
      set slug_s to normalize_slug using (text.from using (payload at "slug"))
    end
    if not (is_valid_entry_slug using slug_s)
      give back author_error using 422, "author_validation_failed", "Invalid draft slug", "slug", "invalid_slug"
    end
    set price_in to "14.99"
    if payload has "list_price" and (payload at "list_price") is not nothing
      set price_in to payload at "list_price"
    end
    set p_price to parse_author_money_cents using price_in, "list_price"
    if not p_price.ok
      give back author_error using 422, "author_validation_failed", p_price.error, "list_price", p_price.reason
    end
    set blurb_s to ""
    if payload has "blurb" and (payload at "blurb") is not nothing
      set bres to normalize_and_validate_body using (payload at "blurb")
      if not bres.ok
        give back author_error using 422, "author_validation_failed", bres.error, "blurb", "unsafe_html"
      end
      set blurb_s to bres.body_html
    end

    call ensure_author_types using stmts
    set ct to data.one using stmts.get_type, record {lookup: "slug", sv: t_type, iv: 0}
    set full_path to compute_full_path using ct.permalink_pattern, slug_s
    if is_author_reserved_slug using slug_s, full_path
      give back author_error using 409, "reserved_slug_collision", "Imported slug collides with reserved system prefix", "slug", "reserved_path"
    end

    set tok_cache_key to "radar_tok:" joined with (crypto.sha256_hex using tok)
    set tok_cached to cache.get using stmts.cms_cache, tok_cache_key
    if tok_cached.found
      give back author_error using 409, "radar_token_replayed", "Radar approval token has already been redeemed", "approval_token", "replay"
    end

    set now_rec to call dates.now_utc
    set now_iso to now_rec.iso
    set imp_by to "user:" joined with (text.from using auth.session.user_id)

    set attempt to 0
    set winner_done to no
    set winner_entry to nothing
    set winner_import to nothing
    while (not winner_done) and attempt is less than 20
      set attempt to attempt plus 1
      set tx to data.begin using stmts.db
      try
        set dup_plan to data.one using stmts.author.get_radar, record {mode: "plan", sv: plan_id}, tx
        if dup_plan is not nothing
          call data.rollback using tx
          give back author_error using 409, "radar_plan_already_imported", "This radar_plan_id has already been imported", "radar_plan_id", "replay"
        end
        set dup_path to data.one using stmts.get_entry_by_full_path, record {full_path: full_path}, tx
        if dup_path is not nothing
          call data.rollback using tx
          give back author_error using 409, "duplicate_slug", ("Entry already exists at " joined with full_path), "slug", "duplicate_slug"
        end
        set def_a to ensure_default_author_for_user using stmts, auth.session.user_id, auth.session.display_name, now_iso, tx
        set cf_json to json.stringify using {"radar_plan_id": plan_id, "list_price": p_price.formatted}
        call data.execute using stmts.insert_entry, record {content_type_id: ct.id, slug: slug_s, full_path: full_path, title: title_s, status: "draft", body_html: blurb_s, custom_fields_json: cf_json, meta_title: title_s, meta_description: blurb_s, author_id: auth.session.user_id, published_at: nothing, created_at: now_iso, updated_at: now_iso}, tx
        set ent to data.one using stmts.get_entry_by_full_path, record {full_path: full_path}, tx
        if t_type is "series"
          call data.execute using stmts.author.ins_series, record {entry_id: ent.id, author_id: def_a.id, genre_slug: gslug, reading_order_mode: "chronological", total_planned_books: 3, active: 1, created_at: now_iso, updated_at: now_iso}, tx
        end
        if t_type is "book"
          call data.execute using stmts.author.ins_book, record {entry_id: ent.id, author_id: def_a.id, series_id: nothing, series_position: nothing, subtitle: "", isbn_13: "", asin: "", edition_format: "paperback", page_count: 0, word_count: 0, in_language: "en", genre_slug: gslug, blurb: blurb_s, list_price_cents: p_price.cents, royalty_rate_bp: 7000, currency: "USD", product_id: nothing, cover_media_id: nothing, active: 1, created_at: now_iso, updated_at: now_iso}, tx
        end
        if t_type is "chapter"
          if (not (payload has "book_id")) or (payload at "book_id") is nothing
            call data.rollback using tx
            give back author_error using 400, "missing_fields", "book_id is required when target_type is chapter", "book_id", "missing_fields"
          end
          set pbid to parse_author_int using (payload at "book_id"), 1, 2147483647
          if not pbid.ok
            call data.rollback using tx
            give back author_error using 422, "author_validation_failed", pbid.error, "book_id", pbid.reason
          end
          call data.execute using stmts.author.ins_chapter, record {entry_id: ent.id, book_id: pbid.val, chapter_number: 1, sort_order: 1, is_sample: 0, word_count: 0, reading_minutes: 0, cliffhanger_hook: "", readability_grade_bp: nothing, readability_score: nothing, created_at: now_iso, updated_at: now_iso}, tx
        end
        call data.execute using stmts.author.ins_radar, record {radar_plan_id: plan_id, genre_slug: gslug, target_type: t_type, entry_id: ent.id, payload_sha256: p_sha, imported_by: imp_by, created_at: now_iso}, tx
        set imp_row to data.one using stmts.author.get_radar, record {mode: "plan", sv: plan_id}, tx
        call data.commit using tx
        set winner_entry to ent
        set winner_import to imp_row
        set winner_done to yes
      catch tx_err
        try
          call data.rollback using tx
        catch rb_err
        end
        set recheck to data.one using stmts.author.get_radar, record {mode: "plan", sv: plan_id}
        if recheck is not nothing
          give back author_error using 409, "radar_plan_already_imported", "Concurrent radar import already claimed this radar_plan_id", "radar_plan_id", "replay"
        end
        if (text.contains using (text.lower using tx_err.message), "unique") or (text.contains using (text.lower using tx_err.message), "constraint")
          give back author_error using 409, "radar_plan_already_imported", "Duplicate radar import blocked", "radar_plan_id", "replay"
        end
        if attempt is at least 20
          give back author_error using 409, "radar_plan_already_imported", "Concurrent radar import conflict", "radar_plan_id", "conflict"
        end
      end
    end

    call cache.set using stmts.cms_cache, tok_cache_key, "1", 86400000
    call invalidate_author_caches using stmts, 0, 0, 0, 0
    call invalidate_route_caches using stmts, full_path, "", t_type
    give back server.json using 201, {"import": winner_import, "entry": winner_entry, "status_enforced": "draft"}
  catch err
    give back author_error using 400, "invalid_json", err.message, "", "invalid_json"
  end
end

route "POST" "/api/admin/author/readability-audit" using req
  set auth to require_author_admin_api using stmts, req, "author:manage", yes
  if not auth.ok
    give back auth.response
  end
  if not stmts.author_ready or (not (get_author_config using stmts).enabled)
    give back author_error using 404, "author_disabled", "Author Mode is disabled", "", "disabled"
  end
  set rl to check_author_rate_limit using stmts, req, auth.session, "readability"
  if not rl.ok
    give back rl.response
  end
  set cfg to get_author_config using stmts
  set orig_chk to validate_groxy_origin using cfg.groxy_ai_origin, no
  if not orig_chk.ok
    give back author_error using 422, "GRAB-E402", orig_chk.error, "groxy_ai_origin", "GRAB-E402"
  end
  try
    set payload to server.parse_json using req
    if (not (payload has "prose")) or (payload at "prose") is nothing
      give back author_error using 400, "missing_fields", "prose is required", "prose", "missing_fields"
    end
    set prose_s to text.trim using (text.from using (payload at "prose"))
    if prose_s is ""
      give back author_error using 422, "author_validation_failed", "prose cannot be empty", "prose", "empty_prose"
    end
    set g_csrf to groxy_fetch_csrf using orig_chk.origin
    set req_map to {"prose": prose_s}
    if payload has "genre_slug" and (payload at "genre_slug") is not nothing and (text.trim using (text.from using (payload at "genre_slug"))) is not ""
      set req_map to collections.put using req_map, "genre_slug", (text.trim using (text.from using (payload at "genre_slug")))
    end
    set hdrs to {"Content-Type": "application/json", "Accept": "application/json"}
    if g_csrf is not ""
      set hdrs to collections.put using hdrs, "X-CSRF-Token", g_csrf
    end
    set aresp to http.post using (orig_chk.origin joined with "/api/groxy/author/readability-audit"), (json.stringify using req_map), record {headers: hdrs, timeout_ms: 8000}
    if not aresp.ok
      give back author_error using 502, "groxy_bridge_error", ("Groxy AI readability audit failed (" joined with (text.from using aresp.status) joined with ")"), "", "bridge_error"
    end
    set audit_doc to json.parse using aresp.body
    if payload has "chapter_id" and (payload at "chapter_id") is not nothing
      set pcid to parse_author_int using (payload at "chapter_id"), 1, 2147483647
      if pcid.ok
        set chap to data.one using stmts.author.chapters, record {mode: "id", iv: pcid.val, sv: "", sv2: ""}
        if chap is not nothing
          set can_upd to (role_has_capability using auth.session.role, "entries:update:any") or (chap.owner_user_id is auth.session.user_id)
          if can_upd
            set r_score to nothing
            if audit_doc has "clarity_score" and (audit_doc at "clarity_score") is not nothing
              set ps to parse_author_int using (audit_doc at "clarity_score"), 0, 100
              if ps.ok
                set r_score to ps.val
              end
            end
            set now_rec to call dates.now_utc
            call data.execute using stmts.author.upd_chapter, record {chapter_number: chap.chapter_number, sort_order: chap.sort_order, is_sample: chap.is_sample, word_count: chap.word_count, reading_minutes: chap.reading_minutes, cliffhanger_hook: chap.cliffhanger_hook, readability_grade_bp: chap.readability_grade_bp, readability_score: r_score, updated_at: now_rec.iso, id: chap.id}
            call invalidate_author_caches using stmts, chap.book_id, 0, chap.id, 0
          end
        end
      end
    end
    give back server.json using 200, audit_doc
  catch err
    give back author_error using 502, "groxy_bridge_error", err.message, "", "bridge_error"
  end
end

