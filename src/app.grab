route "GET" "/{slug}" using req
  set slug_norm to normalize_slug using req.params.slug
  set full_path to "/" joined with slug_norm
  if is_reserved_path using full_path
    give back render_theme_page using stmts, "404", {"requested_path": full_path, "current_path": full_path}, 404, []
  end

  set archive_type to data.one using stmts.get_type, record {lookup: "archive", sv: slug_norm, iv: 0}
  if archive_type is not nothing
    set theme to get_active_theme_context using stmts
    set registry to build_active_hook_registry using theme
    set q_map to {"content_type": archive_type.slug, "per_page": "10", "sort_by": "published_at", "sort_dir": "desc"}
    if req.query has "page"
      set q_map to collections.put using q_map, "page", (req.query at "page")
    end
    set qres to query_entries using stmts, theme, registry, q_map, yes
    set items to []
    set cnt to "0"
    if qres.ok
      set items to qres.data.items
      set cnt to text.from using qres.data.pagination.total_items
    end
    set summary to build_entries_summary using items
    give back render_theme_page using stmts, "archive", {"archive_label": archive_type.label_plural, "archive_slug": slug_norm, "meta_description": archive_type.label_plural joined with " archive", "entry_count": cnt, "published_count": cnt, "entries_summary": summary, "current_path": full_path}, 200, items
  end

  give back resolve_public_path using stmts, full_path
end

route "GET" "/{type_prefix}/{slug}" using req
  set prefix_norm to normalize_slug using req.params.type_prefix
  set slug_norm to normalize_slug using req.params.slug
  set full_path to "/" joined with prefix_norm joined with "/" joined with slug_norm
  if is_reserved_path using full_path
    give back render_theme_page using stmts, "404", {"requested_path": full_path, "current_path": full_path}, 404, []
  end

  set tax_row to data.one using stmts.get_taxonomy, record {lookup: "archive", iv: 0, sv: prefix_norm}
  if tax_row is not nothing
    give back render_taxonomy_archive using stmts, tax_row, slug_norm, full_path, req
  end

  give back resolve_public_path using stmts, full_path
end

# ==============================================================================
# Native Verified Payment Webhook Event Handler (deploy/grab.platform.commerce.json)
# ==============================================================================

make receive_payment_event using event
  set edb to data.open using "main"
  set etx to event.transaction
  set now_rec to call dates.now_utc
  set now_iso to now_rec.iso

  set s_ev_chk to data.prepare using edb, "SELECT event_id FROM payment_events WHERE event_id = :eid", record {params: record {eid: "text"}, columns: record {event_id: "text"}}
  set s_ev_ins to data.prepare using edb, "INSERT INTO payment_events (event_id, order_id, outcome, payload_hash, received_at) VALUES (:eid, :oid, :out, :phash, :rec)", record {params: record {eid: "text", oid: record {type: "integer", nullable: yes}, out: "text", phash: "text", rec: "text"}, columns: record {}}
  set s_get_set to data.prepare using edb, "SELECT value FROM site_settings WHERE key = :key", record {params: record {key: "text"}, columns: record {value: "text"}}
  set s_get_ord to data.prepare using edb, "SELECT o.id, o.number, o.cart_id, o.customer_id, o.user_id, o.status, o.subtotal_cents, o.discount_cents, o.tax_cents, o.shipping_cents, o.total_cents, o.currency, o.coupon_id, o.payment_ref, o.access_token_hash, o.shipping_address_json, o.needs_review, o.review_note, o.created_at, o.payment_due_by, o.paid_at, c.email AS customer_email, c.display_name AS customer_name FROM orders o JOIN customers c ON c.id = o.customer_id WHERE (:mode = 'all') OR (:mode = 'review' AND o.needs_review = 1) OR (:mode = 'status' AND o.status = :sv) OR (:mode = 'customer' AND o.customer_id = :iv) OR (:mode = 'id' AND o.id = :iv) OR (:mode = 'number' AND o.number = :sv) OR (:mode = 'token' AND o.access_token_hash = :sv) OR (:mode = 'active' AND o.status IN ('pending_payment', 'paid', 'fulfilling', 'shipped')) OR (:mode = 'due' AND o.status = 'pending_payment' AND o.payment_due_by <= :sv) ORDER BY o.id DESC", record {params: record {mode: "text", iv: "integer", sv: "text"}, columns: record {id: "integer", number: "text", cart_id: "text", customer_id: "integer", user_id: record {type: "integer", nullable: yes}, status: "text", subtotal_cents: "integer", discount_cents: "integer", tax_cents: "integer", shipping_cents: "integer", total_cents: "integer", currency: "text", coupon_id: record {type: "integer", nullable: yes}, payment_ref: "text", access_token_hash: "text", shipping_address_json: "text", needs_review: "integer", review_note: "text", created_at: "text", payment_due_by: "text", paid_at: record {type: "text", nullable: yes}, customer_email: "text", customer_name: "text"}}
  set s_upd_ord to data.prepare using edb, "UPDATE orders SET number = :number, status = :status, needs_review = :needs_review, review_note = :review_note, shipping_address_json = :shipping_address_json, paid_at = :paid_at, payment_ref = :payment_ref WHERE id = :id AND (:req_status = '' OR status = :req_status)", record {params: record {number: "text", status: "text", needs_review: "integer", review_note: "text", shipping_address_json: "text", paid_at: record {type: "text", nullable: yes}, payment_ref: "text", id: "integer", req_status: "text"}, columns: record {}}
  set s_audit to data.prepare using edb, "INSERT INTO order_audit (order_id, actor, from_status, to_status, reason, created_at) VALUES (:oid, :act, :fst, :tst, :rsn, :cat)", record {params: record {oid: "integer", act: "text", fst: "text", tst: "text", rsn: "text", cat: "text"}, columns: record {}}
  set s_items to data.prepare using edb, "SELECT oi.id, oi.product_id, oi.qty, oi.kind, df.media_id, df.download_limit, df.expiry_hours FROM order_items oi LEFT JOIN product_digital_files df ON df.product_id = oi.product_id WHERE oi.order_id = :oid", record {params: record {oid: "integer"}, columns: record {id: "integer", product_id: "integer", qty: "integer", kind: "text", media_id: record {type: "integer", nullable: yes}, download_limit: record {type: "integer", nullable: yes}, expiry_hours: record {type: "integer", nullable: yes}}}

  set dup to data.one using s_ev_chk, record {eid: event.id}, etx
  if dup is not nothing
    call events.complete using etx, event
    give back record {ok: yes, outcome: "duplicate_ignored"}
  end

  set pmap to {}
  try
    set pmap to json.parse using (json.stringify using event.payload)
  catch err
    set pmap to {}
  end

  set ev_type to event.type
  if pmap has "type" and (pmap at "type") is not nothing and (text.trim using (text.from using (pmap at "type"))) is not ""
    set ev_type to text.trim using (text.from using (pmap at "type"))
  end
  set ord_num to ""
  if pmap has "order_number" and (pmap at "order_number") is not nothing
    set ord_num to text.trim using (text.from using (pmap at "order_number"))
  end
  set cur_in to ""
  if pmap has "currency" and (pmap at "currency") is not nothing
    set cur_in to text.upper using (text.trim using (text.from using (pmap at "currency")))
  end
  set pay_ref to ""
  if pmap has "payment_ref" and (pmap at "payment_ref") is not nothing
    set pay_ref to text.trim using (text.from using (pmap at "payment_ref"))
  end
  set amt_cents to -1
  if pmap has "amount"
    set pm to parse_money_cents using (pmap at "amount"), no, 9999999999
    if pm.ok
      set amt_cents to pm.cents
    end
  end

  set redir_meta to json.stringify using {"type": ev_type, "order_number": ord_num, "currency": cur_in}
  set ev_phash to crypto.sha256_hex using redir_meta

  set en_row to data.one using s_get_set, record {key: "commerce_enabled"}, etx
  if en_row is nothing or en_row.value is not "1"
    call data.execute using s_ev_ins, record {eid: event.id, oid: nothing, out: "ignored_commerce_disabled", phash: ev_phash, rec: now_iso}, etx
    call events.complete using etx, event
    give back record {ok: yes, outcome: "ignored_commerce_disabled"}
  end

  set ord to data.one using s_get_ord, record {mode: "number", iv: 0, sv: ord_num}, etx
  if ord is nothing
    call data.execute using s_ev_ins, record {eid: event.id, oid: nothing, out: "ignored_unknown_order", phash: ev_phash, rec: now_iso}, etx
    call events.complete using etx, event
    give back record {ok: yes, outcome: "ignored_unknown_order"}
  end

  if amt_cents is not ord.total_cents or cur_in is not ord.currency
    call data.execute using s_upd_ord, record {number: ord.number, status: ord.status, needs_review: 1, review_note: "Webhook amount or currency mismatch — manual review required", shipping_address_json: ord.shipping_address_json, paid_at: ord.paid_at, payment_ref: ord.payment_ref, id: ord.id, req_status: ""}, etx
    call data.execute using s_audit, record {oid: ord.id, act: "webhook", fst: ord.status, tst: ord.status, rsn: "webhook_amount_mismatch", cat: now_iso}, etx
    call data.execute using s_ev_ins, record {eid: event.id, oid: ord.id, out: "amount_mismatch", phash: ev_phash, rec: now_iso}, etx
    call events.complete using etx, event
    give back record {ok: yes, outcome: "amount_mismatch"}
  end

  if ev_type is "payment.succeeded"
    if ord.status is "expired" or ord.status is "cancelled"
      call data.execute using s_upd_ord, record {number: ord.number, status: ord.status, needs_review: 1, review_note: ("Late payment.succeeded arrived while order status was " joined with ord.status), shipping_address_json: ord.shipping_address_json, paid_at: ord.paid_at, payment_ref: pay_ref, id: ord.id, req_status: ""}, etx
      call data.execute using s_audit, record {oid: ord.id, act: "webhook", fst: ord.status, tst: ord.status, rsn: "late_payment_needs_review", cat: now_iso}, etx
      call data.execute using s_ev_ins, record {eid: event.id, oid: ord.id, out: "late_payment", phash: ev_phash, rec: now_iso}, etx
      call events.complete using etx, event
      give back record {ok: yes, outcome: "late_payment"}
    end

    if ord.status is "pending_payment"
      set s_grant to data.prepare using edb, "INSERT INTO download_grants (order_item_id, media_id, token_hash, expires_at, remaining, created_at) VALUES (:oi_id, :mid, :th, :exp, :rem, :cat)", record {params: record {oi_id: "integer", mid: "integer", th: "text", exp: "text", rem: "integer", cat: "text"}, columns: record {}}
      set s_cev to data.prepare using edb, "INSERT INTO commerce_events (name, subject_id, payload_json, created_at) VALUES (:name, :subj, :pjson, :cat)", record {params: record {name: "text", subj: "text", pjson: "text", cat: "text"}, columns: record {}}
      call data.execute using s_upd_ord, record {number: ord.number, status: "paid", needs_review: ord.needs_review, review_note: ord.review_note, shipping_address_json: ord.shipping_address_json, paid_at: now_iso, payment_ref: pay_ref, id: ord.id, req_status: ""}, etx
      call data.execute using s_audit, record {oid: ord.id, act: "webhook", fst: "pending_payment", tst: "paid", rsn: "payment_succeeded", cat: now_iso}, etx

      set items to data.query using s_items, record {oid: ord.id}, etx
      for each oi in items
        if oi.kind is "digital" and oi.media_id is not nothing
          set dl_lim to 5
          if oi.download_limit is not nothing and oi.download_limit is greater than 0
            set dl_lim to oi.download_limit
          end
          set exp_h to 72
          if oi.expiry_hours is not nothing and oi.expiry_hours is greater than 0
            set exp_h to oi.expiry_hours
          end
          set exp_rec to dates.from_unix using (now_rec.unix plus (exp_h times 3600))
          set init_tok to crypto.random_urlsafe using 32
          set init_hash to crypto.sha256_hex using init_tok
          call data.execute using s_grant, record {oi_id: oi.id, mid: oi.media_id, th: init_hash, exp: exp_rec.iso, rem: dl_lim, cat: now_iso}, etx
        end
      end

      set cev_payload to json.stringify using {"name": "commerce:purchase_completed", "version": 1, "order_number": ord.number, "currency": ord.currency, "paid_at": now_iso}
      call data.execute using s_cev, record {name: "commerce:purchase_completed", subj: ord.number, pjson: cev_payload, cat: now_iso}, etx
      call data.execute using s_ev_ins, record {eid: event.id, oid: ord.id, out: "paid", phash: ev_phash, rec: now_iso}, etx
      call events.complete using etx, event
      give back record {ok: yes, outcome: "paid"}
    end

    call data.execute using s_ev_ins, record {eid: event.id, oid: ord.id, out: "ignored_already_processed", phash: ev_phash, rec: now_iso}, etx
    call events.complete using etx, event
    give back record {ok: yes, outcome: "ignored_already_processed"}
  end

  if ev_type is "payment.failed"
    if ord.status is "pending_payment"
      set s_stock to data.prepare using edb, "UPDATE products SET stock_qty = stock_qty + :delta, updated_at = :updated_at WHERE id = :id AND stock_qty IS NOT NULL AND (:min_check = 0 OR stock_qty + :delta >= 0)", record {params: record {delta: "integer", updated_at: "text", id: "integer", min_check: "integer"}, columns: record {}}
      set s_del_red to data.prepare using edb, "DELETE FROM coupon_redemptions WHERE order_id = :order_id AND coupon_id = :coupon_id", record {params: record {order_id: "integer", coupon_id: "integer"}, columns: record {}}
      set s_dec_cpn to data.prepare using edb, "UPDATE coupons SET redeemed_count = CASE WHEN redeemed_count > 0 THEN redeemed_count - 1 ELSE 0 END, updated_at = :cat WHERE id = :id", record {params: record {cat: "text", id: "integer"}, columns: record {}}
      call data.execute using s_upd_ord, record {number: ord.number, status: "payment_failed", needs_review: ord.needs_review, review_note: ord.review_note, shipping_address_json: ord.shipping_address_json, paid_at: ord.paid_at, payment_ref: pay_ref, id: ord.id, req_status: ""}, etx
      set items to data.query using s_items, record {oid: ord.id}, etx
      for each oi in items
        call data.execute using s_stock, record {delta: oi.qty, updated_at: now_iso, id: oi.product_id, min_check: 0}, etx
      end
      if ord.coupon_id is not nothing
        set dr to data.execute using s_del_red, record {order_id: ord.id, coupon_id: ord.coupon_id}, etx
        if dr.rows_affected is greater than 0
          call data.execute using s_dec_cpn, record {cat: now_iso, id: ord.coupon_id}, etx
        end
      end
      call data.execute using s_audit, record {oid: ord.id, act: "webhook", fst: "pending_payment", tst: "payment_failed", rsn: "payment_failed", cat: now_iso}, etx
      call data.execute using s_ev_ins, record {eid: event.id, oid: ord.id, out: "payment_failed", phash: ev_phash, rec: now_iso}, etx
      call events.complete using etx, event
      give back record {ok: yes, outcome: "payment_failed"}
    end
  end

  call data.execute using s_ev_ins, record {eid: event.id, oid: ord.id, out: "ignored_state", phash: ev_phash, rec: now_iso}, etx
  call events.complete using etx, event
  give back record {ok: yes, outcome: "ignored_state"}
end
