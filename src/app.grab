set stmt_query_id_desc to data.prepare using db, "SELECT e.id, e.content_type_id, ct.slug AS content_type_slug, ct.label_singular AS content_type_label, e.slug, e.full_path, e.title, e.status, e.body_html, e.custom_fields_json, e.meta_title, e.meta_description, e.published_at, e.created_at, e.updated_at FROM entries e JOIN content_types ct ON ct.id = e.content_type_id WHERE (:filter_type = 0 OR e.content_type_id = :content_type_id) AND (:filter_status = 0 OR e.status = :status) ORDER BY e.id DESC LIMIT :limit_rows OFFSET :offset_rows", record {params: record {filter_type: "integer", content_type_id: "integer", filter_status: "integer", status: "text", limit_rows: "integer", offset_rows: "integer"}, columns: record {id: "integer", content_type_id: "integer", content_type_slug: "text", content_type_label: "text", slug: "text", full_path: "text", title: "text", status: "text", body_html: "text", custom_fields_json: "text", meta_title: "text", meta_description: "text", published_at: record {type: "text", nullable: yes}, created_at: "text", updated_at: "text"}}
