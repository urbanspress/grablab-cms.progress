use cache
use collections
use data
use dates
use files
use json
use server
use text

# ==============================================================================
# Startup: Open Database, Open Cache, and Prepare All Parameterized SQL
# ==============================================================================

set db to data.open using "main"
set cms_cache to cache.open using "cms"

set stmt_get_setting to data.prepare using db, "SELECT value FROM site_settings WHERE key = :key", record {params: record {key: "text"}, columns: record {value: "text"}}
set stmt_list_settings to data.prepare using db, "SELECT key, value FROM site_settings ORDER BY key", record {params: record {}, columns: record {key: "text", value: "text"}}
set stmt_upsert_setting_update to data.prepare using db, "UPDATE site_settings SET value = :value, updated_at = :updated_at WHERE key = :key", record {params: record {value: "text", updated_at: "text", key: "text"}, columns: record {}}
set stmt_upsert_setting_insert to data.prepare using db, "INSERT INTO site_settings (key, value, updated_at) VALUES (:key, :value, :updated_at)", record {params: record {key: "text", value: "text", updated_at: "text"}, columns: record {}}

set stmt_list_types to data.prepare using db, "SELECT id, slug, label_singular, label_plural, permalink_pattern, has_archive, archive_slug, is_system, created_at FROM content_types ORDER BY id", record {params: record {}, columns: record {id: "integer", slug: "text", label_singular: "text", label_plural: "text", permalink_pattern: "text", has_archive: "integer", archive_slug: record {type: "text", nullable: yes}, is_system: "integer", created_at: "text"}}
set stmt_get_type_by_slug to data.prepare using db, "SELECT id, slug, label_singular, label_plural, permalink_pattern, has_archive, archive_slug, is_system, created_at FROM content_types WHERE slug = :slug", record {params: record {slug: "text"}, columns: record {id: "integer", slug: "text", label_singular: "text", label_plural: "text", permalink_pattern: "text", has_archive: "integer", archive_slug: record {type: "text", nullable: yes}, is_system: "integer", created_at: "text"}}
set stmt_get_type_by_id to data.prepare using db, "SELECT id, slug, label_singular, label_plural, permalink_pattern, has_archive, archive_slug, is_system, created_at FROM content_types WHERE id = :id", record {params: record {id: "integer"}, columns: record {id: "integer", slug: "text", label_singular: "text", label_plural: "text", permalink_pattern: "text", has_archive: "integer", archive_slug: record {type: "text", nullable: yes}, is_system: "integer", created_at: "text"}}
set stmt_get_type_by_archive to data.prepare using db, "SELECT id, slug, label_singular, label_plural, permalink_pattern, has_archive, archive_slug, is_system, created_at FROM content_types WHERE has_archive = 1 AND archive_slug = :archive_slug", record {params: record {archive_slug: "text"}, columns: record {id: "integer", slug: "text", label_singular: "text", label_plural: "text", permalink_pattern: "text", has_archive: "integer", archive_slug: record {type: "text", nullable: yes}, is_system: "integer", created_at: "text"}}
set stmt_insert_type to data.prepare using db, "INSERT INTO content_types (slug, label_singular, label_plural, permalink_pattern, has_archive, archive_slug, is_system, created_at) VALUES (:slug, :label_singular, :label_plural, :permalink_pattern, :has_archive, :archive_slug, :is_system, :created_at)", record {params: record {slug: "text", label_singular: "text", label_plural: "text", permalink_pattern: "text", has_archive: "integer", archive_slug: record {type: "text", nullable: yes}, is_system: "integer", created_at: "text"}, columns: record {}}

set stmt_list_fields_by_type to data.prepare using db, "SELECT id, content_type_id, field_key, label, field_type, is_required, default_value, sort_order FROM field_definitions WHERE content_type_id = :content_type_id ORDER BY sort_order, id", record {params: record {content_type_id: "integer"}, columns: record {id: "integer", content_type_id: "integer", field_key: "text", label: "text", field_type: "text", is_required: "integer", default_value: record {type: "text", nullable: yes}, sort_order: "integer"}}
set stmt_get_field_by_key to data.prepare using db, "SELECT id, content_type_id, field_key, label, field_type, is_required, default_value, sort_order FROM field_definitions WHERE content_type_id = :content_type_id AND field_key = :field_key", record {params: record {content_type_id: "integer", field_key: "text"}, columns: record {id: "integer", content_type_id: "integer", field_key: "text", label: "text", field_type: "text", is_required: "integer", default_value: record {type: "text", nullable: yes}, sort_order: "integer"}}
set stmt_insert_field to data.prepare using db, "INSERT INTO field_definitions (content_type_id, field_key, label, field_type, is_required, default_value, sort_order) VALUES (:content_type_id, :field_key, :label, :field_type, :is_required, :default_value, :sort_order)", record {params: record {content_type_id: "integer", field_key: "text", label: "text", field_type: "text", is_required: "integer", default_value: record {type: "text", nullable: yes}, sort_order: "integer"}, columns: record {}}

set stmt_list_entries to data.prepare using db, "SELECT e.id, e.content_type_id, ct.slug AS content_type_slug, ct.label_singular AS content_type_label, e.slug, e.full_path, e.title, e.status, e.body_html, e.custom_fields_json, e.meta_title, e.meta_description, e.published_at, e.created_at, e.updated_at FROM entries e JOIN content_types ct ON ct.id = e.content_type_id ORDER BY e.id DESC", record {params: record {}, columns: record {id: "integer", content_type_id: "integer", content_type_slug: "text", content_type_label: "text", slug: "text", full_path: "text", title: "text", status: "text", body_html: "text", custom_fields_json: "text", meta_title: "text", meta_description: "text", published_at: record {type: "text", nullable: yes}, created_at: "text", updated_at: "text"}}
set stmt_list_published_entries to data.prepare using db, "SELECT e.id, e.content_type_id, ct.slug AS content_type_slug, ct.label_singular AS content_type_label, e.slug, e.full_path, e.title, e.status, e.body_html, e.custom_fields_json, e.meta_title, e.meta_description, e.published_at, e.created_at, e.updated_at FROM entries e JOIN content_types ct ON ct.id = e.content_type_id WHERE e.status = 'published' ORDER BY e.id DESC", record {params: record {}, columns: record {id: "integer", content_type_id: "integer", content_type_slug: "text", content_type_label: "text", slug: "text", full_path: "text", title: "text", status: "text", body_html: "text", custom_fields_json: "text", meta_title: "text", meta_description: "text", published_at: record {type: "text", nullable: yes}, created_at: "text", updated_at: "text"}}
set stmt_list_published_by_type to data.prepare using db, "SELECT e.id, e.content_type_id, ct.slug AS content_type_slug, ct.label_singular AS content_type_label, e.slug, e.full_path, e.title, e.status, e.body_html, e.custom_fields_json, e.meta_title, e.meta_description, e.published_at, e.created_at, e.updated_at FROM entries e JOIN content_types ct ON ct.id = e.content_type_id WHERE e.content_type_id = :content_type_id AND e.status = 'published' ORDER BY e.id DESC", record {params: record {content_type_id: "integer"}, columns: record {id: "integer", content_type_id: "integer", content_type_slug: "text", content_type_label: "text", slug: "text", full_path: "text", title: "text", status: "text", body_html: "text", custom_fields_json: "text", meta_title: "text", meta_description: "text", published_at: record {type: "text", nullable: yes}, created_at: "text", updated_at: "text"}}
set stmt_get_entry_by_id to data.prepare using db, "SELECT e.id, e.content_type_id, ct.slug AS content_type_slug, ct.label_singular AS content_type_label, e.slug, e.full_path, e.title, e.status, e.body_html, e.custom_fields_json, e.meta_title, e.meta_description, e.published_at, e.created_at, e.updated_at FROM entries e JOIN content_types ct ON ct.id = e.content_type_id WHERE e.id = :id", record {params: record {id: "integer"}, columns: record {id: "integer", content_type_id: "integer", content_type_slug: "text", content_type_label: "text", slug: "text", full_path: "text", title: "text", status: "text", body_html: "text", custom_fields_json: "text", meta_title: "text", meta_description: "text", published_at: record {type: "text", nullable: yes}, created_at: "text", updated_at: "text"}}
set stmt_get_entry_by_full_path to data.prepare using db, "SELECT e.id, e.content_type_id, ct.slug AS content_type_slug, ct.label_singular AS content_type_label, e.slug, e.full_path, e.title, e.status, e.body_html, e.custom_fields_json, e.meta_title, e.meta_description, e.published_at, e.created_at, e.updated_at FROM entries e JOIN content_types ct ON ct.id = e.content_type_id WHERE e.full_path = :full_path", record {params: record {full_path: "text"}, columns: record {id: "integer", content_type_id: "integer", content_type_slug: "text", content_type_label: "text", slug: "text", full_path: "text", title: "text", status: "text", body_html: "text", custom_fields_json: "text", meta_title: "text", meta_description: "text", published_at: record {type: "text", nullable: yes}, created_at: "text", updated_at: "text"}}
set stmt_get_published_entry_by_path to data.prepare using db, "SELECT e.id, e.content_type_id, ct.slug AS content_type_slug, ct.label_singular AS content_type_label, e.slug, e.full_path, e.title, e.status, e.body_html, e.custom_fields_json, e.meta_title, e.meta_description, e.published_at, e.created_at, e.updated_at FROM entries e JOIN content_types ct ON ct.id = e.content_type_id WHERE e.full_path = :full_path AND e.status = 'published'", record {params: record {full_path: "text"}, columns: record {id: "integer", content_type_id: "integer", content_type_slug: "text", content_type_label: "text", slug: "text", full_path: "text", title: "text", status: "text", body_html: "text", custom_fields_json: "text", meta_title: "text", meta_description: "text", published_at: record {type: "text", nullable: yes}, created_at: "text", updated_at: "text"}}
set stmt_insert_entry to data.prepare using db, "INSERT INTO entries (content_type_id, slug, full_path, title, status, body_html, custom_fields_json, meta_title, meta_description, published_at, created_at, updated_at) VALUES (:content_type_id, :slug, :full_path, :title, :status, :body_html, :custom_fields_json, :meta_title, :meta_description, :published_at, :created_at, :updated_at)", record {params: record {content_type_id: "integer", slug: "text", full_path: "text", title: "text", status: "text", body_html: "text", custom_fields_json: "text", meta_title: "text", meta_description: "text", published_at: record {type: "text", nullable: yes}, created_at: "text", updated_at: "text"}, columns: record {}}
set stmt_update_entry to data.prepare using db, "UPDATE entries SET slug = :slug, full_path = :full_path, title = :title, status = :status, body_html = :body_html, custom_fields_json = :custom_fields_json, meta_title = :meta_title, meta_description = :meta_description, published_at = :published_at, updated_at = :updated_at WHERE id = :id", record {params: record {slug: "text", full_path: "text", title: "text", status: "text", body_html: "text", custom_fields_json: "text", meta_title: "text", meta_description: "text", published_at: record {type: "text", nullable: yes}, updated_at: "text", id: "integer"}, columns: record {}}

set stmt_find_redirect_by_old_path to data.prepare using db, "SELECT s.id, s.old_path, s.entry_id, e.full_path AS target_path FROM slug_history s JOIN entries e ON e.id = s.entry_id WHERE s.old_path = :old_path AND e.status = 'published'", record {params: record {old_path: "text"}, columns: record {id: "integer", old_path: "text", entry_id: "integer", target_path: "text"}}
set stmt_list_redirects to data.prepare using db, "SELECT s.id, s.old_path, s.entry_id, e.full_path AS target_path, s.created_at FROM slug_history s JOIN entries e ON e.id = s.entry_id ORDER BY s.id DESC", record {params: record {}, columns: record {id: "integer", old_path: "text", entry_id: "integer", target_path: "text", created_at: "text"}}
set stmt_delete_redirect_by_old_path to data.prepare using db, "DELETE FROM slug_history WHERE old_path = :old_path", record {params: record {old_path: "text"}, columns: record {}}
set stmt_insert_redirect to data.prepare using db, "INSERT INTO slug_history (old_path, entry_id, created_at) VALUES (:old_path, :entry_id, :created_at)", record {params: record {old_path: "text", entry_id: "integer", created_at: "text"}, columns: record {}}

set stmt_list_themes to data.prepare using db, "SELECT slug, name, version, engine, is_active, manifest_json, installed_at FROM themes ORDER BY slug", record {params: record {}, columns: record {slug: "text", name: "text", version: "text", engine: "text", is_active: "integer", manifest_json: "text", installed_at: "text"}}
set stmt_get_theme_by_slug to data.prepare using db, "SELECT slug, name, version, engine, is_active, manifest_json, installed_at FROM themes WHERE slug = :slug", record {params: record {slug: "text"}, columns: record {slug: "text", name: "text", version: "text", engine: "text", is_active: "integer", manifest_json: "text", installed_at: "text"}}
set stmt_get_active_theme to data.prepare using db, "SELECT slug, name, version, engine, is_active, manifest_json, installed_at FROM themes WHERE is_active = 1", record {params: record {}, columns: record {slug: "text", name: "text", version: "text", engine: "text", is_active: "integer", manifest_json: "text", installed_at: "text"}}
set stmt_insert_theme to data.prepare using db, "INSERT INTO themes (slug, name, version, engine, is_active, manifest_json, installed_at) VALUES (:slug, :name, :version, :engine, :is_active, :manifest_json, :installed_at)", record {params: record {slug: "text", name: "text", version: "text", engine: "text", is_active: "integer", manifest_json: "text", installed_at: "text"}, columns: record {}}
set stmt_update_theme_manifest to data.prepare using db, "UPDATE themes SET name = :name, version = :version, engine = :engine, manifest_json = :manifest_json WHERE slug = :slug", record {params: record {name: "text", version: "text", engine: "text", manifest_json: "text", slug: "text"}, columns: record {}}
