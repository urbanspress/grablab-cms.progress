route "PUT" "/api/admin/entries/{id}/terms" using req
  set auth to require_api_auth using stmts, req, "entries:update:own", yes
  if not auth.ok
    give back auth.response
  end
  try
    set entry_id to text.to_integer using req.params.id
    set existing to data.one using stmts.get_entry_by_id, record {id: entry_id}
    if existing is nothing
      give back server.json using 404, record {error: "Entry not found"}
    end
    if not (role_has_capability using auth.session.role, "entries:update:any")
      if existing.author_id is nothing or existing.author_id is not auth.session.user_id
        give back server.json using 403, record {error: "Forbidden: can only assign terms on your own entries"}
      end
    end
    set payload to server.parse_json using req
    if (not (payload has "term_ids")) or (payload at "term_ids") is nothing
      give back server.json using 400, record {error: "term_ids array is required"}
    end
    set now_rec to call dates.now_utc
    set tx to data.begin using stmts.db
    try
      set tr to sync_entry_terms_tx using stmts, entry_id, (payload at "term_ids"), now_rec.iso, tx
      if not tr.ok
        call data.rollback using tx
        give back server.json using 400, record {error: tr.error}
      end
      set updated_terms to data.query using stmts.list_entry_terms, record {entry_id: entry_id}, tx
      call data.commit using tx
      call invalidate_route_caches using stmts, existing.full_path, "", existing.content_type_slug
      give back server.json using 200, record {entry_id: entry_id, terms: updated_terms}
    catch tx_err
      call data.rollback using tx
      give back server.json using 500, record {error: tx_err.message}
    end
  catch err
    give back server.json using 400, record {error: err.message}
  end
end

# ==============================================================================
# Capability-Gated grab mcp CMS Tools (/api/mcp, /api/mcp/tools/*)
# ==============================================================================

route "GET" "/api/mcp/tools" using req
  set bearer to extract_bearer_token using req
  set sess to nothing
  if bearer is not ""
    set sess to resolve_session_token using stmts, bearer
  otherwise
    set sess to resolve_session using stmts, req
  end
  if sess is nothing
    give back server.json using 401, record {error: "MCP authentication required"}
  end
  give back server.json using 200, record {tools: (call mcp_tool_schemas), user_role: sess.role}
end

route "POST" "/api/mcp/tools/{name}" using req
  set principal to resolve_mcp_principal using stmts, req
  if not principal.ok
    give back server.json using principal.status, record {error: principal.error}
  end
  try
    set body_map to server.parse_json using req
    set args to body_map
    if body_map has "arguments" and (body_map at "arguments") is not nothing
      set args to body_map at "arguments"
    end
    set res to execute_mcp_tool using stmts, principal.session, req.params.name, args
    give back server.json using res.status, res.payload
  catch err
    give back server.json using 400, record {error: err.message}
  end
end

route "POST" "/api/mcp" using req
  set principal to resolve_mcp_principal using stmts, req
  if not principal.ok
    give back server.json using principal.status, record {error: principal.error}
  end
  try
    set rpc to server.parse_json using req
    set rpc_id to nothing
    if rpc has "id"
      set rpc_id to rpc at "id"
    end
    set method to ""
    if rpc has "method" and (rpc at "method") is not nothing
      set method to text.from using (rpc at "method")
    end
    if method is "initialize"
      give back server.json using 200, record {jsonrpc: "2.0", id: rpc_id, result: (record {protocolVersion: "2024-11-05", serverInfo: (record {name: "grablab-cms-mcp", version: "1.0.0"}), capabilities: (record {tools: {}})})}
    end
    if method is "ping"
      give back server.json using 200, record {jsonrpc: "2.0", id: rpc_id, result: {}}
    end
    if method is "tools/list"
      give back server.json using 200, record {jsonrpc: "2.0", id: rpc_id, result: (record {tools: (call mcp_tool_schemas)})}
    end
    if method is "tools/call"
      set params to {}
      if rpc has "params" and (rpc at "params") is not nothing
        set params to rpc at "params"
      end
      set tname to ""
      if params has "name" and (params at "name") is not nothing
        set tname to text.from using (params at "name")
      end
      set targs to {}
      if params has "arguments" and (params at "arguments") is not nothing
        set targs to params at "arguments"
      end
      set res to execute_mcp_tool using stmts, principal.session, tname, targs
      if not res.ok
        give back server.json using 200, record {jsonrpc: "2.0", id: rpc_id, result: (record {isError: yes, status: res.status, content: [record {type: "text", text: (json.stringify using res.payload)}], structuredContent: res.payload})}
      end
      give back server.json using 200, record {jsonrpc: "2.0", id: rpc_id, result: (record {isError: no, status: res.status, content: [record {type: "text", text: (json.stringify using res.payload)}], structuredContent: res.payload})}
    end
    give back server.json using 200, record {jsonrpc: "2.0", id: rpc_id, error: (record {code: -32601, message: ("Method not found: " joined with method)})}
  catch err
    give back server.json using 400, record {jsonrpc: "2.0", id: nothing, error: (record {code: -32700, message: err.message})}
  end
end

route "GET" "/api/{rest}" using req
  give back server.json using 404, record {error: "Unknown API endpoint", path: req.path}
end

# ==============================================================================
# Pretty Permalink & Search Public Routes
# ==============================================================================

make render_taxonomy_archive using stmts, tax_row, slug_norm, full_path, req
  set term_row to data.one using stmts.get_term_by_tax_slug, record {taxonomy_id: tax_row.id, slug: slug_norm}
  if term_row is nothing
    give back render_theme_page using stmts, "404", {"requested_path": full_path, "current_path": full_path}, 404, []
  end
  set theme to get_active_theme_context using stmts
  set registry to build_active_hook_registry using theme
  set q_map to {"taxonomy": tax_row.slug, "term_slug": slug_norm, "include_children": "true", "per_page": "10", "sort_by": "published_at", "sort_dir": "desc"}
  if req.query has "page"
    set q_map to collections.put using q_map, "page", (req.query at "page")
  end
  set qres to query_entries using stmts, theme, registry, q_map, yes
  set items to []
  set cnt to "0"
  if qres.ok
    set items to qres.data.items
    set cnt to text.from using qres.data.pagination.total_items
  end
  set summary to build_entries_summary using items
  set desc_txt to term_row.description
  if desc_txt is ""
    set desc_txt to tax_row.label_singular joined with ": " joined with term_row.name
  end
  set arch_prefix to tax_row.archive_slug joined with "/" joined with slug_norm
  give back render_theme_page using stmts, "archive", {"archive_label": term_row.name, "archive_slug": arch_prefix, "meta_description": desc_txt, "taxonomy_slug": tax_row.slug, "term_slug": slug_norm, "entry_count": cnt, "published_count": cnt, "entries_summary": summary, "current_path": full_path}, 200, items
end

route "GET" "/search" using req
  set q_text to ""
  if req.query has "q"
    set q_text to text.trim using (text.from using (req.query at "q"))
  end
  set theme to get_active_theme_context using stmts
  set registry to build_active_hook_registry using theme
  set qres to query_entries using stmts, theme, registry, {"per_page": "50", "sort_by": "published_at", "sort_dir": "desc"}, yes
  set matched to []
  if qres.ok
    set q_lower to text.lower using q_text
    for each item in qres.data.items
      if q_lower is "" or (text.contains using (text.lower using item.title), q_lower) or (text.contains using (text.lower using item.excerpt), q_lower)
        set matched to collections.append using matched, item
      end
    end
  end
  set summary to build_entries_summary using matched
  set cnt to text.from using (collections.length using matched)
  give back render_theme_page using stmts, "search", {"page_title": "Search", "query": q_text, "results_summary": summary, "published_count": cnt, "current_path": "/search"}, 200, matched
end

route "GET" "/" using req
  set settings to get_site_settings_map using stmts
  set home_id_raw to settings at "home_entry_id"
  if home_id_raw is not ""
    try
      set home_id to text.to_integer using home_id_raw
      set home_entry to data.one using stmts.get_entry_by_id, record {id: home_id}
      if home_entry is not nothing and home_entry.status is "published"
        give back render_single_entry using stmts, home_entry
      end
    catch err
    end
  end

  set theme to get_active_theme_context using stmts
  set registry to build_active_hook_registry using theme
  set q_map to {"per_page": "10", "sort_by": "published_at", "sort_dir": "desc"}
  if req.query has "page"
    set q_map to collections.put using q_map, "page", (req.query at "page")
  end
  set qres to query_entries using stmts, theme, registry, q_map, yes
  set items to []
  set cnt to "0"
  if qres.ok
    set items to qres.data.items
    set cnt to text.from using qres.data.pagination.total_items
  end
  set summary to build_entries_summary using items
  give back render_theme_page using stmts, "home", {"page_title": "Home", "meta_description": (settings at "site_tagline"), "published_count": cnt, "entries_summary": summary, "current_path": "/"}, 200, items
end

route "GET" "/category/{slug}" using req
  set slug_norm to normalize_slug using req.params.slug
  set full_path to "/category/" joined with slug_norm
  set tax_row to data.one using stmts.get_taxonomy_by_archive, record {archive_slug: "category"}
  if tax_row is nothing
    give back render_theme_page using stmts, "404", {"requested_path": full_path, "current_path": full_path}, 404, []
  end
  give back render_taxonomy_archive using stmts, tax_row, slug_norm, full_path, req
end

route "GET" "/tag/{slug}" using req
  set slug_norm to normalize_slug using req.params.slug
  set full_path to "/tag/" joined with slug_norm
  set tax_row to data.one using stmts.get_taxonomy_by_archive, record {archive_slug: "tag"}
  if tax_row is nothing
    give back render_theme_page using stmts, "404", {"requested_path": full_path, "current_path": full_path}, 404, []
  end
  give back render_taxonomy_archive using stmts, tax_row, slug_norm, full_path, req
end

route "GET" "/{slug}" using req
  set slug_norm to normalize_slug using req.params.slug
  set full_path to "/" joined with slug_norm
  if is_reserved_path using full_path
    give back render_theme_page using stmts, "404", {"requested_path": full_path, "current_path": full_path}, 404, []
  end

  set archive_type to data.one using stmts.get_type_by_archive, record {archive_slug: slug_norm}
  if archive_type is not nothing
    set theme to get_active_theme_context using stmts
    set registry to build_active_hook_registry using theme
    set q_map to {"content_type": archive_type.slug, "per_page": "10", "sort_by": "published_at", "sort_dir": "desc"}
    if req.query has "page"
      set q_map to collections.put using q_map, "page", (req.query at "page")
    end
    set qres to query_entries using stmts, theme, registry, q_map, yes
    set items to []
    set cnt to "0"
    if qres.ok
      set items to qres.data.items
      set cnt to text.from using qres.data.pagination.total_items
    end
    set summary to build_entries_summary using items
    give back render_theme_page using stmts, "archive", {"archive_label": archive_type.label_plural, "archive_slug": slug_norm, "meta_description": archive_type.label_plural joined with " archive", "entry_count": cnt, "published_count": cnt, "entries_summary": summary, "current_path": full_path}, 200, items
  end

  give back resolve_public_path using stmts, full_path
end

route "GET" "/{type_prefix}/{slug}" using req
  set prefix_norm to normalize_slug using req.params.type_prefix
  set slug_norm to normalize_slug using req.params.slug
  set full_path to "/" joined with prefix_norm joined with "/" joined with slug_norm
  if is_reserved_path using full_path
    give back render_theme_page using stmts, "404", {"requested_path": full_path, "current_path": full_path}, 404, []
  end

  set tax_row to data.one using stmts.get_taxonomy_by_archive, record {archive_slug: prefix_norm}
  if tax_row is not nothing
    give back render_taxonomy_archive using stmts, tax_row, slug_norm, full_path, req
  end

  give back resolve_public_path using stmts, full_path
end
