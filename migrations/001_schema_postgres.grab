use data

set db to data.open using "main"

set migration to data.migrate using db, [record {version: 1, name: "grablab_v01_schema_postgres", steps: ["CREATE TABLE IF NOT EXISTS site_settings (key VARCHAR(128) PRIMARY KEY, value TEXT NOT NULL, updated_at TEXT NOT NULL)", "CREATE TABLE IF NOT EXISTS content_types (id INTEGER PRIMARY KEY GENERATED BY DEFAULT AS IDENTITY, slug VARCHAR(64) UNIQUE NOT NULL, label_singular TEXT NOT NULL, label_plural TEXT NOT NULL, permalink_pattern TEXT NOT NULL, has_archive INTEGER NOT NULL DEFAULT 1, archive_slug VARCHAR(64) NULL, is_system INTEGER NOT NULL DEFAULT 0, created_at TEXT NOT NULL)", "CREATE TABLE IF NOT EXISTS field_definitions (id INTEGER PRIMARY KEY GENERATED BY DEFAULT AS IDENTITY, content_type_id INTEGER NOT NULL REFERENCES content_types(id) ON DELETE CASCADE, field_key VARCHAR(64) NOT NULL, label TEXT NOT NULL, field_type VARCHAR(32) NOT NULL, is_required INTEGER NOT NULL DEFAULT 0, default_value TEXT NULL, sort_order INTEGER NOT NULL DEFAULT 0, UNIQUE(content_type_id, field_key))", "CREATE TABLE IF NOT EXISTS entries (id INTEGER PRIMARY KEY GENERATED BY DEFAULT AS IDENTITY, content_type_id INTEGER NOT NULL REFERENCES content_types(id), slug VARCHAR(190) NOT NULL, full_path VARCHAR(255) UNIQUE NOT NULL, title TEXT NOT NULL, status VARCHAR(32) NOT NULL DEFAULT 'draft', body_html TEXT NOT NULL DEFAULT '', custom_fields_json TEXT NOT NULL DEFAULT '{}', meta_title TEXT NOT NULL DEFAULT '', meta_description TEXT NOT NULL DEFAULT '', published_at TEXT NULL, created_at TEXT NOT NULL, updated_at TEXT NOT NULL)", "CREATE TABLE IF NOT EXISTS slug_history (id INTEGER PRIMARY KEY GENERATED BY DEFAULT AS IDENTITY, old_path VARCHAR(255) UNIQUE NOT NULL, entry_id INTEGER NOT NULL REFERENCES entries(id) ON DELETE CASCADE, created_at TEXT NOT NULL)", "CREATE TABLE IF NOT EXISTS themes (slug VARCHAR(64) PRIMARY KEY, name TEXT NOT NULL, version VARCHAR(64) NOT NULL, engine VARCHAR(32) NOT NULL, is_active INTEGER NOT NULL DEFAULT 0, manifest_json TEXT NOT NULL, installed_at TEXT NOT NULL)", "CREATE INDEX IF NOT EXISTS idx_field_definitions_type ON field_definitions(content_type_id, sort_order)", "CREATE INDEX IF NOT EXISTS idx_entries_type_status ON entries(content_type_id, status)", "CREATE INDEX IF NOT EXISTS idx_slug_history_entry ON slug_history(entry_id)"]}]

show migration
