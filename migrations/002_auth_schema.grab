use data

set db to data.open using "main"

set migration to data.migrate using db, [record {version: 1, name: "grablab_v01_schema", steps: ["CREATE TABLE IF NOT EXISTS site_settings (key TEXT PRIMARY KEY, value TEXT NOT NULL, updated_at TEXT NOT NULL)", "CREATE TABLE IF NOT EXISTS content_types (id INTEGER PRIMARY KEY, slug TEXT UNIQUE NOT NULL, label_singular TEXT NOT NULL, label_plural TEXT NOT NULL, permalink_pattern TEXT NOT NULL, has_archive INTEGER NOT NULL DEFAULT 1, archive_slug TEXT NULL, is_system INTEGER NOT NULL DEFAULT 0, created_at TEXT NOT NULL)", "CREATE TABLE IF NOT EXISTS field_definitions (id INTEGER PRIMARY KEY, content_type_id INTEGER NOT NULL REFERENCES content_types(id) ON DELETE CASCADE, field_key TEXT NOT NULL, label TEXT NOT NULL, field_type TEXT NOT NULL, is_required INTEGER NOT NULL DEFAULT 0, default_value TEXT NULL, sort_order INTEGER NOT NULL DEFAULT 0, UNIQUE(content_type_id, field_key))", "CREATE TABLE IF NOT EXISTS entries (id INTEGER PRIMARY KEY, content_type_id INTEGER NOT NULL REFERENCES content_types(id), slug TEXT NOT NULL, full_path TEXT UNIQUE NOT NULL, title TEXT NOT NULL, status TEXT NOT NULL DEFAULT 'draft', body_html TEXT NOT NULL DEFAULT '', custom_fields_json TEXT NOT NULL DEFAULT '{}', meta_title TEXT NOT NULL DEFAULT '', meta_description TEXT NOT NULL DEFAULT '', published_at TEXT NULL, created_at TEXT NOT NULL, updated_at TEXT NOT NULL)", "CREATE TABLE IF NOT EXISTS slug_history (id INTEGER PRIMARY KEY, old_path TEXT UNIQUE NOT NULL, entry_id INTEGER NOT NULL REFERENCES entries(id) ON DELETE CASCADE, created_at TEXT NOT NULL)", "CREATE TABLE IF NOT EXISTS themes (slug TEXT PRIMARY KEY, name TEXT NOT NULL, version TEXT NOT NULL, engine TEXT NOT NULL, is_active INTEGER NOT NULL DEFAULT 0, manifest_json TEXT NOT NULL, installed_at TEXT NOT NULL)", "CREATE INDEX IF NOT EXISTS idx_field_definitions_type ON field_definitions(content_type_id, sort_order)", "CREATE INDEX IF NOT EXISTS idx_entries_type_status ON entries(content_type_id, status)", "CREATE INDEX IF NOT EXISTS idx_slug_history_entry ON slug_history(entry_id)"]}, record {version: 2, name: "grablab_v03_auth_schema", steps: ["CREATE TABLE IF NOT EXISTS users (id INTEGER PRIMARY KEY, email TEXT UNIQUE NOT NULL, display_name TEXT NOT NULL, role TEXT NOT NULL DEFAULT 'viewer', password_hash TEXT NULL, email_verified INTEGER NOT NULL DEFAULT 0, is_active INTEGER NOT NULL DEFAULT 1, last_login_at TEXT NULL, created_at TEXT NOT NULL, updated_at TEXT NOT NULL)", "CREATE TABLE IF NOT EXISTS sessions (id TEXT PRIMARY KEY, user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE, token_hash TEXT UNIQUE NOT NULL, csrf_secret TEXT NOT NULL, ip_hash TEXT NOT NULL DEFAULT '', user_agent TEXT NOT NULL DEFAULT '', expires_at TEXT NOT NULL, created_at TEXT NOT NULL, last_seen_at TEXT NOT NULL)", "CREATE TABLE IF NOT EXISTS oauth_accounts (id INTEGER PRIMARY KEY, user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE, provider TEXT NOT NULL, provider_user_id TEXT NOT NULL, provider_email TEXT NOT NULL, created_at TEXT NOT NULL, updated_at TEXT NOT NULL, UNIQUE(provider, provider_user_id))", "ALTER TABLE entries ADD COLUMN author_id INTEGER NULL REFERENCES users(id) ON DELETE SET NULL", "CREATE INDEX IF NOT EXISTS idx_sessions_user ON sessions(user_id)", "CREATE INDEX IF NOT EXISTS idx_sessions_expires ON sessions(expires_at)", "CREATE INDEX IF NOT EXISTS idx_oauth_user ON oauth_accounts(user_id)", "CREATE INDEX IF NOT EXISTS idx_entries_author ON entries(author_id)"]}]

show migration
