use crypto
use data
use dates
use env
use files
use json
use text

set db to data.open using "main"
set now_rec to call dates.now_utc
set now_iso to now_rec.iso

set check_setting to data.prepare using db, "SELECT value FROM site_settings WHERE key = :key", record {params: record {key: "text"}, columns: record {value: "text"}}
set insert_setting to data.prepare using db, "INSERT INTO site_settings (key, value, updated_at) VALUES (:key, :value, :updated_at)", record {params: record {key: "text", value: "text", updated_at: "text"}, columns: record {}}

set find_type to data.prepare using db, "SELECT id FROM content_types WHERE slug = :slug", record {params: record {slug: "text"}, columns: record {id: "integer"}}
set insert_type to data.prepare using db, "INSERT INTO content_types (slug, label_singular, label_plural, permalink_pattern, has_archive, archive_slug, is_system, created_at) VALUES (:slug, :label_singular, :label_plural, :permalink_pattern, :has_archive, :archive_slug, :is_system, :created_at)", record {params: record {slug: "text", label_singular: "text", label_plural: "text", permalink_pattern: "text", has_archive: "integer", archive_slug: record {type: "text", nullable: yes}, is_system: "integer", created_at: "text"}, columns: record {}}

set find_field to data.prepare using db, "SELECT id FROM field_definitions WHERE content_type_id = :content_type_id AND field_key = :field_key", record {params: record {content_type_id: "integer", field_key: "text"}, columns: record {id: "integer"}}
set insert_field to data.prepare using db, "INSERT INTO field_definitions (content_type_id, field_key, label, field_type, is_required, default_value, sort_order) VALUES (:content_type_id, :field_key, :label, :field_type, :is_required, :default_value, :sort_order)", record {params: record {content_type_id: "integer", field_key: "text", label: "text", field_type: "text", is_required: "integer", default_value: record {type: "text", nullable: yes}, sort_order: "integer"}, columns: record {}}

set find_entry to data.prepare using db, "SELECT id FROM entries WHERE full_path = :full_path", record {params: record {full_path: "text"}, columns: record {id: "integer"}}
set insert_entry to data.prepare using db, "INSERT INTO entries (content_type_id, slug, full_path, title, status, body_html, custom_fields_json, meta_title, meta_description, published_at, created_at, updated_at) VALUES (:content_type_id, :slug, :full_path, :title, :status, :body_html, :custom_fields_json, :meta_title, :meta_description, :published_at, :created_at, :updated_at)", record {params: record {content_type_id: "integer", slug: "text", full_path: "text", title: "text", status: "text", body_html: "text", custom_fields_json: "text", meta_title: "text", meta_description: "text", published_at: record {type: "text", nullable: yes}, created_at: "text", updated_at: "text"}, columns: record {}}

set find_theme to data.prepare using db, "SELECT slug, is_active FROM themes WHERE slug = :slug", record {params: record {slug: "text"}, columns: record {slug: "text", is_active: "integer"}}
set count_active_themes to data.prepare using db, "SELECT count(*) AS total FROM themes WHERE is_active = 1", record {params: record {}, columns: record {total: "integer"}}
set insert_theme to data.prepare using db, "INSERT INTO themes (slug, name, version, engine, is_active, manifest_json, installed_at) VALUES (:slug, :name, :version, :engine, :is_active, :manifest_json, :installed_at)", record {params: record {slug: "text", name: "text", version: "text", engine: "text", is_active: "integer", manifest_json: "text", installed_at: "text"}, columns: record {}}
set update_theme to data.prepare using db, "UPDATE themes SET name = :name, version = :version, engine = :engine, manifest_json = :manifest_json WHERE slug = :slug", record {params: record {name: "text", version: "text", engine: "text", manifest_json: "text", slug: "text"}, columns: record {}}

set count_users to data.prepare using db, "SELECT count(*) AS total FROM users", record {params: record {}, columns: record {total: "integer"}}
set insert_user to data.prepare using db, "INSERT INTO users (email, display_name, role, password_hash, email_verified, is_active, created_at, updated_at) VALUES (:email, :display_name, :role, :password_hash, :email_verified, :is_active, :created_at, :updated_at)", record {params: record {email: "text", display_name: "text", role: "text", password_hash: record {type: "text", nullable: yes}, email_verified: "integer", is_active: "integer", created_at: "text", updated_at: "text"}, columns: record {}}

set find_taxonomy to data.prepare using db, "SELECT id FROM taxonomies WHERE slug = :slug", record {params: record {slug: "text"}, columns: record {id: "integer"}}
set insert_taxonomy to data.prepare using db, "INSERT INTO taxonomies (slug, label_singular, label_plural, is_hierarchical, archive_slug, content_type_slugs_json, is_system, created_at) VALUES (:slug, :label_singular, :label_plural, :is_hierarchical, :archive_slug, :content_type_slugs_json, :is_system, :created_at)", record {params: record {slug: "text", label_singular: "text", label_plural: "text", is_hierarchical: "integer", archive_slug: "text", content_type_slugs_json: "text", is_system: "integer", created_at: "text"}, columns: record {}}

set find_term to data.prepare using db, "SELECT id FROM terms WHERE taxonomy_id = :taxonomy_id AND slug = :slug", record {params: record {taxonomy_id: "integer", slug: "text"}, columns: record {id: "integer"}}
set insert_term to data.prepare using db, "INSERT INTO terms (taxonomy_id, parent_id, slug, name, description, sort_order, created_at, updated_at) VALUES (:taxonomy_id, :parent_id, :slug, :name, :description, :sort_order, :created_at, :updated_at)", record {params: record {taxonomy_id: "integer", parent_id: record {type: "integer", nullable: yes}, slug: "text", name: "text", description: "text", sort_order: "integer", created_at: "text", updated_at: "text"}, columns: record {}}

set find_entry_term to data.prepare using db, "SELECT entry_id FROM entry_terms WHERE entry_id = :entry_id AND term_id = :term_id", record {params: record {entry_id: "integer", term_id: "integer"}, columns: record {entry_id: "integer"}}
set insert_entry_term to data.prepare using db, "INSERT INTO entry_terms (entry_id, term_id, created_at) VALUES (:entry_id, :term_id, :created_at)", record {params: record {entry_id: "integer", term_id: "integer", created_at: "text"}, columns: record {}}

set count_menus to data.prepare using db, "SELECT count(*) AS total FROM menus", record {params: record {}, columns: record {total: "integer"}}
set find_menu_by_slug to data.prepare using db, "SELECT id FROM menus WHERE slug = :slug", record {params: record {slug: "text"}, columns: record {id: "integer"}}
set insert_menu to data.prepare using db, "INSERT INTO menus (slug, name, location, created_at, updated_at) VALUES (:slug, :name, :location, :created_at, :updated_at)", record {params: record {slug: "text", name: "text", location: record {type: "text", nullable: yes}, created_at: "text", updated_at: "text"}, columns: record {}}
set insert_menu_item to data.prepare using db, "INSERT INTO menu_items (menu_id, parent_id, label, link_type, entry_id, external_url, target_blank, css_class, sort_order, created_at, updated_at) VALUES (:menu_id, :parent_id, :label, :link_type, :entry_id, :external_url, :target_blank, :css_class, :sort_order, :created_at, :updated_at)", record {params: record {menu_id: "integer", parent_id: record {type: "integer", nullable: yes}, label: "text", link_type: "text", entry_id: record {type: "integer", nullable: yes}, external_url: record {type: "text", nullable: yes}, target_blank: "integer", css_class: "text", sort_order: "integer", created_at: "text", updated_at: "text"}, columns: record {}}

set starter_manifest_raw to files.read_text using "themes/default-starter/theme.json"
set starter_manifest to json.parse using starter_manifest_raw

set default_oauth_json to json.stringify using {"google": {"enabled": no, "client_id": "", "client_secret_enc": "", "secret_hint": "", "allowed_domains": ""}, "github": {"enabled": no, "client_id": "", "client_secret_enc": "", "secret_hint": "", "allowed_domains": ""}, "discord": {"enabled": no, "client_id": "", "client_secret_enc": "", "secret_hint": "", "allowed_domains": ""}, "apple": {"enabled": no, "client_id": "", "client_secret_enc": "", "secret_hint": "", "allowed_domains": ""}}

set tx to data.begin using db

set defaults to [record {key: "site_title", value: "GrabLab CMS"}, record {key: "site_tagline", value: "Zero-plugin CMS built on GRAB v1.1.0 and Grex JS v1.0.0"}, record {key: "active_theme_slug", value: "default-starter"}, record {key: "home_entry_id", value: ""}, record {key: "oauth_providers_json", value: default_oauth_json}, record {key: "oauth_allow_signup", value: "false"}]
for each item in defaults
  set existing_setting to data.one using check_setting, record {key: item.key}, tx
  if existing_setting is nothing
    call data.execute using insert_setting, record {key: item.key, value: item.value, updated_at: now_iso}, tx
  end
end

set page_row to data.one using find_type, record {slug: "page"}, tx
if page_row is nothing
  call data.execute using insert_type, record {slug: "page", label_singular: "Page", label_plural: "Pages", permalink_pattern: "/:slug", has_archive: 0, archive_slug: nothing, is_system: 1, created_at: now_iso}, tx
  set page_row to data.one using find_type, record {slug: "page"}, tx
end

set post_row to data.one using find_type, record {slug: "post"}, tx
if post_row is nothing
  call data.execute using insert_type, record {slug: "post", label_singular: "Post", label_plural: "Posts", permalink_pattern: "/blog/:slug", has_archive: 1, archive_slug: "blog", is_system: 1, created_at: now_iso}, tx
  set post_row to data.one using find_type, record {slug: "post"}, tx
end

set page_subtitle to data.one using find_field, record {content_type_id: page_row.id, field_key: "subtitle"}, tx
if page_subtitle is nothing
  call data.execute using insert_field, record {content_type_id: page_row.id, field_key: "subtitle", label: "Subtitle", field_type: "text", is_required: 0, default_value: "", sort_order: 1}, tx
end

set post_subtitle to data.one using find_field, record {content_type_id: post_row.id, field_key: "subtitle"}, tx
if post_subtitle is nothing
  call data.execute using insert_field, record {content_type_id: post_row.id, field_key: "subtitle", label: "Subtitle", field_type: "text", is_required: 0, default_value: "", sort_order: 1}, tx
end

set post_minutes to data.one using find_field, record {content_type_id: post_row.id, field_key: "reading_minutes"}, tx
if post_minutes is nothing
  call data.execute using insert_field, record {content_type_id: post_row.id, field_key: "reading_minutes", label: "Reading Minutes", field_type: "integer", is_required: 0, default_value: "3", sort_order: 2}, tx
end

set about_entry to data.one using find_entry, record {full_path: "/about"}, tx
if about_entry is nothing
  call data.execute using insert_entry, record {content_type_id: page_row.id, slug: "about", full_path: "/about", title: "About GrabLab CMS", status: "published", body_html: "GrabLab CMS is a zero-plugin, security-first CMS built on GRAB v1.1.0 and Grex JS v1.0.0.", custom_fields_json: "{\"subtitle\":\"Clean core architecture\"}", meta_title: "About GrabLab CMS", meta_description: "Learn about GrabLab CMS.", published_at: now_iso, created_at: now_iso, updated_at: now_iso}, tx
end

set hello_entry to data.one using find_entry, record {full_path: "/blog/hello-world"}, tx
if hello_entry is nothing
  call data.execute using insert_entry, record {content_type_id: post_row.id, slug: "hello-world", full_path: "/blog/hello-world", title: "Hello, GrabLab CMS", status: "published", body_html: "Welcome to GrabLab CMS featuring typed custom fields, pretty permalinks, automatic 301 slug history, and native authentication.", custom_fields_json: "{\"subtitle\":\"First post on GrabLab\",\"reading_minutes\":\"2\"}", meta_title: "Hello, GrabLab CMS", meta_description: "First post on GrabLab CMS.", published_at: now_iso, created_at: now_iso, updated_at: now_iso}, tx
end

set starter_row to data.one using find_theme, record {slug: "default-starter"}, tx
if starter_row is nothing
  set active_count_row to data.one using count_active_themes, record {}, tx
  set make_active to 0
  if active_count_row.total is 0
    set make_active to 1
  end
  call data.execute using insert_theme, record {slug: starter_manifest at "slug", name: starter_manifest at "name", version: starter_manifest at "version", engine: starter_manifest at "engine", is_active: make_active, manifest_json: starter_manifest_raw, installed_at: now_iso}, tx
otherwise
  call data.execute using update_theme, record {name: starter_manifest at "name", version: starter_manifest at "version", engine: starter_manifest at "engine", manifest_json: starter_manifest_raw, slug: "default-starter"}, tx
end

try
  set user_cnt_row to data.one using count_users, record {}, tx
  if user_cnt_row is not nothing and user_cnt_row.total is 0
    if (env.has using "GRABLAB_ADMIN_EMAIL") and (env.has using "GRABLAB_ADMIN_PASSWORD")
      set admin_email to text.lower using (text.trim using (env.get using "GRABLAB_ADMIN_EMAIL"))
      set admin_pass to env.get using "GRABLAB_ADMIN_PASSWORD"
      set admin_name to "Site Administrator"
      try
        if env.has using "GRABLAB_ADMIN_NAME"
          set env_name to text.trim using (env.get using "GRABLAB_ADMIN_NAME")
          if env_name is not ""
            set admin_name to env_name
          end
        end
      catch name_err
      end
      if admin_email is not "" and (text.length using admin_pass) is at least 10
        set pw_hash to crypto.hash_password using admin_pass
        call data.execute using insert_user, record {email: admin_email, display_name: admin_name, role: "admin", password_hash: pw_hash, email_verified: 1, is_active: 1, created_at: now_iso, updated_at: now_iso}, tx
      end
    end
  end
catch seed_user_err
end

set cat_tax_row to data.one using find_taxonomy, record {slug: "category"}, tx
if cat_tax_row is nothing
  call data.execute using insert_taxonomy, record {slug: "category", label_singular: "Category", label_plural: "Categories", is_hierarchical: 1, archive_slug: "category", content_type_slugs_json: "[\"post\"]", is_system: 1, created_at: now_iso}, tx
  set cat_tax_row to data.one using find_taxonomy, record {slug: "category"}, tx
end

set tag_tax_row to data.one using find_taxonomy, record {slug: "post_tag"}, tx
if tag_tax_row is nothing
  call data.execute using insert_taxonomy, record {slug: "post_tag", label_singular: "Tag", label_plural: "Tags", is_hierarchical: 0, archive_slug: "tag", content_type_slugs_json: "[\"post\"]", is_system: 1, created_at: now_iso}, tx
end

if cat_tax_row is not nothing
  set uncat_row to data.one using find_term, record {taxonomy_id: cat_tax_row.id, slug: "uncategorized"}, tx
  if uncat_row is nothing
    call data.execute using insert_term, record {taxonomy_id: cat_tax_row.id, parent_id: nothing, slug: "uncategorized", name: "Uncategorized", description: "Default post category", sort_order: 1, created_at: now_iso, updated_at: now_iso}, tx
    set uncat_row to data.one using find_term, record {taxonomy_id: cat_tax_row.id, slug: "uncategorized"}, tx
  end
  set hello_seeded to data.one using find_entry, record {full_path: "/blog/hello-world"}, tx
  if hello_seeded is not nothing and uncat_row is not nothing
    set existing_et to data.one using find_entry_term, record {entry_id: hello_seeded.id, term_id: uncat_row.id}, tx
    if existing_et is nothing
      call data.execute using insert_entry_term, record {entry_id: hello_seeded.id, term_id: uncat_row.id, created_at: now_iso}, tx
    end
  end
end

set menu_cnt_row to data.one using count_menus, record {}, tx
if menu_cnt_row is not nothing and menu_cnt_row.total is 0
  call data.execute using insert_menu, record {slug: "main-nav", name: "Main Navigation", location: "primary", created_at: now_iso, updated_at: now_iso}, tx
  set main_menu_row to data.one using find_menu_by_slug, record {slug: "main-nav"}, tx
  if main_menu_row is not nothing
    call data.execute using insert_menu_item, record {menu_id: main_menu_row.id, parent_id: nothing, label: "Home", link_type: "external", entry_id: nothing, external_url: "/", target_blank: 0, css_class: "", sort_order: 1, created_at: now_iso, updated_at: now_iso}, tx
    call data.execute using insert_menu_item, record {menu_id: main_menu_row.id, parent_id: nothing, label: "Blog", link_type: "external", entry_id: nothing, external_url: "/blog", target_blank: 0, css_class: "", sort_order: 2, created_at: now_iso, updated_at: now_iso}, tx
    set about_seeded to data.one using find_entry, record {full_path: "/about"}, tx
    if about_seeded is not nothing
      call data.execute using insert_menu_item, record {menu_id: main_menu_row.id, parent_id: nothing, label: "About", link_type: "entry", entry_id: about_seeded.id, external_url: nothing, target_blank: 0, css_class: "", sort_order: 3, created_at: now_iso, updated_at: now_iso}, tx
    end
  end
end

call data.commit using tx
show "GrabLab CMS v1.0.1 seed completed."
