use data

set db to data.open using "main"

set migration to data.migrate using db, [record {version: 1, name: "grablab_v01_schema_postgres", steps: ["CREATE TABLE IF NOT EXISTS site_settings (key VARCHAR(128) PRIMARY KEY, value TEXT NOT NULL, updated_at TEXT NOT NULL)", "CREATE TABLE IF NOT EXISTS content_types (id INTEGER PRIMARY KEY GENERATED BY DEFAULT AS IDENTITY, slug VARCHAR(64) UNIQUE NOT NULL, label_singular TEXT NOT NULL, label_plural TEXT NOT NULL, permalink_pattern TEXT NOT NULL, has_archive INTEGER NOT NULL DEFAULT 1, archive_slug VARCHAR(64) NULL, is_system INTEGER NOT NULL DEFAULT 0, created_at TEXT NOT NULL)", "CREATE TABLE IF NOT EXISTS field_definitions (id INTEGER PRIMARY KEY GENERATED BY DEFAULT AS IDENTITY, content_type_id INTEGER NOT NULL REFERENCES content_types(id) ON DELETE CASCADE, field_key VARCHAR(64) NOT NULL, label TEXT NOT NULL, field_type TEXT NOT NULL, is_required INTEGER NOT NULL DEFAULT 0, default_value TEXT NULL, sort_order INTEGER NOT NULL DEFAULT 0, UNIQUE(content_type_id, field_key))", "CREATE TABLE IF NOT EXISTS entries (id INTEGER PRIMARY KEY GENERATED BY DEFAULT AS IDENTITY, content_type_id INTEGER NOT NULL REFERENCES content_types(id), slug VARCHAR(190) NOT NULL, full_path VARCHAR(255) UNIQUE NOT NULL, title TEXT NOT NULL, status VARCHAR(32) NOT NULL DEFAULT 'draft', body_html TEXT NOT NULL DEFAULT '', custom_fields_json TEXT NOT NULL DEFAULT '{}', meta_title TEXT NOT NULL DEFAULT '', meta_description TEXT NOT NULL DEFAULT '', published_at TEXT NULL, created_at TEXT NOT NULL, updated_at TEXT NOT NULL)", "CREATE TABLE IF NOT EXISTS slug_history (id INTEGER PRIMARY KEY GENERATED BY DEFAULT AS IDENTITY, old_path VARCHAR(255) UNIQUE NOT NULL, entry_id INTEGER NOT NULL REFERENCES entries(id) ON DELETE CASCADE, created_at TEXT NOT NULL)", "CREATE TABLE IF NOT EXISTS themes (slug VARCHAR(64) PRIMARY KEY, name TEXT NOT NULL, version TEXT NOT NULL, engine VARCHAR(32) NOT NULL, is_active INTEGER NOT NULL DEFAULT 0, manifest_json TEXT NOT NULL, installed_at TEXT NOT NULL)", "CREATE INDEX IF NOT EXISTS idx_field_definitions_type ON field_definitions(content_type_id, sort_order)", "CREATE INDEX IF NOT EXISTS idx_entries_type_status ON entries(content_type_id, status)", "CREATE INDEX IF NOT EXISTS idx_slug_history_entry ON slug_history(entry_id)"]}, record {version: 2, name: "grablab_v03_auth_schema_postgres", steps: ["CREATE TABLE IF NOT EXISTS users (id INTEGER PRIMARY KEY GENERATED BY DEFAULT AS IDENTITY, email VARCHAR(255) UNIQUE NOT NULL, display_name VARCHAR(120) NOT NULL, role VARCHAR(32) NOT NULL DEFAULT 'viewer', password_hash TEXT NULL, email_verified INTEGER NOT NULL DEFAULT 0, is_active INTEGER NOT NULL DEFAULT 1, last_login_at TEXT NULL, created_at TEXT NOT NULL, updated_at TEXT NOT NULL)", "CREATE TABLE IF NOT EXISTS sessions (id VARCHAR(64) PRIMARY KEY, user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE, token_hash VARCHAR(128) UNIQUE NOT NULL, csrf_secret TEXT NOT NULL, ip_hash VARCHAR(64) NOT NULL DEFAULT '', user_agent TEXT NOT NULL DEFAULT '', expires_at TEXT NOT NULL, created_at TEXT NOT NULL, last_seen_at TEXT NOT NULL)", "CREATE TABLE IF NOT EXISTS oauth_accounts (id INTEGER PRIMARY KEY GENERATED BY DEFAULT AS IDENTITY, user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE, provider VARCHAR(32) NOT NULL, provider_user_id VARCHAR(190) NOT NULL, provider_email VARCHAR(255) NOT NULL, created_at TEXT NOT NULL, updated_at TEXT NOT NULL, UNIQUE(provider, provider_user_id))", "ALTER TABLE entries ADD COLUMN author_id INTEGER NULL REFERENCES users(id) ON DELETE SET NULL", "CREATE INDEX IF NOT EXISTS idx_sessions_user ON sessions(user_id)", "CREATE INDEX IF NOT EXISTS idx_sessions_expires ON sessions(expires_at)", "CREATE INDEX IF NOT EXISTS idx_oauth_user ON oauth_accounts(user_id)", "CREATE INDEX IF NOT EXISTS idx_entries_author ON entries(author_id)"]}, record {version: 3, name: "grablab_v04_cms_schema_postgres", steps: ["CREATE TABLE IF NOT EXISTS media (id INTEGER PRIMARY KEY GENERATED BY DEFAULT AS IDENTITY, filename VARCHAR(128) UNIQUE NOT NULL, original_name VARCHAR(255) NOT NULL, storage_path VARCHAR(255) UNIQUE NOT NULL, mime_type VARCHAR(128) NOT NULL, byte_size INTEGER NOT NULL, width INTEGER NULL, height INTEGER NULL, alt_text VARCHAR(512) NOT NULL DEFAULT '', is_decorative INTEGER NOT NULL DEFAULT 0, caption TEXT NOT NULL DEFAULT '', sha256_hex VARCHAR(64) NOT NULL, uploader_id INTEGER NULL REFERENCES users(id) ON DELETE SET NULL, created_at TEXT NOT NULL, updated_at TEXT NOT NULL)", "CREATE TABLE IF NOT EXISTS menus (id INTEGER PRIMARY KEY GENERATED BY DEFAULT AS IDENTITY, slug VARCHAR(100) UNIQUE NOT NULL, name VARCHAR(120) NOT NULL, location VARCHAR(32) NULL, created_at TEXT NOT NULL, updated_at TEXT NOT NULL)", "CREATE TABLE IF NOT EXISTS menu_items (id INTEGER PRIMARY KEY GENERATED BY DEFAULT AS IDENTITY, menu_id INTEGER NOT NULL REFERENCES menus(id) ON DELETE CASCADE, parent_id INTEGER NULL REFERENCES menu_items(id) ON DELETE CASCADE, label VARCHAR(160) NOT NULL, link_type VARCHAR(16) NOT NULL, entry_id INTEGER NULL REFERENCES entries(id) ON DELETE SET NULL, external_url VARCHAR(512) NULL, target_blank INTEGER NOT NULL DEFAULT 0, css_class VARCHAR(120) NOT NULL DEFAULT '', sort_order INTEGER NOT NULL DEFAULT 0, created_at TEXT NOT NULL, updated_at TEXT NOT NULL)", "CREATE TABLE IF NOT EXISTS taxonomies (id INTEGER PRIMARY KEY GENERATED BY DEFAULT AS IDENTITY, slug VARCHAR(64) UNIQUE NOT NULL, label_singular VARCHAR(80) NOT NULL, label_plural VARCHAR(80) NOT NULL, is_hierarchical INTEGER NOT NULL DEFAULT 0, archive_slug VARCHAR(64) UNIQUE NOT NULL, content_type_slugs_json TEXT NOT NULL DEFAULT '[\"post\"]', is_system INTEGER NOT NULL DEFAULT 0, created_at TEXT NOT NULL)", "CREATE TABLE IF NOT EXISTS terms (id INTEGER PRIMARY KEY GENERATED BY DEFAULT AS IDENTITY, taxonomy_id INTEGER NOT NULL REFERENCES taxonomies(id) ON DELETE CASCADE, parent_id INTEGER NULL REFERENCES terms(id) ON DELETE SET NULL, slug VARCHAR(120) NOT NULL, name VARCHAR(120) NOT NULL, description TEXT NOT NULL DEFAULT '', sort_order INTEGER NOT NULL DEFAULT 0, created_at TEXT NOT NULL, updated_at TEXT NOT NULL, UNIQUE(taxonomy_id, slug))", "CREATE TABLE IF NOT EXISTS entry_terms (entry_id INTEGER NOT NULL REFERENCES entries(id) ON DELETE CASCADE, term_id INTEGER NOT NULL REFERENCES terms(id) ON DELETE CASCADE, created_at TEXT NOT NULL, PRIMARY KEY(entry_id, term_id))", "CREATE INDEX IF NOT EXISTS idx_media_uploader ON media(uploader_id)", "CREATE INDEX IF NOT EXISTS idx_media_mime ON media(mime_type)", "CREATE INDEX IF NOT EXISTS idx_menus_location ON menus(location)", "CREATE INDEX IF NOT EXISTS idx_menu_items_menu ON menu_items(menu_id, parent_id, sort_order)", "CREATE INDEX IF NOT EXISTS idx_terms_tax ON terms(taxonomy_id, sort_order)", "CREATE INDEX IF NOT EXISTS idx_entry_terms_term ON entry_terms(term_id)"]}]

show migration
