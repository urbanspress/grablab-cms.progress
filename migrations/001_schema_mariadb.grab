use data

set db to data.open using "main"

set migration to data.migrate using db, [record {version: 1, name: "grablab_v01_schema_mariadb", steps: ["CREATE TABLE IF NOT EXISTS site_settings (`key` VARCHAR(128) PRIMARY KEY, `value` TEXT NOT NULL, updated_at VARCHAR(40) NOT NULL)", "CREATE TABLE IF NOT EXISTS content_types (id INTEGER PRIMARY KEY AUTO_INCREMENT, slug VARCHAR(64) UNIQUE NOT NULL, label_singular VARCHAR(128) NOT NULL, label_plural VARCHAR(128) NOT NULL, permalink_pattern VARCHAR(255) NOT NULL, has_archive INTEGER NOT NULL DEFAULT 1, archive_slug VARCHAR(64) NULL, is_system INTEGER NOT NULL DEFAULT 0, created_at VARCHAR(40) NOT NULL)", "CREATE TABLE IF NOT EXISTS field_definitions (id INTEGER PRIMARY KEY AUTO_INCREMENT, content_type_id INTEGER NOT NULL, field_key VARCHAR(64) NOT NULL, label VARCHAR(128) NOT NULL, field_type VARCHAR(32) NOT NULL, is_required INTEGER NOT NULL DEFAULT 0, default_value TEXT NULL, sort_order INTEGER NOT NULL DEFAULT 0, UNIQUE KEY uq_type_field (content_type_id, field_key), CONSTRAINT fk_field_type FOREIGN KEY (content_type_id) REFERENCES content_types(id) ON DELETE CASCADE)", "CREATE TABLE IF NOT EXISTS entries (id INTEGER PRIMARY KEY AUTO_INCREMENT, content_type_id INTEGER NOT NULL, slug VARCHAR(190) NOT NULL, full_path VARCHAR(255) UNIQUE NOT NULL, title VARCHAR(255) NOT NULL, status VARCHAR(32) NOT NULL DEFAULT 'draft', body_html LONGTEXT NOT NULL, custom_fields_json LONGTEXT NOT NULL, meta_title VARCHAR(255) NOT NULL, meta_description TEXT NOT NULL, published_at VARCHAR(40) NULL, created_at VARCHAR(40) NOT NULL, updated_at VARCHAR(40) NOT NULL, CONSTRAINT fk_entry_type FOREIGN KEY (content_type_id) REFERENCES content_types(id))", "CREATE TABLE IF NOT EXISTS slug_history (id INTEGER PRIMARY KEY AUTO_INCREMENT, old_path VARCHAR(255) UNIQUE NOT NULL, entry_id INTEGER NOT NULL, created_at VARCHAR(40) NOT NULL, CONSTRAINT fk_slug_entry FOREIGN KEY (entry_id) REFERENCES entries(id) ON DELETE CASCADE)", "CREATE TABLE IF NOT EXISTS themes (slug VARCHAR(64) PRIMARY KEY, name VARCHAR(128) NOT NULL, version VARCHAR(64) NOT NULL, engine VARCHAR(32) NOT NULL, is_active INTEGER NOT NULL DEFAULT 0, manifest_json LONGTEXT NOT NULL, installed_at VARCHAR(40) NOT NULL)", "CREATE INDEX idx_field_definitions_type ON field_definitions(content_type_id, sort_order)", "CREATE INDEX idx_entries_type_status ON entries(content_type_id, status)", "CREATE INDEX idx_slug_history_entry ON slug_history(entry_id)"]}]

show migration
